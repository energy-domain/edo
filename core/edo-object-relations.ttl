    skos:definition "Minimum bending radius established in design for the component or system."@en,
        "Raio mínimo de curvatura estabelecido em projeto para o componente ou sistema."@pt-br ;
    skos:prefLabel "Designed Minimum Bending Radius"@en,
        "Raio mínimo de curvatura de projeto"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:DimensionalAttribute,
        edo:MechanicalAttribute ;

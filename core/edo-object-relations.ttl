    rdfs:subClassOf edo:EarlyLeakNomPressTableColumn ;
    skos:definition "Indicates the basis used to establish the tensile limit value during the Early Leak Nominal Pressure Test, ensuring the product's tensile strength is respected to avoid damage."@en ;
    skos:prefLabel "Early Leak Nominal Pressure Table - Tensile Limit Value Reference"@en,
        "Tabela de Pressão Nominal de Vazamento Precoce - Referência do Limite de Tração"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:ElasticityModulusAt23Degrees a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ElasticityModulusAt23Degrees" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Specifies the modulus of elasticity of the material at 23 degrees Celsius, indicating its stiffness or resistance to deformation under stress at this temperature. This property is crucial for determining how the flexible structure responds to mechanical loads, ensuring that it maintains structural integrity."@en,
        "Módulo de elasticidade a 23 graus Celsius (Específica para Materiais Metálicos e Poliméricos)"@pt-br ;
    skos:prefLabel "Elasticity Modulus At 23 Degrees"@en,
        "Módulo de Elasticidade a 23 Graus Celsius"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ElectricalControlCable a owl:Class ;
    dcterms:identifier "ElectricalControlCable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ElectricalControlCableEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalControlCableEnd ;
            owl:onProperty edo:hasEnd ],
        edo:ElectricalCable ;
    skos:definition "Electrical cable used for signal, control, instrumentation, electrical communication or low-power auxiliary supply functions within an umbilical or related subsea system."@en,
        "Cabo elétrico usado para funções de sinal, controle, instrumentação, comunicação elétrica ou alimentação auxiliar de baixa potência em um umbilical ou sistema submarino relacionado."@pt-br ;
    skos:prefLabel "Electrical Control Cable"@en,
        "Cabo Elétrico de Controle"@pt-br .

edo:ElectricalControlConnectorPort a owl:Class ;
    dcterms:identifier "ElectricalControlConnectorPort" ;
    rdfs:subClassOf edo:ElectricalConnectorPort,
        edo:ElectricalControlPort ;
    skos:definition "Electrical connector port whose represented service includes signal, control, instrumentation, electrical communication or low-power auxiliary supply functions."@en,
        "Porta de conector elétrico cujo serviço representado inclui funções de sinal, controle, instrumentação, comunicação elétrica ou alimentação auxiliar de baixa potência."@pt-br ;
    skos:prefLabel "Electrical Control Connector Port"@en,
        "Porta de Conector Elétrico de Controle"@pt-br .

edo:ElectricalPowerCable a owl:Class ;
    dcterms:identifier "ElectricalPowerCable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ElectricalPowerCableEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalPowerCableEnd ;
            owl:onProperty edo:hasEnd ],
        edo:ElectricalCable ;
    skos:definition "Electrical cable used primarily for transmission of electrical power to supply electrical loads, without defining the cable by an arbitrary voltage or current threshold."@en,
        "Cabo elétrico usado principalmente para transmissão de potência elétrica destinada à alimentação de cargas, sem definir o cabo por um limiar arbitrário de tensão ou corrente."@pt-br ;
    skos:prefLabel "Electrical Power Cable"@en,
        "Cabo Elétrico de Potência"@pt-br .

edo:ElectricalPowerConnectorPort a owl:Class ;
    dcterms:identifier "ElectricalPowerConnectorPort" ;
    rdfs:subClassOf edo:ElectricalConnectorPort,
        edo:ElectricalPowerPort ;
    skos:definition "Electrical connector port whose represented service is electrical power transmission to supply electrical loads."@en,
        "Porta de conector elétrico cujo serviço representado é transmissão de potência elétrica para alimentação de cargas."@pt-br ;
    skos:prefLabel "Electrical Power Connector Port"@en,
        "Porta de Conector Elétrico de Potência"@pt-br .

edo:ElectricalSpliceBox a owl:Class ;
    dcterms:identifier "ElectricalSpliceBox" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ElectricalSplicePort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalSplicePort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:SpliceBox ;
    skos:definition "Splice box providing enclosed electrical splice termination for two or more electrical splice interfaces. The class specializes the generic splice-box concept without preventing other splice-box technologies, such as optical splice boxes, from being represented separately."@en,
        "Caixa de emenda que fornece terminação elétrica por emenda enclausurada para duas ou mais interfaces elétricas de emenda. A classe especializa o conceito genérico de caixa de emenda sem impedir que outras tecnologias, como caixas de emenda óptica, sejam representadas separadamente."@pt-br ;
    skos:prefLabel "Electrical Splice Box"@en,
        "Caixa de Emenda Elétrica"@pt-br .

edo:EnergyDomains a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:VocabularyConcepts ;
    skos:prefLabel "Industrial Domains"@en,
        "Domínios Industriais"@pt-br .

edo:ErosionalVelocity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ErosionalVelocity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Represents the maximum velocity of a fluid at which erosion of the material begins to occur. This property is crucial for determining the operational limits of the system, ensuring that the material can withstand fluid flow without suffering erosive damage."@en ;
    skos:prefLabel "Erosional Velocity"@en,
        "Velocidade erosional"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Evidence a owl:Class ;
    dcterms:identifier "Evidence" ;
    rdfs:subClassOf edo:InformationArtifact ;
    skos:definition "An information artifact used to demonstrate the execution, condition or result of an activity or task, including images, video, audio, documents or other records."@en,
        "Artefato informacional utilizado para comprovar a execução, a condição ou o resultado de uma atividade ou tarefa, incluindo imagens, vídeo, áudio, documentos ou outros registros."@pt-br ;
    skos:prefLabel "Evidence"@en,
        "Evidência"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:ExecutiveProjectRevision a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ExecutiveProjectRevision" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the revision number of the executive project, represented as a numeric value that is incremented with each new submission (e.g., 0000, 0001, 0002), stored as text for consistency in formatting."@en,
        "Revisão do projeto executivo  Valor numérico incrementado a cada novo envio (0000, 0001, 0002 e etc.) como texto"@pt-br ;
    skos:prefLabel "Executive Project Revision"@en,
        "Revisão do Projeto Executivo"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:FatMaxPress a owl:Class ;

    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole .

edo:RequiredRiserConfiguration a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredRiserConfiguration" ;
    rdfs:subClassOf edo:RiserConfiguration ;
    skos:definition "Riser configuration or set of riser configurations required or admitted by the owner for the solution."@en,
        "Configuração ou conjunto de configurações de riser requeridas ou admitidas pelo owner para a solução."@pt-br ;
    skos:prefLabel "Required Riser Configuration"@en,
        "Configuração de Riser Requerida"@pt-br ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:RiserConfiguration .

edo:RequiredService a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredService" ;
    rdfs:subClassOf edo:Service ;
    skos:definition "Service or set of services that the owner requires the solution to be capable of performing."@en,
        "Serviço ou conjunto de serviços que o owner requer que a solução seja capaz de desempenhar."@pt-br ;
    skos:prefLabel "Required Service"@en,
        "Serviço Requerido"@pt-br ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:Service .

edo:RequiredVolumetricFlowRate a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredVolumetricFlowRate" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Required volumetric flow rate for the operating condition."@en,
        "Vazão volumétrica requerida para a condição operacional."@pt-br ;
    skos:prefLabel "RequiredVolumetricFlowRate"@en ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole .

edo:RiserBalcony a owl:Class ;
    dcterms:identifier "RiserBalcony" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edo:hosts ;
            owl:someValuesFrom edo:RiserSupport ],
        edo:Location ;
    skos:definition "Installation location for supports and accessories on the riser balcony of the production unit."@en,
        "Local de instalação para suportes e acessórios no riser balcony da unidade de produção"@pt-br ;
    skos:prefLabel "Riser Balcony"@en,
        "Plataforma do Riser"@pt-br .

edo:RotatingMachine a owl:Class ;
    dcterms:identifier "RotatingMachine" ;
    rdfs:subClassOf edo:PowerMachine ;
    skos:prefLabel "Rotating machine"@en,
        "Máquina rotativa"@pt-br .

edo:RuptDefAlongFibers a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RuptDefAlongFibers" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Describes the deformation that occurs when the composite material ruptures in a direction parallel to its fibers. This property is essential for assessing the material's behavior under stress aligned with the fiber orientation, providing insights into its performance and durability in subsea structures where axial forces are present."@en ;
    skos:prefLabel "Rupture Deformation Along Fibers"@en,
        "Deformação de Ruptura longitudinalmente às fibras"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RuptDefPerpendFibers a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RuptDefPerpendFibers" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Describes the deformation that occurs when the composite material ruptures in a direction perpendicular to its fibers. This property is crucial for understanding the material's behavior under stress conditions that do not align with the fiber orientation, helping to assess its performance and failure limits in subsea structures."@en ;
    skos:prefLabel "Rupture Deformation Perpendicular To Fibers"@en,
        "Deformação de Ruptura perpendicularmente às fibras"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:SerialNumber a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SerialNumber" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "A unique identifier assigned to each individual item, distinguishing it from all other units of the same type. The Serial Number is critical for traceability, maintenance, and warranty purposes, ensuring that the history, performance, and lifecycle of the equipment can be tracked. It is often used in conjunction with a Part Number, which identifies the type or model of the component."@en ;
    skos:prefLabel "Serial Number"@en,
        "Número de Série"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ShackleInnerDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ShackleInnerDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Indicates the inner diameter of the shackle. This property measures the width of the space inside the shackle, which is important for ensuring compatibility with other components and for determining the appropriate fit and load distribution."@en ;
    skos:prefLabel "Shackle Inner Diameter"@en,
        "Diâmetro interno da furação do olhal"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:ShackleOpeningWidth a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ShackleOpeningWidth" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Measures the width of the opening in the shackle where components, such as pins or cables, are inserted. This property is crucial for ensuring that the shackle can properly accommodate and secure the intended connecting elements."@en ;
    skos:prefLabel "Shackle Opening Width"@en,
        "Largura da Abertura"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ShackleOuterDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ShackleOuterDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Indicates the outer diameter of the shackle. This property provides the measurement of the overall width of the shackle, which is crucial for ensuring it fits properly with other components and meets the design specifications for load-bearing and connection requirements."@en ;
    skos:prefLabel "Shackle Outer Diameter"@en,
        "Diâmetro externo do olhal"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:ShackleThickness a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ShackleThickness" ;
    rdfs:subClassOf edo:DomainAttribute,
        edo:Thickness ;
    skos:definition "Specifies the thickness of the shackle material. This property measures the distance between the inner and outer surfaces of the shackle, which is essential for understanding its strength, durability, and ability to handle load stresses."@en ;
    skos:prefLabel "Shackle Thickness"@en,
        "Espessura do olhal"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Thickness .

edo:ShortTermFloatDensity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ShortTermFloatDensity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "The density of the float material in the early stages of operation, accounting for slight water absorption or other surface-level changes."@en,
        "Representa a densidade do flutuador logo após o início da operação, considerando um aumento de densidade devido à absorção de água em pequena quantidade ou outras alterações superficiais."@pt-br ;
    skos:prefLabel "Short Term Float Density"@en,
        "Densidade do Flutuador a Curto Prazo"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ShortTermFloatVolume a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ShortTermFloatVolume" ;
    rdfs:subClassOf edo:DisplacedVolume ;
    skos:definition "The expected submerged volume of the float during the initial phase of operation, considering minor factors like slight water absorption or small deformations."@en,
        "O volume submerso esperado logo após o início da operação, levando em consideração pequenas variações iniciais, como a absorção mínima de água ou pequenas deformações. Serve para calcular a flutuabilidade em condições reais no curto prazo."@pt-br ;
    skos:prefLabel "Short Term Float Volume"@en,
        "Volume do Flutuador a Curto Prazo"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:DisplacedVolume .

edo:SolubilityCurveAttribute a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SolubilityTable" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Provides data on the solubility of various substances in a material, used to evaluate how different fluids or gases dissolve into the structure. This information is essential for assessing material compatibility and predicting the effects of prolonged exposure to specific substances under operational conditions."@en ;
    skos:prefLabel "Solubility Table (Specific for Polymeric Materials)"@en,
        "Tabela de Solubilidade (Específica para Materiais Poliméricos)"@pt-br ;
    edo:attributeOntologicalNature edo:CurveAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute .

edo:SolubilityTable a owl:Class .

edo:SolubilityTable_MoleculeIdentifier a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SolubilityTable_MoleculeIdentifier" ;
    rdfs:subClassOf edo:SolubilityTableColumn ;
    skos:definition "Specifies the type of molecule. This property identifies the particular molecule involved, which is crucial for understanding the material's interaction with or response to different chemical substances."@en,
        "Tipo de Molécula (co2, h2s, ch4, h2o,…)"@pt-br ;
    skos:prefLabel "Molecule Identifier"@en,
        "Identificador de Molécula"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:SolubilityTable_PolymerState a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SolubilityTable_PolymerState" ;
    rdfs:subClassOf edo:SolubilityTableColumn ;
    skos:definition "The state of the polymeric material is specified.. This property is crucial for understanding how the material behaves under different conditions and its suitability for various applications."@en ;
    skos:prefLabel "Polymer State"@en,
        "Estado do Polímero"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:SolubilityTable_SolubilityCoefficient a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SolubilityTable_SolubilityCoefficient" ;
    rdfs:subClassOf edo:SolubilityTableColumn ;
    skos:definition "Represents the rate at which a substance dissolves in a specific material, indicating how much of the substance can be absorbed by the material. This property is important for understanding the material's chemical compatibility and behavior when exposed to various substances."@en ;
    skos:prefLabel "Solubility Coefficient"@en,
        "Coeficiente de solubilidade"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:SolubilityTable_Temperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SolubilityTable_Temperature" ;
    rdfs:subClassOf edo:SolubilityTableColumn ;
    skos:definition "Represents the thermal condition or measurement of heat for a component or system. This property is important for assessing how the component performs or operates under specific thermal conditions, ensuring it remains within safe and effective operating limits."@en ;
    skos:prefLabel "Temperature"@en,
        "Temperatura"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:SpatialRelation a owl:ObjectProperty ;
    rdfs:label "Spatial Relation"@en,
        "Relação Espacial"@pt-br ;
    dcterms:identifier "SpatialRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:definition "Category of relationships used to express containment, location or spatial organisation between domain entities."@en,
        "Categoria de relacionamentos usada para expressar contenção, localização ou organização espacial entre entidades do domínio."@pt-br .

edo:SpecialRequirements a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SpecialRequirements" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Special requirements refer to specific conditions, standards, or instructions that must be met during the design, manufacturing, installation, or operation of an object or system. These can include unique technical specifications, safety measures, regulatory compliance, or client-specific requests that go beyond standard procedures."@en,
        "Requisitos especiais, Observações ou Documentos especiais para o tramo"@pt-br ;
    skos:prefLabel "Special Requirements"@en,
        "Requisitos Especiais"@pt-br ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:SpecificHeatCapacity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SpecificHeatCapacity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the amount of heat required to raise the temperature of the material by a specific amount, typically measured per unit mass. This property is important for understanding the thermal behavior of the material.."@en,
        "Calor Específico do material"@pt-br ;
    skos:prefLabel "Specific Heat Capacity"@en,
        "Calor Específico"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:SpecificWeight a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SpecificWeight" ;
    rdfs:subClassOf edo:Weight ;
    skos:definition "Weight per unit volume."@en,
        "Peso por unidade de volume."@pt-br ;
    skos:prefLabel "Specific Weight"@en,
        "Peso Específico"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N-PER-M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Weight .

edo:SpoolingTension a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SpoolingTension" ;
    rdfs:subClassOf edo:Tension ;
    skos:definition "Tension applied to a flexible component during the spooling process."@en,
        "Tração aplicada a um componente flexível durante o processo de bobinamento."@pt-br ;
    skos:prefLabel "Spooling Tension"@en,
        "Tração de bobinamento"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute,
        edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Tension .

edo:StatusAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "StatusAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a status, state or editorial/operational condition of an element or artefact."@en,
        "Atributo que representa um status, estado ou condição editorial/operacional de um elemento ou artefato."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Status attribute"@en,
        "Atributo de status"@pt-br .

edo:StiffTorsionalStiffnessAtSeaLevel a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StiffTorsionalStiffnessAtSeaLevel" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Represents the torsional stiffness of a component when measured at sea level, indicating its resistance to twisting under applied torque. This property is important for ensuring that the component maintains its structural integrity and performance under rotational forces."@en,
        "Rigidez a torção (GJ) (maior valor) a 20°C e pressão atmosferica (dentro e fora)"@pt-br ;
    skos:prefLabel "Stiff Torsional Stiffness At Sea Level"@en,
        "Rigidez a Torção Rígida ao Nível do Mar"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:StrIntOffPLevMaxPress a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrIntOffPLevMaxPress" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The maximum pressure applied during the Structural Integrity Test (offshore, at platform level), ensuring structural integrity under extreme conditions."@en,
        "Condições de teste dos tramos para Pressão - Máxima - Teste de integridade estrutural hidrostática (off-shore, no nível da plataforma)"@pt-br ;
    skos:prefLabel "Structural Integrity Offshore Leak Test At Platform Level Maximum Pressure"@en,
        "Integridade Estrutural Offshore com Pressão Máxima no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:StrIntOffPLevMaxPressValRef a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrIntOffPLevMaxPressValRef" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "Specifies the reference pressure used to determine the Structural Offshore Maximum Pressure value."@en,
        "Comentários Condições de teste dos tramos para - Máximo - Teste de integridade estrutural hidrostática (off-shore, no nível da plataforma)"@pt-br ;
    skos:prefLabel "Structural Integrity Offshore Leak Test At Platform Level Maximum Pressure Value Reference"@en,
        "Referência de Valor de Pressão Máxima para Teste de Integridade Estrutural Offshore e de Vazamento no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:StrIntOffPLevMaxPressValRefMult a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrIntOffPLevMaxPressValRefMult" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The multiplier applied to the reference pressure to determine the Structural Offshore Maximum Pressure value."@en ;
    skos:prefLabel "Structural Integrity Offshore Leak Test At Platform Level Maximum Pressure Value Reference Multiplier"@en,
        "Multiplicador de Referência de Valor de Pressão Máxima para Teste de Integridade Estrutural Offshore no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:StrIntOffPLevNomPress a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrIntOffPLevNomPress" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The nominal pressure applied during the Structural Integrity Test (offshore, at platform level), simulating typical conditions to verify structural integrity."@en,
        "Condições de teste dos tramos para Pressão - Nominal - Teste de integridade estrutural hidrostática (off-shore, no nível da plataforma)"@pt-br ;
    skos:prefLabel "Structural Integrity Offshore Leak Test At Platform Level Nominal Pressure"@en,
        "Integridade Estrutural Offshore com Pressão Nominal no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:StrIntOffPLevNomPressValRef a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrIntOffPLevNomPressValRef" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "Specifies the reference pressure used to determine the Structural Offshore Leak Test Nominal Pressure value."@en,
        "Comentários Condições de teste dos tramos para - Nominal - Teste de integridade estrutural hidrostática (off-shore, no nível da plataforma)"@pt-br ;
    skos:prefLabel "Structural Integrity Offshore Leak Test At Platform Level Nominal Pressure Value Reference"@en,
        "Referência de Valor de Pressão Nominal para Teste de Integridade Estrutural Offshore no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:StrIntOffPLevNomPressValRefMult a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrIntOffPLevNomPressValRefMult" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;

    dcterms:identifier "StrIntOnNoTensNomPress" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The nominal pressure applied during the Structural Integrity Test (onboard, without tension), simulating typical conditions to verify structural integrity."@en,

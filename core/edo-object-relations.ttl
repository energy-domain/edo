edo:StrandsTableAttribute a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrandsTableAttribute" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Provides detailed information about the mechanical and geometrical properties, including dimensions and material characteristics, necessary for understanding and evaluating the component's performance and suitability for its intended application."@en ;
    skos:prefLabel "Strands Table"@en,
        "Tabela de Propriedades das Cordoalhas"@pt-br ;
    edo:attributeOntologicalNature edo:TableAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute .

edo:StrandsTable_SpareQuantity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrandsTable_SpareQuantity" ;
    rdfs:subClassOf edo:StrandsTableColumn ;
    skos:definition "Specifies the number of spare units available, ensuring adequate backup components are on hand for maintenance or replacement. This quantity helps in planning and minimizing downtime during operations in subsea environments."@en ;
    skos:prefLabel "Spare Quantity"@en,
        "Quantidade de Sobressalentes"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:StrandsTable_StrandsLength a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrandsTable_StrandsLength" ;
    rdfs:subClassOf edo:StrandsTableColumn ;
    skos:definition "Length of the individual strands."@en ;
    skos:prefLabel "Strands Length"@en,
        "Comprimento das Cordoalhas"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:StrandsTable_StrandsQuantity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StrandsTable_StrandsQuantity" ;
    rdfs:subClassOf edo:StrandsTableColumn ;
    skos:definition "Number of individual strands used, determining the overall reinforcement and strength of the component."@en ;
    skos:prefLabel "Strands Quantity"@en,
        "Quantidade de Cordoalhas"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:StructureApplicationsList a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StructureApplicationsList" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the possible positions where the structure can be applied along the pipeline system. Multiple values can be selected to show in which sections, such as different parts of a riser or flowline, the structure is suitable for use."@en,
        "Lista de todas as possíveis aplicações para a estrutura Valores aplicáveis (Mais de um valor pode ser escolhido): R (Riser) RT (Para seção de topo do riser) RI (Para seção intermediaria do riser) RF (Para seção de fundo do riser) F (Para Flowline)"@pt-br ;
    skos:prefLabel "Structure Applications List"@en,
        "Lista de Aplicações da Estrutura"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:StructureCode a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StructureCode" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the code or identifier assigned to the structure. This property is used to uniquely identify and reference the structure within a system, ensuring proper tracking, documentation, and management."@en ;
    skos:prefLabel "Structure Code"@en,
        "Código da estrutura"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:SubProjectId a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SubProjectId" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Refers to the identification code assigned to the well or piece of equipment for which the interconnection is being designed. This code is often provisional, used during the initial stages of development, such as during the fabrication or installation of flexible pipelines, before a final approval or designation is granted. It serves as a reference point for all equipment and documentation until the well or equipment receives its definitive identification from the relevant regulatory authority. Examples include codes like LL-S.P6, LL-S.MSIAG1, or simpler identifiers such as P6 or MSIAG1."@en ;
    skos:prefLabel "Sub Project Id"@en,
        "Id do Subprojeto"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:SupplierProvidedMaterialName a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SupplierProvidedMaterialName" ;
    rdfs:subClassOf edo:MaterialManufacturerAttribute ;
    skos:definition "Name of the material as specified by the original supplier. This property identifies the exact material provided, ensuring it aligns with the required specifications for the accessory."@en ;
    skos:prefLabel "Supplier Provided Material Name"@en,
        "Nome do material conforme designado pelo fornecedor original do material"@pt-br ;
    edo:attributeOntologicalNature edo:MaterialCompositionAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TechnicalDisciplines a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:VocabularyConcepts ;
    skos:prefLabel "Technical Disciplines"@en,
        "Disciplinas Técnicas"@pt-br .

edo:TemporalAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "TemporalAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that records a date, time, timestamp or planned temporal reference."@en,
        "Atributo que registra uma data, hora, timestamp ou referência temporal planejada."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Temporal attribute"@en,
        "Atributo temporal"@pt-br .

edo:TensileArmourAnnulusCondition a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensileArmourAnnulusCondition" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute,
        edo:DomainAttribute ;
    skos:definition "Indicates the condition of the annulus in the tensile armour layer, which refers to the space between the tensile armour and other layers."@en,
        "Condição do anular das amarduras de tração, Alagado ou Seco"@pt-br ;
    skos:prefLabel "Tensile Armour Annulus Condition"@en,
        "Condição do Anular das Armaduras de Tração"@pt-br ;
    edo:attributeOntologicalNature edo:ConditionAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TensileArmourFreeAnnulusVolume a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensileArmourFreeAnnulusVolume" ;
    rdfs:subClassOf edo:InternalVolume ;
    skos:definition "Indicates the available volume within the annulus of the tensile armour layer that is not occupied by material."@en ;
    skos:prefLabel "Tensile Armour Free Annulus Volume"@en,
        "Volume livre do anular das armaduras de tração"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:OperationalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:InternalVolume .

edo:TensileWireLayAngle a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensileWireLayAngle" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Refers to the angle formed between the individual tensile wires and the longitudinal axis of the flexible pipe. This angle determines how the wires are arranged around the pipe, influencing its mechanical properties and performance under load."@en ;
    skos:prefLabel "Tensile Wire Lay Angle"@en,
        "Ângulo de Enrolamento dos Arames sob Tração"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TensileWiresCount a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensileWiresCount" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the total number of tensile wires in the layer, which contributes to the mechanical strength and load-bearing capacity of the flexible pipe."@en ;
    skos:prefLabel "Tensile Wires Count"@en,
        "Quantidade de Arames de Tração"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TensionerPadsMaterial a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensionerPadsMaterial" ;
    rdfs:subClassOf edo:CrushingFrictionCoefficientTighteningAttribute,
        edo:CrushingMaximumAllowableTighteningAttribute ;
    skos:definition "Indicates the fabrication material used for the tensioner pads. This property is important for assessing the durability, friction, and wear resistance of the pads, ensuring they perform effectively under operational conditions."@en,
        "Nome do material da sapata do tensionador (Por exemplo, Carbon Steel)"@pt-br ;
    skos:prefLabel "Tensioner Pads Material"@en,
        "Material das Sapatas do Tensionador"@pt-br ;
    edo:attributeOntologicalNature edo:MaterialCompositionAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TensionerPadsOpeningAngle a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensionerPadsOpeningAngle" ;
    rdfs:subClassOf edo:CrushingFrictionCoefficientTighteningAttribute,
        edo:CrushingMaximumAllowableTighteningAttribute ;
    skos:definition "Defines the opening angle of the tensioner pads. This angle is crucial for determining how the pads make contact with the surface, affecting the distribution of force and the overall efficiency of the tightening process. Proper control of this angle ensures effective load application and surface protection during operation."@en ;
    skos:prefLabel "Tensioner Pads Opening Angle"@en,
        "Ângulo de Abertura das Sapatas do Tensionador"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TensionerPadsShape a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensionerPadsShape" ;
    rdfs:subClassOf edo:CrushingFrictionCoefficientTighteningAttribute,
        edo:CrushingMaximumAllowableTighteningAttribute ;
    skos:definition "Specifies the geometric shape of the tensioner pads. The shape affects the contact area, frictional performance, and overall effectiveness of the tightening process, influencing how forces are applied and distributed."@en,
        "Disposição geométrica da sapata (Por exemplo \"V\")"@pt-br ;
    skos:prefLabel "Tensioner Pads Shape"@en,
        "Forma das Sapatas do Tensionador"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TensionerTracksQuantity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TensionerTracksQuantity" ;
    rdfs:subClassOf edo:CrushingFrictionCoefficientTighteningAttribute,
        edo:CrushingMaximumAllowableTighteningAttribute ;
    skos:definition "Indicates the quantity of tensioner tracks. This value is important for understanding the distribution of tightening forces and how evenly the load is applied across the structure during the tightening process."@en,
        "Quantidade de lagartas do tensionador (Por exemplo, 4)"@pt-br ;
    skos:prefLabel "Tensioner Tracks Quantity"@en,
        "Quantidade de Lagartas do Tensionador"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TestConditions a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TestConditions" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute,
        edo:CrushingFrictionCoefficientTighteningAttribute,
        edo:CrushingMaximumAllowableTensionAttribute,
        edo:CrushingMaximumAllowableTighteningAttribute,
        edo:DomainAttribute,
        edo:LayingMinimumRadiusCurveAttribute ;
    skos:definition "Specifies unstructured complementary information regarding the conditions under which a test is performed. This property may include additional details such as temperature, pressure, load, or other factors that could influence the test results, providing context for accurate interpretation of performance assessments."@en,
        "Descrição completa das condições para a execução do ensaio"@pt-br ;
    skos:prefLabel "Test Conditions"@en,
        "Condições de Teste"@pt-br ;
    edo:attributeOntologicalNature edo:ConditionAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TestEquipment a owl:Class ;
    dcterms:identifier "TestEquipment" ;
    rdfs:subClassOf edo:SurfaceEquipment ;
    skos:prefLabel "Test equipment"@en,
        "Equipamento de teste"@pt-br .

edo:ThermalConductivityCoefficient a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ThermalConductivityCoefficient" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the material's ability to conduct heat, measured as the rate at which heat passes through the material under a temperature gradient. This property is important for assessing how the material handles heat transfer in subsea environments, ensuring it can maintain performance under varying thermal conditions."@en,
        "Coeficiente de Condutividade Térmica do material (Obs. Para materiais compósitos, indicar o coefitiente no sentido longitudinal das fibras)"@pt-br ;
    skos:prefLabel "Thermal Conductivity Coefficient"@en,
        "Coeficiente de Condutividade Térmica"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ThermalExchangeCoefficientFlooded a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ThermalExchangeCoefficientFlooded" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the rate at which heat is transferred through a material or component in flooded conditions. This property is essential for assessing the material's thermal performance, influencing its ability to manage heat effectively in operational scenarios where it is exposed to fluid filling."@en,
        "Coeficiente de troca térmica na temperatura máxima de projeto no interior, na temperatura da profundidade máxima especificada da água no exterior, com os anulares de isolamento e das armadura de tração alagados, no final da vida útil."@pt-br ;
    skos:prefLabel "Thermal Exchange Coefficient Flooded"@en,
        "Coeficiente de Troca Térmica em Condição Alagada"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute,
        edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ThreadPitch a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ThreadPitch" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "The distance between adjacent thread crests, measured along the thread's axis, determining the threading's fineness or coarseness."@en ;
    skos:prefLabel "Thread Pitch"@en,
        "Passo da Rosca"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ThreadStandard a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ThreadStandard" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "The standard specification governing the design and dimensions of threads used in the component, ensuring compatibility and interchangeability."@en ;
    skos:prefLabel "Thread Standard"@en,
        "Padrão de Rosca"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ThreadedFastenerType a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ThreadedFastenerType" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Type of threaded fastening element used in the set."@en,
        "Tipo de elemento de fixação roscado utilizado no conjunto."@pt-br ;
    skos:prefLabel "Threaded Fastener Type"@en,
        "Tipo de Fixador Roscado"@pt-br ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:validValues "BOLT",
        "STUD" .

edo:ThreadsPerInch a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ThreadsPerInch" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Threads per Inch. Indicates the number of threads present in one inch of the bolt"@en ;
    skos:prefLabel "Threads Per Inch"@en,
        "Fios por Polegada"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Timestamp a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Timestamp" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Exact date and time, providing a precise reference for tracking when an event or action occurred within the system."@en ;
    skos:prefLabel "Timestamp"@en ;
    edo:attributeCategory edo:ProvenanceAttribute ;
    edo:attributeOntologicalNature edo:ProvenanceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:DateTimeValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:TowardsReferencePoint a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "TowardsReferencePoint" ;
    dcterms:isReplacedBy edo:hasReferenceDatum ;
    owl:deprecated true ;
    skos:broader edo:DomainValueConcepts ;
    skos:definition "Longitudinal orientation value indicating that the placement is measured towards the reference point along the applicable longitudinal direction."@en,
        "Valor de orientação longitudinal que indica que o posicionamento é medido em direção ao ponto de referência ao longo da direção longitudinal aplicável."@pt-br ;
    skos:inScheme edo:DomainValueConcept ;
    skos:prefLabel "Towards reference point"@en,
        "Em direção ao ponto de referência"@pt-br .

edo:UltTensStrAlongFibers a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "UltTensStrAlongFibers" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the maximum tensile stress a material can withstand along the direction of its fibers before breaking. This property is crucial for assessing the strength of fiber-reinforced materials, ensuring they can handle tensile loads effectively in the direction of fiber alignment."@en ;
    skos:prefLabel "Ultimate Tensile Strength Along Fibers"@en,
        "Tensão máxima de tração longitudinalmente às fibras"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:UltTensStrPerpendFibers a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "UltTensStrPerpendFibers" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the maximum tensile stress a material can withstand when applied perpendicular to the direction of its fibers before breaking. This property is important for evaluating the strength and durability of fiber-reinforced materials under tensile loads that are not aligned with the fibers, providing insights into their performance in various loading conditions."@en ;
    skos:prefLabel "Ultimate Tensile Strength Perpendicular To Fibers"@en,
        "Tensão máxima de tração perpendicularmente às fibras"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:UltimateTensileStress a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "UltimateTensileStress" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the maximum stress a material can withstand while being stretched or pulled before breaking. This property is essential for evaluating the material's strength and determining its ability to perform under tensile loads without failure."@en,
        "Tensão máxima de tração (Específica para Materiais Metálicos)"@pt-br ;
    skos:prefLabel "Ultimate Tensile Stress"@en,
        "Tensão Máxima de Tração"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:UmbilicalSegment a owl:Class ;
    dcterms:identifier "UmbilicalSegment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:UmbilicalEnd ;
            owl:onProperty edo:hasEnd ],
        [ a owl:Restriction ;
            owl:onClass edo:UmbilicalEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:FunctionLine ;
            owl:onProperty edo:hasPart ],
        edo:TransportLineSegment ;
    skos:prefLabel "Umbilical Segment"@en,
        "Tramo de Umbilical"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:UnifilarDiagram a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "UnifilarDiagram" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "A simplified schematic illustrates the arrangement of flexible pipeline sections and their associated accessories, such as end fittings and clamps. This diagram shows how these sections and accessories are connected, providing a clear overview of the pipeline configuration without detailing internal structures. It is used to aid in planning, installation, and understanding of the flexible pipeline system by visualizing the main components and their positions."@en ;
    skos:prefLabel "Unifilar Diagram"@en,
        "Código do Diagrama Unifilar"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:UnifilarDiagramRev a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "UnifilarDiagramRev" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the revision number of the unifilar diagram, reflecting updates or changes made to the arrangement of pipeline sections and their accessories. Each revision ensures that the latest configuration is accurately documented for installation and planning purposes."@en ;
    skos:prefLabel "Unifilar Diagram Revision"@en,
        "Número da Revisão do Diagrama Unifilar"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:UpperItubeDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "UpperItubeDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Diameter of the upper section of the tube or pipe. This measurement is important for ensuring proper fit and compatibility with other components or connections. The diameter of the upper section affects the alignment and sealing capabilities of the assembly, and ensures that the tube or pipe meets the design and operational requirements for the installation or application."@en ;
    skos:prefLabel "Upper I-tube Diameter"@en,
        "Diâmetro do I-TUBE superior"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:UtilizationFactor a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "UtilizationFactor" ;
    rdfs:subClassOf edo:CrushingFrictionCoefficientTighteningAttribute,
        edo:CrushingMaximumAllowableTensionAttribute,
        edo:CrushingMaximumAllowableTighteningAttribute ;
    skos:definition "Represents the ratio used to determine the level of utilisation, indicating how much of the system’s capacity is being used under given conditions. This factor is crucial for assessing whether the structure operates within safe limits or approaching its maximum capacity."@en ;
    skos:prefLabel "Utilization Factor"@en,
        "Fator de Utilização"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Vessel a owl:Class ;
    dcterms:identifier "Vessel" ;
    rdfs:subClassOf edo:PressureComponent ;
    skos:prefLabel "Vessel"@en,
        "Vaso"@pt-br .

edo:WetChristmasTree a owl:Class ;
    dcterms:identifier "WetChristmasTree" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edo:hasPart ;
            owl:someValuesFrom edo:ConnectionModule ],
        edo:FlowControlEquipment ;
    skos:definition "Piece of equipment containing valves and instrumentation allowing direct control of flow from/to a well"@en,
        "Equipamento composto por válvulas e instrumentos que permite controlar diretamente os fluidos de/para um poço"@pt-br ;
    skos:prefLabel "Wet Christmas tree"@en,
        "Árvore de Natal molhada"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:WireLayer a owl:Class ;
    dcterms:identifier "WireLayer" ;
    rdfs:subClassOf edo:ArmourLayer ;
    skos:definition "Basis for all wired layers."@en ;
    skos:prefLabel "Wire Layer"@en,
        "Camada de Arame"@pt-br .

edo:WireRopeQuantity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "WireRopeQuantity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the number of wire ropes required or used for installation or operation"@en ;
    skos:prefLabel "Wire Rope Quantity"@en,
        "Quantidade de cordas de Aço"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:WireRopeSlingDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "WireRopeSlingDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Specifies the diameter of the wire rope sling. This property provides the measurement of the thickness of the wire rope, which is important for determining its strength and load-bearing capacity."@en,
        "Diâmetro do Estrobo de Corda de Aço"@pt-br ;
    skos:prefLabel "Wire Rope Sling Diameter"@en,
        "Diâmetro do Estrobo de Corda de Aço"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:WireRopeSlingLength a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "WireRopeSlingLength" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Specifies the length of the wire rope sling used in the installation or operation. This property provides the measurement of the sling’s length, which is essential for ensuring proper fit and functionality during use."@en ;
    skos:prefLabel "Wire Rope Sling Length"@en,
        "Comprimento do Estrobo da Corda de Aço"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:WorkingLoadLimit a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "WorkingLoadLimit" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "The Working Load Limit (WLL) refers to the maximum load that a component, such as a shackle, lifting device, or anchor, is designed to safely support under normal operating conditions."@en ;
    skos:prefLabel "Working Load Limit (WLL)"@en,
        "Limite de Carga de Trabalho"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:connectionRealizedBy a owl:ObjectProperty ;
    rdfs:label "Connection Realised By"@en,
        "Conexão Realizada Por"@pt-br ;
    dcterms:identifier "connectionRealizedBy" ;
    rdfs:domain edo:ConnectionPoint ;
    rdfs:range edo:PhysicalConnection ;
    rdfs:subPropertyOf edo:interfaceRealizedBy ;
    owl:inverseOf edo:connectsPoint ;
    skos:altLabel "Realised By"@en,
        "Realizada Por"@pt-br ;
    skos:definition "Associates a connection point with the physical connection that joins it to another connection point."@en,
        "Associa um ponto de conexão à conexão física que o une a outro ponto de conexão."@pt-br .

edo:hasElectricalContact a owl:ObjectProperty ;
    rdfs:label "Has Electrical Contact"@en,
        "Tem Contato Elétrico"@pt-br ;
    dcterms:identifier "hasElectricalContact" ;
    rdfs:domain edo:ElectricPort ;
    rdfs:range edo:ElectricalContact ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:isElectricalContactOf ;
    skos:definition "Associates an aggregate electric port with a detailed electrical contact represented within that port. The relation may be omitted when exchange data does not provide contact-level detail."@en,
        "Associa uma porta elétrica agregada a um contato elétrico detalhado representado nessa porta. A relação pode ser omitida quando os dados de troca não fornecem detalhamento em nível de contato."@pt-br .

edo:hasElectricalContactSpecification a owl:ObjectProperty ;
    rdfs:label "Has Electrical Contact Specification"@en,
        "Tem Especificação de Contato Elétrico"@pt-br ;
    dcterms:identifier "hasElectricalContactSpecification" ;
    rdfs:domain edo:ElectricalConnectorSpecification ;
    rdfs:range edo:ElectricalContactSpecification ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    owl:inverseOf edo:isElectricalContactSpecificationOf ;
    skos:definition "Associates an electrical connector specification with an optional detailed specification of one of its contact positions. No minimum is imposed so aggregate-only connector specifications remain valid."@en,
        "Associa uma especificação de conector elétrico a uma especificação detalhada opcional de uma de suas posições de contato. Nenhum mínimo é imposto, de modo que especificações apenas agregadas permaneçam válidas."@pt-br .

edo:hasEvidence a owl:ObjectProperty ;
    rdfs:label "Has Evidence"@en,
        "Tem Evidência"@pt-br ;
    dcterms:identifier "hasEvidence" ;
    rdfs:subPropertyOf edo:InformationRelation ;
    skos:definition "Associates an activity or task with an information artifact that provides evidence of its execution, condition or result."@en,
        "Associa uma atividade ou tarefa a um artefato informacional que fornece evidência de sua execução, condição ou resultado."@pt-br .

edo:hasIssue a owl:ObjectProperty ;
    rdfs:label "Has Issue"@en,
        "Tem Pendência"@pt-br ;
    dcterms:identifier "hasIssue" ;
    rdfs:subPropertyOf edo:InformationRelation ;
    skos:definition "Associates an activity or task with an issue recorded in its context."@en,
        "Associa uma atividade ou tarefa a uma pendência registrada em seu contexto."@pt-br .

edo:hasMaterial a owl:ObjectProperty ;
    rdfs:label "Has Material"@en,
        "Tem Material"@pt-br ;
    dcterms:identifier "hasMaterial" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:MaterialType ;
    rdfs:subPropertyOf edo:MaterialRelation ;
    skos:altLabel "Is Made Of"@en,
        "É Feito De"@pt-br ;
    skos:definition "Associates a domain element with the material it is made of, without prescribing a specific modelling pattern for material definitions."@en,
        "Associa um elemento do domínio ao material do qual é feito, sem impor um padrão específico de modelagem para definições de material."@pt-br .

edo:hasResponsibleAgent a owl:ObjectProperty ;
    rdfs:label "Has Responsible Agent"@en,
        "Tem Agente Responsável"@pt-br ;
    dcterms:identifier "hasResponsibleAgent" ;
    rdfs:subPropertyOf edo:OrganizationalRelation ;
    skos:definition "Associates a domain entity with the agent responsible for an activity, task, deliverable or decision."@en,
        "Associa uma entidade do domínio ao agente responsável por uma atividade, tarefa, entrega ou decisão."@pt-br .

edo:hasSpec a owl:ObjectProperty ;
    rdfs:label "Has Specification"@en,
        "Tem Especificação"@pt-br ;
    dcterms:identifier "hasSpec" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:Specification ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    skos:definition "Associates a domain entity with a specification, requirement or technical artefact that defines, limits or governs its selection and compatibility."@en,
        "Associa uma entidade do domínio a uma especificação, requisito ou artefato técnico que define, limita ou governa sua seleção e compatibilidade."@pt-br .

edo:hasSubject a owl:ObjectProperty ;
    rdfs:label "Has Subject"@en,
        "Tem Objeto"@pt-br ;
    dcterms:identifier "hasSubject" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:definition "Associates an activity or information artifact with the domain element that is its subject or object of attention."@en,
        "Associa uma atividade ou artefato informacional ao elemento do domínio que constitui seu objeto de atenção."@pt-br .

edo:isConnectionMechanismOf a owl:ObjectProperty ;
    rdfs:label "Is Connection Mechanism Of"@en,
        "É Mecanismo de Conexão de"@pt-br ;
    dcterms:identifier "isConnectionMechanismOf" ;
    rdfs:domain edo:ConnectionMechanism ;
    rdfs:range edo:PhysicalConnection ;
    rdfs:subPropertyOf edo:ConnectionRelation ;
    owl:inverseOf edo:hasConnectionMechanism .

edo:isDefinedByType a owl:ObjectProperty ;
    dcterms:identifier "isDefinedByType" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:TechnicalArtifact ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation .

edo:isInterfaceCompatibleWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Is Interface Compatible With"@en,
        "Interface É Compatível Com"@pt-br ;
    dcterms:identifier "isInterfaceCompatibleWith" ;
    rdfs:domain edo:ConnectionInterface ;
    rdfs:range edo:ConnectionInterface ;
    rdfs:subPropertyOf edo:ConnectionRelation ;
    owl:propertyChainAxiom ( edo:hasInterfaceSpecification edo:isMatingCompatibleWith edo:isInterfaceSpecificationOf ) ;
    skos:definition "Indicates that two connection interfaces are compatible for direct mating according to an explicit mating-compatibility relation between their effective interface specifications. Compatibility expresses possibility, not an actual installed connection."@en,
        "Indica que duas interfaces de conexão são compatíveis para acoplamento direto conforme uma relação explícita de compatibilidade de acoplamento entre suas especificações efetivas de interface. Compatibilidade expressa possibilidade, não uma conexão efetivamente instalada."@pt-br .

edo:isMatingCompatibleWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Is Mating Compatible With"@en,
        "É Compatível para Acoplamento Com"@pt-br ;
    dcterms:identifier "isMatingCompatibleWith" ;
    rdfs:domain edo:ConnectionInterfaceSpecification ;
    rdfs:range edo:ConnectionInterfaceSpecification ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    skos:definition "Indicates that two connection-interface specifications permit direct mating without an intervening adapter. Compatibility is symmetric but is not assumed to be transitive or reflexive."@en,
        "Indica que duas especificações de interface de conexão permitem acoplamento direto sem adaptador intermediário. A compatibilidade é simétrica, mas não é considerada transitiva nem reflexiva."@pt-br .

edo:isServiceInterfaceExposedAt a owl:ObjectProperty ;
    rdfs:label "Is Service Interface Exposed At"@en,
        "É Interface de Serviço Exposta em"@pt-br ;
    dcterms:identifier "isServiceInterfaceExposedAt" ;
    rdfs:domain edo:ConnectionInterface ;
    rdfs:range edo:LinearEnd ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:exposesServiceInterface ;
    skos:definition "Relates a connection interface owned by terminal hardware to the aggregate terminal end at which that interface is externally exposed."@en,
        "Relaciona uma interface de conexão pertencente ao hardware terminal à extremidade terminal agregada na qual essa interface é externamente exposta."@pt-br .

edo:isTerminalHardwareOf a owl:ObjectProperty ;
    rdfs:label "Is Terminal Hardware Of"@en,
        "É Hardware Terminal de"@pt-br ;
    dcterms:identifier "isTerminalHardwareOf" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:PartWholeRelation ;
    owl:inverseOf edo:hasTerminalHardware ;
    skos:definition "Relates a physical part to the assembly or equipment in which it serves as terminal hardware."@en,
        "Relaciona uma parte física ao conjunto ou equipamento no qual ela desempenha o papel de hardware terminal."@pt-br .

edo:spatiallyContains a owl:ObjectProperty ;
    rdfs:label "Spatially Contains"@en,
        "Contém Espacialmente"@pt-br ;
    dcterms:identifier "spatiallyContains" ;
    rdfs:subPropertyOf edo:SpatialRelation ;
    skos:definition "Associates a spatial element or location with a domain element whose primary location is contained within that spatial context."@en,
        "Associa um elemento espacial ou localização a um elemento do domínio cuja localização primária está contida naquele contexto espacial."@pt-br .

edo:specifiesElectricalContact a owl:ObjectProperty ;
    rdfs:label "Specifies Electrical Contact"@en,
        "Especifica Contato Elétrico"@pt-br ;
    dcterms:identifier "specifiesElectricalContact" ;
    rdfs:domain edo:ElectricalContactSpecification ;
    rdfs:range edo:ElectricalContact ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    owl:inverseOf edo:isDefinedByElectricalContactSpecification ;
    skos:definition "Relates a reusable electrical contact-position specification to a physical or project contact occurrence defined by it."@en,
        "Relaciona uma especificação reutilizável de posição de contato elétrico a uma ocorrência física ou de projeto de contato definida por ela."@pt-br .

edo:Activity a owl:Class ;
    dcterms:identifier "Activity" ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "A domain element representing work or an occurrence performed over time in order to achieve an intended outcome."@en,
        "Elemento de domínio que representa trabalho ou uma ocorrência realizada ao longo do tempo com o objetivo de alcançar um resultado pretendido."@pt-br ;
    skos:prefLabel "Activity"@en,
        "Atividade"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:ActuatedEquipment a owl:Class ;
    dcterms:identifier "ActuatedEquipment" ;
    rdfs:subClassOf edo:SubseaEquipment ;
    skos:definition "Equipment with locally- or remotely-actuatable functions"@en,
        "Equipamentos com funções atuáveis localmente ou remotamente"@pt-br ;
    skos:prefLabel "Actuated Equipment"@en,
        "Equipamento Atuável"@pt-br .

edo:ActuatedValve a owl:Class ;
    dcterms:identifier "ActuatedValve" ;
    rdfs:subClassOf edo:Valve ;
    skos:definition "Externally-actuated valve. Base for all valves that require external action for opening/closing"@en,
        "Base para todas as válvulas atuadas externamente, ou seja, que necessitam de ação externa para abrir/fechar"@pt-br ;
    skos:prefLabel "Externally-actuated valve"@en,
        "Válvula atuada externamente"@pt-br .

edo:AdministrativeAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "AdministrativeAttribute" ;
    skos:broader edo:AttributeCategories ;
    skos:definition "Attribute category related to administration, content management, provenance, status or governance metadata."@en,
        "Categoria de atributo relacionada a administração, gestão de conteúdo, proveniência, status ou metadados de governança."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory ;
    skos:prefLabel "Administrative attribute"@en,
        "Atributo administrativo"@pt-br .

edo:Anchor a owl:Class ;
    dcterms:identifier "Anchor" ;
    rdfs:subClassOf edo:Structure ;
    skos:definition "Foundation structure driven into seabed"@en,
        "Estrutura de fundação cravada no leito marinho"@pt-br ;
    skos:prefLabel "Anchor"@en,
        "Âncora"@pt-br .

edo:AnodeCollar a owl:Class ;
    dcterms:identifier "AnodeCollar" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ExternalDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:GalvanicMaterial ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ClampInternalDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:IndividualAnodeMass ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MountingPoint ;
            owl:onProperty edo:hasMountingPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:SplitCollar ;
    skos:altLabel "Anode Clamp"@en,
        "Cathodic Protection Collar"@en,
        "Sacrificial Anode Collar"@en ;
    skos:definition "Individual split collar incorporating sacrificial-anode material and intended to be clamped around a host line as one physical cathodic-protection collar."@en,
        "Colar bipartido individual que incorpora material de anodo sacrificial e é destinado a ser abraçado ao redor de uma linha hospedeira como um colar físico de proteção catódica."@pt-br ;
    skos:prefLabel "Anode Collar"@en,
        "Colar de Anodo"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:ArmourLayer a owl:Class ;
    dcterms:identifier "ArmourLayer" ;
    rdfs:subClassOf edo:WoundLayer ;
    skos:definition "A reinforcement layer in subsea flexible pipes used in oil and gas exploration, designed to provide mechanical strength and protection against external forces, such as pressure and movement. It ensures structural integrity by preventing deformation and failure during operation. Typically made from high-strength metal wires, like carbon steel or stainless steel, the Armor Layer enhances the pipe's durability in harsh underwater conditions."@en ;
    skos:prefLabel "Armour Layer"@en,
        "Camada de Armadura"@pt-br .

edo:AttributeValueCardinalities a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Value Cardinalities"@en,
        "Cardinalidades de Valor de Atributo"@pt-br .

edo:BendStiffener a owl:Class ;
    dcterms:identifier "BendStiffener" ;
    rdfs:subClassOf edo:LineAncillary ;
    skos:definition "Device used in subsea flexible pipes to provide gradual stiffness transition between the flexible pipe and a fixed structure, preventing excessive bending at critical areas such as terminations or connectors. The Bend Stiffener is designed to manage stress concentration by stiffening the pipe over a defined length, reducing the risk of damage due to repeated bending, fatigue, or over-flexing. Typically made from high-strength materials, it ensures the long-term structural integrity of the pipe in dynamic subsea environments."@en ;
    skos:prefLabel "Bend Stiffener"@en,
        "Enrijecedor de Curvatura"@pt-br .

edo:BendingStiffnessTableColumn a owl:Class ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:BoltedClamping a owl:Class ;
    dcterms:identifier "BoltedClamping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:StudSet ;
            owl:onProperty edo:hasPart ],
        [ a owl:Restriction ;
            owl:onClass edo:StudSet ;
            owl:onProperty edo:hasPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:ConnectionMechanism ;
    owl:disjointWith edo:GasketSealing ;
    skos:prefLabel "Bolted Clamping"@en,
        "Aperto Aparafusado"@pt-br .

edo:CarcassLayer a owl:Class ;
    dcterms:identifier "CarcassLayer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:StressAtDesignPressure ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MetallicLayerPitch ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:ArmourLayer ;
    skos:definition "A reinforcement layer in subsea flexible pipes that provides structural strength and stability. It helps maintain the shape and integrity of the pipe under operational pressure, ensuring the flexibility of the pipe while protecting the internal components. Typically made from metal or polymer materials, it acts as a foundation for the other protective layers."@en,
        "Camada formada por perfis intertravados"@pt-br ;
    skos:prefLabel "Carcass Layer"@en,
        "Camada de Carcaça"@pt-br .

edo:ClampInternalDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ClampInternalDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Is the clamp internal diameter"@en ;
    skos:prefLabel "Clamp Internal Diameter"@en,
        "Diâmetro interno do clamp"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:ClassInstantiationRoleScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:identifier "ClassInstantiationRoleScheme" ;
    skos:definition "Controlled vocabulary for indicating whether and how EDO classes are intended to be instantiated in project or asset information models."@en,
        "Vocabulário controlado para indicar se e como classes da EDO devem ser instanciadas em modelos de informação de projetos ou ativos."@pt-br ;
    skos:prefLabel "Class instantiation role scheme"@en,
        "Esquema de papéis de instanciação de classe"@pt-br .

edo:ClassInstantiationRoles a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:MetamodelConcepts ;
    skos:prefLabel "Class Instantiation Roles"@en,
        "Papéis de Instanciação de Classe"@pt-br .

edo:ConnectionModuleMatingConnection a owl:Class ;
    dcterms:identifier "ConnectionModuleMatingConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:HubMatingConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    skos:prefLabel "Connection Module Mating Connection"@en,
        "Conexão de Acoplamento do Módulo de Conexão"@pt-br .

edo:ContactIdentifier a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ContactIdentifier" ;
    rdfs:subClassOf edo:ElectricalContactAttribute ;
    skos:definition "Identifier, position designation or pin/contact reference that distinguishes one electrical contact within its owning electric port."@en,
        "Identificador, designação de posição ou referência de pino/contato que distingue um contato elétrico dentro de sua porta elétrica proprietária."@pt-br ;
    skos:prefLabel "Contact Identifier"@en,
        "Identificador do Contato"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:CrimpedConnection a owl:Class ;
    dcterms:identifier "CrimpedConnection" ;
    rdfs:subClassOf edo:FluidPort ;
    owl:disjointWith edo:FlangeConnection,
        edo:WeldedConnection ;
    skos:prefLabel "Crimped Connection"@en,
        "Conexão Crimpada"@pt-br .

edo:CrushingFrictionCoefficientTighteningTableColumn a owl:Class ;
    rdfs:subClassOf edo:CrushingFrictionCoefficientTighteningAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:CrushingMaximumAllowableTighteningTableColumn a owl:Class ;
    rdfs:subClassOf edo:CrushingMaximumAllowableTighteningAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:DateTimeValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "DateTime Value"@en ;
    rdfs:comment "Expected XSD datatype for date and time values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:dateTime .

edo:DecommissioningPhase a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "DecommissioningPhase" ;
    skos:broader edo:LifecyclePhase ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Decommissioning Phase"@en,
        "Fase de Descomissionamento"@pt-br .

edo:DiscretePart a owl:Class ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "A discrete part is a physical element with a distinct material identity, typically used for assembly, fastening, connection, sealing, protection, or replacement, but not normally managed as an individually traceable asset. Discrete parts include items such as bolts, studs, gaskets, rings, clamps, and other non-serialized parts used in engineered systems."@en,
        "Uma peça discreta é um elemento físico com identidade material distinta, normalmente usado para montagem, fixação, conexão, vedação, proteção ou substituição, mas que normalmente não é gerenciado como um ativo individualmente rastreável. Peças discretas incluem itens como parafusos, estojos, juntas, anéis, abraçadeiras e outras peças não serializadas usadas em sistemas de engenharia."@pt-br ;
    skos:prefLabel "Discrete Part"@en,
        "Peça Discreta"@pt-br .

edo:Distance a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Distance" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Linear measurement between two reference points or positions."@en,
        "Medição linear entre dois pontos ou posições de referência."@pt-br ;
    skos:prefLabel "Distance"@en,
        "Distância"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole .

edo:DomainAttributeValueCardinality a owl:NamedIndividual,
        skos:ConceptScheme ;
    skos:definition "Controlled vocabulary for classifying whether a domain attribute supports a single value or multiple values."@en,
        "Vocabulário controlado para classificar se um atributo de domínio suporta valor único ou múltiplos valores."@pt-br ;
    skos:prefLabel "Domain attribute value cardinality"@en,
        "Cardinalidade de valor de atributo de domínio"@pt-br .

edo:DomainGovernanceAnnotation a owl:AnnotationProperty ;
    rdfs:label "Governance Annotation"@en,
        "Anotação de Governança"@pt-br ;
    dcterms:identifier "DomainGovernanceAnnotation" ;
    rdfs:subPropertyOf edo:DomainMetamodelAnnotation ;
    skos:definition "Category of annotations used to manage maturity, curation, publication and editorial governance of entities in the Energy Domain Ontology."@en,
        "Categoria de anotações usadas para gerir maturidade, curadoria, publicação e governança editorial de entidades da Energy Domain Ontology."@pt-br .

edo:DomainRelationConstraintAnnotation a owl:AnnotationProperty ;
    rdfs:label "Relation Constraint Annotation"@en,
        "Anotação de Restrição de Relacionamento"@pt-br ;
    dcterms:identifier "DomainRelationConstraintAnnotation" ;
    rdfs:subPropertyOf edo:DomainValidationAnnotation ;
    skos:definition "Category of annotations used to express structural or semantic constraints on domain relationships, such as expected cardinalities per role."@en,
        "Categoria de anotações usadas para expressar restrições estruturais ou semânticas sobre relacionamentos de domínio, como cardinalidades esperadas por papel."@pt-br .

edo:Downstream a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Downstream"@en,
        "Downstream"@pt-br ;
    skos:broader edo:OilAndGas ;
    skos:definition "Oil & Gas sector covering refining, processing, distribution, and retail of petroleum products."@en,
        "Setor de Petróleo & Gás que abrange refino, processamento, distribuição e varejo de produtos petrolíferos."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:EModVsTempTableColumn a owl:Class ;
    rdfs:subClassOf edo:EModVsTempCurveAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:EarlyLeakMaxPressTableAttribute a owl:Class ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    edo:attributeOntologicalNature edo:TableAttribute .

edo:EarlyLeakNomPressTableAttribute a owl:Class ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    edo:attributeOntologicalNature edo:TableAttribute .

edo:ElectricalControlCableEnd a owl:Class ;
    dcterms:identifier "ElectricalControlCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalControlCable ;
            owl:onProperty edo:isEndOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalControlPort ;
            owl:onProperty edo:hasEndInterface ],
        edo:ElectricalCableEnd ;
    skos:definition "Terminal end of an electrical control cable, exposing one or more electrical control interfaces for the functions carried by the cable."@en,
        "Extremidade terminal de um cabo elétrico de controle, apresentando uma ou mais interfaces elétricas de controle para as funções transportadas pelo cabo."@pt-br ;
    skos:prefLabel "Electrical Control Cable End"@en,
        "Extremidade de Cabo Elétrico de Controle"@pt-br .

edo:ElectricalInterfaceSpecification a owl:Class ;
    dcterms:identifier "ElectricalInterfaceSpecification" ;
    rdfs:subClassOf edo:ConnectionInterfaceSpecification ;
    skos:definition "Connection-interface specification that consolidates mating-relevant electrical interface requirements such as connector family, mating role, keying, contact arrangement and electrical ratings. It does not by itself classify the represented service as control or power."@en,
        "Especificação de interface de conexão que consolida requisitos de interface elétrica relevantes ao acoplamento, como família do conector, papel de acoplamento, chaveamento, arranjo de contatos e ratings elétricos. Por si só, não classifica o serviço representado como controle ou potência."@pt-br ;
    skos:prefLabel "Electrical Interface Specification"@en,
        "Especificação de Interface Elétrica"@pt-br .

edo:ElectricalPowerCableEnd a owl:Class ;
    dcterms:identifier "ElectricalPowerCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalPowerPort ;
            owl:onProperty edo:hasEndInterface ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalPowerCable ;
            owl:onProperty edo:isEndOf ],
        edo:ElectricalCableEnd ;
    skos:definition "Terminal end of an electrical power cable, exposing one or more electrical power interfaces for the functions carried by the cable."@en,
        "Extremidade terminal de um cabo elétrico de potência, apresentando uma ou mais interfaces elétricas de potência para as funções transportadas pelo cabo."@pt-br ;
    skos:prefLabel "Electrical Power Cable End"@en,
        "Extremidade de Cabo Elétrico de Potência"@pt-br .

edo:Equipment a owl:Class ;
    dcterms:identifier "Equipment" ;
    rdfs:subClassOf edo:CompactObject ;
    skos:definition "Large and complex objects for permanent or temporary use"@en,
        "Objetos de grande porte e complexidade, para uso permanente ou temporário"@pt-br ;
    skos:prefLabel "Equipment"@en,
        "Equipamento"@pt-br .

edo:ExternalDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ExternalDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Distance measured across the outermost points, passing through the center."@en ;
    skos:prefLabel "External Diameter"@en,
        "Diâmetro externo"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:FlangeAttribute a owl:Class ;
    rdfs:label "Flange Attribute"@en ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:AttributeGroupAttribute .

edo:FlangedJoint a owl:Class ;
    dcterms:identifier "FlangedJoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:GasketSealing ;
            owl:onProperty edo:hasConnectionMechanism ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:Na42e7c95d1884160b64faeea70840f68 ;
            owl:onProperty edo:hasConnectionMechanism ],
        [ a owl:Restriction ;
            owl:onClass edo:BoltedClamping ;
            owl:onProperty edo:hasConnectionMechanism ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FlangeConnection ;
            owl:onProperty edo:connectsPoint ],
        [ a owl:Restriction ;
            owl:onClass edo:FlangeConnection ;
            owl:onProperty edo:connectsPoint ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        edo:PhysicalConnection ;
    owl:disjointWith edo:FlexiblePipeCrimpedJoint,
        edo:WeldedJoint ;
    skos:prefLabel "Flanged Joint"@en,
        "Junta Flangeada"@pt-br .

edo:FlexiblePipeBody a owl:Class ;
    dcterms:identifier "FlexiblePipeBody" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:FlexiblePipeBodyEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FlexiblePipeBodyEnd ;
            owl:onProperty edo:hasEnd ],
        [ a owl:Restriction ;
            owl:onClass edo:FlexiblePipeStructure ;
            owl:onProperty edo:isDefinedByType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlexiblePipeCrimpedConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FlexiblePipeCrimpedConnection ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:ConstituentComponent ;
    skos:definition "Multilayer tubular constituent of a flexible pipe segment, extending between the two end fittings and defined by a flexible pipe structure."@en,
        "Constituinte tubular multicamada de um tramo de duto flexível, estendendo-se entre os dois end fittings e definido por uma estrutura de duto flexível."@pt-br ;
    skos:prefLabel "Flexible Pipe Body"@en,
        "Corpo do Duto Flexível"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:FlexiblePipeSegmentEnd a owl:Class ;
    dcterms:identifier "FlexiblePipeSegmentEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:FlangeConnection ;
            owl:onProperty edo:hasEndInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FlangeConnection ;
            owl:onProperty edo:hasEndInterface ],
        edo:LinearEnd ;
    owl:disjointWith edo:FlexiblePipeBodyEnd ;
    skos:definition "External end of a finished flexible pipe segment, represented by the flange connection interface of the end fitting located at that end."@en,
        "Extremidade externa de um tramo acabado de duto flexível, representada pela interface de conexão flangeada do end fitting localizado nessa extremidade."@pt-br ;
    skos:prefLabel "Flexible Pipe Segment End"@en,
        "Extremidade do Tramo de Duto Flexível"@pt-br .

edo:FlexibleStructure a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:FlexibleStructureLayer ;
            owl:onProperty edo:hasOrderedPart ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:FlexibleStructureLayer ;
            owl:onProperty edo:hasOrderedPart ],
        edo:ConfiguredSystem ;
    skos:definition "The Flexible Structure is the layered configuration of a flexible system designed to provide strength, protection, and adaptability in demanding environments. It consists of multiple layers or components, each performing a specific function such as reinforcement, pressure containment, insulation, or communication. Engineered to accommodate movement, pressure variations, and mechanical loads, the flexible structure ensures reliability, durability and performance across different applications, including subsea pipelines and umbilicals."@en,
        "A Estrutura Flexível é a configuração em camadas de um sistema flexível, projetada para oferecer resistência, proteção e adaptabilidade em ambientes exigentes. Ela é composta por múltiplas camadas ou componentes, cada um desempenhando uma função específica, como reforço, contenção de pressão, isolamento ou comunicação. Projetada para acomodar movimentos, variações de pressão e cargas mecânicas, a estrutura flexível garante confiabilidade, durabilidade e desempenho em diferentes aplicações, incluindo dutos e umbilicais submarinos."@pt-br ;
    skos:prefLabel "FlexibleStructure"@en,
        "Estrutura Flexível"@pt-br .

edo:FloatingProductionUnit a owl:Class ;
    dcterms:identifier "FloatingProductionUnit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edo:hasPart ;
            owl:someValuesFrom edo:RiserBalcony ],
        edo:FunctionalAsset ;
    skos:altLabel "FLNG"@en,
        "FPSO"@en,
        "FPU"@en,
        "Floating Platform"@en,
        "Floating Production Facility"@en ;
    skos:definition "Offshore platform used in oil and gas exploration and production, designed to extract, process, and store hydrocarbons. The Floating Production Unit (FPU) is anchored or moored to the seabed and can operate in deep waters, often connected to subsea wells via flexible pipes and umbilicals. It accommodates processing equipment for separating oil, gas, and water, as well as facilities for temporary storage or transfer of processed hydrocarbons to tankers or pipelines. FPUs are essential for the efficient and safe production of oil and gas in challenging offshore environments."@en,
        "Plataforma offshore usada na exploração e produção de petróleo e gás, projetada para extrair, processar e armazenar hidrocarbonetos. A Unidade de Produção Flutuante (FPU) é ancorada ou amarrada ao leito marinho e pode operar em águas profundas, frequentemente conectada a poços submarinos por meio de dutos flexíveis e umbilicais. Ela acomoda equipamentos de processamento para separação de petróleo, gás e água, bem como instalações para armazenamento temporário ou transferência de hidrocarbonetos processados para navios-tanque ou dutos. As FPUs são essenciais para a produção eficiente e segura de petróleo e gás em ambientes offshore desafiadores."@pt-br ;
    skos:prefLabel "Floating Production Unit"@en,
        "Unidade de Produção Flutuante (UEP)"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:FlowConnectorMatingConnection a owl:Class ;
    dcterms:identifier "FlowConnectorMatingConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:HubMatingConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    skos:prefLabel "Flow Connector Mating Connection"@en,
        "Conexão de Acoplamento do Conector de Fluxo"@pt-br .

edo:FluidInterfaceSpecification a owl:Class ;
    dcterms:identifier "FluidInterfaceSpecification" ;
    rdfs:subClassOf edo:ConnectionInterfaceSpecification ;
    skos:definition "Connection-interface specification for interfaces that convey or contain a fluid service and whose mating compatibility depends on fluid-interface engineering requirements."@en,
        "Especificação de interface de conexão para interfaces que conduzem ou contêm um serviço de fluido e cuja compatibilidade de acoplamento depende de requisitos de engenharia da interface de fluido."@pt-br ;
    skos:prefLabel "Fluid Interface Specification"@en,
        "Especificação de Interface de Fluido"@pt-br .

edo:GalvanicConnectionPoint a owl:Class ;
    dcterms:identifier "GalvanicConnectionPoint" ;
    rdfs:subClassOf edo:ElectricPort ;
    skos:definition "Electrical connection point participating in a galvanic connection for intentional electrical continuity."@en,
        "Ponto de conexão elétrica que participa de uma conexão galvânica para continuidade elétrica intencional."@pt-br ;
    skos:prefLabel "Galvanic Connection Point"@en,
        "Ponto de Conexão Galvânica"@pt-br .

edo:HotStabMatingConnection a owl:Class ;
    dcterms:identifier "HotStabMatingConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:HydraulicConnectorSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:HotStabReceptacleMatingConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    owl:disjointWith edo:HotStabReceptacleMatingConnection ;
    skos:prefLabel "Hot Stab Mating Connection"@en,
        "Conexão de Acoplamento do Hot Stab"@pt-br .

edo:HubBlockCapMatingConnection a owl:Class ;
    dcterms:identifier "HubBlockCapMatingConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:HubMatingConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    skos:prefLabel "Hub Block Cap Mating Connection"@en,
        "Conexão de Acoplamento da Tampa de Bloqueio do Hub"@pt-br .

edo:HubProtectionCapMatingConnection a owl:Class ;
    dcterms:identifier "HubProtectionCapMatingConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:HubMatingConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    skos:prefLabel "Hub Protection Cap Mating Connection"@en,
        "Conexão de Acoplamento da Tampa de Proteção do Hub"@pt-br .

edo:HydraulicConnectorSpecification a owl:Class ;
    dcterms:identifier "HydraulicConnectorSpecification" ;
    rdfs:subClassOf edo:FluidInterfaceSpecification ;
    skos:definition "Fluid-interface specification for hydraulic connector mating interfaces whose direct compatibility depends on connector-family requirements such as mating role, pressure capability, flow-path arrangement, size, keying or equivalent interface-defining criteria."@en,
        "Especificação de interface de fluido para interfaces de acoplamento de conectores hidráulicos cuja compatibilidade direta depende de requisitos da família do conector, como papel de acoplamento, capacidade de pressão, arranjo de vias de fluxo, tamanho, chaveamento ou critérios equivalentes que definem a interface."@pt-br ;
    skos:prefLabel "Hydraulic Connector Specification"@en,
        "Especificação de Conector Hidráulico"@pt-br .

edo:IdInUnifilarDiagram a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "IdInUnifilarDiagram" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Numeric identifier used to represent the component in a unifilar diagram, ensuring clear reference and traceability within the diagram. This identifier allows for easy identification of the component's position and connection points in the simplified representation of the system."@en,
        "Identificador do item no diagrama unifilar (unifilar \"classico\", pre-existente) conforme a coluna \"item\" do unifilar."@pt-br ;
    skos:prefLabel "Id In Unifilar Diagram"@en,
        "Identificador no Diagrama Unifilar"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:InstallationPoint a owl:Class ;
    dcterms:identifier "InstallationPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:Feature ;
            owl:onProperty edo:hasReferenceDatum ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredLongitudinalPosition ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:AttachmentPoint ;
    skos:definition "Attachment point belonging to a host element that defines the intended location at which another element is to be mounted or attached."@en,
        "Ponto de montagem pertencente a um elemento hospedeiro que define a posição pretendida na qual outro elemento deve ser montado ou fixado."@pt-br ;
    skos:prefLabel "Installation Point"@en,
        "Ponto de Instalação"@pt-br .

edo:InstalledRole a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "InstalledRole" ;
    skos:broader edo:AttributeRoles ;
    skos:definition "Role of an attribute that expresses a factual value or condition of the installed asset."@en,
        "Papel de um atributo que expressa um valor ou condição factual do ativo instalado."@pt-br ;
    skos:inScheme edo:DomainAttributeRole ;
    skos:prefLabel "Installed role"@en,
        "Papel instalado"@pt-br .

edo:IntendedLongitudinalPlacement a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "IntendedLongitudinalPlacement" ;
    dcterms:isReplacedBy edo:RequiredLongitudinalPosition,
        edo:hasReferenceDatum ;
    rdfs:subClassOf edo:DomainAttribute ;
    owl:deprecated true ;
    skos:definition "Intended longitudinal placement of an attachment point, expressed by a longitudinal offset and an orientation relative to a reference point. It represents design intent for positioning, not final as-built geometry."@en,
        "Posicionamento longitudinal pretendido de um ponto de anexação, expresso por um deslocamento longitudinal e uma orientação em relação a um ponto de referência. Representa intenção de projeto para posicionamento, não geometria as-built final."@pt-br ;
    skos:prefLabel "Intended Longitudinal Placement"@en,
        "Posicionamento Longitudinal Pretendido"@pt-br ;
    edo:attributeOntologicalNature edo:ConditionAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign .

edo:LineSpan a owl:Class ;
    dcterms:identifier "LineSpan" ;
    rdfs:subClassOf edo:Location ;
    skos:definition "Individual span of a complete line, with own characteristics"@en,
        "Trecho individual, com características particulares, de uma linha completa"@pt-br ;
    skos:prefLabel "Line span"@en,
        "Trecho de linha"@pt-br .

edo:LineTerminationModule a owl:Class ;
    dcterms:identifier "LineTerminationModule" ;
    rdfs:subClassOf edo:TieInEquipment ;
    skos:prefLabel "Line termination module"@en,
        "Módulo de terminação de linha"@pt-br .

edo:LinearMass a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "LinearMass" ;
    rdfs:subClassOf edo:Mass ;
    skos:definition "Mass per unit length."@en,
        "Massa por unidade de comprimento."@pt-br ;
    skos:prefLabel "Linear Mass"@en,
        "Massa Linear"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:KiloGM-PER-M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Mass .

edo:MechanicalConnectionPoint a owl:Class ;
    dcterms:identifier "MechanicalConnectionPoint" ;
    rdfs:subClassOf edo:ConnectionPoint ;
    skos:prefLabel "Mechanical Connection Point"@en,
        "Ponto de Conexão Mecânica"@pt-br .

edo:MetallicStrandSet a owl:Class ;
    dcterms:identifier "MetallicStrandSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:MetallicStrandLength ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrandsTable_StrandsLength ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrandsTable_SpareQuantity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrandsTable_StrandsQuantity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PartElement ;
    skos:definition "Physical set of metallic strands used to establish electrical continuity between galvanically connected elements, such as sacrificial anodes and protected metallic infrastructure."@en,
        "Conjunto físico de cordoalhas metálicas usado para estabelecer continuidade elétrica entre elementos conectados galvanicamente, como anodos sacrificiais e infraestrutura metálica protegida."@pt-br ;
    skos:prefLabel "Metallic Strand Set"@en,
        "Conjunto de Cordoalhas de Continuidade"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:MetamodelConcepts a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:VocabularyConcepts ;
    skos:prefLabel "Metamodel Concepts"@en,
        "Conceitos de Metamodelo"@pt-br .

edo:NominalLength a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "NominalLength" ;
    rdfs:subClassOf edo:Length ;
    skos:definition "Nominal or intended length used as the reference value for design, manufacturing or specification."@en,
        "Comprimento nominal ou pretendido usado como valor de referência para projeto, fabricação ou especificação."@pt-br ;
    skos:prefLabel "Nominal Length"@en,
        "Comprimento Nominal"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign,
        edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Length .

edo:Nuclear a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Nuclear Energy"@en,
        "Energia Nuclear"@pt-br ;
    skos:broader edo:Domain ;
    skos:definition "Industrial domain covering the generation of energy from nuclear reactions, including fission and fusion."@en,
        "Domínio industrial que abrange a geração de energia a partir de reações nucleares, incluindo fissão e fusão."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:Offset a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Offset" ;
    rdfs:subClassOf edo:Distance ;
    skos:definition "Distance expressed as a displacement from a reference point, line or position."@en,
        "Distância expressa como deslocamento a partir de um ponto, linha ou posição de referência."@pt-br ;
    skos:prefLabel "Offset"@en,
        "Deslocamento"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:LocationAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Distance .

edo:OperatingPressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OperatingPressure" ;
    rdfs:subClassOf edo:Pressure ;
    skos:definition "Pressure associated with an operating condition of the component or system."@en,
        "Pressão associada a uma condição operacional do componente ou sistema."@pt-br ;
    skos:prefLabel "Operating Pressure"@en,
        "Pressão operacional"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:OperationalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:Pressure .

edo:OperatingTemperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OperatingTemperature" ;
    rdfs:subClassOf edo:Temperature ;
    skos:definition "Temperature associated with an operating condition of the component or system."@en,
        "Temperatura associada a uma condição operacional do componente ou sistema."@pt-br ;
    skos:prefLabel "Operating Temperature"@en,
        "Temperatura operacional"@pt-br ;
    edo:attributeNature edo:EnvironmentalAttribute,
        edo:OperationalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:DEG_C ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:Temperature .

edo:OperationPhase a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OperationPhase" ;
    skos:broader edo:LifecyclePhase ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Operation Phase"@en,
        "Fase de Operação"@pt-br .

edo:OpticalInterfaceSpecification a owl:Class ;
    dcterms:identifier "OpticalInterfaceSpecification" ;
    rdfs:subClassOf edo:ConnectionInterfaceSpecification ;
    skos:definition "Reusable mating specification for an optical interface. It captures optical-interface compatibility criteria while remaining distinct from the physical cable, connector or termination hardware using it."@en,
        "Especificação reutilizável de acoplamento para uma interface óptica. Captura critérios de compatibilidade da interface óptica, permanecendo distinta do cabo físico, conector ou hardware de terminação que a utiliza."@pt-br ;
    skos:prefLabel "Optical Interface Specification"@en,
        "Especificação de Interface Óptica"@pt-br .

edo:OrganizationalRelation a owl:ObjectProperty ;
    rdfs:label "Organisational Relation"@en,
        "Relação Organizacional"@pt-br ;
    dcterms:identifier "OrganizationalRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:altLabel "Grouping Relation"@en,
        "Relação de Agrupamento"@pt-br ;
    skos:definition "Category of relationships used to represent organisational or grouping semantics over domain entities."@en,
        "Categoria de relacionamentos usada para representar semântica organizacional ou de agrupamento sobre entidades do domínio."@pt-br .

edo:Pile a owl:Class ;
    dcterms:identifier "Pile" ;
    rdfs:subClassOf edo:Anchor ;
    skos:prefLabel "Pile"@en,
        "Estaca"@pt-br .

edo:PipeSegment a owl:Class ;
    dcterms:identifier "PipeSegment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:TransportLineSegment ;
    skos:definition "Pipeline segment for movement/flow of fluids."@en,
        "Segmento de Duto"@pt-br ;
    skos:prefLabel "Pipe Segment"@en,
        "Segmento de Duto"@pt-br .

edo:PipelineSpan a owl:Class ;
    dcterms:identifier "PipelineSpan" ;
    rdfs:subClassOf edo:LineSpan ;
    skos:definition "A linear installation location representing a defined spatial span along a pipeline route, used to locate and organise the physical pipeline elements installed within that span."@en,
        "Localização linear de instalação que representa um trecho espacial definido ao longo da rota de um duto, utilizada para localizar e organizar os elementos físicos do duto instalados nesse trecho."@pt-br ;
    skos:prefLabel "Pipeline span"@en,
        "Trecho de duto"@pt-br .

edo:PressureEquipment a owl:Class ;
    dcterms:identifier "PressureEquipment" ;
    rdfs:subClassOf edo:ActuatedEquipment ;
    skos:definition "Equipment whose main function involves fluid containment, even if not meant for permanent installation"@en,
        "Equipamentos cuja função principal envolve contenção de fluidos, ainda que não destinados a instalação permanente"@pt-br ;
    skos:prefLabel "Pressure-containing equipment"@en,
        "Equipamentos de contenção de pressão"@pt-br .

edo:PullingHead a owl:Class ;
    dcterms:identifier "PullingHead" ;
    rdfs:subClassOf edo:LineAncillary ;
    skos:altLabel "Cable Head"@en,
        "Installation Head"@en,
        "Pulling Grip"@en,
        "Pulling Tool"@en ;
    skos:definition "A component used in subsea flexible pipe installations to provide a secure attachment point for pulling the pipe into position during installation or retrieval operations. The Pulling Head is fitted to the end of the flexible pipe, allowing connection to pulling equipment such as winches or cranes. It is designed to withstand high loads, ensuring that the pipe can be pulled safely without causing damage. The Pulling Head is essential for handling, testing, and securing the pipe in place during subsea installation."@en ;
    skos:prefLabel "Pulling Head"@en,
        "Cabeça de Tração"@pt-br .

edo:ReferenceDocument a owl:Class ;
    rdfs:subClassOf edo:ExternalReference ;
    skos:definition "Represents a document or publication that serves as a source of information, guidelines, or standards, providing context and supporting decision-making within a project or system."@en,
        "Representa um documento ou publicação que serve como fonte de informação, diretrizes ou normas, fornecendo contexto e apoiando a tomada de decisão dentro de um projeto ou sistema."@pt-br ;
    skos:prefLabel "Reference Document"@en,
        "Documento de Referência"@pt-br .

edo:RingGasket a owl:Class ;
    dcterms:identifier "RingGasket" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:RingGasketType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketPressureRating ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketInnerDIameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketStandard ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketOuterDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketSpecification ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketMaterial ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:ConsumableElement ;
    skos:altLabel " Seal Ring"@en,
        "Gasket"@en,
        "O-Ring"@en,
        "Packing Ring"@en,
        "Seal Gasket"@en,
        "Sealing Ring"@en ;
    skos:definition "The seal ring is a crucial component used in subsea oil and gas interconnection end fittings to ensure a secure and leak-proof connection between pipes or equipment. Typically made from high-performance materials such as elastomers or metals, the seal ring is designed to withstand extreme pressure, temperature, and environmental conditions found in subsea operations. It is installed within the end fitting to create a reliable seal that prevents fluid leakage and maintains the integrity of the interconnection. The seal ring’s precise design and material selection are essential for ensuring long-term durability and performance in harsh subsea environments."@en ;
    skos:prefLabel "Ring Gasket"@en,
        "Junta de Conexão"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:RingGasketMaterial a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RingGasketMaterial" ;
    rdfs:subClassOf edo:RingGasketAttribute ;
    skos:definition "Type of material from which an object is made, allowing for precise documentation and categorisation."@en ;
    skos:prefLabel "Ring Gasket Material"@en,
        "Material da Junta de Vedação"@pt-br ;
    edo:attributeOntologicalNature edo:MaterialCompositionAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RopeSegment a owl:Class ;
    dcterms:identifier "RopeSegment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:MechanicalConnectionPoint ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:LinearObject ;
    skos:prefLabel "Rope segment"@en,
        "Tramo de cabo"@pt-br .

edo:SpliceBox a owl:Class ;
    dcterms:identifier "SpliceBox" ;
    rdfs:subClassOf edo:ComponentDevice ;
    skos:prefLabel "Splice box"@en,
        "Caixa de emenda"@pt-br .

edo:StressAtDesignPressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "StressAtDesignPressure" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Maximum stress that the material can withstand when subjected to design pressure is specified. This parameter is critical for ensuring that the material maintains its structural integrity and performs reliably under the operational pressure conditions specified in the design."@en ;
    skos:prefLabel "Stress At Design Pressure"@en,
        "Tensão na pressão de projeto"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:StudSet rdfs:subClassOf edo:ConsumableElement .

edo:SubseaManifoldsEngineering a owl:NamedIndividual,
        skos:Concept ;
    skos:broader edo:SubseaEngineering ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:SupportRegion a owl:Class ;
    dcterms:identifier "SupportRegion" ;
    rdfs:subClassOf edo:SupportPoint ;
    skos:definition "A specific region used to define the support location of the components within a 3D model."@en,
        "Uma região específica usada para definir a localização de suporte dos componentes dentro de um modelo 3D."@pt-br ;
    skos:prefLabel "Support Region"@en,
        "Região de suporte no Modelo"@pt-br .

edo:SurfaceEquipment a owl:Class ;
    dcterms:identifier "SurfaceEquipment" ;
    rdfs:subClassOf edo:Equipment ;
    skos:prefLabel "Surface Equipment"@en,
        "Equipamento de Superfície"@pt-br .

edo:TapesQuantity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TapesQuantity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Number of tapes applied within the structure, influencing factors such as insulation, protection, and reinforcement. "@en ;
    skos:prefLabel "Tapes Quantity"@en,
        "Quantidade de fitas"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Task a owl:Class ;
    dcterms:identifier "Task" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:Agent ;
            owl:onProperty edo:hasResponsibleAgent ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:Issue ;
            owl:onProperty edo:hasIssue ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:Evidence ;
            owl:onProperty edo:hasEvidence ],
        [ a owl:Restriction ;
            owl:onClass edo:Creator ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:Timestamp ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:CreatorId ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:Content ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Activity ;
    skos:definition "An activity representing a defined unit of work to be planned, assigned, executed and tracked within a process."@en,
        "Atividade que representa uma unidade definida de trabalho a ser planejada, atribuída, executada e acompanhada dentro de um processo."@pt-br ;
    skos:prefLabel "Task"@en,
        "Tarefa"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:TechnicalNotes a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "TechnicalNotes" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "A field used to provide additional technical information or clarifications that may not be covered by other specific properties, to support a comprehensive understanding of the material’s behavior and suitability."@en ;
    skos:prefLabel "Technical Notes"@en,
        "Notas Técnicas"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ThreadedFastenerSet a owl:Class ;
    dcterms:identifier "ThreadedFastenerSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:PitchToleranceClass ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:Quantity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ThreadStandard ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ThreadedFastenerType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:NominalDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PhysicalConnection ;
    skos:definition "A physical connection set based on threaded fastening elements, encompassing both headed bolts and headless studs together with associated fastening hardware."@en,
        "Conjunto de conexão física baseado em elementos de fixação roscados, abrangendo parafusos com cabeça e estojos sem cabeça, juntamente com os elementos de fixação associados."@pt-br ;
    skos:prefLabel "Threaded Fastener Set"@en,
        "Conjunto de Fixadores Roscados"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:TransportLineSegment a owl:Class ;
    dcterms:identifier "TransportLineSegment" ;
    rdfs:subClassOf edo:LinearObject ;
    skos:definition "Line for conducting some type of flow."@en,
        "Linha para condução de algum tipo de fluxo"@pt-br ;
    skos:prefLabel "Transport Line Segment"@en,
        "Segmento de Linha de Transporte"@pt-br .

edo:TubingEnd a owl:Class ;
    dcterms:identifier "TubingEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:TubingCoupling ;
            owl:onProperty edo:isTerminatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:Tubing ;
            owl:onProperty edo:isEndOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FluidPort ;
            owl:onProperty edo:hasEndInterface ],
        edo:FunctionLineEnd ;
    owl:disjointWith edo:ElectricalCableEnd,
        edo:OpticalFiberCableEnd ;
    skos:definition "Terminal end of an umbilical tubing functional line, exposing fluid connection interfaces."@en,
        "Extremidade terminal de uma linha funcional de tubing de um umbilical, apresentando interfaces de conexão de fluido."@pt-br ;
    skos:prefLabel "Tubing End"@en,
        "Extremidade de Tubing"@pt-br .

edo:UmbilicalComponent a owl:Class ;
    dcterms:identifier "UmbilicalComponent" ;
    rdfs:subClassOf edo:ConstituentComponent ;
    skos:definition "Represents a component of an umbilical system, typically part of subsea or industrial installations, forming the basis for functional lines and structural layers."@en,
        "Representa um componente de um sistema umbilical, tipicamente parte de instalações submarinas ou industriais, servindo de base para linhas funcionais e camadas estruturais."@pt-br ;
    skos:prefLabel "Umbilical Component"@en,
        "Umbilical component"@en,
        "Componente Umbilical"@pt-br,
        "Componente de umbilical"@pt-br .

edo:UmbilicalSpan a owl:Class ;
    dcterms:identifier "UmbilicalSpan" ;
    rdfs:subClassOf edo:LineSpan ;
    skos:prefLabel "Umbilical span"@en,
        "Trecho de umbilical"@pt-br .

edo:ValueConcepts a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:VocabularyConcepts ;
    skos:prefLabel "Value Concepts"@en,
        "Conceitos de Valor"@pt-br .

edo:Valve a owl:Class ;
    dcterms:identifier "Valve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:PressureComponent ;
    skos:prefLabel "Valve"@en,
        "Válvula"@pt-br .

edo:WoundLayer a owl:Class ;
    dcterms:identifier "WoundLayer" ;
    rdfs:subClassOf edo:FlexibleStructureLayer ;
    skos:definition "Basis for all layers constructed by helical winding of one or more elements."@en,
        "Base para todas as camadas construídas pelo enrolamento helicoidal de um ou mais elementos"@pt-br ;
    skos:prefLabel "Wound Layer"@en,
        "Camada Espiralada"@pt-br .

edo:exposesServiceInterface a owl:ObjectProperty ;
    rdfs:label "Exposes Service Interface"@en,
        "Expõe Interface de Serviço"@pt-br ;
    dcterms:identifier "exposesServiceInterface" ;
    rdfs:domain edo:LinearEnd ;
    rdfs:range edo:ConnectionInterface ;
    rdfs:subPropertyOf edo:hasEndInterface ;
    owl:inverseOf edo:isServiceInterfaceExposedAt ;
    skos:definition "Associates an aggregate terminal end with a connection interface of its terminal hardware that is externally available for service connection, without implying ownership of that interface by the end."@en,
        "Associa uma extremidade terminal agregada a uma interface de conexão de seu hardware terminal que fica externamente disponível para conexão de serviço, sem implicar que a extremidade seja proprietária dessa interface."@pt-br .

edo:hasConstituentEnd a owl:ObjectProperty ;
    rdfs:label "Has Constituent End"@en,
        "Tem Extremidade Constituinte"@pt-br ;
    dcterms:identifier "hasConstituentEnd" ;
    rdfs:domain edo:UmbilicalEnd ;
    rdfs:range edo:FunctionLineEnd ;
    rdfs:subPropertyOf edo:hasPart ;
    owl:inverseOf edo:isConstituentEndOf ;
    skos:definition "Associates an aggregate umbilical end with a terminal end of a constituent functional line located at that same side of the umbilical."@en,
        "Associa uma extremidade agregada do umbilical à extremidade terminal de uma linha funcional constituinte localizada no mesmo lado do umbilical."@pt-br .

edo:hasOrderedPart a owl:ObjectProperty ;
    rdfs:label "Has Ordered Part"@en,
        "Tem Parte Ordenada"@pt-br ;
    dcterms:identifier "hasOrderedPart" ;
    rdfs:subPropertyOf edo:hasPart ;
    skos:altLabel "Sequential Part"@en,
        "Parte Sequencial"@pt-br ;
    skos:definition "Indicates a part–whole relationship in which the parts participate in an explicit sequence, where the order of the parts is semantically relevant in the domain schema."@en,
        "Indica uma relação parte–todo na qual as partes participam de uma sequência explícita, em que a ordem das partes é semanticamente relevante no schema do domínio."@pt-br .

edo:hasTask a owl:ObjectProperty ;
    rdfs:label "Has Task"@en,
        "Tem Tarefa"@pt-br ;
    dcterms:identifier "hasTask" ;
    rdfs:subPropertyOf edo:PartWholeRelation ;
    skos:definition "Associates a process with a task that composes or participates in that process."@en,
        "Associa um processo a uma tarefa que o compõe ou dele participa."@pt-br .

edo:hasTerminalHardware a owl:ObjectProperty ;
    rdfs:label "Has Terminal Hardware"@en,
        "Tem Hardware Terminal"@pt-br ;
    dcterms:identifier "hasTerminalHardware" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:hasPart ;
    owl:inverseOf edo:isTerminalHardwareOf ;
    skos:definition "Relates an assembly or equipment to a physical part that serves as terminal hardware within that assembly, without reclassifying the part by that contextual role."@en,
        "Relaciona um conjunto ou equipamento a uma parte física que desempenha o papel de hardware terminal nesse conjunto, sem reclassificar a parte por esse papel contextual."@pt-br .

edo:hosts a owl:ObjectProperty ;
    rdfs:label "Hosts"@en,
        "Abriga"@pt-br ;
    dcterms:identifier "hosts" ;
    rdfs:subPropertyOf edo:FunctionalRelation ;
    skos:definition "Associates a domain entity with an element functionally installed, supported or organised under it, without asserting physical composition between them."@en,
        "Associa uma entidade do domínio a um elemento funcionalmente instalado, suportado ou organizado sob ela, sem afirmar composição física entre ambos."@pt-br .

edo:interfaceRealizedBy a owl:ObjectProperty ;
    rdfs:label "Interface Realized By"@en,
        "Interface Realizada Por"@pt-br ;
    dcterms:identifier "interfaceRealizedBy" ;
    rdfs:domain edo:ConnectionInterface ;
    rdfs:range edo:PhysicalConnection ;
    rdfs:subPropertyOf edo:ConnectionRelation ;
    owl:inverseOf edo:connectsInterface .

edo:isAttachmentPointOf a owl:ObjectProperty ;
    rdfs:label "Is Attachment Point Of"@en,
        "É Ponto de Montagem de"@pt-br ;
    dcterms:identifier "isAttachmentPointOf" ;
    rdfs:domain edo:AttachmentPoint ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:hasAttachmentPoint .

edo:isConnectionPointOf a owl:ObjectProperty ;
    rdfs:label "Is Connection Point Of"@en,
        "É Ponto de Conexão de"@pt-br ;
    dcterms:identifier "isConnectionPointOf" ;
    rdfs:domain edo:ConnectionPoint ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:isConnectionInterfaceOf ;
    owl:inverseOf edo:hasConnectionPoint .

edo:isDefinedByElectricalContactSpecification a owl:ObjectProperty ;
    rdfs:label "Is Defined By Electrical Contact Specification"@en,
        "É Definido por Especificação de Contato Elétrico"@pt-br ;
    dcterms:identifier "isDefinedByElectricalContactSpecification" ;
    rdfs:domain edo:ElectricalContact ;
    rdfs:range edo:ElectricalContactSpecification ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    owl:inverseOf edo:specifiesElectricalContact ;
    skos:definition "Optionally relates a represented electrical contact occurrence to the reusable contact-position specification that defines it. The relation is not required when contact detail or catalogue mapping is absent from an exchange dataset."@en,
        "Relaciona opcionalmente uma ocorrência representada de contato elétrico à especificação reutilizável de posição de contato que a define. A relação não é exigida quando o detalhamento de contatos ou o mapeamento de catálogo estiver ausente de um conjunto de dados de troca."@pt-br .

edo:isElectricalContactOf a owl:ObjectProperty ;
    rdfs:label "Is Electrical Contact Of"@en,
        "É Contato Elétrico de"@pt-br ;
    dcterms:identifier "isElectricalContactOf" ;
    rdfs:domain edo:ElectricalContact ;
    rdfs:range edo:ElectricPort ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:hasElectricalContact ;
    skos:definition "Relates a detailed electrical contact to the single aggregate electric port in which that contact is represented."@en,
        "Relaciona um contato elétrico detalhado à única porta elétrica agregada na qual esse contato é representado."@pt-br .

edo:isElectricalContactSpecificationOf a owl:ObjectProperty ;
    rdfs:label "Is Electrical Contact Specification Of"@en,
        "É Especificação de Contato Elétrico de"@pt-br ;
    dcterms:identifier "isElectricalContactSpecificationOf" ;
    rdfs:domain edo:ElectricalContactSpecification ;
    rdfs:range edo:ElectricalConnectorSpecification ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    owl:inverseOf edo:hasElectricalContactSpecification ;
    skos:definition "Relates a contact-position specification to the electrical connector specification whose contact arrangement it details."@en,
        "Relaciona uma especificação de posição de contato à especificação de conector elétrico cujo arranjo de contatos ela detalha."@pt-br .

edo:isEndInterfaceOf a owl:ObjectProperty ;
    rdfs:label "Is End Interface Of"@en,
        "É Interface de Extremidade de"@pt-br ;
    dcterms:identifier "isEndInterfaceOf" ;
    rdfs:domain edo:ConnectionInterface ;
    rdfs:range edo:LinearEnd ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:hasEndInterface ;
    skos:definition "Associates a connection interface with the linear end at which it is exposed."@en,
        "Associa uma interface de conexão à extremidade linear na qual ela está presente."@pt-br .

edo:isInterfaceSpecificationOf a owl:ObjectProperty ;
    rdfs:label "Is Interface Specification Of"@en,
        "É Especificação de Interface de"@pt-br ;
    dcterms:identifier "isInterfaceSpecificationOf" ;
    rdfs:domain edo:ConnectionInterfaceSpecification ;
    rdfs:range edo:ConnectionInterface ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    owl:inverseOf edo:hasInterfaceSpecification ;
    skos:definition "Relates a reusable connection-interface specification to an interface governed by that specification."@en,
        "Relaciona uma especificação reutilizável de interface de conexão a uma interface governada por essa especificação."@pt-br .

edo:Agent a owl:Class ;
    dcterms:identifier "Agent" ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "A domain element capable of participating in activities and assuming roles, responsibilities or authorship."@en,
        "Elemento de domínio capaz de participar de atividades e assumir papéis, responsabilidades ou autoria."@pt-br ;
    skos:prefLabel "Agent"@en,
        "Agente"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:AnodeGalvanicConnectionPoint a owl:Class ;
    dcterms:identifier "AnodeGalvanicConnectionPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ProtectedStructureGalvanicConnectionPoint ;
            owl:onProperty edo:isConnectedTo ],
        edo:GalvanicConnectionPoint ;
    owl:disjointWith edo:ProtectedStructureGalvanicConnectionPoint ;
    skos:definition "Galvanic connection point on the sacrificial-anode side of a cathodic-protection connection."@en,
        "Ponto de conexão galvânica no lado do anodo sacrificial de uma conexão de proteção catódica."@pt-br ;
    skos:prefLabel "Anode Galvanic Connection Point"@en,
        "Ponto de Conexão Galvânica do Anodo"@pt-br .

edo:Asset a owl:Class ;
    dcterms:identifier "Asset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:SerialNumber ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:IsSpare ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:DomainElement ;
    skos:definition "An asset is a physical project element that is individually traceable and replaceable, typically through a serial number or equivalent identification. Assets include equipment, pipeline segments, accessories, and other production or transportation items whose lifecycle must be managed individually for operation, maintenance, safety, performance, and replacement purposes."@en,
        "Um ativo é um elemento físico de projeto individualmente rastreável e substituível, normalmente por meio de número de série ou identificação equivalente. Ativos incluem equipamentos, tramos de dutos, acessórios e outros itens de produção ou transporte cujo ciclo de vida precisa ser gerenciado individualmente para fins de operação, manutenção, segurança, desempenho e substituição."@pt-br ;
    skos:prefLabel "Asset"@en,
        "Ativo"@pt-br .

edo:AttributeScopes a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Scopes"@en,
        "Escopos de Atributo"@pt-br .

edo:BendMomentVsShearForceTableColumn a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BendMomentVsShearForceTable" ;
    rdfs:subClassOf edo:BendMomentVsShearForceCurveAttribute ;
    skos:definition "Provides data on the relationship between bending moment and shear force, used to evaluate how the structure behaves under combined loading conditions. This information is critical for determining the structural integrity and performance under different operational stresses."@en ;
    skos:prefLabel "Bending moment vs Shear Force Table"@en,
        "Tabela de Momento de Curvatura em Função da Força Cisalhante"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute .

edo:ClampingSurface a owl:Class ;
    dcterms:identifier "ClampingSurface" ;
    rdfs:subClassOf edo:MechanicalConnectionSurface ;
    skos:definition "Mechanical connection surface participating in a clamped attachment through distributed contact pressure."@en,
        "Superfície de conexão mecânica que participa de uma fixação por abraçadeira por meio de pressão de contato distribuída."@pt-br ;
    skos:prefLabel "Clamping Surface"@en,
        "Superfície de Aperto"@pt-br .

edo:ConnectionModule a owl:Class ;
    dcterms:identifier "ConnectionModule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ConnectionModuleMatingConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:LineTerminationModule ;
    skos:definition "Line termination equipment enabling anchoring and connection to a matching hub"@en,
        "Equipamento de terminação de linha que permite sua ancoragem e conexão a um hub correspondente"@pt-br ;
    skos:prefLabel "Connection module"@en,
        "Módulo de conexão"@pt-br .

edo:ConstituentComponent a owl:Class ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "A constituent component is a physical component that forms part of the internal or structural composition of an asset, but is not normally managed as an individually traceable asset. Examples include flexible pipe layers, umbilical function lines, fillers, tubes, cables, and other embedded or constituent parts of engineered products."@en,
        "Um componente constituinte é um componente físico que forma parte da composição interna ou estrutural de um ativo, mas que normalmente não é gerenciado como um ativo individualmente rastreável. Exemplos incluem camadas de dutos flexíveis, linhas funcionais de umbilicais, enchimentos, tubos, cabos e outras partes embutidas ou constituintes de produtos de engenharia."@pt-br ;
    skos:prefLabel "Constituent Component"@en,
        "Componente Constituinte"@pt-br .

edo:ConsumableElement a owl:Class ;
    rdfs:subClassOf edo:DiscretePart ;
    skos:definition "Physical, non-traceable, and replaceable elements. They typically correspond to items that are consumed, depleted, or exchanged during the lifecycle of a project or asset, without requiring individual identification or tracking. The purpose of this class is to distinguish such elements from assets that are uniquely traceable and from components that are permanently integrated, ensuring clarity in modeling and maintenance processes."@en,
        "Representa elementos físicos, não rastreáveis e substituíveis. Normalmente correspondem a itens que são consumidos, desgastados ou trocados ao longo do ciclo de vida de um projeto ou ativo, sem necessidade de identificação ou rastreamento individual. O propósito dessa categoria é diferenciá-los de ativos que são rastreáveis de forma única e de componentes que são permanentemente integrados, garantindo clareza nos processos de modelagem e manutenção."@pt-br ;
    skos:prefLabel "Consumable Element"@en,
        "Elemento Consumível"@pt-br .

edo:ContentManagementAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ContentManagementAttribute" ;
    skos:broader edo:AdministrativeAttribute ;
    skos:definition "Administrative attribute category related to content, status, versioning or textual management information."@en,
        "Categoria de atributo administrativo relacionada a conteúdo, status, versionamento ou informação textual de gestão."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory ;
    skos:prefLabel "Content management attribute"@en,
        "Atributo de gestão de conteúdo"@pt-br .

edo:CrushingMaximumAllowableTensionTableColumn a owl:Class ;
    rdfs:subClassOf edo:CrushingMaximumAllowableTensionAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:DataPort a owl:Class ;
    dcterms:identifier "DataPort" ;
    rdfs:subClassOf edo:Port ;
    skos:definition "Represents a port that allows the exchange of data or signals between elements."@en,
        "Representa uma porta que permite a troca de dados ou sinais entre elementos."@pt-br ;
    skos:prefLabel "Data Port"@en,
        "Porta de Dados"@pt-br .

edo:DomainAttributeScope a owl:NamedIndividual,
        skos:ConceptScheme ;
    skos:definition "Controlled vocabulary for classifying whether a domain attribute applies at type, instance or batch level."@en,
        "Vocabulário controlado para classificar se um atributo de domínio se aplica ao nível de tipo, instância ou lote."@pt-br ;
    skos:prefLabel "Domain attribute scope"@en,
        "Escopo de atributo de domínio"@pt-br .

edo:DomainLifecycleAnnotation a owl:AnnotationProperty ;
    rdfs:label "Lifecycle Annotation"@en,
        "Anotação de Ciclo de Vida"@pt-br ;
    dcterms:identifier "DomainLifecycleAnnotation" ;
    rdfs:subPropertyOf edo:DomainMetamodelAnnotation ;
    skos:definition "Category of annotations used to describe lifecycle-related aspects of domain assets and their data."@en,
        "Categoria de anotações usadas para descrever aspectos de ciclo de vida de ativos e dados de domínio."@pt-br .

edo:ElectricalCable a owl:Class ;
    dcterms:identifier "ElectricalCable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalCableEnd ;
            owl:onProperty edo:hasEnd ],
        [ a owl:Restriction ;
            owl:onClass edo:ElectricalCableEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        edo:FunctionLine ;
    skos:definition "Represents an electrical cable within a function line, transmitting electrical power or signals."@en,
        "Representa um cabo elétrico dentro de uma linha funcional, transmitindo energia elétrica ou sinais."@pt-br ;
    skos:prefLabel "Electrical Cable"@en,
        "Electrical cable"@en,
        "Cabo Elétrico"@pt-br,
        "Cabo elétrico"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:ElectricalContactAttribute a owl:Class ;
    dcterms:identifier "ElectricalContactAttribute" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Attribute used to describe a detailed electrical contact represented within an electric port."@en,
        "Atributo usado para descrever um contato elétrico detalhado representado dentro de uma porta elétrica."@pt-br ;
    skos:prefLabel "Electrical Contact Attribute"@en,
        "Atributo de Contato Elétrico"@pt-br .

edo:ElectricalSplicePort a owl:Class ;
    dcterms:identifier "ElectricalSplicePort" ;
    rdfs:subClassOf edo:ElectricPort ;
    skos:definition "Electric port representing the aggregate electrical interface of a cable or conductor group at a splice termination. It represents a splice-side interface rather than a detachable connector mating interface; detailed conductor-level splice information may be represented separately when required."@en,
        "Porta elétrica que representa a interface elétrica agregada de um cabo ou grupo de condutores em uma terminação por emenda. Representa uma interface do lado da emenda, e não uma interface de acoplamento por conector destacável; informações detalhadas de emenda em nível de condutor podem ser representadas separadamente quando necessário."@pt-br ;
    skos:prefLabel "Electrical Splice Port"@en,
        "Porta de Emenda Elétrica"@pt-br .

edo:ElectronicDevice a owl:Class ;
    dcterms:identifier "ElectronicDevice" ;
    rdfs:subClassOf edo:ComponentDevice ;
    skos:prefLabel "Electronic device"@en,
        "Dispositivo eletrônico"@pt-br .

edo:EndFitting a owl:Class ;
    dcterms:identifier "EndFitting" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:Nbc3e33883a0d4b58acd445aad62efbbb ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:onClass edo:EndFittingCrimpedConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlangeConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlangeType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:BoreDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketStandard ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlangeFaceType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:HasModaSensor ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketPressureRating ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketOuterDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:HasN2InjectionPort ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketSpecification ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketInnerDIameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:HasFaceORing ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PipeTermination ;
    skos:altLabel "Connector Fitting"@en,
        "End Termination"@en,
        "Termination Assembly"@en,
        "Termination Fitting"@en ;
    skos:definition "Component used in subsea flexible pipes to provide a secure transition between the flexible pipe and rigid structures, such as subsea equipment or topside facilities, as well as to connect two sections of flexible pipe. The End Fitting ensures the structural integrity and sealing of the pipe, allowing for the connection of the flexible line to other equipment or sections while withstanding internal pressures and environmental forces. It is a critical interface that accommodates the pipe's mechanical, hydraulic, and thermal loads, ensuring long-term reliable performance in harsh subsea conditions."@en,
        "Componente utilizado em dutos flexíveis para fornecer uma transição segura entre o duto flexível e estruturas rígidas, como equipamentos submersos ou instalações no topo, bem como para conectar duas seções de duto flexível. O Terminador garante a integridade estrutural e o vedamento do duto, permitindo a conexão da linha flexível a outros equipamentos ou seções, resistindo a pressões internas e forças ambientais. É uma interface crítica que acomoda as cargas mecânicas, hidráulicas e térmicas do duto, garantindo desempenho confiável a longo prazo em condições submarinas adversas."@pt-br ;
    skos:prefLabel "End fitting"@en,
        "Conector de Extremidade"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:EquipmentEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Equipment Engineering"@en,
        "Engenharia de Equipamentos"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on the design and specification of industrial equipment."@en,
        "Disciplina de engenharia focada no projeto e especificação de equipamentos industriais."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:ExternalReference a owl:Class ;
    rdfs:subClassOf edo:InformationArtifact ;
    skos:definition "Represents entities that serve as external references within a project or model. They are not physical or logical elements themselves but provide links to supporting information such as documents, data dictionaries, or standards. Their purpose is to connect the model to external sources of knowledge, ensuring traceability, compliance, and contextual understanding."@en,
        "Representa entidades que funcionam como referências externas dentro de um projeto ou modelo. Não são elementos físicos nem lógicos em si, mas fornecem vínculos para informações de apoio, como documentos, dicionários de dados ou normas. Seu propósito é conectar o modelo a fontes externas de conhecimento, garantindo rastreabilidade, conformidade e compreensão contextual."@pt-br ;
    skos:prefLabel "External Reference"@en,
        "Referência Externa"@pt-br .

edo:FlangeType a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "FlangeType" ;
    rdfs:subClassOf edo:FlangeAttribute ;
    skos:definition "Specifies the type of flange within the Standard, which defines certain characteristics, like the Standard itself, Type or Class, Diameter and Operating Pressure."@en ;
    skos:prefLabel "Flange Type"@en,
        "Tipo de Flange"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:FlexiblePipeCrimpedJoint a owl:Class ;
    dcterms:identifier "FlexiblePipeCrimpedJoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( edo:FlexiblePipeCrimpedConnection edo:EndFittingCrimpedConnection ) ] ;
            owl:onProperty edo:connectsPoint ],
        [ a owl:Restriction ;
            owl:onClass edo:EndFittingCrimpedConnection ;
            owl:onProperty edo:connectsPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlexiblePipeCrimpedConnection ;
            owl:onProperty edo:connectsPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PhysicalConnection ;
    owl:disjointWith edo:WeldedJoint ;
    skos:definition "Permanent structural and pressure-containing physical connection formed by crimping an end fitting onto a flexible pipe segment."@en,
        "Conexão física permanente, estrutural e de contenção de pressão, formada pela crimpagem de um end fitting em um tramo de duto flexível."@pt-br ;
    skos:prefLabel "Flexible Pipe Crimped Joint"@en,
        "Junta Crimpada de Duto Flexível"@pt-br .

edo:FunctionalAsset a owl:Class ;
    dcterms:identifier "FunctionalAsset" ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "A functionally identified and managed domain element that aggregates or represents the physical elements required to perform a function, and may retain its identity across changes in physical composition and deliveries from different contracts or suppliers."@en,
        "Elemento de domínio identificado e gerenciado funcionalmente que agrega ou representa os elementos físicos necessários à realização de uma função, podendo manter sua identidade ao longo de mudanças em sua composição física e de entregas provenientes de diferentes contratos ou fornecedores."@pt-br ;
    skos:prefLabel "Functional Asset"@en,
        "Ativo Funcional"@pt-br .

edo:GasketSealing a owl:Class ;
    dcterms:identifier "GasketSealing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:RingGasket ;
            owl:onProperty edo:hasPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:RingGasket ;
            owl:onProperty edo:hasPart ],
        edo:ConnectionMechanism ;
    skos:prefLabel "Gasket Sealing"@en,
        "Vedação por Junta"@pt-br .

edo:Geothermal a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Geothermal Energy"@en,
        "Energia Geotérmica"@pt-br ;
    skos:broader edo:Renewable ;
    skos:definition "Energy derived from heat stored beneath the Earth's surface."@en,
        "Energia derivada do calor armazenado abaixo da superfície da Terra."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:HardwareItem a owl:Class ;
    dcterms:identifier "HardwareItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ProjectDrawingRevision ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaterialSupplierName ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DrawingDimensionsTable_DimensionUnit ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:Mass ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:IdInUnifilarDiagram ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DrawingDimensionsTable_DimensionName ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:InternalVolume ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SupplierProvidedMaterialName ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ManufacturerDefinedMaterialName ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DisplacedVolume ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ProjectDrawingCode ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DrawingDimensionsTable_DimensionValue ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DrawingDimensionsTable_DimensionDescription ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PartNumber ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Component ;
    skos:definition "Simple mechanical items such as pipe components, etc."@en,
        "Itens mecânicos simples como ferragens, fixadores, vedações, etc."@pt-br ;
    skos:prefLabel "Hardware Item"@en,
        "Item de Hardware"@pt-br .

edo:HotStabReceptacleMatingConnection a owl:Class ;
    dcterms:identifier "HotStabReceptacleMatingConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:HydraulicConnectorSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:HotStabMatingConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    skos:prefLabel "Hot Stab Receptacle Mating Connection"@en,
        "Conexão de Acoplamento do Receptáculo de Hot Stab"@pt-br .

edo:Interconnection a owl:Class ;
    dcterms:identifier "Interconnection" ;
    rdfs:subClassOf edo:FunctionalAsset ;
    skos:definition "A functional asset representing a complete engineered interconnection between endpoints, aggregating the spans, terminations, inline equipment and other elements that together provide the required transport, power, control or communication function."@en,
        "Ativo funcional que representa uma interligação de engenharia completa entre pontos terminais, agregando os trechos, terminações, equipamentos inline e demais elementos que, em conjunto, realizam a função requerida de transporte, potência, controle ou comunicação."@pt-br ;
    skos:prefLabel "Interconnection"@en,
        "Interligação"@pt-br .

edo:InternalIncidentalPressureTableColumn a owl:Class ;
    rdfs:subClassOf edo:InternalIncidentalPressureCurveAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign .

edo:Jumper a owl:Class ;
    dcterms:identifier "Jumper" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:Port ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:LinearObject ;
    skos:altLabel "Flying lead"@en ;
    skos:definition "Short electrical, hydraulic, optical etc. interconnections, usually directly manipulated in the subsea environment by ROV/diver"@en,
        "Interconexões elétricas, hidráulicas, óticas, etc. de menor porte, geralmente manipuláveis no ambiente submarino diretamente por ROV/mergulho"@pt-br ;
    skos:prefLabel "Signal/control jumper"@en,
        "Jumper de controle/sinal"@pt-br .

edo:JumperConnector a owl:Class ;
    dcterms:identifier "JumperConnector" ;
    rdfs:subClassOf edo:Connector ;
    skos:definition "Represents a connector designed to temporarily link elements, typically for testing, commissioning, or flexible system configurations."@en,
        "Representa um conector projetado para ligar temporariamente elementos, normalmente para testes, comissionamento ou configurações flexíveis de sistemas."@pt-br ;
    skos:prefLabel "Jumper Connector"@en,
        "Conector Jumper"@pt-br .

edo:LayingMinimumRadiusCurveAttribute a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:CurveAttribute .

edo:LocationType a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Location Type"@en,
        "Tipo de Localização"@pt-br ;
    skos:broader edo:LocationTypes ;
    skos:definition "Classification of industrial activities based on their geographical location."@en,
        "Classificação de atividades industriais baseada em sua localização geográfica."@pt-br ;
    skos:inScheme edo:LocationTypeScheme ;
    skos:topConceptOf edo:LocationTypeScheme .

edo:MaterialManufacturerAttribute a owl:Class ;
    rdfs:label "Material Manufacturer"@en ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:AttributeGroupAttribute .

edo:MaterialSpecification a owl:Class ;
    dcterms:identifier "MaterialSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:PoissonRatioAt23Degrees ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SpecificWeight ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:TechnicalNotes ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ThermalConductivityCoefficient ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ElasticityModulusAt23Degrees ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SpecificHeatCapacity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaterialComposition ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:InformationArtifact ;
    skos:definition "Information artifact that specifies a material through its identity, composition and relevant physical, mechanical, thermal or other engineering properties."@en,
        "Artefato informacional que especifica um material por meio de sua identidade, composição e propriedades físicas, mecânicas, térmicas ou outras propriedades de engenharia relevantes."@pt-br ;
    skos:prefLabel "Material Specification"@en,
        "Especificação de Material"@pt-br .

edo:MaxDesignAbsIntPresTableColumn a owl:Class ;
    rdfs:subClassOf edo:MaxDesignAbsIntPresCurveAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign .

edo:OilAndGas a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Oil & Gas"@en,
        "Petróleo & Gás"@pt-br ;
    skos:broader edo:Domain ;
    skos:definition "Industrial domain covering all activities related to the exploration, production, refining, and distribution of oil and gas."@en,
        "Domínio industrial que abrange todas as atividades relacionadas à exploração, produção, refino e distribuição de petróleo e gás."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:OpticalConnectorPort a owl:Class ;
    dcterms:identifier "OpticalConnectorPort" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalConnectorSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        edo:OpticalPort ;
    skos:definition "Optical port representing a detachable connector-based mating interface governed by an optical connector specification."@en,
        "Porta óptica que representa uma interface de acoplamento destacável baseada em conector, governada por uma especificação de conector óptico."@pt-br ;
    skos:prefLabel "Optical Connector Port"@en,
        "Porta de Conector Óptico"@pt-br .

edo:OpticalPort a owl:Class ;
    dcterms:identifier "OpticalPort" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalInterfaceSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        edo:DataPort ;
    skos:definition "Data port whose represented signal transport is optical. The class identifies optical transmission semantics without implying detachable connector mating; splices, penetrators or connectorized interfaces may be specialized separately."@en,
        "Porta de dados cujo transporte de sinal representado é óptico. A classe identifica a semântica de transmissão óptica sem implicar acoplamento por conector destacável; emendas, penetradores ou interfaces com conector podem ser especializados separadamente."@pt-br ;
    skos:prefLabel "Optical Port"@en,
        "Porta Óptica"@pt-br .

edo:OpticalSplicePort a owl:Class ;
    dcterms:identifier "OpticalSplicePort" ;
    rdfs:subClassOf edo:OpticalPort ;
    skos:definition "Optical port representing the aggregate optical interface of a fibre or fibre group at a splice termination. It represents a splice-side interface rather than a detachable connector mating interface; detailed fibre-level splice information may be represented separately when required."@en,
        "Porta óptica que representa a interface óptica agregada de uma fibra ou grupo de fibras em uma terminação por emenda. Representa uma interface do lado da emenda, e não uma interface de acoplamento por conector destacável; informações detalhadas de emenda em nível de fibra podem ser representadas separadamente quando necessário."@pt-br ;
    skos:prefLabel "Optical Splice Port"@en,
        "Porta de Emenda Óptica"@pt-br .

edo:PanelConnector a owl:Class ;
    dcterms:identifier "PanelConnector" ;
    rdfs:subClassOf edo:Connector ;
    skos:definition "Connectors for installation in panels or other stationary positions."@en,
        "Conectores para instalação em painéis ou outras posições estacionárias."@pt-br ;
    skos:prefLabel "Panel Connector"@en,
        "Conector de Painel"@pt-br .

edo:PipeSectionApplication a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PipeSectionApplication" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the specific application of the flexible pipe section in the interconnection system, categorizing it based on its role or position within the riser or flowline."@en,
        "Aplicação do tramo, de acordo com as seguintes nomenclaturas: R (Riser); RT (seção de topo do riser); RI (seção intermediaria do riser); RF (seção de fundo do riser); F (Flowline)"@pt-br ;
    skos:prefLabel "Pipe Section Application"@en,
        "Aplicação do Tramo"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:PipeSupport a owl:Class ;
    dcterms:identifier "PipeSupport" ;
    rdfs:subClassOf edo:Structure .

edo:Position a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Position" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Location of an element, feature or point within a reference system or relative to a reference element."@en,
        "Localização de um elemento, feature ou ponto em um sistema de referência ou em relação a um elemento de referência."@pt-br ;
    skos:prefLabel "Position"@en,
        "Posição"@pt-br ;
    edo:attributeNature edo:LocationAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole .

edo:RingGasketInnerDIameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RingGasketInnerDIameter" ;
    rdfs:subClassOf edo:RingGasketAttribute ;
    skos:definition "The internal diameter, which determines the size of the bore it fits into. This dimension is crucial for ensuring a proper fit and effective sealing."@en ;
    skos:prefLabel "Ring Gasket Inner Diameter"@en,
        "Diâmetro Interno da Junta de Vedação"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RingGasketOuterDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RingGasketOuterDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:RingGasketAttribute ;
    skos:definition "The external diameter, which determines the size of the surface it seals against. This dimension is essential for providing a secure seal and preventing leakage."@en ;
    skos:prefLabel "Ring Gasket Outer Diameter"@en,
        "Diâmetro Externo da Junta de Vedação"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:RingGasketPressureRating a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RingGasketPressureRating" ;
    rdfs:subClassOf edo:RingGasketAttribute ;
    skos:definition "The maximum pressure it can withstand without failing. This rating is important for ensuring that the seal ring performs effectively under the operating pressures of the application."@en ;
    skos:prefLabel "Ring Gasket Pressure Rating"@en,
        "Classificação de Pressão da Junta de Vedação"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RingGasketSpecification a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RingGasketSpecification" ;
    rdfs:subClassOf edo:RingGasketAttribute ;
    skos:definition "The detailed description of it's design and performance characteristics, including material, size, and pressure rating. This provides comprehensive information about the seal ring's suitability for specific applications."@en ;
    skos:prefLabel "Ring Gasket Specification"@en,
        "Especificação da Junta de Vedação"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RingGasketStandard a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RingGasketStandard" ;
    rdfs:subClassOf edo:RingGasketAttribute ;
    skos:definition "The standard or specification it conforms to, such as API, ISO, or other industry standards. This indicates the compliance of the seal ring with established guidelines for quality and performance."@en ;
    skos:prefLabel "Ring Gasket Standard"@en,
        "Padrão da Junta de Vedação"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RingGasketType a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RingGasketType" ;
    rdfs:subClassOf edo:RingGasketAttribute ;
    skos:definition "The specific type or design. This classification helps identify the appropriate seal ring based on its design and application requirements, ensuring it meets the sealing needs under various conditions."@en ;
    skos:prefLabel "Ring Gasket Type"@en,
        "Tipo de Junta de Vedação"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RiserConfiguration a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RiserConfiguration" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "This property specifies the configuration type for the riser section of the pipeline. It provides key information on the structural design, indicating the arrangement and dynamic behaviour of the riser system. The chosen configuration affects how the structure responds to environmental forces, such as currents and pressure, and plays a critical role in determining the overall performance and durability of the system."@en ;
    skos:prefLabel "Riser Configuration"@en,
        "Configuração do Riser"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:RiserSupport a owl:Class ;
    dcterms:identifier "RiserSupport" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:someValuesFrom edo:ConnectionPoint ],
        edo:Component ;
    skos:definition "Interface at the production unit for coupling and support of a riser"@en,
        "Interface na unidade de produção para acoplamento e suporte de um riser"@pt-br ;
    skos:prefLabel "Riser support"@en,
        "Suporte de riser"@pt-br .

edo:Service a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Service" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the type of service the pipeline is designated for, specifying its operational purpose within the project. This classification is used to ensure proper management, installation, and use of the pipeline according to its intended function."@en,
        "Escolha um da lista: IA (Injeção de água); IG (Injeção de Gás); LPO (Linha de Produção de Óleo); PG (Produtor de Gás); SE (Serviço); GAS (Gasoduto); UEH (Umbilical Eletro Hidráulico); CEP (Cabo Elétrico de Potência)"@pt-br ;
    skos:prefLabel "Service"@en,
        "Serviço"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Solar a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Solar Energy"@en,
        "Energia Solar"@pt-br ;
    skos:broader edo:Renewable ;
    skos:definition "Energy harnessed from sunlight, including photovoltaic and thermal systems."@en,
        "Energia obtida da luz solar, incluindo sistemas fotovoltaicos e térmicos."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:StorageAccessory a owl:Class ;
    dcterms:identifier "StorageAccessory" ;
    rdfs:subClassOf edo:Accessory ;
    skos:prefLabel "Storage/transportation accessory"@en,
        "Acessório de armazenamento/transporte"@pt-br .

edo:StrandsTableColumn a owl:Class ;
    rdfs:subClassOf edo:StrandsTableAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:TechnicalArtifact a owl:Class ;
    rdfs:subClassOf edo:InformationArtifact ;
    skos:definition "Reusable technical artifact that participates in the definition, configuration or governance of domain elements, without necessarily representing a physical object."@en,
        "Artefato técnico reutilizável que participa da definição, configuração ou governança de elementos de domínio, sem representar necessariamente um objeto físico."@pt-br ;
    skos:prefLabel "Technical Artifact"@en,
        "Artefato Técnico"@pt-br .

edo:TieInEquipment a owl:Class ;
    dcterms:identifier "TieInEquipment" ;
    rdfs:subClassOf edo:FlowControlModule ;
    skos:prefLabel "Tie-in equipment"@en,
        "Equipamento de interligação"@pt-br .

edo:TopsideEquipment a owl:Class ;
    dcterms:identifier "TopsideEquipment" ;
    rdfs:subClassOf edo:SurfaceEquipment ;
    skos:prefLabel "Topside Equipment"@en,
        "Equipamento de Topside"@pt-br .

edo:TubingCoupling a owl:Class ;
    dcterms:identifier "TubingCoupling" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:Coupling ;
    skos:definition "Couplings for fluid conveyance lines (i.e. hydraulic or pneumatic)."@en,
        "Acoplamentos para linhas de condução de fluidos (i.e. hidráulicos ou pneumáticos)."@pt-br ;
    skos:prefLabel "Tubing Coupling"@en,
        "Acoplamento de Tubulação"@pt-br .

edo:Upstream a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Upstream"@en,
        "Upstream"@pt-br ;
    skos:broader edo:OilAndGas ;
    skos:definition "Oil & Gas sector covering exploration, drilling, and production of hydrocarbon resources."@en,
        "Setor de Petróleo & Gás que abrange exploração, perfuração e produção de recursos de hidrocarbonetos."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:Wind a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Wind Energy"@en,
        "Energia Eólica"@pt-br ;
    skos:broader edo:Renewable ;
    skos:definition "Energy generated from wind using turbines and related technologies."@en,
        "Energia gerada a partir do vento usando turbinas e tecnologias relacionadas."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:hasAttachmentPoint a owl:ObjectProperty ;
    rdfs:label "Has Attachment Point"@en,
        "Tem Ponto de Montagem"@pt-br ;
    dcterms:identifier "hasAttachmentPoint" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:AttachmentPoint ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:isAttachmentPointOf ;
    skos:definition "Associates a domain element with an attachment point belonging to it."@en,
        "Associa um elemento de domínio a um ponto de montagem que lhe pertence."@pt-br .

edo:isConstituentEndOf a owl:ObjectProperty ;
    rdfs:label "Is Constituent End Of"@en,
        "É Extremidade Constituinte de"@pt-br ;
    dcterms:identifier "isConstituentEndOf" ;
    rdfs:domain edo:FunctionLineEnd ;
    rdfs:range edo:UmbilicalEnd ;
    rdfs:subPropertyOf edo:PartWholeRelation ;
    owl:inverseOf edo:hasConstituentEnd .

edo:terminatesEnd a owl:ObjectProperty ;
    rdfs:label "Terminates End"@en,
        "Termina Extremidade"@pt-br ;
    dcterms:identifier "terminatesEnd" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:LinearEnd ;
    rdfs:subPropertyOf edo:FunctionalRelation ;
    owl:inverseOf edo:isTerminatedBy ;
    skos:definition "Relates a domain element to a terminal end whose termination it performs or realizes in a particular assembly or installation context."@en,
        "Relaciona um elemento de domínio a uma extremidade terminal cuja terminação ele desempenha ou realiza em um determinado contexto de montagem ou instalação."@pt-br .

edo:AttachmentPoint a owl:Class ;
    dcterms:identifier "AttachmentPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:DomainElement ;
            owl:onProperty edo:isAttachmentPointOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Feature ;
    skos:definition "Feature representing a point participating in attachment, mounting or positioning of one element relative to another, without implying a physical flow connection."@en,
        "Feature que representa um ponto que participa da fixação, montagem ou posicionamento de um elemento em relação a outro, sem implicar conexão física de fluxo."@pt-br ;
    skos:prefLabel "Attachment Point"@en,
        "Ponto de Anexação"@pt-br .

edo:AttributeValueOrigins a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Value Origins"@en,
        "Origens de Valor de Atributo"@pt-br .

edo:BendingRadius a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BendingRadius" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for bending radius values. Specialized attributes must be used when the value represents a requirement, design limit, certified limit, operating condition or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de raio de curvatura. Atributos especializados devem ser usados quando o valor representar requisito, limite de projeto, limite certificado, condição operacional ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Bending Radius"@en,
        "Raio de curvatura"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue .

edo:Biomass a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Biomass Energy"@en,
        "Energia de Biomassa"@pt-br ;
    skos:broader edo:Renewable ;
    skos:definition "Energy produced from organic materials such as wood, agricultural residues, or waste."@en,
        "Energia produzida a partir de materiais orgânicos como madeira, resíduos agrícolas ou lixo."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:CompactObject a owl:Class ;
    rdfs:label "Compact Object"@en ;
    dcterms:identifier "CompactObject" ;
    rdfs:subClassOf edo:Asset ;
    skos:definition "A mobile physical object, usually manufactured in a standardized manner."@en,
        "Objeto físico móvel, geralmente fabricado de maneira padronizada."@pt-br ;
    skos:prefLabel "Compact Object"@en,
        "Objeto Compacto"@pt-br .

edo:Component a owl:Class ;
    dcterms:identifier "Component" ;
    rdfs:subClassOf edo:CompactObject ;
    skos:definition "Items always found as part of larger objects, with varying levels of complexity."@en,
        "Itens sempre encontrados como parte de objetos maiores, com nível variado de complexidade"@pt-br ;
    skos:prefLabel "Component"@en,
        "Componente"@pt-br .

edo:ConceptStatusScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:identifier "ConceptStatusScheme" ;
    skos:definition "Controlled vocabulary for editorial and governance status values assigned to EDO concepts."@en,
        "Vocabulário controlado para valores de status editorial e de governança atribuídos a conceitos da EDO."@pt-br ;
    skos:prefLabel "Concept status scheme"@en,
        "Esquema de status de conceito"@pt-br .

edo:ConceptStatuses a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:MetamodelConcepts ;
    skos:prefLabel "Concept Statuses"@en,
        "Status de Conceito"@pt-br .

edo:ConnectionMechanism a owl:Class ;
    dcterms:identifier "ConnectionMechanism" ;
    rdfs:subClassOf edo:DomainElement ;
    skos:prefLabel "Connection Mechanism"@en,
        "Mecanismo de Conexão"@pt-br .

edo:Connector a owl:Class ;
    dcterms:identifier "Connector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ConnectionPoint ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:ComponentDevice ;
    skos:definition "Represents a physical component used to join, link, or interface two or more elements, enabling mechanical, electrical, or fluid connection."@en,
        "Representa um componente físico usado para unir, ligar ou interligar dois ou mais elementos, permitindo conexão mecânica, elétrica ou de fluido."@pt-br ;
    skos:prefLabel "Connector"@en,
        "Conector"@pt-br .

edo:CrushingCurveAttribute a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:CurveAttribute .

edo:DesignPhase a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "DesignPhase" ;
    skos:broader edo:LifecyclePhase ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Design Phase"@en,
        "Fase de Projeto"@pt-br .

edo:DiffusionTableColumn a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DiffusionTable" ;
    rdfs:subClassOf edo:DiffusionCurveAttribute ;
    skos:definition "Provides data on the diffusion rates of substances through materials, used to assess how different fluids or gases permeate the structure over time. This information is crucial for evaluating material suitability and predicting long-term performance under specific environmental conditions."@en,
        "Difusão (Específica para Materiais Poliméricos)"@pt-br ;
    skos:prefLabel "Diffusion Table"@en,
        "Tabela de Difusão"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute .

edo:DimensionsTableColumn a owl:Class ;
    rdfs:subClassOf edo:DrawingDimensionsTableAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:DomainAttributeValueOrigin a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:identifier "DomainAttributeValueOrigin" ;
    skos:definition "Controlled vocabulary for classifying how an attribute value is obtained or produced."@en,
        "Vocabulário controlado para classificar como um valor de atributo é obtido ou produzido."@pt-br ;
    skos:prefLabel "Domain attribute value origin"@en,
        "Origem de valor de atributo de domínio"@pt-br .

edo:ElectricalConnectorPort a owl:Class ;
    dcterms:identifier "ElectricalConnectorPort" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalConnectorSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        edo:ElectricPort ;
    skos:definition "Electric port representing a connector-based mating interface whose direct mating is governed by an electrical connector specification. The class identifies connector mating technology without classifying the carried service as control or power."@en,
        "Porta elétrica que representa uma interface de acoplamento baseada em conector cujo acoplamento direto é governado por uma especificação de conector elétrico. A classe identifica a tecnologia de acoplamento por conector sem classificar o serviço transportado como controle ou potência."@pt-br ;
    skos:prefLabel "Electrical Connector Port"@en,
        "Porta de Conector Elétrico"@pt-br .

edo:ElectricalConnectorSpecification a owl:Class ;
    dcterms:identifier "ElectricalConnectorSpecification" ;
    rdfs:subClassOf edo:ElectricalInterfaceSpecification ;
    skos:definition "Electrical interface specification for a connector-based mating interface. It may describe connector family, mating role, keying, contact arrangement and electrical ratings, while remaining distinct from the control or power function carried by the interface."@en,
        "Especificação de interface elétrica para uma interface de acoplamento baseada em conector. Pode descrever família do conector, papel de acoplamento, chaveamento, arranjo de contatos e ratings elétricos, permanecendo distinta da função de controle ou potência transportada pela interface."@pt-br ;
    skos:prefLabel "Electrical Connector Specification"@en,
        "Especificação de Conector Elétrico"@pt-br .

edo:ElectricalControlPort a owl:Class ;
    dcterms:identifier "ElectricalControlPort" ;
    rdfs:subClassOf edo:ElectricPort ;
    skos:definition "Electric port whose represented service is signal, control, instrumentation, electrical communication or low-power auxiliary supply. The class expresses electrical function, not a connector mating geometry."@en,
        "Porta elétrica cujo serviço representado é sinal, controle, instrumentação, comunicação elétrica ou alimentação auxiliar de baixa potência. A classe expressa a função elétrica, não a geometria de acoplamento de um conector."@pt-br ;
    skos:prefLabel "Electrical Control Port"@en,
        "Porta Elétrica de Controle"@pt-br .

edo:ElectricalPowerPort a owl:Class ;
    dcterms:identifier "ElectricalPowerPort" ;
    rdfs:subClassOf edo:ElectricPort ;
    skos:definition "Electric port whose represented service is electrical power transmission to supply electrical loads. The class expresses electrical function, not a connector mating geometry."@en,
        "Porta elétrica cujo serviço representado é transmissão de potência elétrica para alimentação de cargas. A classe expressa a função elétrica, não a geometria de acoplamento de um conector."@pt-br ;
    skos:prefLabel "Electrical Power Port"@en,
        "Porta Elétrica de Potência"@pt-br .

edo:FlexiblePipeBodyEnd a owl:Class ;
    dcterms:identifier "FlexiblePipeBodyEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:FlexiblePipeCrimpedConnection ;
            owl:onProperty edo:hasEndInterface ],
        [ a owl:Restriction ;
            owl:onClass edo:FlexiblePipeCrimpedConnection ;
            owl:onProperty edo:hasEndInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:LinearEnd ;
    skos:definition "End of the multilayer flexible pipe body exposing the crimped interface used to permanently attach an end fitting."@en,
        "Extremidade do corpo multicamada do duto flexível que apresenta a interface crimpada usada para fixar permanentemente um end fitting."@pt-br ;
    skos:prefLabel "Flexible Pipe Body End"@en,
        "Extremidade do Corpo do Duto Flexível"@pt-br .

edo:FlexibleStructureLayer a owl:Class ;
    dcterms:identifier "FlexibleStructureLayer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryInertiaY ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerContinuity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryCrossSection ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerThickness ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerWatertight ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryInertiaX ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryProfileThickness ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerAnnularType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerWatertightLowerLayerInternalFreeVolume ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerAnnular ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryManufacturer ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryName ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryThickness ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:InternalDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LinearMass ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:LayerGeometryProfileWidth ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlexibleStructureLayerMaterial ;
            owl:onProperty edo:hasMaterial ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:ConstituentComponent ;
    skos:definition "A specific layer within the structure of a subsea flexible pipe, each designed to fulfill a distinct function. These layers work together to provide essential properties such as pressure containment, reinforcement, and environmental protection. Engineered to withstand harsh underwater conditions, each layer contributes to the overall flexibility, durability, and performance of the subsea flexible pipe system."@en ;
    skos:prefLabel "Flexible Structure Layer"@en,
        "Camadas de Estruturas Flexíveis"@pt-br .

edo:Hydropower a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Hydropower"@en,
        "Energia Hidrelétrica"@pt-br ;
    skos:broader edo:Renewable ;
    skos:definition "Energy generated from moving water, including dams and tidal power."@en,
        "Energia gerada a partir da água em movimento, incluindo barragens e energia das marés."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:InformationRelation a owl:ObjectProperty ;
    rdfs:label "Information Relation"@en,
        "Relação Informacional"@pt-br ;
    dcterms:identifier "InformationRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:altLabel "Documentation Relation"@en,
        "Relação de Documentação"@pt-br ;
    skos:definition "Category of relationships used to associate domain entities with informational artefacts such as documents and external classification references."@en,
        "Categoria de relacionamentos usada para associar entidades do domínio a artefatos informacionais como documentos e referências externas de classificação."@pt-br .

edo:LifecyclePhase a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "LifecyclePhase" ;
    skos:broader edo:LifecyclePhases ;
    skos:definition "A stage in the lifecycle of an industrial asset, from conception to decommissioning."@en,
        "Uma etapa no ciclo de vida de um ativo industrial, desde a concepção até a desativação."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Lifecycle phase"@en,
        "Fase do ciclo de vida"@pt-br ;
    skos:topConceptOf edo:LifecyclePhaseScheme .

edo:LocationTypeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Location type scheme"@en,
        "Esquema de tipo de localização"@pt-br ;
    dcterms:identifier "LocationTypeScheme" ;
    skos:definition "Controlled vocabulary for location-type classifications used by EDO."@en,
        "Vocabulário controlado para classificações de tipo de localização usadas pela EDO."@pt-br ;
    skos:hasTopConcept edo:LocationType .

edo:MooringAccessory a owl:Class ;
    dcterms:identifier "MooringAccessory" ;
    rdfs:subClassOf edo:HardwareItem ;
    skos:definition "A Mooring Accessory includes components like anchors, chains, and connectors used to secure offshore platforms or vessels to the seabed, ensuring stability and safety in harsh marine conditions."@en ;
    skos:prefLabel "Mooring Accessory"@en,
        "Acessório de Amarração"@pt-br .

edo:PartWholeRelation a owl:ObjectProperty ;
    rdfs:label "Part–Whole Relation"@en,
        "Relação Parte–Todo"@pt-br ;
    dcterms:identifier "PartWholeRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:altLabel "Composition Relation"@en,
        "Relação de Composição"@pt-br ;
    skos:definition "Category of relationships used to represent part–whole structures between domain entities."@en,
        "Categoria de relacionamentos usada para representar estruturas parte–todo entre entidades do domínio."@pt-br .

edo:PermeabilityTableColumn a owl:Class ;
    rdfs:subClassOf edo:PermeabilityCurveAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:PipeClampingSurface a owl:Class ;
    dcterms:identifier "PipeClampingSurface" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:PipeSegment ;
            owl:onProperty edo:isConnectionInterfaceOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:CollarClampingSurface ;
            owl:onProperty edo:isInterfaceConnectedTo ],
        edo:ClampingSurface ;
    skos:definition "Local external surface region of a pipe segment participating in a clamped attachment."@en,
        "Região local da superfície externa de um tramo de duto que participa de uma fixação por abraçadeira."@pt-br ;
    skos:prefLabel "Pipe Clamping Surface"@en,
        "Superfície de Aperto do Duto"@pt-br .

edo:Port a owl:Class ;
    rdfs:subClassOf edo:ConnectionPoint ;
    skos:definition "Represents an interface point through which an element can exchange data, energy, or fluids."@en,
        "Representa um ponto de interface através do qual um elemento pode trocar dados, energia ou fluidos."@pt-br ;
    skos:prefLabel "Port"@en,
        "Porta"@pt-br .

edo:ProtectedStructureGalvanicConnectionPoint a owl:Class ;
    dcterms:identifier "ProtectedStructureGalvanicConnectionPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:AnodeGalvanicConnectionPoint ;
            owl:onProperty edo:isConnectedTo ],
        edo:GalvanicConnectionPoint ;
    skos:definition "Galvanic connection point on the protected-metallic-structure side of a cathodic-protection connection."@en,
        "Ponto de conexão galvânica no lado da estrutura metálica protegida de uma conexão de proteção catódica."@pt-br ;
    skos:prefLabel "Protected Structure Galvanic Connection Point"@en,
        "Ponto de Conexão Galvânica da Estrutura Protegida"@pt-br .

edo:RequiredLongitudinalPosition a owl:Class ;
    dcterms:identifier "RequiredLongitudinalPosition" ;
    rdfs:subClassOf edo:Position ;
    skos:definition "Required longitudinal distance locating an installation point relative to its selected reference datum along the applicable longitudinal direction of the host element."@en,
        "Distância longitudinal requerida que localiza um ponto de instalação em relação ao datum de referência selecionado, ao longo da direção longitudinal aplicável do elemento hospedeiro."@pt-br ;
    skos:prefLabel "Required Longitudinal Position"@en,
        "Posição Longitudinal Requerida"@pt-br ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue .

edo:SafeWorkingLoad a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SafeWorkingLoad" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Safe Working Load (SWL) refers to the maximum load that can be safely handled under normal operating conditions. This value ensures the equipment operates within its designed capacity, preventing overloading and potential failure."@en ;
    skos:prefLabel "Safe Working Load"@en,
        "Carga Máxima Segura de Trabalho"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Sensor a owl:Class ;
    dcterms:identifier "Sensor" ;
    rdfs:subClassOf edo:ElectronicDevice ;
    skos:prefLabel "Sensor"@en,
        "Sensor"@pt-br .

edo:SolubilityTableColumn a owl:Class ;
    rdfs:subClassOf edo:SolubilityCurveAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:SupportPoint a owl:Class ;
    dcterms:identifier "SupportPoint" ;
    rdfs:subClassOf edo:Feature ;
    skos:definition "Represents a point used to support, lift, or position elements within a project."@en,
        "Representa um ponto utilizado para apoiar, levantar ou posicionar elementos dentro de um projeto."@pt-br ;
    skos:prefLabel "Support Point"@en,
        "Ponto de Apoio"@pt-br .

edo:TableAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "TableAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a table or tabular dataset."@en,
        "Atributo que representa uma tabela ou conjunto de dados tabular."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Table attribute"@en,
        "Atributo de tabela"@pt-br .

edo:WeldedJoint a owl:Class ;
    dcterms:identifier "WeldedJoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:WeldedConnection ;
            owl:onProperty edo:connectsPoint ],
        [ a owl:Restriction ;
            owl:onClass edo:WeldedConnection ;
            owl:onProperty edo:connectsPoint ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        edo:PhysicalConnection ;
    skos:definition "Permanent physical connection formed by welding two welded fluid-port connection points."@en,
        "Conexão física permanente formada pela soldagem de dois pontos de conexão de porta de fluido do tipo soldado."@pt-br ;
    skos:prefLabel "Welded Joint"@en,
        "Junta Soldada"@pt-br .

edo:hasConnectionMechanism a owl:ObjectProperty ;
    rdfs:label "Has Connection Mechanism"@en,
        "Tem Mecanismo de Conexão"@pt-br ;
    dcterms:identifier "hasConnectionMechanism" ;
    rdfs:domain edo:PhysicalConnection ;
    rdfs:range edo:ConnectionMechanism ;
    rdfs:subPropertyOf edo:ConnectionRelation ;
    owl:inverseOf edo:isConnectionMechanismOf .

edo:hasMountingPoint a owl:ObjectProperty ;
    rdfs:label "Has Mounting Point"@en,
        "Tem Ponto de Montagem do Elemento"@pt-br ;
    dcterms:identifier "hasMountingPoint" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:MountingPoint ;
    rdfs:subPropertyOf edo:hasAttachmentPoint ;
    skos:definition "Associates an element being mounted with the mounting point used to position it relative to its host."@en,
        "Associa um elemento a ser montado ao ponto de montagem usado para posicioná-lo em relação ao elemento hospedeiro."@pt-br .

edo:Accessory a owl:Class ;
    dcterms:identifier "Accessory" ;
    rdfs:subClassOf edo:CompactObject ;
    skos:definition "Items of reasonable complexity but not very large, including things for temporary/occasional use"@en,
        "Itens de razoável complexidade mas porte não muito grande, incluindo coisas de uso temporário/ocasional"@pt-br ;
    skos:prefLabel "Acessory"@en,
        "Acessório"@pt-br .

edo:AttributeGroupAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "AttributeGroupAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute used as a grouping or organisational parent for related domain attributes, rather than as a direct scalar property value."@en,
        "Atributo usado como agrupador ou pai organizacional de atributos de domínio relacionados, e não como valor escalar direto de propriedade."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Attribute group attribute"@en,
        "Atributo de grupo de atributos"@pt-br .

edo:AuxiliaryModule a owl:Class ;
    dcterms:identifier "AuxiliaryModule" ;
    rdfs:subClassOf edo:SubseaEquipment ;
    skos:definition "Module with auxiliary functions installed as part of some larger subsea equipment"@en,
        "Módulo com funçõs auxiliares, instalado como parte de um equipamento submarino maior"@pt-br ;
    skos:prefLabel "Auxiliary module"@en,
        "Módulo auxiliar"@pt-br .

edo:CollarClampingSurface a owl:Class ;
    dcterms:identifier "CollarClampingSurface" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:PipeClampingSurface ;
            owl:onProperty edo:isInterfaceConnectedTo ],
        edo:ClampingSurface ;
    owl:disjointWith edo:PipeClampingSurface ;
    skos:definition "Clamping surface belonging to a collar and intended to bear against the host element."@en,
        "Superfície de aperto pertencente a um colar e destinada a apoiar-se contra o elemento hospedeiro."@pt-br ;
    skos:prefLabel "Collar Clamping Surface"@en,
        "Superfície de Aperto do Colar"@pt-br .

edo:CrushingMaximumAllowableTensionAttribute a owl:Class ;
    rdfs:subClassOf edo:CrushingCurveAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute .

edo:DomainValueConcept a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:identifier "DomainValueConcept" ;
    skos:definition "Concept scheme for controlled values and auxiliary classification concepts used by the EDO."@en,
        "Esquema de conceitos para valores controlados e conceitos auxiliares de classificação usados pela EDO."@pt-br ;
    skos:prefLabel "Domain value concepts"@en,
        "Conceitos de valor de domínio"@pt-br .

edo:DomainValueConcepts a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:ValueConcepts ;
    skos:prefLabel "Domain Value Concepts"@en,
        "Conceitos de Valor de Domínio"@pt-br .

edo:EarlyLeakMaxPressTableColumn a owl:Class ;
    rdfs:subClassOf edo:EarlyLeakMaxPressTableAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:EarlyLeakNomPressTableColumn a owl:Class ;
    rdfs:subClassOf edo:EarlyLeakNomPressTableAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:ElectricalContactSpecification a owl:Class ;
    dcterms:identifier "ElectricalContactSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ContactIdentifier ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ElectricalConnectorSpecification ;
            owl:onProperty edo:isElectricalContactSpecificationOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Specification ;
    skos:definition "Reusable specification of one contact position within an electrical connector specification. It defines contact-level mating or electrical criteria without representing a physical contact occurrence."@en,
        "Especificação reutilizável de uma posição de contato dentro de uma especificação de conector elétrico. Define critérios de acoplamento ou elétricos em nível de contato sem representar uma ocorrência física de contato."@pt-br ;
    skos:prefLabel "Electrical Contact Specification"@en,
        "Especificação de Contato Elétrico"@pt-br .

edo:FunctionLine a owl:Class ;
    dcterms:identifier "FunctionLine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:FunctionLineEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FunctionLineEnd ;
            owl:onProperty edo:hasEnd ],
        edo:UmbilicalComponent ;
    skos:definition "Represents a line within an umbilical component that carries a specific function, such as electrical, optical, or fluid transmission."@en,
        "Representa uma linha dentro de um componente umbilical que desempenha uma função específica, como transmissão elétrica, óptica ou de fluido."@pt-br ;
    skos:prefLabel "Function Line"@en,
        "Function line"@en,
        "Linha Funcional"@pt-br,
        "Linha de função"@pt-br .

edo:FunctionalRelation a owl:ObjectProperty ;
    rdfs:label "Functional Relation"@en,
        "Relação Funcional"@pt-br ;
    dcterms:identifier "FunctionalRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:definition "Category of relationships used to express functional links between domain entities without implying physical composition or spatial containment."@en,
        "Categoria de relacionamentos usada para expressar vínculos funcionais entre entidades do domínio sem implicar composição física ou contenção espacial."@pt-br .

edo:HubMatingConnection a owl:Class ;
    dcterms:identifier "HubMatingConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:Nb5f9c268db3145df9b0d2391c3a97fc2 ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    skos:prefLabel "Hub Mating Connection"@en,
        "Conexão de Acoplamento do Hub"@pt-br .

edo:InternalDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "InternalDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Distance measured across the innermost points, passing through the center."@en ;
    skos:prefLabel "Internal Diameter"@en,
        "Diâmetro interno"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute,
        edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign,
        edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:LinearObject a owl:Class ;
    dcterms:identifier "LinearObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:LinearEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        edo:Asset ;
    skos:definition "Base for any type of interconnecting element with linear geometry."@en,
        "Base para qualquer tipo de elemento de interconexão com geometria linear"@pt-br ;
    skos:prefLabel "Linear Object"@en,
        "Objeto Linear"@pt-br .

edo:Location a owl:Class ;
    dcterms:identifier "Location" ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "Basis for all model installation locations."@en,
        "Base para todos os locais de instalação neste modelo"@pt-br ;
    skos:prefLabel "Location"@en,
        "Localização"@pt-br .

edo:Marine a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Marine" ;
    skos:broader edo:Renewable ;
    skos:definition "Marine energy refers to renewable energy harnessed from the oceans and seas, including tidal flows, wave motion, ocean currents, thermal gradients and salinity differences. It represents a diverse set of technologies under development that aim to complement traditional renewable energy sources by exploiting the vast and predictable energy potential of the marine environment."@en,
        "Energia marinha refere-se à energia renovável aproveitada dos oceanos e mares, incluindo fluxos de marés, movimento das ondas, correntes oceânicas, gradientes térmicos e diferenças de salinidade. Representa um conjunto diversificado de tecnologias em desenvolvimento que visam complementar as fontes renováveis tradicionais ao explorar o vasto e previsível potencial energético do ambiente marinho."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Marine Energy"@en,
        "Energia Marinha"@pt-br .

edo:MountingPoint a owl:Class ;
    dcterms:identifier "MountingPoint" ;
    rdfs:subClassOf edo:AttachmentPoint ;
    skos:definition "Attachment point belonging to an element being mounted and intended to be geometrically matched with the corresponding installation point on its host."@en,
        "Ponto de montagem pertencente ao elemento que será montado e destinado a coincidir geometricamente com o ponto de instalação correspondente no elemento hospedeiro."@pt-br ;
    skos:prefLabel "Mounting Point"@en,
        "Ponto de Montagem do Elemento"@pt-br .

edo:Structure a owl:Class ;
    dcterms:identifier "Structure" ;
    rdfs:subClassOf edo:CompactObject ;
    skos:definition "Large but not very complex items for permanent use"@en,
        "Itens de grande porte mas não muito complexos, para uso permanente"@pt-br ;
    skos:prefLabel "Structure"@en,
        "Estrutura"@pt-br .

edo:TapeLayer a owl:Class ;
    dcterms:identifier "TapeLayer" ;
    rdfs:subClassOf edo:WoundLayer ;
    skos:definition "A layer within the structure of a subsea flexible pipe composed of tape-like materials. This layer is designed to provide additional reinforcement and protection. Typically made from high-strength polymers or other durable materials, the tape layer contributes to the pipe’s overall flexibility, structural integrity, and resistance to external environmental factors. Engineered for harsh underwater conditions, it helps maintain the performance and durability of the flexible pipe system."@en ;
    skos:prefLabel "Tape Layer"@en,
        "Camada de Fita"@pt-br .

edo:Tubing a owl:Class ;
    dcterms:identifier "Tubing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:TubingEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:TubingEnd ;
            owl:onProperty edo:hasEnd ],
        edo:FunctionLine ;
    skos:definition "Represents a fluid-carrying tube within a function line of an umbilical component."@en,
        "Representa um tubo condutor de fluido dentro de uma linha funcional de um componente umbilical."@pt-br ;
    skos:prefLabel "Tubing"@en,
        "Tubulação"@pt-br .

edo:WeldedConnection a owl:Class ;
    dcterms:identifier "WeldedConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:WeldedConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    skos:definition "Represents a fluid port connection achieved by welding, forming a permanent joint. It also defines the logical location within a model where fluid distribution components are joined, ensuring proper alignment and functionality during assembly and operation. This logical connection is essential for defining the interface between fluid distribution elements in subsea systems or other fluid handling applications."@en,
        "Representa uma conexão de porta de fluido realizada por soldagem, formando uma junta permanente. Também define a localização lógica em um modelo onde os componentes de distribuição de fluido são unidos, garantindo o alinhamento e a funcionalidade corretos durante a montagem e a operação. Essa conexão lógica é essencial para definir a interface entre elementos de distribuição de fluido em sistemas submarinos ou outros sistemas de manuseio de fluido."@pt-br ;
    skos:prefLabel "Welded Connection"@en,
        "Conexão Soldada"@pt-br .

edo:hasConnectionInterface a owl:ObjectProperty ;
    rdfs:label "Has Connection Interface"@en,
        "Tem Interface de Conexão"@pt-br ;
    dcterms:identifier "hasConnectionInterface" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:ConnectionInterface ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:isConnectionInterfaceOf ;
    skos:definition "Associates a domain element with a connection interface that belongs to it."@en,
        "Associa um elemento de domínio a uma interface de conexão que lhe pertence."@pt-br .

edo:hasReferenceDatum a owl:ObjectProperty ;
    rdfs:label "Has Reference Datum"@en,
        "Tem Datum de Referência"@pt-br ;
    dcterms:identifier "hasReferenceDatum" ;
    rdfs:domain edo:InstallationPoint ;
    rdfs:range edo:Feature ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    skos:definition "Associates an installation point with the feature selected as the datum from which its required longitudinal position is interpreted."@en,
        "Associa um ponto de instalação à feature escolhida como datum a partir da qual sua posição longitudinal requerida é interpretada."@pt-br .

edo:isConnectionInterfaceOf a owl:ObjectProperty ;
    rdfs:label "Is Connection Interface Of"@en,
        "É Interface de Conexão de"@pt-br ;
    dcterms:identifier "isConnectionInterfaceOf" ;
    rdfs:domain edo:ConnectionInterface ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:hasConnectionInterface .

edo:isInterfaceConnectedTo a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Is Interface Connected To"@en,
        "Interface Está Conectada A"@pt-br ;
    dcterms:identifier "isInterfaceConnectedTo" ;
    rdfs:domain edo:ConnectionInterface ;
    rdfs:range edo:ConnectionInterface ;
    rdfs:subPropertyOf edo:ConnectionRelation,
        edo:isInterfaceCompatibleWith ;
    skos:definition "Relates two connection interfaces that directly participate in the same physical or functional connection."@en,
        "Relaciona duas interfaces de conexão que participam diretamente da mesma conexão física ou funcional."@pt-br .

edo:ComponentDevice a owl:Class ;
    dcterms:identifier "ComponentDevice" ;
    rdfs:subClassOf edo:Component ;
    skos:definition "Complex devices incorporated as parts of larger equipment/systems"@en,
        "Dispositivos complexos incorporados como parte de equipamentos/sistemas maiores"@pt-br ;
    skos:prefLabel "Component Device"@en,
        "Dispositivo Componente"@pt-br .

edo:ConnectionRelation a owl:ObjectProperty ;
    rdfs:label "Connection Relation"@en,
        "Relação de Conexão"@pt-br ;
    dcterms:identifier "ConnectionRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:altLabel "Connectivity Relation"@en,
        "Relação de Conectividade"@pt-br ;
    skos:definition "Category of relationships used to express conceptual connectivity between domain entities."@en,
        "Categoria de relacionamentos usada para expressar conectividade conceitual entre entidades do domínio."@pt-br .

edo:ConstructionPhase a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ConstructionPhase" ;
    skos:broader edo:LifecyclePhase ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Construction Phase"@en,
        "Fase de Construção"@pt-br .

edo:ElectricalInterfaceSpecificationAttribute a owl:Class ;
    dcterms:identifier "ElectricalInterfaceSpecificationAttribute" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Attribute used to describe a mating-relevant characteristic of an electrical interface specification. The class groups specification criteria without making every criterion mandatory for every kind of electrical interface."@en,
        "Atributo usado para descrever uma característica relevante ao acoplamento de uma especificação de interface elétrica. A classe agrupa critérios de especificação sem tornar todos os critérios obrigatórios para todo tipo de interface elétrica."@pt-br ;
    skos:prefLabel "Electrical Interface Specification Attribute"@en,
        "Atributo de Especificação de Interface Elétrica"@pt-br .

edo:EndFittingCrimpedConnection a owl:Class ;
    dcterms:identifier "EndFittingCrimpedConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:FlexiblePipeCrimpedConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:CrimpedConnection ;
    skos:prefLabel "End Fitting Crimped Connection"@en,
        "Conexão Crimpada do End Fitting"@pt-br .

edo:FlowControlModule a owl:Class ;
    dcterms:identifier "FlowControlModule" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    skos:definition "Module with pressure containment or flow control functions, installed as part of some larger unit or equipment"@en,
        "Módulo com funções de contenção de pressão ou controle de fluxo, instalado como parte de uma unidade ou equipamento maior"@pt-br ;
    skos:prefLabel "Flow control module"@en,
        "Módulo de controle de fluxo"@pt-br .

edo:LayingMinimumRadiusTableColumn a owl:Class ;
    rdfs:subClassOf edo:LayingMinimumRadiusCurveAttribute ;
    edo:attributeOntologicalNature edo:TableColumnAttribute .

edo:LocationAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "LocationAttribute" ;
    skos:broader edo:AttributeNatures ;
    skos:definition "Attribute nature related to physical, spatial or installation location."@en,
        "Natureza de atributo relacionada a localização física, espacial ou de instalação."@pt-br ;
    skos:inScheme edo:DomainAttributeNature ;
    skos:prefLabel "Location attribute"@en,
        "Atributo de localização"@pt-br .

edo:MaxPressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "MaxPressure" ;
    rdfs:subClassOf edo:Pressure ;
    skos:definition "Generic maximum pressure capability attribute. Use a lifecycle-specific specialization when the value represents a requirement, design value or certified value."@en,
        "Atributo genérico de capacidade máxima de pressão. Usar uma especialização de ciclo de vida quando o valor representar requisito, valor de projeto ou valor certificado."@pt-br ;
    skos:prefLabel "Maximum Pressure"@en,
        "Pressão máxima"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:specializesAttribute edo:Pressure .

edo:MaxTension a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "MaxTension" ;
    rdfs:subClassOf edo:Tension ;
    skos:definition "Maximum tensile force associated with a component or system."@en,
        "Força máxima de tração associada a um componente ou sistema."@pt-br ;
    skos:prefLabel "Max Tension"@en,
        "Tração máxima"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:specializesAttribute edo:Tension .

edo:MaxWaterDepth a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "MaxWaterDepth" ;
    rdfs:subClassOf edo:WaterDepth ;
    skos:definition "Generic maximum water depth capability attribute. Use a lifecycle-specific specialization when the value represents a requirement, design value or certified value."@en,
        "Atributo genérico de capacidade máxima de profundidade d'água. Usar uma especialização de ciclo de vida quando o valor representar requisito, valor de projeto ou valor certificado."@pt-br ;
    skos:prefLabel "Maximum Water Depth"@en,
        "Profundidade d'água máxima"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:specializesAttribute edo:WaterDepth .

edo:OpticalFiberCableEnd a owl:Class ;
    dcterms:identifier "OpticalFiberCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalPort ;
            owl:onProperty edo:hasEndInterface ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:DataPort ;
            owl:onProperty edo:hasEndInterface ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalFiberCable ;
            owl:onProperty edo:isEndOf ],
        edo:FunctionLineEnd ;
    skos:definition "Terminal end of an umbilical optical-fibre cable, exposing data or optical-signal connection interfaces."@en,
        "Extremidade terminal de um cabo de fibra óptica de um umbilical, apresentando interfaces de conexão de dados ou sinal óptico."@pt-br ;
    skos:prefLabel "Optical Fiber Cable End"@en,
        "Extremidade de Cabo de Fibra Óptica"@pt-br .

edo:SplitCollar a owl:Class ;
    dcterms:identifier "SplitCollar" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:CollarClampingSurface ;
            owl:onProperty edo:hasConnectionInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:LineAncillary ;
    skos:definition "A component used to encircle and secure parts of subsea systems, such as flexible pipes, risers, or accessories. The Split Collar is designed with a split or gap, allowing it to be clamped around the pipe or component and then fastened together. This design facilitates easy installation and removal, making it useful for applications where adjustments or maintenance are required. The Split Collar provides structural support, alignment, and stability, ensuring that the connected components remain securely in place."@en ;
    skos:prefLabel "Split Collar"@en,
        "Colar Bipartido"@pt-br .

edo:SubseaEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Subsea Engineering"@en,
        "Engenharia Submarina"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on underwater systems and equipment for offshore operations."@en,
        "Disciplina de engenharia focada em sistemas e equipamentos subaquáticos para operações offshore."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:SubseaEquipment a owl:Class ;
    dcterms:identifier "SubseaEquipment" ;
    rdfs:subClassOf edo:Equipment ;
    skos:definition "Complex equipment for subsea use"@en,
        "Equipamentos complexos para uso submarino"@pt-br ;
    skos:prefLabel "Subsea Equipment"@en,
        "Equipamento Submarino"@pt-br .

edo:Tension a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Tension" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for tensile force values. Specialized attributes must be used when the value represents a requirement, design value, certified value, operating condition or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de força de tração. Atributos especializados devem ser usados quando o valor representar requisito, valor de projeto, valor certificado, condição operacional ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Tension"@en,
        "Tração"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N ;
    edo:hasValueCardinality edo:SingleValue .

edo:WaterDepth a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "WaterDepth" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for water depth values. Specialized attributes must be used when the value represents a requirement, design capacity, certified capacity, installed location or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de profundidade d'água. Atributos especializados devem ser usados quando o valor representar requisito, capacidade de projeto, capacidade certificada, localização instalada ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Water Depth"@en,
        "Profundidade d'água"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue .

edo:AttributeCategories a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Categories"@en,
        "Categorias de Atributo"@pt-br .

edo:AttributeNatures a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Natures"@en,
        "Naturezas de Atributo"@pt-br .

edo:AttributeRoles a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Roles"@en,
        "Papéis de Atributo"@pt-br .

edo:DomainAttributeNature a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Domain attribute nature"@en,
        "Natureza de atributo de domínio"@pt-br ;
    dcterms:identifier "DomainAttributeNature" ;
    skos:definition "Controlled vocabulary for conceptual natures of domain attributes."@en,
        "Vocabulário controlado para naturezas conceituais de atributos de domínio."@pt-br .

edo:DomainAttributeRole a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Domain attribute role"@en,
        "Papel de atributo de domínio"@pt-br ;
    dcterms:identifier "DomainAttributeRole" ;
    skos:definition "Controlled vocabulary for semantic lifecycle roles played by domain attributes."@en,
        "Vocabulário controlado para papéis semânticos de ciclo de vida desempenhados por atributos de domínio."@pt-br .

edo:ElectricalCableEnd a owl:Class ;
    dcterms:identifier "ElectricalCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalCable ;
            owl:onProperty edo:isEndOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricPort ;
            owl:onProperty edo:hasEndInterface ],
        edo:FunctionLineEnd ;
    owl:disjointWith edo:OpticalFiberCableEnd ;
    skos:definition "Terminal end of an umbilical electrical cable, exposing electrical connection interfaces for power, signal or other electrical functions represented by the cable."@en,
        "Extremidade terminal de um cabo elétrico de um umbilical, apresentando interfaces de conexão elétrica para potência, sinal ou outras funções elétricas representadas pelo cabo."@pt-br ;
    skos:prefLabel "Electrical Cable End"@en,
        "Extremidade de Cabo Elétrico"@pt-br .

edo:FlexiblePipeCrimpedConnection a owl:Class ;
    dcterms:identifier "FlexiblePipeCrimpedConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:EndFittingCrimpedConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:CrimpedConnection ;
    owl:disjointWith edo:EndFittingCrimpedConnection ;
    skos:prefLabel "Flexible Pipe Crimped Connection"@en,
        "Conexão Crimpada do Duto Flexível"@pt-br .

edo:MaximumTemperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "MaximumTemperature" ;
    rdfs:subClassOf edo:Temperature ;
    skos:definition "Generic maximum temperature attribute. Use a lifecycle-specific specialization when the value represents a requirement, design value or certified value."@en,
        "Atributo genérico de temperatura máxima. Usar uma especialização de ciclo de vida quando o valor representar requisito, valor de projeto ou valor certificado."@pt-br ;
    skos:prefLabel "Maximum Temperature"@en,
        "Temperatura máxima"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:EnvironmentalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:DEG_C ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:specializesAttribute edo:Temperature .

edo:MinimumTemperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "MinimumTemperature" ;
    rdfs:subClassOf edo:Temperature ;
    skos:definition "Generic minimum temperature attribute. Use a lifecycle-specific specialization when the value represents a requirement, design value or certified value."@en,
        "Atributo genérico de temperatura mínima. Usar uma especialização de ciclo de vida quando o valor representar requisito, valor de projeto ou valor certificado."@pt-br ;
    skos:prefLabel "Minimum Temperature"@en,
        "Temperatura mínima"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:EnvironmentalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:DEG_C ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:specializesAttribute edo:Temperature .

edo:PresenceIndicatorAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PresenceIndicatorAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that indicates whether a feature, component, option or condition is present or applicable."@en,
        "Atributo que indica se uma feature, componente, opção ou condição está presente ou é aplicável."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Presence indicator attribute"@en,
        "Atributo indicador de presença"@pt-br .

edo:Renewable a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Renewable Energy"@en,
        "Energia Renovável"@pt-br ;
    skos:broader edo:Domain ;
    skos:definition "Industrial domain covering energy sources that are naturally replenished, such as solar, wind, and hydropower."@en,
        "Domínio industrial que abrange fontes de energia que são naturalmente reabastecidas, como solar, eólica e hidrelétrica."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:RingGasketAttribute a owl:Class ;
    rdfs:label "Ring Gasket"@en ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:AttributeGroupAttribute .

edo:RunningTool a owl:Class ;
    dcterms:identifier "RunningTool" ;
    rdfs:subClassOf edo:ActuatedEquipment ;
    skos:definition "Major tools for installation or retrieval of equipment in the subsea environment"@en,
        "Ferramenta de grande porte para instalação ou recuperação de equipamentos no ambiente submarino"@pt-br ;
    skos:prefLabel "Subsea running tool"@en,
        "Ferramenta submarina de instalação"@pt-br .

edo:SolidLayer a owl:Class ;
    dcterms:identifier "SolidLayer" ;
    rdfs:subClassOf edo:FlexibleStructureLayer ;
    skos:definition "Continuous layer used in subsea flexible pipes or similar structures, typically fabricated through extrusion. It provides structural reinforcement, pressure containment, or environmental protection, ensuring the integrity and performance of the pipe by offering consistent support or shielding."@en,
        "Camada maciça formada por extrusão contínua de um material"@pt-br ;
    skos:prefLabel "Solid Layer"@en,
        "Camada Sólida"@pt-br .

edo:VocabularyConcepts a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:definition "Root concept for EDO controlled vocabulary concepts."@en ;
    skos:prefLabel "Vocabulary Concepts."@en,
        "Conceitos de Vocabulário"@pt-br .

edo:isTerminatedBy a owl:ObjectProperty ;
    rdfs:label "Is Terminated By"@en,
        "É Terminada Por"@pt-br ;
    dcterms:identifier "isTerminatedBy" ;
    rdfs:domain edo:LinearEnd ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:FunctionalRelation ;
    owl:inverseOf edo:terminatesEnd ;
    skos:definition "Relates a terminal end to a domain element that performs or realizes the termination of that end in a particular assembly or installation context."@en,
        "Relaciona uma extremidade terminal a um elemento de domínio que desempenha ou realiza a terminação dessa extremidade em um determinado contexto de montagem ou instalação."@pt-br .

edo:AsBuiltRole a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "AsBuiltRole" ;
    skos:broader edo:AttributeRoles ;
    skos:definition "Role of an attribute that expresses a documented as-built value."@en,
        "Papel de um atributo que expressa um valor as-built documentado."@pt-br ;
    skos:inScheme edo:DomainAttributeRole ;
    skos:prefLabel "As-built role"@en,
        "Papel as-built"@pt-br .

edo:AttributeConcepts a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:VocabularyConcepts ;
    skos:prefLabel "Attribute Concepts"@en,
        "Conceitos de Atributo"@pt-br .

edo:DesignLife a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DesignLife" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for the intended service life of a component or system. Specialized attributes must be used when the value represents a requirement, certified value, remaining life or fatigue-specific meaning."@en,
        "Atributo genérico para a vida útil pretendida de um componente ou sistema. Atributos especializados devem ser usados quando o valor representar requisito, valor certificado, vida remanescente ou significado específico de fadiga."@pt-br ;
    skos:prefLabel "Design Life"@en,
        "Vida útil de projeto"@pt-br ;
    edo:attributeNature edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:YR ;
    edo:hasValueCardinality edo:SingleValue .

edo:Domain a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Industrial Domain"@en,
        "Domínio Industrial"@pt-br ;
    rdfs:comment "Represents a high-level industrial domain, such as Oil & Gas, Nuclear, or Renewable Energy."@en ;
    skos:broader edo:EnergyDomains ;
    skos:definition "A high-level industrial sector or application area."@en,
        "Um setor industrial ou área de aplicação de alto nível."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:topConceptOf edo:IndustrialDomainScheme .

edo:DomainClassificationAnnotation a owl:AnnotationProperty ;
    rdfs:label "Classification Annotation"@en,
        "Anotação de Classificação"@pt-br ;
    dcterms:identifier "DomainClassificationAnnotation" ;
    rdfs:subPropertyOf edo:DomainMetamodelAnnotation ;
    skos:definition "Category of annotations used to classify ontology elements according to domain-specific taxonomies such as discipline, domain and attribute categories."@en,
        "Categoria de anotações usadas para classificar elementos da ontologia de acordo com taxonomias específicas do domínio, como disciplina, domínio e categorias de atributos."@pt-br .

edo:ElectricalContact a owl:Class ;
    dcterms:identifier "ElectricalContact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ElectricalContactSpecification ;
            owl:onProperty edo:isDefinedByElectricalContactSpecification ],
        [ a owl:Restriction ;
            owl:onClass edo:ElectricPort ;
            owl:onProperty edo:isElectricalContactOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ContactIdentifier ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Feature ;
    skos:definition "Detailed electrical contact feature belonging to one electric port and representing one electrically distinguishable contact position or conductive path within that aggregate mating interface. Connector mating remains represented by the owning electric port."@en,
        "Feature detalhada de contato elétrico pertencente a uma porta elétrica e representando uma posição de contato ou caminho condutivo eletricamente distinguível dentro dessa interface agregada de acoplamento. O acoplamento do conector permanece representado pela porta elétrica proprietária."@pt-br ;
    skos:prefLabel "Electrical Contact"@en,
        "Contato Elétrico"@pt-br .

edo:FatigueLife a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "FatigueLife" ;
    rdfs:subClassOf edo:DesignLife ;
    skos:definition "Service life associated with fatigue behaviour under cyclic loading or other fatigue-relevant conditions."@en,
        "Vida útil associada ao comportamento em fadiga sob carregamento cíclico ou outras condições relevantes de fadiga."@pt-br ;
    skos:prefLabel "Fatigue Life"@en,
        "Vida à fadiga"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:YR ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:DesignLife .

edo:LayerGeometryAttribute a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:AttributeGroupAttribute .

edo:MinimumBendingRadius a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "MinimumBendingRadius" ;
    rdfs:subClassOf edo:BendingRadius ;
    skos:definition "Generic minimum bending radius limit associated with a component or system."@en,
        "Limite genérico de raio mínimo de curvatura associado a um componente ou sistema."@pt-br ;
    skos:prefLabel "Minimum Bending Radius"@en,
        "Raio mínimo de curvatura"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:DimensionalAttribute,
        edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:specializesAttribute edo:BendingRadius .

edo:Pressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Pressure" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for pressure values. Specialized attributes must be used when the value represents a requirement, design capacity, certified capacity, operating condition or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de pressão. Atributos especializados devem ser usados quando o valor representar requisito, capacidade de projeto, capacidade certificada, condição operacional ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Pressure"@en,
        "Pressão"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue .

edo:UmbilicalEnd a owl:Class ;
    dcterms:identifier "UmbilicalEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ConnectionInterface ;
            owl:onProperty edo:exposesServiceInterface ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:UmbilicalSegment ;
            owl:onProperty edo:isEndOf ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:FunctionLineEnd ;
            owl:onProperty edo:hasConstituentEnd ],
        edo:LinearEnd ;
    owl:disjointWith edo:FunctionLineEnd ;
    skos:definition "One of the two terminal regions of an umbilical segment, aggregating the terminal ends and connection interfaces of the functional lines that run through the umbilical."@en,
        "Uma das duas regiões terminais de um tramo de umbilical, agregando as extremidades terminais e interfaces de conexão das linhas funcionais que percorrem o umbilical."@pt-br ;
    skos:prefLabel "Umbilical End"@en,
        "Extremidade do Umbilical"@pt-br .

edo:connectsPoint a owl:ObjectProperty ;
    rdfs:label "Connects Point"@en,
        "Conecta Ponto"@pt-br ;
    dcterms:identifier "connectsPoint" ;
    rdfs:domain edo:PhysicalConnection ;
    rdfs:range edo:ConnectionPoint ;
    rdfs:subPropertyOf edo:connectsInterface ;
    owl:inverseOf edo:connectionRealizedBy .

edo:ConnectionInterfaceSpecification a owl:Class ;
    dcterms:identifier "ConnectionInterfaceSpecification" ;
    rdfs:subClassOf edo:Specification ;
    skos:definition "Technical specification that consolidates the mating-relevant requirements and criteria of a connection interface, such as geometry, rating, service, contact arrangement or governing standard, so that compatibility can be evaluated without encoding every combination as an interface subclass."@en,
        "Especificação técnica que consolida os requisitos e critérios relevantes ao acoplamento de uma interface de conexão, como geometria, classe, serviço, arranjo de contatos ou norma aplicável, permitindo avaliar compatibilidade sem codificar cada combinação como uma subclasse de interface."@pt-br ;
    skos:prefLabel "Connection Interface Specification"@en,
        "Especificação de Interface de Conexão"@pt-br .

edo:CrushingFrictionCoefficientTighteningAttribute a owl:Class ;
    rdfs:subClassOf edo:CrushingCurveAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute .

edo:CrushingMaximumAllowableTighteningAttribute a owl:Class ;
    rdfs:subClassOf edo:CrushingCurveAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute .

edo:DomainAttributeStructureAnnotation a owl:AnnotationProperty ;
    rdfs:label "Attribute Structure Annotation"@en,
        "Anotação de Estrutura de Atributo"@pt-br ;
    dcterms:identifier "DomainAttributeStructureAnnotation" ;
    rdfs:subPropertyOf edo:DomainMetamodelAnnotation ;
    skos:definition "Category of annotations that describe how attributes are structured and organised within the ontology."@en,
        "Categoria de anotações que descrevem como atributos são estruturados e organizados dentro da ontologia."@pt-br .

edo:DomainMetamodelAnnotation a owl:AnnotationProperty ;
    rdfs:label "Domain Metamodel Annotation"@en,
        "Anotação de Metamodelo de Domínio"@pt-br ;
    dcterms:identifier "DomainMetamodelAnnotation" ;
    skos:definition "Category of annotations that describe how Energy Domain Ontology metamodel elements are structured, classified, governed or validated."@en,
        "Categoria de anotações que descrevem como elementos do metamodelo da Energy Domain Ontology são estruturados, classificados, governados ou validados."@pt-br .

edo:FunctionLineEnd a owl:Class ;
    dcterms:identifier "FunctionLineEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:DomainElement ;
            owl:onProperty edo:isTerminatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FunctionLine ;
            owl:onProperty edo:isEndOf ],
        [ a owl:Restriction ;
            owl:onClass edo:UmbilicalEnd ;
            owl:onProperty edo:isConstituentEndOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:UmbilicalEnd ;
            owl:onProperty edo:isConstituentEndOf ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ConnectionInterface ;
            owl:onProperty edo:hasEndInterface ],
        edo:LinearEnd ;
    skos:definition "Terminal feature of a functional line within an umbilical, exposing one or more connection interfaces appropriate to the function carried by that line."@en,
        "Feature terminal de uma linha funcional dentro de um umbilical, apresentando uma ou mais interfaces de conexão apropriadas à função transportada por essa linha."@pt-br ;
    skos:prefLabel "Function Line End"@en,
        "Extremidade da Linha Funcional"@pt-br .

edo:InformationArtifact a owl:Class ;
    dcterms:identifier "InformationArtifact" ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "A domain element of informational nature that records, defines, specifies, references, or organises information about domain elements, activities, or contexts."@en,
        "Elemento de domínio de natureza informacional que registra, define, especifica, referencia ou organiza informação sobre elementos, atividades ou contextos do domínio."@pt-br ;
    skos:prefLabel "Information Artifact"@en,
        "Artefato Informacional"@pt-br .

edo:OperationalAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OperationalAttribute" ;
    skos:broader edo:AttributeNatures ;
    skos:definition "Attribute nature related to operation, use or service conditions."@en,
        "Natureza de atributo relacionada a operação, uso ou condições de serviço."@pt-br ;
    skos:inScheme edo:DomainAttributeNature ;
    skos:prefLabel "Operational attribute"@en,
        "Atributo operacional"@pt-br .

edo:ProvenanceAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ProvenanceAttribute" ;
    skos:broader edo:AdministrativeAttribute ;
    skos:definition "Administrative attribute category related to authorship, creator identity, timestamp or provenance metadata."@en,
        "Attribute that records provenance, authorship, creation, revision or traceability metadata."@en,
        "Atributo que registra metadados de proveniência, autoria, criação, revisão ou rastreabilidade."@pt-br,
        "Categoria de atributo administrativo relacionada a autoria, identidade do criador, registro temporal ou metadados de proveniência."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory,
        edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Provenance attribute"@en,
        "Atributo de proveniência"@pt-br .

edo:Specification a owl:Class ;
    rdfs:subClassOf edo:TechnicalArtifact ;
    skos:definition "Technical artifact that specifies requirements, limits, parameters, standards or compatibility criteria applicable to domain elements."@en,
        "Artefato técnico que especifica requisitos, limites, parâmetros, normas ou critérios de compatibilidade aplicáveis a elementos de domínio."@pt-br ;
    skos:prefLabel "Specification"@en,
        "Especificação"@pt-br .

edo:connectsInterface a owl:ObjectProperty ;
    rdfs:label "Connects Interface"@en,
        "Conecta Interface"@pt-br ;
    dcterms:identifier "connectsInterface" ;
    rdfs:domain edo:PhysicalConnection ;
    rdfs:range edo:ConnectionInterface ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:interfaceRealizedBy ;
    skos:definition "Associates a physical connection with each connection interface that it physically joins."@en,
        "Associa uma conexão física a cada interface de conexão que ela une fisicamente."@pt-br .

edo:isEndOf a owl:ObjectProperty ;
    rdfs:label "Is End Of"@en,
        "É Extremidade de"@pt-br ;
    dcterms:identifier "isEndOf" ;
    rdfs:domain edo:LinearEnd ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:hasEnd ;
    skos:definition "Associates a linear end with the domain element to which that end belongs."@en,
        "Associa uma extremidade linear ao elemento de domínio ao qual ela pertence."@pt-br .

edo:BurstPressure a owl:Class ;
    dcterms:identifier "BurstPressure" ;
    rdfs:subClassOf edo:Pressure ;
    skos:definition "Pressure associated with the internal pressure limit at which an element, component, or system may rupture."@en ;
    skos:prefLabel "Burst Pressure"@en,
        "Pressão de Ruptura"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue .

edo:CollapsePressure a owl:Class ;
    dcterms:identifier "CollapsePressure" ;
    rdfs:subClassOf edo:Pressure ;
    skos:definition "Pressure associated with the external pressure limit at which an element, component, or system may collapse."@en ;
    skos:prefLabel "Collapse Pressure"@en,
        "Pressão de Colapso"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue .

edo:ConditionAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ConditionAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a state, condition, service condition or applicability condition."@en,
        "Atributo que representa um estado, condição, condição de serviço ou condição de aplicabilidade."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Condition attribute"@en,
        "Atributo de condição"@pt-br .

edo:CurveAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "CurveAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a curve or curve-like dataset rather than a single scalar value."@en,
        "Atributo que representa uma curva ou conjunto de dados similar a curva, e não um valor escalar único."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Curve attribute"@en,
        "Atributo de curva"@pt-br .

edo:DocumentReferenceAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "DocumentReferenceAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that records or points to a document, drawing, specification or other technical artefact."@en,
        "Atributo que registra ou aponta para um documento, desenho, especificação ou outro artefato técnico."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Document reference attribute"@en,
        "Atributo de referência documental"@pt-br .

edo:DomainApplicabilityAnnotation a owl:AnnotationProperty ;
    rdfs:label "Domain Applicability Annotation"@en,
        "Anotação de Aplicabilidade de Domínio"@pt-br ;
    dcterms:identifier "DomainApplicabilityAnnotation" ;
    rdfs:subPropertyOf edo:DomainMetamodelAnnotation ;
    skos:definition "Category of annotations that qualify when a relation, attribute, value or rule applies in the domain context."@en,
        "Categoria de anotações que qualificam quando uma relação, atributo, valor ou regra se aplica no contexto do domínio."@pt-br .

edo:DomainAttributeCategory a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:identifier "DomainAttributeCategory" ;
    skos:definition "Controlled vocabulary for internal EDO categories used to classify domain attributes by informational or administrative purpose."@en,
        "Vocabulário controlado para categorias internas da EDO usadas para classificar atributos de domínio por finalidade informacional ou administrativa."@pt-br ;
    skos:prefLabel "Domain attribute category"@en,
        "Categoria de atributo de domínio"@pt-br .

edo:Feature a owl:Class ;
    dcterms:identifier "Feature" ;
    rdfs:subClassOf edo:DomainElement ;
    skos:definition "Domain element that represents a dependent feature, interface, point or region of another element, used to support connection, attachment, reference, positioning or interaction."@en,
        "Elemento de domínio que representa uma feature, interface, ponto ou região dependente de outro elemento, usada para apoiar conexão, anexação, referência, posicionamento ou interação."@pt-br ;
    skos:prefLabel "Feature"@en,
        "Feature"@pt-br .

edo:FlangeConnection a owl:Class ;
    dcterms:identifier "FlangeConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:FlangeInterfaceSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FlangeConnection ;
            owl:onProperty edo:isConnectedTo ],
        edo:FluidPort ;
    owl:disjointWith edo:WeldedConnection ;
    skos:definition "Represents a logical fluid port connection defined by a flange interface. It indicates the precise logical location within a model where fluid distribution components are connected, ensuring correct alignment and functionality of the system during assembly and installation. This connection type defines the interface between fluid distribution elements in subsea or other fluid-handling systems."@en,
        "Representa uma conexão lógica de porta de fluido definida por uma interface flangeada. Indica a localização lógica precisa em um modelo onde os componentes de distribuição de fluido são conectados, garantindo o alinhamento e a funcionalidade corretos do sistema durante a montagem e a instalação. Esse tipo de conexão define a interface entre os elementos de distribuição de fluido em sistemas submarinos ou outros sistemas de manuseio de fluido."@pt-br ;
    skos:prefLabel "Flange Connection"@en,
        "Conexão Flangeada"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:FlowControlEquipment a owl:Class ;
    dcterms:identifier "FlowControlEquipment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:HasThermalInsulation ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:NumberOfRemoteProcessIsolationValves ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:NumberOfChokeValves ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:Piggable ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PressureEquipment ;
    skos:definition "Permament-use equipment with process fluid control functions"@en,
        "Equipamentos de uso permanente com funções de controle de fluidos de processo"@pt-br ;
    skos:prefLabel "Flow control equipment"@en,
        "Equipamento de controle de fluxo"@pt-br .

edo:OperatingRole a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OperatingRole" ;
    skos:broader edo:AttributeRoles ;
    skos:definition "Role of an attribute that expresses an operating value or condition."@en,
        "Papel de um atributo que expressa um valor ou condição operacional."@pt-br ;
    skos:inScheme edo:DomainAttributeRole ;
    skos:prefLabel "Operating role"@en,
        "Papel operacional"@pt-br .

edo:Weight a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Weight" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Force exerted by gravity on an object."@en,
        "Força exercida pela gravidade sobre um objeto."@pt-br ;
    skos:prefLabel "Weight"@en,
        "Peso"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole .

edo:BendingStiffnessCurveAttribute a owl:Class ;
    rdfs:label "Bending Stiffness Attribute"@en ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:CurveAttribute .

edo:DomainRelation a owl:ObjectProperty ;
    rdfs:label "Domain Relation"@en,
        "Relacionamento de Domínio"@pt-br ;
    dcterms:identifier "DomainRelation" ;
    skos:definition "Root object property for representing conceptual relationships between domain entities in the Energy Domain Ontology."@en,
        "Propriedade de objeto raiz para representar relacionamentos conceituais entre entidades do domínio na Energy Domain Ontology."@pt-br .

edo:LineAncillary a owl:Class ;
    dcterms:identifier "LineAncillary" ;
    rdfs:subClassOf edo:Component ;
    skos:definition "A component designed to complement and enhance the functionality of subsea flexible pipes. Line Ancillaries include a variety of parts such as connectors, clamps, or collars that facilitate the installation, operation, and maintenance of flexible pipes used in subsea systems. These ancillaries ensure proper alignment, secure connections, and protection against environmental factors, contributing to the reliable performance and integrity of the flexible pipe system in harsh underwater conditions."@en ;
    skos:prefLabel "Line Ancillary"@en,
        "Acessório de Linha"@pt-br .

edo:TechnicalDefinitionRelation a owl:ObjectProperty ;
    rdfs:label "Technical Definition Relation"@en,
        "Relação de Definição Técnica"@pt-br ;
    dcterms:identifier "TechnicalDefinitionRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:definition "Category of relationships used to associate domain entities with specifications, types or technical artefacts that define their configuration or compatibility."@en,
        "Categoria de relacionamentos usada para associar entidades do domínio a especificações, tipos ou artefatos técnicos que definem sua configuração ou compatibilidade."@pt-br .

edo:hasInterfaceSpecification a owl:ObjectProperty ;
    rdfs:label "Has Interface Specification"@en,
        "Tem Especificação de Interface"@pt-br ;
    dcterms:identifier "hasInterfaceSpecification" ;
    rdfs:domain edo:ConnectionInterface ;
    rdfs:range edo:ConnectionInterfaceSpecification ;
    rdfs:subPropertyOf edo:hasSpec ;
    owl:inverseOf edo:isInterfaceSpecificationOf ;
    skos:definition "Associates a connection interface with its consolidated mating specification. The specification is reusable and is not a physical part of the interface."@en,
        "Associa uma interface de conexão à sua especificação consolidada de acoplamento. A especificação é reutilizável e não constitui uma parte física da interface."@pt-br .

edo:CommissioningEngineering a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "CommissioningEngineering" ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Technical discipline concerned with planning, coordinating, verifying, documenting and demonstrating that systems and assets are ready to be placed into service and handed over for operation."@en,
        "Disciplina técnica dedicada ao planejamento, coordenação, verificação, documentação e demonstração de que sistemas e ativos estão aptos a entrar em serviço e ser entregues à operação."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme ;
    skos:prefLabel "Commissioning Engineering"@en,
        "Engenharia de Comissionamento"@pt-br .

edo:DomainValueType a owl:NamedIndividual,
        skos:ConceptScheme ;
    skos:definition "Controlled vocabulary for the expected value type of domain attributes, including numeric, textual, boolean, temporal, URI and binary values."@en,
        "Vocabulário controlado para o tipo de valor esperado de atributos de domínio, incluindo valores numéricos, textuais, booleanos, temporais, URI e binários."@pt-br ;
    skos:prefLabel "Domain value type"@en,
        "Tipo de valor de domínio"@pt-br .

edo:DomainValueTypes a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:ValueConcepts ;
    skos:prefLabel "Domain Value Types"@en,
        "Tipos de Valor de Domínio"@pt-br .

edo:EnvironmentalAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "EnvironmentalAttribute" ;
    skos:broader edo:AttributeNatures ;
    skos:definition "Attribute nature related to environmental conditions or exposure."@en,
        "Natureza de atributo relacionada a condições ambientais ou exposição."@pt-br ;
    skos:inScheme edo:DomainAttributeNature ;
    skos:prefLabel "Environmental attribute"@en,
        "Atributo ambiental"@pt-br .

edo:IdentifierAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "IdentifierAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that identifies, names, codes or references a domain element, artefact, material, project or document."@en,
        "Atributo que identifica, nomeia, codifica ou referencia um elemento de domínio, artefato, material, projeto ou documento."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Identifier attribute"@en,
        "Atributo identificador"@pt-br .

edo:Length a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Length" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for linear length values. Specialized attributes must be used when the value represents a requirement, design value, certified value, as-built condition, installed condition or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de comprimento linear. Atributos especializados devem ser usados quando o valor representar requisito, valor de projeto, valor certificado, condição as-built, condição instalada ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Length"@en,
        "Comprimento"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue .

edo:PhysicalConnection a owl:Class ;
    dcterms:identifier "PhysicalConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ConnectionInterface ;
            owl:onProperty edo:connectsInterface ],
        edo:PartElement ;
    skos:definition "A Physical Connection refers to the actual link or interface between two or more components, such as pipes, equipment, or systems, that allows for the transfer of fluids, energy, or data."@en,
        "Representa uma conexão entre dois ativos físicos"@pt-br ;
    skos:prefLabel "Physical Connection"@en,
        "Conexão Física"@pt-br .

edo:PressureComponent a owl:Class ;
    dcterms:identifier "PressureComponent" ;
    rdfs:subClassOf edo:ComponentDevice ;
    skos:prefLabel "Pressure-containing component"@en,
        "Component de contenção de pressão"@pt-br .

edo:Temperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Temperature" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for temperature values. Specialized attributes must be used when the value represents a requirement, design limit, certified limit, operating condition or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de temperatura. Atributos especializados devem ser usados quando o valor representar requisito, limite de projeto, limite certificado, condição operacional ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Temperature"@en,
        "Temperatura"@pt-br ;
    edo:attributeNature edo:EnvironmentalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:DEG_C ;
    edo:hasValueCardinality edo:SingleValue .

edo:Volume a owl:Class ;
    dcterms:identifier "Volume" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Amount of three-dimensional space occupied, enclosed, or displaced by an element, component, material, or system."@en ;
    skos:prefLabel "Volume"@en,
        "Volume"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue .

edo:WetChristmasTreesEngineering a owl:NamedIndividual,
        skos:Concept ;
    skos:broader edo:SubseaEngineering ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:BooleanValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Boolean Value"@en ;
    rdfs:comment "Expected XSD datatype for boolean values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:boolean .

edo:ElectricPort a owl:Class ;
    dcterms:identifier "ElectricPort" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalInterfaceSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        edo:Port ;
    skos:definition "Represents a port used for transmitting electrical power or signals between elements."@en,
        "Representa uma porta usada para transmitir energia elétrica ou sinais entre elementos."@pt-br ;
    skos:prefLabel "Electric Port"@en,
        "Porta Elétrica"@pt-br .

edo:InternalVolume a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "InternalVolume" ;
    rdfs:subClassOf edo:Volume ;
    skos:definition "Volume of internal space available to be occupied by a fluid, material, or free volume region."@en ;
    skos:prefLabel "Internal Volume"@en,
        "Volume interno"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:OperationalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Volume .

edo:Mass a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Mass" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Amount of matter that makes up an object."@en,
        "Quantidade de matéria que compõe um objeto."@pt-br ;
    skos:prefLabel "Mass"@en,
        "Massa"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:KiloGM ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole .

edo:ConnectionPoint a owl:Class ;
    dcterms:identifier "ConnectionPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:DomainElement ;
            owl:onProperty edo:isConnectionPointOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ConnectionPoint ;
            owl:onProperty edo:isConnectedTo ],
        edo:ConnectionInterface ;
    skos:definition "Represents a point used to establish a connection between elements, either physically or logically."@en,
        "Representa um ponto utilizado para estabelecer conexão entre elementos, seja fisicamente ou logicamente."@pt-br ;
    skos:prefLabel "Connection Point"@en,
        "Ponto de Conexão"@pt-br .

edo:InterfaceRelation a owl:ObjectProperty ;
    rdfs:label "Interface Relation"@en,
        "Relação de Interface"@pt-br ;
    dcterms:identifier "InterfaceRelation" ;
    rdfs:subPropertyOf edo:DomainRelation ;
    skos:definition "Category of relationships used to associate domain entities with interface points, ports or features."@en,
        "Categoria de relacionamentos usada para associar entidades do domínio a pontos, portas ou features de interface."@pt-br .

edo:TechnicalDiscipline a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Technical Discipline"@en,
        "Disciplina Técnica"@pt-br ;
    rdfs:comment "Superclass for all technical engineering disciplines."@en ;
    skos:broader edo:TechnicalDisciplines ;
    skos:definition "A specialized field of engineering or technical expertise within industrial projects."@en,
        "Um campo especializado de engenharia ou expertise técnica dentro de projetos industriais."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme ;
    skos:topConceptOf edo:TechnicalDisciplineScheme .

edo:isConnectedTo a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Is Connected To"@en,
        "Está Conectado A"@pt-br ;
    dcterms:identifier "isConnectedTo" ;
    rdfs:domain edo:ConnectionPoint ;
    rdfs:range edo:ConnectionPoint ;
    rdfs:subPropertyOf edo:isInterfaceConnectedTo ;
    skos:altLabel "Connects To"@en,
        "Conecta-se A"@pt-br ;
    skos:definition "Indicates that two classes of domain elements are conceptually connectable to each other, without specifying how the connection is realised."@en,
        "Indica que duas classes de elementos do domínio são conceitualmente conectáveis entre si, sem especificar como a conexão é realizada."@pt-br .

edo:DisplacedVolume a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DisplacedVolume" ;
    rdfs:subClassOf edo:Volume ;
    skos:definition "Total submerged or immersed volume used to determine displacement and buoyancy behaviour."@en ;
    skos:prefLabel "Displaced Volume"@en,
        "Volume Deslocado"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Volume .

edo:LinearEnd a owl:Class ;
    dcterms:identifier "LinearEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:DomainElement ;
            owl:onProperty edo:isEndOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Feature ;
    skos:definition "Terminal feature representing one of the two geometric or topological ends of a linear element, independently of the number or type of connection interfaces exposed at that end."@en,
        "Feature terminal que representa uma das duas extremidades geométricas ou topológicas de um elemento linear, independentemente da quantidade ou do tipo de interfaces de conexão presentes nessa extremidade."@pt-br ;
    skos:prefLabel "Linear End"@en,
        "Extremidade Linear"@pt-br .

edo:MaterialCompositionAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "MaterialCompositionAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents material identity, material family, composition or material-related designation."@en,
        "Atributo que representa identidade de material, família de material, composição ou designação relacionada a material."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Material composition attribute"@en,
        "Atributo de composição material"@pt-br .

skos:ConceptScheme a owl:Class .

edo:EnumerationAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "EnumerationAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute whose value is selected from a controlled list of allowed values."@en,
        "Atributo cujo valor é selecionado a partir de uma lista controlada de valores permitidos."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Enumeration attribute"@en,
        "Atributo enumerado"@pt-br .

edo:IntValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Integer Value"@en ;
    rdfs:comment "Expected XSD datatype for integer values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:integer .

edo:Thickness a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Thickness" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for thickness values. Specialized attributes must be used when the value represents a layer, geometry, required, designed, certified, as-built or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de espessura. Atributos especializados devem ser usados quando o valor representar espessura de camada, geometria, requerida, de projeto, certificada, as-built ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Thickness"@en,
        "Espessura"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole .

edo:hasPart a owl:ObjectProperty ;
    rdfs:label "Has Part"@en,
        "Tem Parte"@pt-br ;
    dcterms:identifier "hasPart" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:PartWholeRelation ;
    skos:altLabel "Part Of"@en,
        "É Parte De"@pt-br ;
    skos:definition "Indicates that one domain entity is a constituent part of another, expressing a generic part–whole relationship without qualification regarding order, essentiality or replaceability."@en,
        "Indica que uma entidade do domínio é parte constituinte de outra, expressando uma relação parte–todo genérica, sem qualificação quanto à ordem, essencialidade ou substituibilidade."@pt-br .

edo:AttributeOntologicalNatures a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Ontological Natures"@en,
        "Naturezas Ontológicas de Atributo"@pt-br .

edo:hasEndInterface a owl:ObjectProperty ;
    rdfs:label "Has End Interface"@en,
        "Tem Interface de Extremidade"@pt-br ;
    dcterms:identifier "hasEndInterface" ;
    rdfs:domain edo:LinearEnd ;
    rdfs:range edo:ConnectionInterface ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:isEndInterfaceOf ;
    skos:definition "Associates a linear end with a connection interface exposed at that end. A linear end may expose one or several interfaces."@en,
        "Associa uma extremidade linear a uma interface de conexão presente nessa extremidade. Uma extremidade linear pode apresentar uma ou várias interfaces."@pt-br .

edo:CertificationDatumAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "CertificationDatumAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a certified value, capability or condition."@en,
        "Atributo que representa um valor, capacidade ou condição certificada."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Certification datum attribute"@en,
        "Atributo de dado certificado"@pt-br .

edo:CertifiedRole a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "CertifiedRole" ;
    skos:broader edo:AttributeRoles ;
    skos:definition "Role of an attribute that expresses a formally certified value, capability or condition."@en,
        "Papel de um atributo que expressa um valor, capacidade ou condição formalmente certificada."@pt-br ;
    skos:inScheme edo:DomainAttributeRole ;
    skos:prefLabel "Certified role"@en,
        "Papel certificado"@pt-br .

edo:DomainAttributeOntologicalNature a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Domain attribute ontological nature"@en,
        "Natureza ontológica de atributo de domínio"@pt-br ;
    dcterms:identifier "DomainAttributeOntologicalNature" ;
    skos:definition "Controlled vocabulary for classifying EDO domain attributes according to their ontological or informational role."@en,
        "Vocabulário controlado para classificar atributos de domínio da EDO segundo seu papel ontológico ou informacional."@pt-br .

edo:StrategyAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "StrategyAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that describes how values, tables, curves or intermediate values are to be interpreted or processed."@en,
        "Atributo que descreve como valores, tabelas, curvas ou valores intermediários devem ser interpretados ou processados."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Strategy attribute"@en,
        "Atributo de estratégia"@pt-br .

edo:ConnectionInterface a owl:Class ;
    dcterms:identifier "ConnectionInterface" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ConnectionInterfaceSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ConnectionInterfaceSpecification ;
            owl:onProperty edo:hasInterfaceSpecification ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:LinearEnd ;
            owl:onProperty edo:isEndInterfaceOf ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ConnectionInterface ;
            owl:onProperty edo:isInterfaceConnectedTo ],
        [ a owl:Restriction ;
            owl:onClass edo:DomainElement ;
            owl:onProperty edo:isConnectionInterfaceOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Feature ;
    skos:definition "Dependent feature of an element through which a physical or functional connection can be established. A connection interface may be point-like, port-like, surface-like or region-like."@en,
        "Feature dependente de um elemento por meio da qual uma conexão física ou funcional pode ser estabelecida. Uma interface de conexão pode ser pontual, do tipo porta, superfície ou região."@pt-br ;
    skos:prefLabel "Connection Interface"@en,
        "Interface de Conexão"@pt-br .

edo:DomainVocabularyConcept a owl:Class ;
    rdfs:label "Vocabulary Concept"@en,
        "Conceito de Vocabulário"@pt-br ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A controlled concept used by EDO vocabularies to classify, qualify, constrain, or describe domain constructs and metamodel constructs."@en .

edo:LifecyclePhaseScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:identifier "LifecyclePhaseScheme" ;
    skos:definition "Controlled vocabulary for lifecycle phases used to classify when information is created, used or required."@en,
        "Vocabulário controlado para fases do ciclo de vida usadas para classificar quando a informação é criada, usada ou requerida."@pt-br ;
    skos:prefLabel "Lifecycle phase scheme"@en,
        "Esquema de fases do ciclo de vida"@pt-br .

edo:hasEnd a owl:ObjectProperty ;
    rdfs:label "Has End"@en,
        "Tem Extremidade"@pt-br ;
    dcterms:identifier "hasEnd" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:LinearEnd ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    owl:inverseOf edo:isEndOf ;
    skos:definition "Associates a domain element with a terminal linear end belonging to it."@en,
        "Associa um elemento de domínio a uma extremidade linear terminal que lhe pertence."@pt-br .

edo:CapabilityAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "CapabilityAttribute" ;
    skos:broader edo:AttributeNatures ;
    skos:definition "Attribute nature related to a capability, limit or supported condition."@en,
        "Natureza de atributo relacionada a uma capacidade, limite ou condição suportada."@pt-br ;
    skos:inScheme edo:DomainAttributeNature ;
    skos:prefLabel "Capability attribute"@en,
        "Atributo de capacidade"@pt-br .

edo:FluidPort a owl:Class ;
    dcterms:identifier "FluidPort" ;
    rdfs:subClassOf edo:Port ;
    skos:definition "Logical element representing a connection interface for fluid flow, defining the capability to link systems or components."@en,
        "Elemento lógico que representa uma interface de conexão destinada ao fluxo de fluidos, descrevendo a capacidade de ligação entre sistemas ou componentes."@pt-br ;
    skos:prefLabel "Fluid Port"@en,
        "Ponto de Conexão de Distribuição"@pt-br .

edo:TechnicalDisciplineScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Technical discipline scheme"@en,
        "Esquema de disciplina técnica"@pt-br ;
    dcterms:identifier "TechnicalDisciplineScheme" ;
    skos:definition "Controlled vocabulary for technical and engineering disciplines used by EDO."@en,
        "Vocabulário controlado para disciplinas técnicas e de engenharia usadas pela EDO."@pt-br ;
    skos:hasTopConcept edo:TechnicalDiscipline .

edo:HydrostaticPressureTestsAttribute a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:AttributeGroupAttribute .

edo:PerformanceAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PerformanceAttribute" ;
    skos:broader edo:AttributeNatures ;
    skos:definition "Attribute nature related to expected or observed performance."@en,
        "Natureza de atributo relacionada a desempenho esperado ou observado."@pt-br ;
    skos:inScheme edo:DomainAttributeNature ;
    skos:prefLabel "Performance attribute"@en,
        "Atributo de desempenho"@pt-br .

edo:Diameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Diameter" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Generic attribute for diameter values. Specialized attributes must be used when the value represents a nominal, internal, external, required, designed, certified, as-built or another lifecycle-specific meaning."@en,
        "Atributo genérico para valores de diâmetro. Atributos especializados devem ser usados quando o valor representar diâmetro nominal, interno, externo, requerido, de projeto, certificado, as-built ou outro significado específico do ciclo de vida."@pt-br ;
    skos:prefLabel "Diameter"@en,
        "Diâmetro"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole .

edo:DomainElement a owl:Class ;
    skos:definition "Represents a fundamental building block of a project or system, encompassing physical, logical, or informational entities that can be modeled, specified, or referenced."@en,
        "Representa um bloco fundamental de um projeto ou sistema, abrangendo entidades físicas, lógicas ou informacionais que podem ser modeladas, especificadas ou referenciadas."@pt-br ;
    skos:prefLabel "Domain Element"@en,
        "Elemento de Domínio"@pt-br .

edo:RequirementRole a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "RequirementRole" ;
    skos:broader edo:AttributeRoles ;
    skos:definition "Role of an attribute that expresses a required or contractual value."@en,
        "Papel de um atributo que expressa um valor requerido ou contratual."@pt-br ;
    skos:inScheme edo:DomainAttributeRole ;
    skos:prefLabel "Requirement role"@en,
        "Papel de requisito"@pt-br .

edo:IndustrialDomainScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Industrial domain scheme"@en,
        "Esquema de domínio industrial"@pt-br ;
    dcterms:identifier "IndustrialDomainScheme" ;
    skos:definition "Controlled vocabulary for high-level industrial domains and subdomains used by EDO."@en,
        "Vocabulário controlado para domínios e subdomínios industriais de alto nível usados pela EDO."@pt-br ;
    skos:hasTopConcept edo:Domain .

edo:RequirementDatumAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "RequirementDatumAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a required, contractual or specification-driven value or condition."@en,
        "Atributo que representa um valor ou condição requerida, contratual ou derivada de especificação."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Requirement datum attribute"@en,
        "Atributo de dado requerido"@pt-br .

edo:hasConnectionPoint a owl:ObjectProperty ;
    rdfs:label "Has Connection Point"@en,
        "Tem Ponto de Conexão"@pt-br ;
    dcterms:identifier "hasConnectionPoint" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:ConnectionPoint ;
    rdfs:subPropertyOf edo:hasConnectionInterface ;
    owl:inverseOf edo:isConnectionPointOf ;
    skos:definition "Associates a domain entity with a point, port or feature that enables connection or interface with other entities."@en,
        "Associa uma entidade do domínio a um ponto, porta ou feature que permite conexão ou interface com outras entidades."@pt-br .

edo:MechanicalAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "MechanicalAttribute" ;
    skos:broader edo:AttributeNatures ;
    skos:definition "Attribute nature related to mechanical behaviour, resistance, load or strength."@en,
        "Natureza de atributo relacionada a comportamento mecânico, resistência, carga ou capacidade estrutural."@pt-br ;
    skos:inScheme edo:DomainAttributeNature ;
    skos:prefLabel "Mechanical attribute"@en,
        "Atributo mecânico"@pt-br .

edo:SubseaFlexiblePipesEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Subsea Flexible Pipes Engineering"@en,
        "Engenharia de Tubos Flexíveis Submarinos"@pt-br ;
    skos:broader edo:SubseaEngineering ;
    skos:definition "Engineering of flexible pipe systems used in subsea applications."@en,
        "Engenharia de sistemas de tubos flexíveis utilizados em aplicações submarinas."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:BasicDesign a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "BasicDesign" ;
    skos:broader edo:DesignPhase ;
    skos:definition "Phase where general engineering specifications, layouts, and main equipment lists are developed."@en,
        "Fase onde são desenvolvidas especificações gerais de engenharia, layouts e listas de equipamentos principais."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Basic Design"@en,
        "Projeto Básico"@pt-br .

edo:SubseaUmbilicalsEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Subsea Umbilicals Engineering"@en,
        "Engenharia de Umbilicais Submarinos"@pt-br ;
    skos:broader edo:SubseaEngineering ;
    skos:definition "Engineering of subsea umbilical systems providing control, power and chemical injection."@en,
        "Engenharia de sistemas de umbilicais submarinos fornecendo controle, energia e injeção química."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:DesignRole a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "DesignRole" ;
    skos:broader edo:AttributeRoles ;
    skos:definition "Role of an attribute that expresses a value defined by engineering design."@en,
        "Papel de um atributo que expressa um valor definido pelo projeto de engenharia."@pt-br ;
    skos:inScheme edo:DomainAttributeRole ;
    skos:prefLabel "Design role"@en,
        "Papel de projeto"@pt-br .

edo:MultiValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Multiple Values"@en,
        "Múltiplos Valores"@pt-bt ;
    rdfs:comment "Constraint allowing multiple values"@en,
        "Restrição para permitir múltiplos valores"@pt-br ;
    skos:broader edo:AttributeValueCardinalities ;
    skos:inScheme edo:DomainAttributeValueCardinality .

edo:ProjectInstantiableClass a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ProjectInstantiableClass" ;
    skos:broader edo:ClassInstantiationRoles ;
    skos:definition "Class intended to be instantiated as an occurrence in project or asset information models."@en,
        "Classe destinada a ser instanciada como ocorrência em modelos de informação de projetos ou ativos."@pt-br ;
    skos:inScheme edo:ClassInstantiationRoleScheme ;
    skos:prefLabel "Project-instantiable class"@en,
        "Classe instanciável em projeto"@pt-br .

edo:TableColumnAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "TableColumnAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a column or field within a table or curve dataset."@en,
        "Atributo que representa uma coluna ou campo dentro de uma tabela ou conjunto de dados de curva."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Table column attribute"@en,
        "Atributo de coluna de tabela"@pt-br .

edo:DimensionalAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "DimensionalAttribute" ;
    skos:broader edo:AttributeNatures ;
    skos:definition "Attribute nature related to dimensions, geometry or measurable extent."@en,
        "Natureza de atributo relacionada a dimensões, geometria ou extensão mensurável."@pt-br ;
    skos:inScheme edo:DomainAttributeNature ;
    skos:prefLabel "Dimensional attribute"@en,
        "Atributo dimensional"@pt-br .

edo:PhysicalQuantityAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PhysicalQuantityAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a measurable physical quantity or magnitude associated with a domain element."@en,
        "Atributo que representa uma quantidade ou grandeza física mensurável associada a um elemento de domínio."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Physical quantity attribute"@en,
        "Atributo de quantidade física"@pt-br .

edo:StringValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "String Value"@en ;
    rdfs:comment "Expected XSD datatype for text values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:string .

edo:QualityDatumAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "QualityDatumAttribute" ;
    skos:broader edo:AttributeOntologicalNatures ;
    skos:definition "Attribute that represents a datum about a quality, property, capability, limit or condition of a domain element."@en,
        "Atributo que representa um dado sobre uma qualidade, propriedade, capacidade, limite ou condição de um elemento de domínio."@pt-br ;
    skos:inScheme edo:DomainAttributeOntologicalNature ;
    skos:prefLabel "Quality datum attribute"@en,
        "Atributo de dado de qualidade"@pt-br .

edo:InstanceLevelAttribute a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Instance-Level Attribute"@en,
        "Atributo de Instância"@pt-br ;
    rdfs:comment "Attribute specific to a real-world individual instance of item."@en ;
    skos:broader edo:AttributeScopes ;
    skos:definition "Attribute specific to a real-world individual instance of item"@en,
        "Atributo específico a uma instância individual no mundo real"@pt-br ;
    skos:inScheme edo:DomainAttributeScope .

edo:DomainAttribute a owl:Class ;
    skos:definition "Represents a property or characteristic that can be assigned to domain elements, capturing specific information relevant to their design, function, or management."@en,
        "Representa uma propriedade ou característica que pode ser atribuída a elementos de domínio, capturando informações específicas relevantes para seu projeto, função ou gestão."@pt-br ;
    skos:prefLabel "Domain Attribute"@en,
        "Atributo de Domínio"@pt-br .

skos:Concept a owl:Class .

edo:TypeLevelAttribute a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Type-Level Attribute"@en,
        "Atributo de Tipo"@pt-br ;
    rdfs:comment "Attribute common to all items of the same type."@en ;
    skos:broader edo:AttributeScopes ;
    skos:definition "Attribute common to all items of the same type"@en,
        "Atributo comum a todos os itens do mesmo tipo"@pt-br ;
    skos:inScheme edo:DomainAttributeScope .

edo:FloatValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Float Value"@en ;
    rdfs:comment "Expected XSD datatype for engineering real-number values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:decimal .

edo:DetailedDesign a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "DetailedDesign" ;
    skos:broader edo:DesignPhase ;
    skos:definition "Comprehensive engineering phase producing detailed drawings, material specifications, and construction plans."@en,
        "Fase abrangente de engenharia que produz desenhos detalhados, especificações de materiais e planos de construção."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Detailed Design"@en,
        "Projeto Detalhado"@pt-br .

edo:hasAttribute a owl:AnnotationProperty ;
    rdfs:label "Has Attribute"@en,
        "Possui Atributo"@pt-br ;
    dcterms:identifier "hasAttribute" ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Indicates attribute(s) that the entity has."@en,
        "Indica atributo(s) que a entidade possui."@pt-br .

edo:SingleValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Single Value"@en,
        "Valor Simples"@pt-br ;
    rdfs:comment "Constraint ensuring only one value (not a list)"@en,
        "Restrição assegurando apenas um valor (não uma lista)"@pt-br ;
    skos:broader edo:AttributeValueCardinalities ;
    skos:inScheme edo:DomainAttributeValueCardinality .

[] a owl:Class ;
    owl:unionOf ( edo:BoltedClamping edo:GasketSealing ) .

[] a owl:Class ;
    owl:unionOf ( edo:EndFitting edo:LineAncillary ) .

[] a owl:Class ;
    owl:unionOf ( edo:FlowConnectorMatingConnection edo:ConnectionModuleMatingConnection edo:HubBlockCapMatingConnection edo:HubProtectionCapMatingConnection ) .

[] a owl:Class ;
    owl:unionOf ( edo:EndFittingCrimpedConnection edo:FlangeConnection ) .


edo:OffLeakPLevMaxPress a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OffLeakPLevMaxPress" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The maximum pressure applied during the Offshore Leak Test (at platform level), ensuring no leaks occur under extreme pressure."@en,
        "Condições de teste dos tramos para Pressão - Máxima - Teste de vazamento hidrostático offshore (no nível da plataforma)"@pt-br ;
    skos:prefLabel "Offshore Leak Test At Platform Level Maximum Pressure"@en,
        "Teste de Vazamento Offshore na Pressão Máxima no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:OffLeakPLevMaxPressValRef a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OffLeakPLevMaxPressValRef" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "Specifies the reference pressure used to determine the Offshore Leak Test maximum pressure value."@en,
        "Comentários Condições de teste dos tramos para - Máximo - Teste de vazamento hidrostático offshore (no nível da plataforma)"@pt-br ;
    skos:prefLabel "Offshore Leak Test At Platform Level Maximum Pressure Value Reference"@en,
        "Referência de Valor de Pressão Máxima para Teste de Vazamento Offshore no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:OffLeakPLevMaxPressValRefMult a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OffLeakPLevMaxPressValRefMult" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The multiplier applied to the reference pressure to determine the Offshore Leak Test maximum pressure value."@en ;
    skos:prefLabel "Offshore Leak Test At Platform Level Maximum Pressure Value Reference Multiplier"@en,
        "Multiplicador de Referência de Valor de Pressão Máxima para Teste de Vazamento Offshore no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:OffLeakPLevNomPress a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OffLeakPLevNomPress" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The nominal pressure applied during the Offshore Leak Test (at platform level), simulating typical operating conditions to assess for leaks."@en,
        "Condições de teste dos tramos para Pressão - Nominal - Teste de vazamento hidrostático offshore (no nível da plataforma)"@pt-br ;
    skos:prefLabel "Offshore Leak Test At Platform Level Nominal Pressure"@en,
        "Pressão Nominal para Teste de Vazamento Offshore no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:OffLeakPLevNomPressValRef a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OffLeakPLevNomPressValRef" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "Specifies the reference pressure used to determine the Offshore Leak Test nominal pressure value."@en,
        "Comentários Condições de teste dos tramos para - Nominal - Teste de vazamento hidrostático offshore (no nível da plataforma)"@pt-br ;
    skos:prefLabel "Offshore Leak Test At Platform Level Nominal Pressure Value Reference"@en,
        "Referência de Valor de Pressão Nominal para Teste de Vazamento Offshore no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:OffLeakPLevNomPressValRefMult a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OffLeakPLevNomPressValRefMult" ;
    rdfs:subClassOf edo:HydrostaticPressureTestsAttribute ;
    skos:definition "The multiplier applied to the reference pressure to determine the Offshore Leak Test nominal pressure value."@en ;
    skos:prefLabel "Offshore Leak Test At Platform Level Nominal Pressure Value Reference Multiplier"@en,
        "Multiplicador de Referência de Valor de Pressão Nominal para Teste de Vazamento Offshore no Nível da Plataforma"@pt-br ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:OpticalConnectorSpecification a owl:Class ;
    dcterms:identifier "OpticalConnectorSpecification" ;
    rdfs:subClassOf edo:OpticalInterfaceSpecification ;
    skos:definition "Optical interface specification for a detachable connector-based mating interface, suitable for describing connector-family, keying, ferrule/contact geometry and other mating-relevant criteria in external reference data."@en,
        "Especificação de interface óptica para uma interface de acoplamento destacável baseada em conector, adequada para descrever família do conector, chaveamento, geometria de férula/contato e outros critérios relevantes ao acoplamento em dados de referência externos."@pt-br ;
    skos:prefLabel "Optical Connector Specification"@en,
        "Especificação de Conector Óptico"@pt-br .

edo:OpticalFiberCable a owl:Class ;
    dcterms:identifier "OpticalFiberCable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalFiberCableEnd ;
            owl:onProperty edo:hasEnd ],
        [ a owl:Restriction ;
            owl:onClass edo:OpticalFiberCableEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        edo:FunctionLine ;
    skos:definition "Represents an optical fiber cable within a function line, transmitting optical signals for communication or sensing purposes."@en,
        "Representa um cabo de fibra óptica dentro de uma linha funcional, transmitindo sinais ópticos para comunicação ou monitoramento."@pt-br ;
    skos:prefLabel "Optical Fiber Cable"@en,
        "Optical fiber cable"@en,
        "Cabo de Fibra Óptica"@pt-br,
        "Cabo de fibra ótica"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:OpticalSpliceBox a owl:Class ;
    dcterms:identifier "OpticalSpliceBox" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalSplicePort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:OpticalSplicePort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:SpliceBox ;
    skos:definition "Splice box providing enclosed optical splice termination for two or more optical splice interfaces. The class specializes the generic splice-box concept without constraining electrical or other splice-box technologies."@en,
        "Caixa de emenda que fornece terminação óptica por emenda enclausurada para duas ou mais interfaces ópticas de emenda. A classe especializa o conceito genérico de caixa de emenda sem restringir tecnologias elétricas ou outras tecnologias de caixa de emenda."@pt-br ;
    skos:prefLabel "Optical Splice Box"@en,
        "Caixa de Emenda Óptica"@pt-br .

edo:OuterDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OuterDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Represents the external diameter of a component, typically measured from one outer edge to the opposite outer edge. This property is important for ensuring proper fit, compatibility, and performance within a system or assembly."@en ;
    skos:prefLabel "Outer Diameter"@en,
        "Diâmetro externo"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:OutsideTemperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OutsideTemperature" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute,
        edo:Temperature ;
    skos:definition "Temperature outside a component, system or analysed boundary."@en,
        "Temperatura externa de um componente, sistema ou limite analisado."@pt-br ;
    skos:prefLabel "Outside Temperature"@en,
        "Temperatura externa"@pt-br ;
    edo:attributeNature edo:EnvironmentalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:DEG_C ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Temperature .

edo:PanelHydraulicConnector a owl:Class ;
    dcterms:identifier "PanelHydraulicConnector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:PanelConnector ;
    skos:definition "Stationary or panel-mounted hydraulic connector."@en,
        "Conector hidráulico estacionário ou montado em painel."@pt-br ;
    skos:prefLabel "Panel Hydraulic Connector"@en,
        "Conector Hidráulico de Painel"@pt-br .

edo:PartNumber a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PartNumber" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "The Part Number is a unique identifier assigned to each type of element, ensuring consistency and ease of reference. This identifier helps in categorizing, ordering, and tracking the accessory within the system. When the drawing code is used consistently across all projects for a specific type of accessory, it can also serve as the Part Number, facilitating uniformity in documentation and usage."@en ;
    skos:prefLabel "Part Number"@en,
        "Número da peça do acessório"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:PermeabilityCurveAttribute a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PermeabilityTable" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Provides data on the permeability of various substances through materials, helping to assess the rate at which fluids or gases can pass through the structure. This information is crucial for evaluating material performance, ensuring compatibility, and predicting long-term behavior under operational conditions."@en,
        "Permeabilidade (Específica para Materiais Poliméricos)"@pt-br ;
    skos:prefLabel "Permeability Table"@en,
        "Tabela de Permeabilidade"@pt-br ;
    edo:attributeOntologicalNature edo:CurveAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute .

edo:PermeabilityTable a owl:Class .

edo:PermeabilityTable_MoleculeIdentifier a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PermeabilityTable_MoleculeIdentifier" ;
    rdfs:subClassOf edo:PermeabilityTableColumn ;
    skos:definition "Specifies the type of molecule. This property identifies the particular molecule involved, which is crucial for understanding the material's interaction with or response to different chemical substances."@en,
        "tipo de molécula (co2, h2s, ch4, h2o,…)"@pt-br ;
    skos:prefLabel "Molecule Identifier"@en,
        "Identificador de Molécula"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:PermeabilityTable_PermeabilityCoefficient a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PermeabilityTable_PermeabilityCoefficient" ;
    rdfs:subClassOf edo:PermeabilityTableColumn ;
    skos:definition "Represents the rate at which a substance, such as a gas or liquid, can pass through a material. This property is crucial for understanding the material's resistance to permeation, helping to assess its suitability for containing or isolating specific substances."@en ;
    skos:prefLabel "Permeability Coefficient"@en,
        "Coeficiente de Permeabilidade"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:PermeabilityTable_PolymerState a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PermeabilityTable_PolymerState" ;
    rdfs:subClassOf edo:PermeabilityTableColumn ;
    skos:definition "The state of the polymeric material is specified.. This property is crucial for understanding how the material behaves under different conditions and its suitability for various applications."@en,
        "(plastificado, não plastificado,…)"@pt-br ;
    skos:prefLabel "Polymer State"@en,
        "Estado do Polímero"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:PermeabilityTable_Temperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PermeabilityTable_Temperature" ;
    rdfs:subClassOf edo:PermeabilityTableColumn ;
    skos:definition "Represents the thermal condition or measurement of heat for a component or system. This property is important for assessing how the component performs or operates under specific thermal conditions, ensuring it remains within safe and effective operating limits."@en ;
    skos:prefLabel "Temperature"@en,
        "Temperatura"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:Piggable a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Piggable" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Whether equipment has at least one internal flow circuit allowing pig runs"@en,
        "Especifica se o equipamento possui pelo menos um circuito interno de escoamento que permita passagem de pig"@pt-br ;
    skos:prefLabel "Piggable"@en,
        "Pigável"@pt-br ;
    edo:attributeOntologicalNature edo:PresenceIndicatorAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:BooleanValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:PipeTermination a owl:Class ;
    dcterms:identifier "PipeTermination" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:LineTermination ;
    skos:definition "The Pipe Termination refers to the components at the end of a pipeline that provide the final connection to other equipment or systems. These terminations are crucial for ensuring a secure and reliable interface between the pipeline and surrounding infrastructure, allowing for the proper transfer of fluids or gases and maintaining the integrity of the overall system."@en ;
    skos:prefLabel "Pipe Termination"@en,
        "Terminador de Duto"@pt-br .

edo:PitchToleranceClass a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PitchToleranceClass" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "A classification defining the acceptable deviation range for the pitch measurement, ensuring consistency in the helical arrangement of wires or threads."@en ;
    skos:prefLabel "Pitch Tolerance Class"@en,
        "Classe de Tolerância de Passo"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Planned_Start_Timestamp a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Planned_Start_Timestamp" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:prefLabel "Planned Start Timestamp"@en ;
    edo:attributeOntologicalNature edo:TemporalAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:DateTimeValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:PointLocation a owl:Class ;
    dcterms:identifier "PointLocation" ;
    rdfs:subClassOf edo:Location ;
    skos:definition "Basis for all locations that can conventionally be situated at a single geographic point."@en,
        "Base para todos os locais que podem ser convencionalmente situados em um único ponto geográfico"@pt-br ;
    skos:prefLabel "Point Location"@en,
        "Localização de Ponto"@pt-br .

edo:PoissonRatioAt23Degrees a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PoissonRatioAt23Degrees" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates Poisson's ratio of the material at 23 degrees Celsius, representing the ratio of transverse strain to axial strain when the material is subjected to stress. This property is essential for understanding the material's deformation behavior under load and its response to mechanical forces in subsea environments."@en,
        "Coeficiente de Poisson a 23 graus Celsius (Específica para Materiais Metálicos e Poliméricos)"@pt-br ;
    skos:prefLabel "Poisson Ratio At 23 Degrees"@en,
        "Coeficiente de Poisson a 23 Graus Celsius"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:PolymericLayerMaterialType a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PolymericLayerMaterialType" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Type of material from which an object is made, allowing for precise documentation and categorisation."@en ;
    skos:prefLabel "Polymeric Layer Material Type"@en,
        "Tipo de Material da Camada Polimérica"@pt-br ;
    edo:attributeOntologicalNature edo:MaterialCompositionAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:PostSlippingBendingStiffness a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PostSlippingBendingStiffness" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute ;
    skos:definition "Represents the stiffness of a component after slipping occurs during bending. This property is important for evaluating the structural response and stability of the component once it has experienced slippage, ensuring that it can still withstand bending loads without significant deformation."@en ;
    skos:prefLabel "Post Slipping Bending Stiffness"@en,
        "Rigidez de Flexão Pós-Escorregamento"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:PowerMachine a owl:Class ;
    dcterms:identifier "PowerMachine" ;
    rdfs:subClassOf edo:PressureComponent ;
    skos:definition "Machine that consumes externally-supplied power in order to execute mechanical work"@en,
        "Máquina que consome potência fornecida externamente para realização de trabalho mecânico"@pt-br ;
    skos:prefLabel "Power machine"@en,
        "Máquina de potência"@pt-br .

edo:PreSlippingBendingStiffness a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PreSlippingBendingStiffness" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute ;
    skos:definition "Represents the stiffness of a component before any slipping occurs during bending. This property is important for assessing how the component resists bending forces prior to slippage, ensuring that it maintains its shape and performance under load."@en ;
    skos:prefLabel "Pre Slipping Bending Stiffness"@en,
        "Rigidez de Flexão Pré-Escorregamento"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Process a owl:Class ;
    dcterms:identifier "Process" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:Task ;
            owl:onProperty edo:hasTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:Task ;
            owl:onProperty edo:hasTask ],
        [ a owl:Restriction ;
            owl:onClass edo:Planned_Start_Timestamp ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Activity ;
    skos:definition "A structured activity composed of coordinated tasks, and potentially other process elements, organised to achieve a defined outcome."@en,
        "Atividade estruturada composta por tarefas coordenadas e, potencialmente, outros elementos de processo, organizados para alcançar um resultado definido."@pt-br ;
    skos:prefLabel "Process"@en,
        "Processo"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:ProcessingModule a owl:Class ;
    dcterms:identifier "ProcessingModule" ;
    rdfs:subClassOf edo:FlowControlModule ;
    skos:definition "Module installed as part of some larger equipment and designed to produce physical or chemical changes upon fluids"@en,
        "Módulo instalado como parte de um equipamento maior e projetado para produzir mudanças físicas ou químicas sobre fluidos"@pt-br ;
    skos:prefLabel "Processing module"@en,
        "Módulo de processamento"@pt-br .

edo:ProjectAcronym a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ProjectAcronym" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the unique identification code assigned to the operator's project. This property is used for tracking, managing, and referencing the project throughout all phases of its lifecycle, ensuring proper identification and organization."@en,
        "Abreviação do nome do projeto da Interligação Submarina. Ex., 'SEP' para o \"FPSO Carioca do campo de Sépia\""@pt-br ;
    skos:prefLabel "Project Acronym"@en,
        "Abreviação do Nome do Projeto da Interligação Submarina"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ProjectCode a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ProjectCode" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Unique identification code assigned to the operator's project, used for tracking, managing, and referencing the project across all phases of its lifecycle."@en ;
    skos:prefLabel "Project Code"@en,
        "Código Identificador único do projeto da operadora da Interligação Submarina"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ProjectDrawingCode a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ProjectDrawingCode" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the unique alphanumeric code assigned to the project drawing. This property is used to reference and locate the specific drawing associated with the item, providing a clear and organized method for tracking and accessing drawing documents."@en,
        "Número do desenho do projeto do acessório"@pt-br ;
    skos:prefLabel "Project Drawing Code"@en,
        "Número do Desenho do Projeto"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ProjectDrawingRevision a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ProjectDrawingRevision" ;
    rdfs:subClassOf edo:DomainAttribute ;

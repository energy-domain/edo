            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrIntOnNoTensMaxPressValRefMult ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrIntOffPLevNomPressValRef ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SpecialRequirements ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:OffLeakPLevMaxPressValRef ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrIntOnNoTensNomPressValRefMult ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:EarlyLeakNomPressTable_PressValRefMult ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrIntOnNoTensNomPressValRef ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:OffLeakPLevNomPress ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:AssemblyShouldObeyModelPolarity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FlexiblePipeSegmentEnd ;
            owl:onProperty edo:hasEnd ],
        [ a owl:Restriction ;
            owl:onClass edo:EndFitting ;
            owl:onProperty edo:hasPart ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( edo:FlexiblePipeBody edo:EndFitting edo:LineAncillary ) ] ;
            owl:onProperty edo:hasPart ],
        [ a owl:Restriction ;
            owl:onClass edo:FlexiblePipeSegmentEnd ;
            owl:onProperty edo:hasEnd ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlexiblePipeBody ;
            owl:onProperty edo:hasPart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrIntOffPLevMaxPress ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:OffLeakPLevMaxPressValRefMult ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:EarlyLeakMaxPressTable_TensLimit ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FatMaxPress ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:OffLeakPLevNomPressValRef ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StrIntOffPLevNomPressValRefMult ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PipeSegment ;
    skos:altLabel "Flexible Line Section"@en,
        "Flexible Pipe Section"@en,
        "Flexible Pipe Segment"@en,
        "Subsea Pipe Segment"@en ;
    skos:definition "Finished subsea flexible pipe section comprising one multilayer flexible pipe body terminated by two end fittings, forming a traceable supplied asset whose external connection interfaces are the flange interfaces of its end fittings."@en,
        "Tramo acabado de duto flexível submarino composto por um corpo tubular flexível multicamada terminado por dois end fittings, constituindo um ativo rastreável fornecido cujas interfaces externas de conexão são as interfaces flangeadas de seus end fittings."@pt-br ;
    skos:prefLabel "Flexible Pipe Segment"@en,
        "Tramo de Duto Flexível"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:FlowBase a owl:Class ;
    dcterms:identifier "FlowBase" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:FlowConnector a owl:Class ;
    dcterms:identifier "FlowConnector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:onClass edo:FlowConnectorMatingConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PressureComponent ;
    skos:definition "Major connector for subsea tie-in to a corresponding hub"@en,
        "Conector de grande porte para acoplamento submarino com um hub/mandril correspondente"@pt-br ;
    skos:prefLabel "Flow Connector"@en,
        "Conector de Fluxo"@pt-br .

edo:FlowLineMandrel a owl:Class ;
    dcterms:identifier "FlowLineMandrel" ;
    rdfs:subClassOf edo:TieInEquipment ;
    skos:definition "Equipment for terminating and connecting multiple lines simultaneously"@en,
        "Equipamento para terminação e interligação de várias linhas simultaneamente"@pt-br ;
    skos:prefLabel "Flow line mandrel"@en,
        "Mandril das linhas de fluxo"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:FlowbaseRunningTool a owl:Class ;
    dcterms:identifier "FlowbaseRunningTool" ;
    rdfs:subClassOf edo:RunningTool ;
    skos:prefLabel "Flowbase running tool"@en,
        "Ferramenta de instalação de BAP"@pt-br .

edo:FlowlineSpan a owl:Class ;
    dcterms:identifier "FlowlineSpan" ;
    rdfs:subClassOf edo:PipelineSpan ;
    skos:definition "Unsuspended pipeline span, laid over or under ground"@en,
        "Trecho de duto não suspenso, estendido sobre ou sob o solo"@pt-br ;
    skos:prefLabel "Flowline span"@en,
        "Trecho flowline"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:FullyThreaded a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "FullyThreaded" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates whether the component will be used fully threaded (TRUE) or not (FALSE)."@en ;
    skos:prefLabel "Fully Threaded"@en,
        "Completamente Rosqueado"@pt-br ;
    edo:attributeOntologicalNature edo:PresenceIndicatorAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:BooleanValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:GalvanicConnection a owl:Class ;
    dcterms:identifier "GalvanicConnection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:MetallicStrandSet ;
            owl:onProperty edo:hasPart ],
        [ a owl:Restriction ;
            owl:onClass edo:AnodeGalvanicConnectionPoint ;
            owl:onProperty edo:connectsInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( edo:AnodeGalvanicConnectionPoint edo:ProtectedStructureGalvanicConnectionPoint ) ] ;
            owl:onProperty edo:connectsInterface ],
        [ a owl:Restriction ;
            owl:onClass edo:ProtectedStructureGalvanicConnectionPoint ;
            owl:onProperty edo:connectsInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:MetallicStrandSet ;
            owl:onProperty edo:hasPart ],
        edo:PhysicalConnection ;
    owl:disjointWith edo:ClampedJoint,
        edo:FlangedJoint,
        edo:FlexiblePipeCrimpedJoint,
        edo:WeldedJoint ;
    skos:definition "Physical electrical connection that intentionally establishes galvanic continuity between a sacrificial-anode side and a protected metallic structure for cathodic protection."@en,
        "Conexão elétrica física que estabelece intencionalmente continuidade galvânica entre o lado de um anodo sacrificial e uma estrutura metálica protegida para proteção catódica."@pt-br ;
    skos:prefLabel "Galvanic Connection"@en,
        "Conexão Galvânica"@pt-br .

edo:GeothermalDirectUse a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "GeothermalDirectUse" ;
    skos:broader edo:Geothermal ;
    skos:definition "Direct use of geothermal energy takes advantage of low or medium temperature geothermal resources for heating buildings, greenhouses, aquaculture facilities, or industrial processes."@en,
        "O uso direto da energia geotérmica aproveita recursos geotérmicos de baixa ou média temperatura para aquecer edifícios, estufas, instalações de aquicultura ou processos industriais."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Geothermal Direct Use"@en,
        "Uso Direto Geotérmico"@pt-br .

edo:GeothermalElectricity a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "GeothermalElectricity" ;
    skos:broader edo:Geothermal ;
    skos:definition "Geothermal electricity generation uses high-enthalpy geothermal resources to produce steam that drives turbines and generates renewable power. It is mainly applied in volcanic regions with accessible geothermal reservoirs."@en,
        "A geração elétrica geotérmica utiliza recursos geotérmicos de alta entalpia para produzir vapor que aciona turbinas e gera energia renovável. É aplicada principalmente em regiões vulcânicas com reservatórios geotérmicos acessíveis."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Geothermal Electricity Generation"@en,
        "Geração Elétrica Geotérmica"@pt-br .

edo:GroovePoint a owl:Class ;
    dcterms:identifier "GroovePoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:GrooveSupportSurfaceFilletRadius ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:GrooveSupportSurfaceDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:GrooveDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:GrvCntrPntDstnceFrmTermFlange ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SafeWorkingLoad ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:GrooveHeight ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:TechnicalNotes ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:GrooveMinimumSupportArea ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:SupportRegion ;
    skos:definition "O Groove Point é um ponto designado na linha de centro do componente, usado para indicar a posição exata de um sulco. O sulco em si é uma área rebaixada projetada para auxiliar na fixação do componente durante a instalação, garantindo que ele permaneça firmemente no lugar durante o processo. O Groove Support Point fornece uma referência para localizar o sulco, facilitando o alinhamento e o posicionamento precisos necessários para uma instalação adequada."@en,
        "Ponto na linha de centro do End Fitting para indicar a posição do Groove"@pt-br ;
    skos:prefLabel "Groove Point"@en,
        "Ponto de Groove"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:Group a owl:Class ;
    dcterms:identifier "Group" ;
    rdfs:subClassOf edo:Agent ;
    skos:definition "An agent representing an organised group of people that may collectively participate in activities or assume responsibilities."@en,
        "Agente que representa um grupo organizado de pessoas que pode participar coletivamente de atividades ou assumir responsabilidades."@pt-br ;
    skos:prefLabel "Group"@en,
        "Grupo"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:GroutBag a owl:Class ;
    dcterms:identifier "GroutBag" ;
    rdfs:subClassOf edo:PipeSupport ;
    skos:prefLabel "Grout bag"@en,
        "Grout bag"@pt-br .

edo:GuideBase a owl:Class ;
    dcterms:identifier "GuideBase" ;
    rdfs:subClassOf edo:Structure ;
    skos:prefLabel "Guide base"@en,
        "Base-guia"@pt-br .

edo:HCM a owl:Class ;
    dcterms:identifier "HCM" ;
    rdfs:subClassOf edo:ConnectionModule ;
    skos:prefLabel "Horizontal connection module"@en,
        "Módulo de conexão horizontal"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:HCRHose a owl:Class ;
    dcterms:identifier "HCRHose" ;
    rdfs:subClassOf edo:Tubing ;
    skos:definition "High Collapse Resistant Hose"@en,
        "Represents a high-pressure rubber hose used within tubing for fluid transport in umbilical systems."@en,
        "Representa uma mangueira de borracha de alta pressão utilizada em tubulações para transporte de fluido em sistemas umbilicais."@pt-br ;
    skos:prefLabel "HCR Hose"@en,
        "Mangueira HCR"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:HPHousing a owl:Class ;
    dcterms:identifier "HPHousing" ;
    rdfs:subClassOf edo:PressureComponent ;
    skos:prefLabel "High-pressure housing"@en,
        "Alojador de alta pressão"@pt-br .

edo:HVACEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "HVAC Engineering"@en,
        "Engenharia de HVAC"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on heating, ventilation and air conditioning systems."@en,
        "Disciplina de engenharia focada em sistemas de aquecimento, ventilação e ar condicionado."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:HandlingCollar a owl:Class ;
    dcterms:identifier "HandlingCollar" ;
    rdfs:subClassOf edo:SplitCollar ;
    skos:altLabel "Handling Clamp"@en,
        "Installation Collar"@en,
        "Lifting Collar"@en,
        "Support Collar"@en ;
    skos:definition "Device used in subsea operations to facilitate the safe handling, lifting, and maneuvering of flexible pipes or heavy components during installation or retrieval. Typically attached around the pipe or component, it provides secure lifting points for cranes or other lifting equipment. Designed to distribute the load evenly, it prevents damage to the pipe or equipment while ensuring efficient and controlled movements in subsea environments."@en ;
    skos:prefLabel "Handling Collar"@en,
        "Colar de Manuseio"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:HangOffCollar a owl:Class ;
    dcterms:identifier "HangOffCollar" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:CollarClampingSurface ;
            owl:onProperty edo:hasConnectionInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MountingPoint ;
            owl:onProperty edo:hasMountingPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlangeType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:CollarInternalDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaxDynamicLoad ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:UpperItubeDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SafeWorkingLoad ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:LineAncillary ;
    skos:altLabel "Hang-Off Clamp"@en,
        "Hang-Off Device"@en,
        "Support Collar"@en,
        "Termination Collar"@en ;
    skos:definition "Device used to secure and support flexible pipes or risers during installation, particularly when they are suspended from a platform or vessel. It provides a stable attachment point, distributing the load and preventing excessive movement or strain on the pipe. The Hang Off Collar is crucial for maintaining the integrity of the pipe while it is held in place before final connection or during temporary suspension in subsea operations."@en,
        "Flange bipartido para suporte de um riser"@pt-br ;
    skos:prefLabel "Hang Off Collar"@en,
        "Sistema de Suspensão"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:HighStrengthTape a owl:Class ;
    dcterms:identifier "HighStrengthTape" ;
    rdfs:subClassOf edo:TapeLayer ;
    skos:definition "Material used in subsea flexible pipes, typically applied as a reinforcing layer to provide additional strength and resistance to external forces. High Strength Tape is designed to improve the tensile properties of the flexible pipe, enhancing its ability to withstand high internal pressures, tension, and dynamic loads in harsh subsea environments. It is typically made from advanced fibers or composite materials, ensuring durability and long-term performance in demanding conditions."@en ;
    skos:prefLabel "High Strength Tape"@en,
        "Fita de Alta Resistência"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:HistoricalAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "HistoricalAttribute" ;
    skos:broader edo:AttributeCategories ;
    skos:definition "Attribute category related to records of past events, inspections or modifications."@en,
        "Categoria de atributo relacionada a registros de eventos passados, inspeções ou modificações."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory ;
    skos:prefLabel "Historical attribute"@en,
        "Atributo histórico"@pt-br .

edo:HoldingBandage a owl:Class ;
    dcterms:identifier "HoldingBandage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ModulusOfElasticity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:TapesQuantity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:StressAtDesignPressure ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:TapeLayer ;
    skos:definition "Reinforcement layer used in subsea flexible pipes to secure and hold internal components in place during manufacturing and operation. The Holding Bandage helps maintain the alignment and stability of the various layers of the pipe, preventing displacement or movement under dynamic conditions. Typically made from high-strength, flexible materials, it contributes to the overall durability and structural integrity of the pipe, ensuring reliable performance in harsh subsea environments."@en ;
    skos:prefLabel "Holding Bandage"@en,
        "Bandagem de Reforço"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:Hook a owl:Class ;
    dcterms:identifier "Hook" ;
    rdfs:subClassOf edo:MooringAccessory ;
    skos:prefLabel "Hook"@en,
        "Gancho"@pt-br .

edo:HotStab a owl:Class ;
    dcterms:identifier "HotStab" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:HotStabMatingConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:HydraulicJumperConnector ;
    skos:definition "Represents a type of hydraulic jumper connector designed for quick connect/disconnect operations under pressure."@en,
        "Representa um tipo de conector jumper hidráulico projetado para operações de conexão/desconexão rápida sob pressão."@pt-br ;
    skos:prefLabel "Hot Stab"@en,
        "Hot Stab"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:HotStabReceptacle a owl:Class ;
    dcterms:identifier "HotStabReceptacle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:HotStabReceptacleMatingConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PanelHydraulicConnector ;
    skos:definition "Interface for receiving a hydraulic connector, such as a hot stab."@en,
        "Interface para receber um conector hidráulico tipo hot stab."@pt-br ;
    skos:prefLabel "Hot Stab Receptacle"@en,
        "Receptáculo de Hot Stab"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:Hub a owl:Class ;
    dcterms:identifier "Hub" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:HubMatingConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PressureComponent ;
    skos:definition "Interface for mating of a matching major connector"@en,
        "Interface para acoplamento de um conector de grande porte correspondente"@pt-br ;
    skos:prefLabel "Hub"@en,
        "Hub"@pt-br .

edo:HubBlockCap a owl:Class ;
    dcterms:identifier "HubBlockCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:HubBlockCapMatingConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:FlowControlModule ;
    skos:definition "Cover that may be installed and locked over a hub, being able to withstand operation pressures in the long term"@en,
        "Cobertura que pode ser instalada e travada sobre um hub/mandril, capaz de conter as pressões de operação a longo prazo"@pt-br ;
    skos:prefLabel "Hub block cap"@en,
        "Capa de bloqueio de hub"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:HubProtectionCap a owl:Class ;
    dcterms:identifier "HubProtectionCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:HubProtectionCapMatingConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Accessory ;
    skos:definition "Simple, non-pressure-containing device for usually temporary protection of a hub against external agents (such as debris, corrosion etc.)"@en,
        "Dispositivo simples, não resistente a pressões de trabalho, para proteção de um hub/mandril contra agentes externos (detritos, corrosão, etc.), geralmente temporariamente"@pt-br ;
    skos:prefLabel "Hub protection cap"@en,
        "Capa de proteção de hub"@pt-br .

edo:HybridRenewables a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "HybridRenewables" ;
    skos:broader edo:Renewable ;
    skos:definition "Hybrid renewables are systems that combine two or more renewable energy sources, such as solar and wind, in order to improve reliability, efficiency and land use. They represent a growing field of integration that enables more flexible and resilient energy generation."@en,
        "Renováveis híbridas são sistemas que combinam duas ou mais fontes de energia renovável, como solar e eólica, com o objetivo de melhorar a confiabilidade, a eficiência e o uso do solo. Representam um campo crescente de integração que permite uma geração de energia mais flexível e resiliente."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Hybrid Renewables"@en,
        "Renováveis Híbridas"@pt-br .

edo:HydraulicJumper a owl:Class ;
    dcterms:identifier "HydraulicJumper" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:FluidPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:Jumper ;
    skos:prefLabel "Hydraulic jumper"@en,
        "Jumper hidráulico"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:HydraulicPowerUnit a owl:Class ;
    dcterms:identifier "HydraulicPowerUnit" ;
    rdfs:subClassOf edo:TopsideEquipment ;
    skos:definition "Topside equipment for generation, control and distribution of hydraulic power"@en,
        "Equipamento de superfície para geração, controle e distribuição de potência hidráulica"@pt-br ;
    skos:prefLabel "Hydraulic power unit"@en,
        "Unidade de potência hidráulica"@pt-br .

edo:HydrogenEnergy a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Hydrogen Energy"@en,
        "Energia de Hidrogênio"@pt-br ;
    skos:broader edo:Domain ;
    skos:definition "Production, storage, and utilization of hydrogen as an energy carrier."@en,
        "Produção, armazenamento e utilização de hidrogênio como vetor energético."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:IMUX a owl:Class ;
    dcterms:identifier "IMUX" ;
    rdfs:subClassOf edo:ElectronicDevice ;
    skos:definition "Communications conversion module for downhole sensors and components"@en,
        "Módulo de conversão para comunicação com sensores e componentes de poço (downhole)"@pt-br ;
    skos:prefLabel "IWIS multiplexer"@en,
        "Multiplexador IWIS"@pt-br .

edo:ITube a owl:Class ;
    dcterms:identifier "ITube" ;
    rdfs:subClassOf edo:RiserSupport ;
    skos:prefLabel "I-tube"@en,
        "I-tube"@pt-br .

edo:IdentificationAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "IdentificationAttribute" ;
    skos:broader edo:AttributeCategories ;
    skos:definition "Attribute category related to identifiers, codes, names or reference identifiers."@en,
        "Categoria de atributo relacionada a identificadores, códigos, nomes ou identificadores de referência."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory ;
    skos:prefLabel "Identification attribute"@en,
        "Atributo de identificação"@pt-br .

edo:ImportedValue a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ImportedValue" ;
    skos:broader edo:AttributeValueOrigins ;
    skos:definition "Value imported from another system, dataset or information source."@en,
        "Valor importado de outro sistema, conjunto de dados ou fonte de informação."@pt-br ;
    skos:inScheme edo:DomainAttributeValueOrigin ;
    skos:prefLabel "Imported value"@en,
        "Valor importado"@pt-br .

edo:InlineT a owl:Class ;
    dcterms:identifier "InlineT" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    skos:definition "Derivation of a main pipeline at an approximately right angle (90°)"@en,
        "Derivação de um duto principal em ângulo aproximadamente reto (90°)"@pt-br ;
    skos:prefLabel "Inline tee"@en,
        "'T' em linha"@pt-br .

edo:InlineValve a owl:Class ;
    dcterms:identifier "InlineValve" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    skos:definition "Inline equipment containing a valve as main element plus accessories, actuation systems etc."@en,
        "Equipamento inline que contém uma válvula como seu principal elemento, e ainda acessórios, sistemas de atuação etc."@pt-br ;
    skos:prefLabel "Inline valve"@en,
        "Válvula inline"@pt-br .

edo:InlineY a owl:Class ;
    dcterms:identifier "InlineY" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    skos:definition "Pipeline bifurcation that allows pigging"@en,
        "Bifurcação de duto que permite passagem de pig"@pt-br ;
    skos:prefLabel "Inline wye"@en,
        "'Y' em linha"@pt-br .

edo:InnerTube a owl:Class ;
    dcterms:identifier "InnerTube" ;
    rdfs:subClassOf edo:SolidLayer ;
    skos:definition "The Inner Tube is the innermost layer of a subsea flexible pipe, responsible for containing and transporting the fluid, such as oil or gas. It is designed to withstand internal pressures and prevent fluid leakage while offering resistance to the corrosive and abrasive nature of the transported substances. The Inner Tube is typically made from high-performance polymeric materials that ensure durability, flexibility, and chemical resistance, making it a critical component in maintaining the integrity of the flexible pipe in subsea operations."@en ;
    skos:prefLabel "Inner Tube"@en,
        "Tubo Interno"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:InstalledLength a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "InstalledLength" ;
    rdfs:subClassOf edo:Length ;
    skos:definition "Length associated with the installed condition of the component or system."@en,
        "Comprimento associado à condição instalada do componente ou sistema."@pt-br ;
    skos:prefLabel "Installed Length"@en,
        "Comprimento instalado"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:InstalledRole ;
    edo:specializesAttribute edo:Length .

edo:InstalledWaterDepth a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "InstalledWaterDepth" ;
    rdfs:subClassOf edo:WaterDepth ;
    skos:definition "Water depth at the installed location of the item. It represents the installed physical condition or location and must not be confused with maximum water depth capability."@en,
        "Profundidade d'água na localização instalada do item. Representa a condição física ou localização instalada e não deve ser confundida com a capacidade máxima de profundidade d'água."@pt-br ;
    skos:prefLabel "Installed Water Depth"@en,
        "Profundidade d'água instalada"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:LocationAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:Installation ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:InstalledRole ;
    edo:specializesAttribute edo:WaterDepth .

edo:InstrumentationEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Instrumentation Engineering"@en,
        "Engenharia de Instrumentação"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on measurement and control instrumentation systems."@en,
        "Disciplina de engenharia focada em sistemas de instrumentação de medição e controle."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:InsulationTape a owl:Class ;
    dcterms:identifier "InsulationTape" ;
    rdfs:subClassOf edo:TapeLayer ;
    skos:definition "Material used in subsea flexible pipes to provide thermal insulation, ensuring that the temperature of the transported fluids remains stable during flow. Insulation Tape is applied in layers around the pipe to minimize heat loss or gain, which is critical for maintaining the fluid's properties, such as viscosity, in deepwater environments. It is typically made from materials with low thermal conductivity, such as polymers or composites, and is essential for enhancing the efficiency and performance of subsea pipelines in harsh temperature conditions."@en ;
    skos:prefLabel "Insulation Tape"@en,
        "Fita de Isolamento"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:IntegratedPipe a owl:Class ;
    dcterms:identifier "IntegratedPipe" ;
    rdfs:subClassOf edo:Tubing ;
    skos:definition "Represents a pipe integrated within tubing for combined structural and functional purposes."@en,
        "Representa um tubo integrado dentro de uma tubulação para finalidades estruturais e funcionais combinadas."@pt-br ;
    skos:prefLabel "Integrated Pipe"@en,
        "Integrated pipe"@en,
        "Duto integrado"@pt-br,
        "Tubo Integrado"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:InterfaceRatedCurrent a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "InterfaceRatedCurrent" ;
    rdfs:subClassOf edo:ElectricalInterfaceSpecificationAttribute ;
    skos:definition "Declared current rating at the electrical-interface level under the conditions and standards applicable to its specification. It does not replace per-contact ratings where a multi-contact connector contains contacts with different current capabilities."@en,
        "Corrente nominal declarada no nível da interface elétrica sob as condições e normas aplicáveis à sua especificação. Não substitui ratings por contato quando um conector multicontato contém contatos com diferentes capacidades de corrente."@pt-br ;
    skos:prefLabel "Interface Rated Current"@en,
        "Corrente Nominal da Interface"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:A ;
    edo:hasValueCardinality edo:SingleValue .

edo:InterfaceRatedVoltage a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "InterfaceRatedVoltage" ;
    rdfs:subClassOf edo:ElectricalInterfaceSpecificationAttribute ;
    skos:definition "Declared voltage rating of an electrical connection interface under the conditions and standards applicable to its specification. This is an interface rating, not the actual operating voltage of a connected circuit."@en,
        "Tensão nominal declarada de uma interface de conexão elétrica sob as condições e normas aplicáveis à sua especificação. Trata-se de um rating da interface, e não da tensão efetiva de operação de um circuito conectado."@pt-br ;
    skos:prefLabel "Interface Rated Voltage"@en,
        "Tensão Nominal da Interface"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:V ;
    edo:hasValueCardinality edo:SingleValue .

edo:InterlockedCarcass a owl:Class ;
    dcterms:identifier "InterlockedCarcass" ;
    rdfs:subClassOf edo:CarcassLayer ;
    skos:definition "The Interlocked Carcass is a metallic layer used in certain subsea flexible pipes to provide internal pressure resistance and prevent collapse. It is designed with interlocking metal strips that offer high strength while maintaining flexibility. This layer enhances the structural integrity of the flexible pipe, protecting it from external pressures and harsh subsea conditions. The Interlocked Carcass allows the pipe to bend without losing its shape or collapsing under deepwater pressure."@en ;
    skos:prefLabel "Interlocked Carcass"@en,
        "Carcaça"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:IntermediateBendStiffener a owl:Class ;
    dcterms:identifier "IntermediateBendStiffener" ;
    rdfs:subClassOf edo:BendStiffener ;
    skos:altLabel "Curvature Stiffener"@en,
        "Intermediate Bending Stiffener"@en,
        "Stiffener"@en ;
    skos:definition "A device used in subsea flexible pipes to provide localized stiffness at specific points along the length of the pipe, preventing excessive bending and reducing stress concentration. The Intermediate Bend Stiffener is typically installed between critical areas to ensure that the pipe maintains a controlled bending radius, protecting it from over-flexing or fatigue. Made from durable materials, it helps prolong the service life of the flexible pipe by distributing loads more evenly and reducing the risk of damage in dynamic subsea environments."@en,
        "Dispositivo usado em tubos flexíveis submarinos para fornecer rigidez localizada em pontos específicos ao longo do comprimento do tubo, evitando dobras excessivas e reduzindo a concentração de tensões. O Enrijecedor de Curvatura Intermediário é tipicamente instalado entre áreas críticas para garantir que o tubo mantenha um raio de curvatura controlado, protegendo-o contra flexões excessivas ou fadiga. Feito de materiais duráveis, ajuda a prolongar a vida útil do tubo flexível, distribuindo as cargas de forma mais uniforme e reduzindo o risco de danos em ambientes submarinos dinâmicos."@pt-br ;
    skos:prefLabel "Intermediate Bend Stiffener"@en,
        "Enrijecedor de Curvatura Intermediário"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:IntermediateSheath a owl:Class ;
    dcterms:identifier "IntermediateSheath" ;
    rdfs:subClassOf edo:SolidLayer ;
    skos:definition "A protective layer within a subsea flexible pipe, positioned between other structural layers to provide additional protection and separation. The Intermediate Sheath serves to isolate different layers, preventing abrasion, wear, or interaction that could compromise the integrity of the pipe. Typically made from polymeric materials, this sheath also contributes to the overall durability and flexibility of the pipe, ensuring it can withstand the dynamic conditions of subsea environments while maintaining the performance of the internal and external layers."@en ;
    skos:prefLabel "Intermediate Sheath"@en,
        "Barreira Intermediária de Vedação"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:InternalPressureSheath a owl:Class ;
    dcterms:identifier "InternalPressureSheath" ;
    rdfs:subClassOf edo:SolidLayer ;
    skos:altLabel "Inner Sheath" ;
    skos:definition "A layer within a subsea flexible pipe designed to contain the internal fluid and withstand the internal pressure exerted by the transported medium, such as oil, gas, or water. The Internal Pressure Sheath plays a crucial role in preventing fluid leakage and maintaining pressure integrity within the pipe. Typically made from high-performance polymeric materials, it ensures the safe transport of fluids under high-pressure conditions, contributing to the pipe's overall structural stability and long-term reliability in harsh subsea environments."@en ;
    skos:prefLabel "Internal Pressure Sheath"@en,
        "Barreira Interna de Pressão"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:LPHousing a owl:Class ;
    dcterms:identifier "LPHousing" ;
    rdfs:subClassOf edo:PressureComponent ;
    skos:prefLabel "Low-pressure housing"@en,
        "Alojador de baixa pressão"@pt-br .

edo:LargeHydropower a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "LargeHydropower" ;
    skos:broader edo:Hydropower ;
    skos:definition "Large hydropower plants generate electricity by harnessing the kinetic and potential energy of rivers using large dams and reservoirs, typically above 30 MW capacity. They provide reliable energy but may cause significant environmental and social impacts."@en,
        "Usinas hidrelétricas de grande porte geram eletricidade aproveitando a energia cinética e potencial dos rios por meio de grandes barragens e reservatórios, geralmente acima de 30 MW de capacidade. Fornecem energia confiável, mas podem causar impactos ambientais e sociais significativos."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Large Hydropower"@en,
        "Hidrelétrica de Grande Porte"@pt-br .

edo:LiftingPoint a owl:Class ;
    dcterms:identifier "LiftingPoint" ;
    rdfs:subClassOf edo:SupportPoint ;
    skos:definition "Represents a point used specifically for lifting operations."@en,
        "Representa um ponto utilizado especificamente para operações de elevação."@pt-br ;
    skos:prefLabel "Lifting Point"@en,
        "Ponto de Elevação"@pt-br .

edo:LogicCap a owl:Class ;
    dcterms:identifier "LogicCap" ;
    rdfs:subClassOf edo:AuxiliaryModule ;
    skos:prefLabel "Logic cap"@en,
        "Capa lógica"@pt-br .

edo:LongValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Long Value"@en ;
    rdfs:comment "Expected XSD datatype for long integer values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:long .

edo:LongitudinalOffset a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "LongitudinalOffset" ;
    dcterms:isReplacedBy edo:RequiredLongitudinalPosition ;
    rdfs:subClassOf edo:IntendedLongitudinalPlacement,
        edo:Offset ;
    owl:deprecated true ;
    skos:definition "Distance from the applicable reference point to the intended attachment point position along the longitudinal direction."@en,
        "Distância do ponto de referência aplicável até a posição pretendida do ponto de anexação ao longo da direção longitudinal."@pt-br ;
    skos:prefLabel "Longitudinal Offset"@en,
        "Deslocamento Longitudinal"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:LocationAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Offset .

edo:LongitudinalOrientation a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "LongitudinalOrientation" ;
    dcterms:isReplacedBy edo:hasReferenceDatum ;
    rdfs:subClassOf edo:IntendedLongitudinalPlacement ;
    owl:deprecated true ;
    skos:definition "Orientation used to interpret the longitudinal offset relative to the reference point."@en,
        "Orientação usada para interpretar o deslocamento longitudinal em relação ao ponto de referência."@pt-br ;
    skos:prefLabel "Longitudinal Orientation"@en,
        "Orientação Longitudinal"@pt-br ;
    edo:allowedValue edo:FromReferencePoint,
        edo:TowardsReferencePoint ;
    edo:attributeNature edo:LocationAttribute ;
    edo:attributeOntologicalNature edo:StrategyAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole .

edo:LowResistanceTape a owl:Class ;
    dcterms:identifier "LowResistanceTape" ;
    rdfs:subClassOf edo:TapeLayer ;
    skos:definition "A layer used in subsea flexible pipes to reduce friction between different components or layers, enhancing the overall flexibility and durability of the pipe. The Low Resistance Tape minimizes wear and abrasion caused by the movement of adjacent layers during operation, particularly in dynamic subsea conditions. Made from materials with low friction properties, it helps extend the lifespan of the pipe by reducing internal stresses and preventing damage to critical layers, ensuring smooth and efficient operation under harsh underwater conditions."@en ;
    skos:prefLabel "Low Resistance Tape"@en,
        "Fita de Baixa Resistência"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:Lubricant a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Lubricant" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Specifies the type of lubricant applied to reduce friction during tightening and ensure consistent torque application. The use of the correct lubricant is critical in preventing galling and corrosion, and helps to maintain the long-term integrity."@en ;
    skos:prefLabel "Lubricant"@en,
        "Nome do Lubrificante"@pt-br ;
    edo:attributeOntologicalNature edo:MaterialCompositionAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:LubricantFrictionFactor a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "LubricantFrictionFactor" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Indicates the friction factor of the lubricant applied, which affects the torque required to achieve proper tightening. This value is crucial for ensuring that the correct amount of torque is applied, accounting for the reduction in friction caused by the lubricant."@en ;
    skos:prefLabel "Lubricant Friction Factor"@en,
        "Fator de atrito do lubrificante"@pt-br ;
    edo:attributeOntologicalNature edo:MaterialCompositionAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:Maintenance a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Maintenance" ;
    skos:broader edo:OperationPhase ;
    skos:definition "Planned or corrective interventions to preserve asset functionality and safety."@en,
        "Intervenções planejadas ou corretivas para preservar a funcionalidade e segurança do ativo."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Maintenance"@en,
        "Manutenção"@pt-br .

edo:MaintenancePoint a owl:Class ;
    dcterms:identifier "MaintenancePoint" ;
    rdfs:subClassOf edo:SupportPoint ;
    skos:definition "Represents a point designated for maintenance or inspection purposes."@en,
        "Representa um ponto designado para fins de manutenção ou inspeção."@pt-br ;
    skos:prefLabel "Maintenance Point"@en,
        "Ponto de Manutenção"@pt-br .

edo:MasterControlStation a owl:Class ;
    dcterms:identifier "MasterControlStation" ;
    rdfs:subClassOf edo:TopsideEquipment ;
    skos:definition "Topside electrical panel for controlling subsea multiplexed systems"@en,
        "Painel elétrico de superfície que efetua o controle de sistemas multiplexados submarinos"@pt-br ;
    skos:prefLabel "Master control station"@en,
        "Estação de controle mestra"@pt-br .

edo:Mattress a owl:Class ;
    dcterms:identifier "Mattress" ;
    rdfs:subClassOf edo:PipeSupport ;
    skos:definition "Malleable mattress used to provide support or weight over a section of pipe"@en,
        "Manta maleável usada para prover suporte ou peso sobre uma seção de duto"@pt-br ;
    skos:prefLabel "Mattress"@en,
        "Manta"@pt-br .

edo:MeasuredValue a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "MeasuredValue" ;
    skos:broader edo:AttributeValueOrigins ;
    skos:definition "Value obtained by direct or indirect measurement."@en,
        "Valor obtido por medição direta ou indireta."@pt-br ;
    skos:inScheme edo:DomainAttributeValueOrigin ;
    skos:prefLabel "Measured value"@en,
        "Valor medido"@pt-br .

edo:MetallicMaterialSpecification a owl:Class ;
    dcterms:identifier "MetallicMaterialSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:MetallicLayerMaterialType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FractureToughness ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:UltimateTensileStress ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:MaterialSpecification ;
    skos:definition "A material specification for a material whose principal constituent or structural phase is metallic."@en,
        "Especificação de material cujo constituinte principal ou fase estrutural é metálica."@pt-br ;
    skos:prefLabel "Metallic Material Specification"@en,
        "Especificação de Material Metálico"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:MetallicTubing a owl:Class ;
    dcterms:identifier "MetallicTubing" ;
    rdfs:subClassOf edo:Tubing ;
    skos:definition "Represents a metallic tube used for fluid transmission or structural support within an umbilical function line."@en,
        "Representa um tubo metálico utilizado para transmissão de fluido ou suporte estrutural dentro de uma linha funcional umbilical."@pt-br ;
    skos:prefLabel "Metallic Tubing"@en,
        "Metallic tubing"@en,
        "Tubulação Metálica"@pt-br,
        "Tubulação metálica"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:MetricThreadedFastenerSet a owl:Class ;
    dcterms:identifier "MetricThreadedFastenerSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ThreadPitch ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:ThreadedFastenerSet ;
    skos:definition "A threaded fastener set specified according to a metric thread system, in which thread spacing is expressed by pitch."@en,
        "Conjunto de fixadores roscados especificado segundo um sistema de rosca métrico, no qual o espaçamento da rosca é expresso pelo passo."@pt-br ;
    skos:prefLabel "Metric Threaded Fastener Set"@en,
        "Conjunto de Fixadores Roscados Métrico"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:Midstream a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Midstream"@en,
        "Midstream"@pt-br ;
    skos:broader edo:OilAndGas ;
    skos:definition "Oil & Gas sector covering transportation, storage, and wholesale marketing of crude or refined petroleum products."@en,
        "Setor de Petróleo & Gás que abrange transporte, armazenamento e comercialização atacadista de produtos petrolíferos brutos ou refinados."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:NonProjectInstantiableClass a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "NonProjectInstantiableClass" ;
    skos:broader edo:ClassInstantiationRoles ;
    skos:definition "Class not intended to be instantiated as an occurrence in project or asset information models."@en,
        "Classe não destinada a ser instanciada como ocorrência em modelos de informação de projetos ou ativos."@pt-br ;
    skos:inScheme edo:ClassInstantiationRoleScheme ;
    skos:prefLabel "Non-project-instantiable class"@en,
        "Classe não instanciável em projeto"@pt-br .

edo:NuclearFuelCycle a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Nuclear Fuel Cycle"@en,
        "Ciclo do Combustível Nuclear"@pt-br ;
    skos:broader edo:Nuclear ;
    skos:definition "Processes involved in mining, processing, enrichment, and disposal of nuclear fuel."@en,
        "Processos envolvidos na mineração, processamento, enriquecimento e descarte de combustível nuclear."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:NuclearPowerGeneration a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Nuclear Power Generation"@en,
        "Geração de Energia Nuclear"@pt-br ;
    skos:broader edo:Nuclear ;
    skos:definition "Operation and maintenance of nuclear power plants for electricity production."@en,
        "Operação e manutenção de usinas nucleares para produção de eletricidade."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:OceanCurrents a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OceanCurrents" ;
    skos:broader edo:Marine ;
    skos:definition "Ocean currents energy harnesses the continuous flow of ocean water masses driven by wind, temperature, salinity and Earth’s rotation. Turbines placed in strategic marine passages can capture this steady and predictable resource to generate renewable electricity."@en,
        "Energia das correntes oceânicas aproveita o fluxo contínuo das massas de água do oceano impulsionado por ventos, temperatura, salinidade e rotação da Terra. Turbinas instaladas em passagens marítimas estratégicas podem capturar esse recurso constante e previsível para gerar eletricidade renovável."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Ocean Currents Energy"@en,
        "Energia das Correntes Oceânicas"@pt-br .

edo:OceanThermal a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OceanThermal" ;
    skos:broader edo:Marine ;
    skos:definition "Ocean thermal energy conversion (OTEC) exploits the temperature difference between warm surface waters and cold deep waters to drive a thermodynamic cycle and produce electricity. It offers a vast, largely untapped renewable energy potential in tropical regions."@en,
        "A conversão de energia térmica oceânica (OTEC) explora a diferença de temperatura entre as águas superficiais quentes e as águas profundas frias para acionar um ciclo termodinâmico e produzir eletricidade. Oferece um vasto potencial de energia renovável ainda pouco explorado em regiões tropicais."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Ocean Thermal Energy Conversion"@en,
        "Conversão de Energia Térmica Oceânica"@pt-br .

edo:Offshore a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Offshore"@en,
        "Offshore"@pt-br ;
    skos:broader edo:LocationType ;
    skos:definition "Industrial activities conducted at sea, typically for oil & gas or wind energy production."@en,
        "Atividades industriais realizadas no mar, tipicamente para produção de petróleo & gás ou energia eólica."@pt-br ;
    skos:inScheme edo:LocationTypeScheme .

edo:OffshoreWind a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OffshoreWind" ;
    skos:broader edo:Wind ;
    skos:definition "Offshore wind energy is generated by turbines located in bodies of water, usually in shallow coastal areas, where winds are stronger and more stable, enabling large-scale power generation."@en,
        "Energia eólica offshore é gerada por turbinas localizadas em corpos d’água, geralmente em áreas costeiras rasas, onde os ventos são mais fortes e estáveis, permitindo a geração de energia em grande escala."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Offshore Wind"@en,
        "Eólica Offshore"@pt-br .

edo:OilAndGasDevelopment a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OilAndGasDevelopment" ;
    skos:broader edo:Upstream ;
    skos:definition "Oil and gas development refers to the planning, engineering, construction, and commissioning of facilities to exploit discovered hydrocarbon resources. It includes drilling development wells, installing production facilities, and establishing supporting infrastructure to enable extraction and processing."@en,
        "Desenvolvimento de óleo e gás refere-se ao planejamento, engenharia, construção e comissionamento de instalações para explorar recursos hidrocarbonetos descobertos. Inclui perfuração de poços de desenvolvimento, instalação de instalações de produção e estabelecimento de infraestrutura de apoio para permitir extração e processamento."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Oil and Gas Development"@en,
        "Desenvolvimento de Óleo e Gás"@pt-br .

edo:OilAndGasDistribution a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OilAndGasDistribution" ;
    skos:broader edo:Downstream ;
    skos:definition "Oil and gas distribution covers the transportation, storage, and delivery of petroleum products from processing facilities to end users. It involves pipelines, terminals, tankers, and associated logistics to ensure safe, reliable, and efficient supply of fuels and feedstocks."@en,
        "Distribuição de óleo e gás abrange o transporte, armazenamento e entrega de produtos petrolíferos das unidades de processamento até os consumidores finais. Envolve dutos, terminais, navios-tanque e logística associada para garantir fornecimento seguro, confiável e eficiente de combustíveis e matérias-primas."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Oil and Gas Distribution"@en,
        "Distribuição de Óleo e Gás"@pt-br .

edo:OilAndGasExploration a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OilAndGasExploration" ;
    skos:broader edo:Upstream ;
    skos:definition "Oil and gas exploration involves identifying and evaluating potential hydrocarbon reserves using geological, geophysical, and geochemical methods. Activities include seismic surveys, exploratory drilling, and reservoir characterization to assess the viability of extraction."@en,
        "Exploração de óleo e gás envolve a identificação e avaliação de potenciais reservas de hidrocarbonetos usando métodos geológicos, geofísicos e geoquímicos. As atividades incluem levantamentos sísmicos, perfuração exploratória e caracterização de reservatórios para avaliar a viabilidade da extração."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Oil and Gas Exploration"@en,
        "Exploração de Óleo e Gás"@pt-br .

edo:OilAndGasProduction a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OilAndGasProduction" ;
    skos:broader edo:Upstream ;
    skos:definition "Oil and gas production encompasses the extraction of hydrocarbons from reservoirs, including well operations, artificial lift, and initial processing to separate oil, gas, and water. It ensures the continuous supply of raw materials for downstream processing and energy generation."@en,
        "Produção de óleo e gás engloba a extração de hidrocarbonetos dos reservatórios, incluindo operações de poços, elevação artificial e processamento inicial para separar óleo, gás e água. Garante o fornecimento contínuo de matérias-primas para processamento downstream e geração de energia."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Oil and Gas Production"@en,
        "Produção de Óleo e Gás"@pt-br .

edo:OilAndGasRefining a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OilAndGasRefining" ;
    skos:broader edo:Downstream ;
    skos:definition "Oil and gas refining involves the conversion of crude oil and natural gas liquids into usable products such as gasoline, diesel, jet fuel, and petrochemicals. Refining processes include distillation, cracking, reforming, and treatment to meet product specifications and environmental standards."@en,
        "Refino de óleo e gás envolve a conversão de petróleo bruto e líquidos de gás natural em produtos utilizáveis, como gasolina, diesel, querosene e petroquímicos. Os processos de refino incluem destilação, craqueamento, reforma e tratamento para atender especificações de produtos e padrões ambientais."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Oil and Gas Refining"@en,
        "Refino de Óleo e Gás"@pt-br .

edo:Onshore a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Onshore"@en,
        "Onshore"@pt-br ;
    skos:broader edo:LocationType ;
    skos:definition "Industrial activities conducted on land."@en,
        "Atividades industriais realizadas em terra."@pt-br ;
    skos:inScheme edo:LocationTypeScheme .

edo:OnshoreWind a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "OnshoreWind" ;
    skos:broader edo:Wind ;
    skos:definition "Onshore wind energy is produced by wind turbines installed on land, typically in areas with high and consistent wind resources. It is one of the most mature and cost-effective renewable energy sources."@en,
        "Energia eólica onshore é produzida por turbinas eólicas instaladas em terra, geralmente em regiões com recursos eólicos elevados e consistentes. É uma das fontes de energia renovável mais maduras e economicamente viáveis."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Onshore Wind"@en,
        "Eólica Onshore"@pt-br .

edo:OpenReceptacle a owl:Class ;
    dcterms:identifier "OpenReceptacle" ;
    rdfs:subClassOf edo:RiserSupport ;
    skos:prefLabel "Open receptacle"@en,
        "Receptáculo aberto"@pt-br .

edo:OperatingBendingRadius a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OperatingBendingRadius" ;
    rdfs:subClassOf edo:BendingRadius ;
    skos:definition "Bending radius associated with an operating condition of the component or system."@en,
        "Raio de curvatura associado a uma condição operacional do componente ou sistema."@pt-br ;
    skos:prefLabel "Operating Bending Radius"@en,
        "Raio de curvatura operacional"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:BendingRadius .

edo:OperatingBurstPressure a owl:Class ;
    dcterms:identifier "OperatingBurstPressure" ;
    rdfs:subClassOf edo:BurstPressure ;
    skos:definition "Burst pressure value used, monitored, or assessed in an operational context."@en ;
    skos:prefLabel "Operating Burst Pressure"@en,
        "Pressão de Ruptura Operacional"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:BurstPressure .

edo:OperatingCollapsePressure a owl:Class ;
    dcterms:identifier "OperatingCollapsePressure" ;
    rdfs:subClassOf edo:CollapsePressure ;
    skos:definition "Collapse pressure value used, monitored, or assessed in an operational context."@en ;
    skos:prefLabel "Operating Collapse Pressure"@en,
        "Pressão de Colapso Operacional"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:CollapsePressure .

edo:OperatingTension a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "OperatingTension" ;
    rdfs:subClassOf edo:Tension ;
    skos:definition "Tensile force associated with an operating condition of the component or system."@en,
        "Força de tração associada a uma condição operacional do componente ou sistema."@pt-br ;
    skos:prefLabel "Operating Tension"@en,
        "Tração operacional"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:Tension .

edo:Operation a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Operation" ;
    skos:broader edo:OperationPhase ;
    skos:definition "Normal use of the asset for its intended purpose, including monitoring and control."@en,
        "Uso normal do ativo para seu propósito pretendido, incluindo monitoramento e controle."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Operation"@en,
        "Operação"@pt-br .

edo:OverrideTool a owl:Class ;
    dcterms:identifier "OverrideTool" ;
    rdfs:subClassOf edo:ROVTool ;
    skos:prefLabel "Override Tool"@en,
        "Ferramenta de Override"@pt-br .

edo:PLEM a owl:Class ;
    dcterms:identifier "PLEM" ;
    rdfs:subClassOf edo:Manifold ;
    skos:definition "Manifold installed at the end of a rigid pipeline, also serving as an anchoring element"@en,
        "Manifold instalado no final de uma linha rígida, servindo também como elemento de ancoragem"@pt-br ;
    skos:prefLabel "PLEM"@en,
        "PLEM"@pt-br ;
    edo:hasDiscipline edo:SubseaManifoldsEngineering .

edo:PLET a owl:Class ;
    dcterms:identifier "PLET" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    skos:definition "Equipment for pipeline termination and anchoring, offering an interface for external connection"@en,
        "Equipamento para terminação e ancoragem de um duto que oferece uma interface para conexão externa"@pt-br ;
    skos:prefLabel "PLET"@en,
        "PLET"@pt-br ;
    edo:hasDiscipline edo:SubseaManifoldsEngineering .

edo:PackageEquipmentEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Package Equipment Engineering"@en,
        "Engenharia de Equipamentos Modulares"@pt-br ;
    skos:broader edo:EquipmentEngineering ;
    skos:definition "Engineering of skid-mounted or modular equipment systems."@en,
        "Engenharia de sistemas de equipamentos modulares ou montados em skids."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:PanelElectricalConnector a owl:Class ;
    dcterms:identifier "PanelElectricalConnector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalConnectorPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:PanelConnector ;
    skos:definition "Panel-mounted or otherwise stationary connector whose connection points are electrical connector ports. The class describes installation context and connector technology without classifying the connector as exclusively control or power, allowing hybrid electrical connector arrangements when required."@en,
        "Conector montado em painel ou em outra posição estacionária cujos pontos de conexão são portas de conector elétrico. A classe descreve o contexto de instalação e a tecnologia do conector sem classificá-lo como exclusivamente de controle ou potência, permitindo arranjos de conectores elétricos híbridos quando necessário."@pt-br ;
    skos:prefLabel "Panel Electrical Connector"@en,
        "Conector Elétrico de Painel"@pt-br .

edo:PanelOpticalConnector a owl:Class ;
    dcterms:identifier "PanelOpticalConnector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalConnectorPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:PanelConnector ;
    skos:definition "Panel-mounted or otherwise stationary connector whose connection points are optical connector ports. The class describes installation context and optical connector technology without prescribing a specific connector family or project mating pair."@en,
        "Conector montado em painel ou em outra posição estacionária cujos pontos de conexão são portas de conector óptico. A classe descreve o contexto de instalação e a tecnologia de conector óptico sem prescrever uma família específica de conector ou um par de acoplamento de projeto."@pt-br ;
    skos:prefLabel "Panel Optical Connector"@en,
        "Conector Óptico de Painel"@pt-br .

edo:Person a owl:Class ;
    dcterms:identifier "Person" ;
    rdfs:subClassOf edo:Agent ;
    skos:definition "An individual human agent that may participate in domain activities and assume responsibilities or authorship."@en,
        "Agente humano individual que pode participar de atividades do domínio e assumir responsabilidades ou autoria."@pt-br ;
    skos:prefLabel "Person"@en,
        "Pessoa"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:Photovoltaic a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Photovoltaic" ;
    skos:broader edo:Solar ;
    skos:definition "Photovoltaic energy is generated by converting sunlight directly into electricity using semiconductor materials such as silicon. It is one of the fastest growing renewable technologies, applicable at scales ranging from rooftop panels to utility-scale solar farms."@en,
        "Energia fotovoltaica é gerada pela conversão direta da luz solar em eletricidade usando materiais semicondutores como o silício. É uma das tecnologias renováveis de crescimento mais rápido, aplicável em escalas que variam de telhados residenciais a grandes usinas solares."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Photovoltaic"@en,
        "Fotovoltaica"@pt-br .

edo:PhysicalPropertyAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PhysicalPropertyAttribute" ;
    skos:broader edo:AttributeCategories ;
    skos:definition "Attribute category related to intrinsic physical properties such as mass, density or material."@en,
        "Categoria de atributo relacionada a propriedades físicas intrínsecas, como massa, densidade ou material."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory ;
    skos:prefLabel "Physical property attribute"@en,
        "Atributo de propriedade física"@pt-br .

edo:PipeMechanicalSupport a owl:Class ;
    dcterms:identifier "PipeMechanicalSupport" ;
    rdfs:subClassOf edo:PipeSupport .

edo:PipeMountPosition a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "PipeMountPosition" ;
    dcterms:isReplacedBy edo:RequiredLongitudinalPosition ;
    rdfs:subClassOf edo:Position ;
    owl:deprecated true ;
    skos:definition "Indicates the distance from the end fitting to the position of the accessory along the direction of fluid flow within the pipe body. This property specifies the precise location of the accessory relative to the end fitting, which is essential for accurate installation and alignment within the tubular body."@en,
        "Cota em metros da posição em que o item é montado no tramo no sentido do fluxo do fluido."@pt-br ;
    skos:prefLabel "Pipe Mount Position"@en,
        "Posição de Montagem no Duto"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:LocationAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Position .

edo:PipePullingHead a owl:Class ;
    dcterms:identifier "PipePullingHead" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:SafeWorkingLoad ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FlangeType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketMaterial ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketPressureRating ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketSpecification ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketOuterDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PullingHeadType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketStandard ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RingGasketInnerDIameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PullingHead ;
    skos:altLabel "Cable Head"@en,
        "Installation Head"@en,
        "Pull Head"@en,
        "Pulling Grip"@en,
        "Pulling Tool"@en ;
    skos:definition "A component used in subsea flexible pipe installations to provide a secure attachment point for pulling the pipe into position during installation or retrieval operations. The Pulling Head is fitted to the end of the flexible pipe, allowing connection to pulling equipment such as winches or cranes. It is designed to withstand high loads, ensuring that the pipe can be pulled safely without causing damage. The Pulling Head is essential for handling, testing, and securing the pipe in place during subsea installation."@en,
        "Cabeça de tração tipo tampa, usada para dutos flexíveis etc."@pt-br ;
    skos:prefLabel "Pipe Pulling Head"@en,
        "Cabeça de Tração do Duto"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:PipingSpool a owl:Class ;
    dcterms:identifier "PipingSpool" ;
    rdfs:subClassOf edo:PressureComponent ;
    skos:definition "Piping section internal to some equipment"@en,
        "Trecho de tubulação interno a um equipamento"@pt-br ;
    skos:prefLabel "Piping spool"@en,
        "Trecho de tubulação"@pt-br .

edo:PlasticHose a owl:Class ;
    dcterms:identifier "PlasticHose" ;
    rdfs:subClassOf edo:Tubing ;
    skos:definition "Represents a plastic hose used within tubing for fluid transport, typically flexible and lightweight."@en,
        "Representa uma mangueira plástica utilizada em tubulações para transporte de fluido, tipicamente flexível e leve."@pt-br ;
    skos:prefLabel "Plastic Hose"@en,
        "Mangueira Plástica"@pt-br,
        "Mangueira plástica"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:PolymericMaterialSpecification a owl:Class ;
    dcterms:identifier "PolymericMaterialSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:DiffusionTable_MoleculeIdentifier ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SolubilityTable_MoleculeIdentifier ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DiffusionTable_DiffusionCoefficient ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SolubilityTable_SolubilityCoefficient ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SolubilityTable_PolymerState ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PermeabilityTable_MoleculeIdentifier ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SolubilityTable ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PermeabilityTable ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PermeabilityTable_PermeabilityCoefficient ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PermeabilityTable_Temperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SolubilityTable_Temperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:EModVsTempTable_Temperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MinimumTemperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PolymericLayerMaterialType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaxPermissibleDeformationDynamic ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:EModVsTempTable_ElasticityModulus ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DiffusionTable_Temperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:PermeabilityTable_PolymerState ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DiffusionTable_PolymerState ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaxPermissibleDeformationStatic ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:DiffusionTable ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:MaterialSpecification ;
    skos:definition "A material specification for a material whose principal constituent is a polymer."@en,
        "Especificação de material cujo constituinte principal é um polímero."@pt-br ;
    skos:prefLabel "Polymeric Material Specification"@en,
        "Especificação de Material Polimérico"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:PowerContact a owl:Class ;
    dcterms:identifier "PowerContact" ;
    rdfs:subClassOf edo:ElectricalContact ;
    skos:definition "Electrical contact whose represented function includes transmission of electrical power to a load or power distribution path."@en,
        "Contato elétrico cuja função representada inclui transmissão de potência elétrica para uma carga ou caminho de distribuição de potência."@pt-br ;
    skos:prefLabel "Power Contact"@en,
        "Contato de Potência"@pt-br .

edo:PreCommissioning a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PreCommissioning" ;
    skos:broader edo:ConstructionPhase ;
    skos:definition "Verification and functional testing before introducing operational fluids or energy."@en,
        "Verificação e testes funcionais antes da introdução de fluidos ou energia operacionais."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Pre-Commissioning"@en,
        "Pré-Comissionamento"@pt-br .

edo:PreservationOrder a owl:Class ;
    dcterms:identifier "PreservationOrder" ;
    rdfs:subClassOf edo:InformationArtifact ;
    skos:definition "An information artifact specifying one or more preservation actions to be performed on a domain element in order to maintain its required condition."@en,
        "Artefato informacional que especifica uma ou mais ações de preservação a serem executadas sobre um elemento do domínio para manter sua condição requerida."@pt-br ;
    skos:prefLabel "Preservation Order"@en,
        "Ordem de Preservação"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:PressureArmour a owl:Class ;
    dcterms:identifier "PressureArmour" ;
    rdfs:subClassOf edo:CarcassLayer ;
    skos:definition "A high-strength, metallic layer used in subsea flexible pipes to provide resistance against both internal and external pressure. The Pressure Armour prevents the pipe from expanding under high internal pressures and protects against collapse due to external pressure. Typically made from helically wound steel or other strong materials, it supports the pipe's structural integrity and ensures reliable operation in harsh subsea environments."@en ;
    skos:prefLabel "Pressure Armour"@en,
        "Armadura de Pressão"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:PressureSensor a owl:Class ;
    dcterms:identifier "PressureSensor" ;
    rdfs:subClassOf edo:Sensor ;
    skos:prefLabel "Pressure sensor"@en,
        "Sensor de pressão"@pt-br .

edo:ProcessEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Process Engineering"@en,
        "Engenharia de Processos"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on the design and optimization of industrial processes."@en,
        "Disciplina de engenharia focada no projeto e otimização de processos industriais."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:ProcessPipeSpec a owl:Class ;
    rdfs:subClassOf edo:Specification ;
    skos:definition "Represents the specification for process pipes, including materials, pressure ratings, dimensions, and standards for industrial processes."@en,
        "Representa a especificação para tubulação de processo, incluindo materiais, classes de pressão, dimensões e normas para processos industriais."@pt-br ;
    skos:prefLabel "Process Pipe Specification"@en,
        "Especificação de Tubo de Processo"@pt-br .

edo:ProcessPipingEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Process Piping Engineering"@en,
        "Engenharia de Tubulação de Processo"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on the design of piping systems for process fluids."@en,
        "Disciplina de engenharia focada no projeto de sistemas de tubulação para fluidos de processo."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:Procurement a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Procurement" ;
    skos:broader edo:ConstructionPhase ;
    skos:definition "Acquisition of materials, equipment, and services required for project execution."@en,
        "Aquisição de materiais, equipamentos e serviços necessários para execução do projeto."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Procurement"@en,
        "Aquisição"@pt-br .

edo:Program a owl:Class ;
    dcterms:identifier "Program" ;
    rdfs:subClassOf edo:InformationArtifact ;
    skos:definition "An information artifact that organises a coordinated set of processes, activities, tasks, milestones or responsibilities oriented towards a defined objective."@en,
        "Artefato informacional que organiza um conjunto coordenado de processos, atividades, tarefas, marcos ou responsabilidades orientados a um objetivo definido."@pt-br ;
    skos:prefLabel "Program"@en,
        "Programa"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:PropagateAttributesToRelationship a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PropagateAttributesToRelationship" ;
    skos:broader edo:DomainValueConcepts ;
    skos:definition "Propagation strategy indicating that attributes should be projected to the materialised relationship when activated by an extraction profile or data contract."@en,
        "Estratégia de propagação que indica que atributos devem ser projetados para o relacionamento materializado quando ativada por um perfil de extração ou data contract."@pt-br ;
    skos:inScheme edo:DomainValueConcept ;
    skos:prefLabel "Propagate attributes to relationship"@en,
        "Propagar atributos para o relacionamento"@pt-br .

edo:PropagateAttributesToSource a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PropagateAttributesToSource" ;
    skos:broader edo:DomainValueConcepts ;
    skos:definition "Propagation strategy indicating that attributes should be projected to the source entity of the contextual relation when activated by an extraction profile or data contract."@en,
        "Estratégia de propagação que indica que atributos devem ser projetados para a entidade de origem da relação contextual quando ativada por um perfil de extração ou data contract."@pt-br ;
    skos:inScheme edo:DomainValueConcept ;
    skos:prefLabel "Propagate attributes to source"@en,
        "Propagar atributos para a origem"@pt-br .

edo:PropagateAttributesToTarget a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PropagateAttributesToTarget" ;
    skos:broader edo:DomainValueConcepts ;
    skos:definition "Propagation strategy indicating that attributes should be projected to the target entity of the contextual relation when activated by an extraction profile or data contract."@en,
        "Estratégia de propagação que indica que atributos devem ser projetados para a entidade de destino da relação contextual quando ativada por um perfil de extração ou data contract."@pt-br ;
    skos:inScheme edo:DomainValueConcept ;
    skos:prefLabel "Propagate attributes to target"@en,
        "Propagar atributos para o destino"@pt-br .

edo:ProtectiveEarthContact a owl:Class ;
    dcterms:identifier "ProtectiveEarthContact" ;
    rdfs:subClassOf edo:ElectricalContact ;
    skos:definition "Electrical contact whose represented function includes protective earthing or protective bonding continuity."@en,
        "Contato elétrico cuja função representada inclui aterramento de proteção ou continuidade de equipotencialização de proteção."@pt-br ;
    skos:prefLabel "Protective Earth Contact"@en,
        "Contato de Terra de Proteção"@pt-br .

edo:ProtectiveSheath a owl:Class ;
    dcterms:identifier "ProtectiveSheath" ;
    rdfs:subClassOf edo:SolidLayer ;
    skos:altLabel "Outer Sheath" ;
    skos:definition "A layer in subsea flexible pipes designed to shield internal components from external environmental factors such as abrasion, mechanical damage, or chemical exposure. The Protective Sheath serves as the outermost barrier, providing defense against harsh subsea conditions while preserving the integrity of the underlying layers. Typically made from durable polymeric materials, it plays a critical role in extending the lifespan of the flexible pipe by protecting it from physical and chemical wear."@en ;
    skos:prefLabel "Protective Sheath"@en,
        "Capa de Proteção"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:PullInCollar a owl:Class ;
    dcterms:identifier "PullInCollar" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:WireRopeSlingLength ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:WireRopeQuantity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:WireRopeSlingDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:SplitCollar ;
    skos:altLabel "Installation Collar"@en,
        "Pull-In Clamp"@en,
        "Pulling Collar"@en,
        "Tension Collar"@en ;
    skos:definition "A device used in subsea operations to assist in the installation of flexible pipes or risers by providing a secure attachment point for pulling the pipe into position. The Pull-In Collar is typically installed around the pipe and serves as a handling point for pulling equipment during installation. It ensures a controlled and secure method of pulling the pipe into place, preventing damage to the pipe while facilitating smooth and efficient installation in subsea environments."@en ;
    skos:prefLabel "Pull-In Collar"@en,
        "Colar de Pull-In"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:Pump a owl:Class ;
    dcterms:identifier "Pump" ;
    rdfs:subClassOf edo:RotatingMachine ;
    skos:prefLabel "Pump"@en,
        "Bomba"@pt-br .

edo:PumpedStorage a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "PumpedStorage" ;
    skos:broader edo:Hydropower ;
    skos:definition "Pumped storage hydropower stores energy by pumping water from a lower reservoir to a higher one during low demand, and releasing it through turbines to generate electricity during peak demand. It acts as a large-scale energy storage system."@en,
        "Hidrelétricas de bombeamento armazenam energia ao bombear água de um reservatório inferior para um superior em períodos de baixa demanda, liberando-a através de turbinas para gerar eletricidade em períodos de pico. Funcionam como um sistema de armazenamento de energia em larga escala."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Pumped Storage"@en,
        "Hidrelétrica de Bombeamento"@pt-br .

edo:PumpingModule a owl:Class ;
    dcterms:identifier "PumpingModule" ;
    rdfs:subClassOf edo:ProcessingModule ;
    skos:definition "Fluid pumping module installed as part of some larger equipment"@en,
        "Módulo com função de bombeamento de fluidos instalado como parte de um equipamento maior"@pt-br ;
    skos:prefLabel "Pumping module"@en,
        "Módulo de bombeamento"@pt-br .

edo:QuickConnectCoupling a owl:Class ;
    dcterms:identifier "QuickConnectCoupling" ;
    rdfs:subClassOf edo:TubingCoupling ;
    skos:definition "Quick connect coupling used to connect or disconnect fluid or gas lines in a practical and safe way, ensuring sealing and minimising leakage during operation."@en,
        "Acoplamento de engate rápido utilizado para conectar ou desconectar linhas de fluido ou gás de forma prática e segura, garantindo vedação e minimizando vazamentos durante a operação."@pt-br ;
    skos:prefLabel "Quick Connect Coupling"@en,
        "Engate Rápido"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:QuickDisconnectionTool a owl:Class ;
    dcterms:identifier "QuickDisconnectionTool" ;
    rdfs:subClassOf edo:RunningTool ;
    skos:prefLabel "Quick disconnection tool"@en,
        "Ferramenta de desconexão rápida"@pt-br .

edo:RearPoint a owl:Class ;
    dcterms:identifier "RearPoint" ;
    rdfs:subClassOf edo:SupportRegion ;
    skos:definition "The rear part of the component can be used to secure the element during installation, ensuring it remains firmly in place throughout the process. The Rear Point provides a reference on the rear part along the component's centre line, facilitating precise alignment and positioning required for proper installation."@en,
        "A parte traseira do componente pode ser utilizada para travar o elemento durante a instalação, garantindo que ele permaneça firmemente no lugar durante o processo. O Ponto Traseiro fornece uma referência na parte posterior ao longo da linha de centro do componente, facilitando o alinhamento e o posicionamento precisos necessários para uma instalação adequada."@pt-br ;
    skos:prefLabel "Rear Point"@en,
        "Ponto Traseiro"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:Recycling a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Recycling" ;
    skos:broader edo:DecommissioningPhase ;
    skos:definition "Processing and reusing materials recovered during decommissioning."@en,
        "Processamento e reutilização de materiais recuperados durante o descomissionamento."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Recycling"@en,
        "Reciclagem"@pt-br .

edo:ReferencePoint a owl:Class ;
    dcterms:identifier "ReferencePoint" ;
    rdfs:subClassOf edo:Feature ;
    skos:definition "Feature used as a reference point for orientation, positioning, measurement or interpretation of another feature or element."@en,
        "Feature usada como ponto de referência para orientação, posicionamento, medição ou interpretação de outra feature ou elemento."@pt-br ;
    skos:prefLabel "Reference Point"@en,
        "Ponto de Referência"@pt-br .

edo:ReliefValve a owl:Class ;
    dcterms:identifier "ReliefValve" ;
    rdfs:subClassOf edo:CheckValve ;
    skos:definition "Automatic pressure relief valve"@en,
        "Válvula automática de alívio de pressão"@pt-br ;
    skos:prefLabel "Relief valve"@en,
        "Válvula de alívio"@pt-br .

edo:RemainingDesignLife a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RemainingDesignLife" ;
    rdfs:subClassOf edo:DesignLife ;
    skos:definition "Remaining service life estimated or recorded for the component or system during operation, inspection or integrity assessment."@en,
        "Vida útil remanescente estimada ou registrada para o componente ou sistema durante operação, inspeção ou avaliação de integridade."@pt-br ;
    skos:prefLabel "Remaining Design Life"@en,
        "Vida útil remanescente"@pt-br ;
    edo:attributeNature edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:YR ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:DesignLife .

edo:RemainingFatigueLife a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RemainingFatigueLife" ;
    rdfs:subClassOf edo:FatigueLife ;
    skos:definition "Remaining fatigue life estimated or recorded for the component or system during operation, inspection or integrity assessment."@en,
        "Vida à fadiga remanescente estimada ou registrada para o componente ou sistema durante operação, inspeção ou avaliação de integridade."@pt-br ;
    skos:prefLabel "Remaining Fatigue Life"@en,
        "Vida à fadiga remanescente"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:YR ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:OperatingRole ;
    edo:specializesAttribute edo:FatigueLife .

edo:ReplacedConcept a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ReplacedConcept" ;
    skos:broader edo:ConceptStatuses ;
    skos:definition "Deprecated concept that has an explicit replacement concept."@en,
        "Conceito depreciado que possui um conceito substituto explícito."@pt-br ;
    skos:inScheme edo:ConceptStatusScheme ;
    skos:prefLabel "Replaced concept"@en,
        "Conceito substituído"@pt-br .

edo:RequiredBurstPressure a owl:Class ;
    dcterms:identifier "RequiredBurstPressure" ;
    rdfs:subClassOf edo:BurstPressure ;
    skos:definition "Required burst pressure that an element, component, or system shall satisfy."@en ;
    skos:prefLabel "Required Burst Pressure"@en,
        "Pressão de Ruptura Requerida"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:BurstPressure .

edo:RequiredCollapsePressure a owl:Class ;
    dcterms:identifier "RequiredCollapsePressure" ;
    rdfs:subClassOf edo:CollapsePressure ;
    skos:definition "Required collapse pressure that an element, component, or system shall satisfy."@en ;
    skos:prefLabel "Required Collapse Pressure"@en,
        "Pressão de Colapso Requerida"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:CollapsePressure .

edo:RequiredDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredDiameter" ;
    rdfs:subClassOf edo:Diameter ;
    skos:definition "Diameter required by the owner, project, contract, standard or data contract."@en,
        "Diâmetro requerido pelo proprietário, projeto, contrato, norma ou contrato de dados."@pt-br ;
    skos:prefLabel "Required Diameter"@en,
        "Diâmetro requerido"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:Diameter .

edo:RequiredDisplacedVolume a owl:Class ;
    dcterms:identifier "RequiredDisplacedVolume" ;
    rdfs:subClassOf edo:DisplacedVolume ;
    skos:definition "Required displaced volume that an element or component shall satisfy."@en ;
    skos:prefLabel "Required Displaced Volume"@en,
        "Volume Deslocado Requerido"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:DisplacedVolume .

edo:RequiredFatigueLife a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredFatigueLife" ;
    rdfs:subClassOf edo:FatigueLife ;
    skos:definition "Fatigue life required by a data contract, project requirement or owner specification."@en,
        "Vida à fadiga requerida por contrato de dados, requisito de projeto ou especificação do proprietário."@pt-br ;
    skos:prefLabel "Required Fatigue Life"@en,
        "Vida à fadiga requerida"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:YR ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:FatigueLife .

edo:RequiredInternalVolume a owl:Class ;
    dcterms:identifier "RequiredInternalVolume" ;
    rdfs:subClassOf edo:InternalVolume ;
    skos:definition "Required internal volume that an element, component, or system shall satisfy."@en ;
    skos:prefLabel "Required Internal Volume"@en,
        "Volume Interno Requerido"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute,
        edo:OperationalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:InternalVolume .

edo:RequiredLength a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredLength" ;
    rdfs:subClassOf edo:Length ;
    skos:definition "Length required by a data contract, project requirement or owner specification."@en,
        "Comprimento requerido por contrato de dados, requisito de projeto ou especificação do proprietário."@pt-br ;
    skos:prefLabel "Required Length"@en,
        "Comprimento requerido"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:Length .

edo:RequiredMass a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredMass" ;
    rdfs:subClassOf edo:Mass ;
    skos:definition "Required mass for an object or component."@en,
        "Massa requerida para um objeto ou componente."@pt-br ;
    skos:prefLabel "Required Mass"@en,
        "Massa Requerida"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:KiloGM ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:Mass .

edo:RequiredMaxPressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredMaxPressure" ;
    rdfs:subClassOf edo:MaxPressure ;
    skos:definition "Maximum pressure required by a data contract, project requirement or owner specification."@en,
        "Pressão máxima requerida por contrato de dados, requisito de projeto ou especificação do proprietário."@pt-br ;
    skos:prefLabel "Required Maximum Pressure"@en,
        "Pressão máxima requerida"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:MaxPressure .

edo:RequiredMaxTension a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredMaxTension" ;
    rdfs:subClassOf edo:MaxTension ;
    skos:definition "Maximum tensile force required by a data contract, project requirement or owner specification."@en,
        "Força máxima de tração requerida por contrato de dados, requisito de projeto ou especificação do proprietário."@pt-br ;
    skos:prefLabel "Required Max Tension"@en,
        "Tração máxima requerida"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:MaxTension .

edo:RequiredMinimumBendingRadius a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredMinimumBendingRadius" ;
    rdfs:subClassOf edo:MinimumBendingRadius ;
    skos:definition "Minimum bending radius required by a data contract, project requirement or owner specification."@en,
        "Raio mínimo de curvatura requerido por contrato de dados, requisito de projeto ou especificação do proprietário."@pt-br ;
    skos:prefLabel "Required Minimum Bending Radius"@en,
        "Raio mínimo de curvatura requerido"@pt-br ;
    edo:attributeNature edo:CapabilityAttribute,
        edo:DimensionalAttribute,
        edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:MinimumBendingRadius .

edo:RequiredThickness a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredThickness" ;
    rdfs:subClassOf edo:Thickness ;
    skos:definition "Thickness required by the owner, project, contract, standard or data contract."@en,
        "Espessura requerida pelo proprietário, projeto, contrato, norma ou contrato de dados."@pt-br ;
    skos:prefLabel "Required Thickness"@en,
        "Espessura requerida"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:Thickness .

edo:RequiredVolume a owl:Class ;
    dcterms:identifier "RequiredVolume" ;
    rdfs:subClassOf edo:Volume ;
    skos:definition "Required volume that an element, component, material, or system shall satisfy."@en ;
    skos:prefLabel "Required Volume"@en,
        "Volume Requerido"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M3 ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:Volume .

edo:RequiredWeight a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "RequiredWeight" ;
    rdfs:subClassOf edo:Weight ;
    skos:definition "Required weight for an object or component."@en,
        "Peso requerido para um objeto ou componente."@pt-br ;
    skos:prefLabel "Required Weight"@en,
        "Peso Requerido"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:N ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:RequirementRole ;
    edo:specializesAttribute edo:Weight .

edo:RigidJoint a owl:Class ;
    dcterms:identifier "RigidJoint" ;
    rdfs:subClassOf edo:LineAncillary ;
    skos:definition "Temporary accessory for connection between the armour pot and the bend stiffener below it, in order to prevent excessive line bending during handling operations."@en,
        "Acessório de uso temporário para conexão entre armor pot e enrijecedor abaixo dele, a fim de prevenir curvatura excessiva da linha durante operações de manuseio."@pt-br ;
    skos:prefLabel "Rigid Joint"@en,
        "Junta Rígida"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:RigidJumper a owl:Class ;
    dcterms:identifier "RigidJumper" ;
    rdfs:subClassOf edo:TieInEquipment ;
    skos:definition "Tie-in element composed of rigid piping and connectors, installed between subsea equipment hubs"@en,
        "Elemento de interligação composto de tubulação rígida e conectores, instalável entre hubs de equipamentos submarinos"@pt-br ;
    skos:prefLabel "Rigid jumper"@en,
        "Jumper rígido"@pt-br .

edo:RiserSpan a owl:Class ;
    dcterms:identifier "RiserSpan" ;
    rdfs:subClassOf edo:PipelineSpan ;
    skos:definition "Suspended pipeline span, continuously subjected to dynamic loading"@en,
        "Trecho de duto suspenso, sujeito continuamente a esforços dinâmicos"@pt-br ;
    skos:prefLabel "Riser span"@en,
        "Trecho riser"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:RiserSupportBuoy a owl:Class ;
    dcterms:identifier "RiserSupportBuoy" ;
    rdfs:subClassOf edo:BuoyancyTank ;
    skos:prefLabel "Riser support buoy"@en,
        "Bóia de sustentação de risers"@pt-br .

edo:RoboticActuator a owl:Class ;
    dcterms:identifier "RoboticActuator" ;
    rdfs:subClassOf edo:AuxiliaryModule ;
    skos:definition "Shared actuation system able to serve multiple final control elements (e.g. valves)"@en,
        "Sistema de atuação compartilhada capaz de servir a múltiplos elementos de controle finais (ex.: válvulas)"@pt-br ;
    skos:prefLabel "Robotic actuator"@en,
        "Atuador robótico"@pt-br .

edo:RotatingEquipmentEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Rotating Equipment Engineering"@en,
        "Engenharia de Equipamentos Rotativos"@pt-br ;
    skos:broader edo:EquipmentEngineering ;
    skos:definition "Engineering of mechanical equipment with rotating components such as pumps, compressors, and turbines."@en,
        "Engenharia de equipamentos mecânicos com componentes rotativos como bombas, compressores e turbinas."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:RunOfRiver a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "RunOfRiver" ;
    skos:broader edo:Hydropower ;
    skos:definition "Run-of-river hydropower plants generate electricity directly from the natural flow of rivers without creating large reservoirs, minimizing flooding but making output dependent on seasonal water levels."@en,
        "Usinas hidrelétricas a fio d’água geram eletricidade diretamente a partir do fluxo natural dos rios, sem criar grandes reservatórios, minimizando alagamentos mas tornando a produção dependente da sazonalidade hídrica."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Run-of-River Hydropower"@en,
        "Hidrelétrica a Fio d’Água"@pt-br .

edo:SCM a owl:Class ;
    dcterms:identifier "SCM" ;
    rdfs:subClassOf edo:AuxiliaryModule ;
    skos:definition "Distribution module for control and monitoring functions in subsea equipment"@en,
        "Módulo de distribuição de funções de controle e monitoramento em um equipamento submarino"@pt-br ;
    skos:prefLabel "Subsea control module"@en,
        "Módulo de controle submarino"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:SCMMB a owl:Class ;
    dcterms:identifier "SCMMB" ;
    rdfs:subClassOf edo:AuxiliaryModule ;
    skos:definition "Equipment for indirect SCM installation"@en,
        "Equipamento para instalação indireta de um SCM"@pt-br ;
    skos:prefLabel "SCM mounting base"@en,
        "Base de montagem de SCM"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:SCMRunningTool a owl:Class ;
    dcterms:identifier "SCMRunningTool" ;
    rdfs:subClassOf edo:RunningTool ;
    skos:prefLabel "SCM running tool"@en,
        "Ferramenta de instalação de SCM"@pt-br .

edo:SDU a owl:Class ;
    dcterms:identifier "SDU" ;
    rdfs:subClassOf edo:SubseaEquipment ;
    skos:prefLabel "Subsea distribution unit"@en,
        "Unidade de distribuição submarina"@pt-br .

edo:SEM a owl:Class ;
    dcterms:identifier "SEM" ;
    rdfs:subClassOf edo:ElectronicDevice ;
    skos:prefLabel "Subsea electronic module"@en,
        "Módulo eletrônico submarino"@pt-br .

edo:SacrificialSheath a owl:Class ;
    dcterms:identifier "SacrificialSheath" ;
    rdfs:subClassOf edo:SolidLayer ;
    skos:definition "A protective layer in subsea flexible pipes designed to absorb damage from external environmental factors, such as abrasion or impact, over time. The Sacrificial Sheath is intended to wear out or degrade under harsh conditions, thereby preserving the integrity of the underlying layers and prolonging the overall lifespan of the pipe. Made from durable materials, this sheath acts as the first line of defense, allowing for the controlled degradation of the pipe's outer surface without affecting its core structural or functional performance."@en ;
    skos:prefLabel "Sacrificial Sheath"@en,
        "Camada de Sacrifício"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:SafetyLossPreventionEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Safety & Loss Prevention Engineering"@en,
        "Engenharia de Segurança e Prevenção de Perdas"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on risk assessment, safety systems and loss prevention."@en,
        "Disciplina de engenharia focada em avaliação de riscos, sistemas de segurança e prevenção de perdas."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:SalinityGradient a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "SalinityGradient" ;
    skos:broader edo:Marine ;
    skos:definition "Salinity gradient energy, also called blue energy, is obtained by exploiting the difference in salt concentration between seawater and freshwater at estuaries. Technologies such as reverse electrodialysis or pressure-retarded osmosis can convert this chemical potential into renewable power."@en,
        "Energia de gradiente de salinidade, também chamada de energia azul, é obtida aproveitando a diferença de concentração de sal entre a água do mar e a água doce em estuários. Tecnologias como eletrodiálise reversa ou osmose com pressão retardada podem converter esse potencial químico em energia renovável."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Salinity Gradient Energy"@en,
        "Energia de Gradiente de Salinidade"@pt-br .

edo:SandDetector a owl:Class ;
    dcterms:identifier "SandDetector" ;
    rdfs:subClassOf edo:Sensor ;
    skos:prefLabel "Sand detector"@en,
        "Detector de areia"@pt-br .

edo:SeparatorVessel a owl:Class ;
    dcterms:identifier "SeparatorVessel" ;
    rdfs:subClassOf edo:Vessel ;
    skos:prefLabel "Seaparator vessel"@en,
        "Vaso separador"@pt-br .

edo:Shackle a owl:Class ;
    dcterms:identifier "Shackle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ShackleThickness ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:WorkingLoadLimit ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ShackleInnerDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ShackleOpeningWidth ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ShackleOuterDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:MooringAccessory ;
    skos:altLabel "Anchor Shackle"@en,
        "Bow Shackle"@en,
        "Clevis"@en,
        "D-Shackle"@en,
        "U-Bolt"@en ;
    skos:definition "A device used to connect and secure components in subsea systems, particularly during lifting, handling, or mooring operations. The Shackle typically consists of a U-shaped metal piece with a removable pin or bolt, allowing it to link components such as chains, slings, or cables. It provides a strong and reliable connection point, ensuring that loads can be safely transferred or lifted without risk of detachment or failure. Shackles are essential for securing flexible lines and other equipment during installation and maintenance in subsea environments."@en,
        "Elemento para permitir conexão de uma corrente ou cabo adequadamente terminado a outros elementos"@pt-br ;
    skos:prefLabel "Shackle"@en,
        "Manilha"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:ShearableRiserJoint a owl:Class ;
    dcterms:identifier "ShearableRiserJoint" ;
    rdfs:subClassOf edo:RunningTool ;
    skos:prefLabel "Shearable riser joint"@en,
        "Junta riser cisalhável"@pt-br .

edo:ShieldContact a owl:Class ;
    dcterms:identifier "ShieldContact" ;
    rdfs:subClassOf edo:ElectricalContact ;
    skos:definition "Electrical contact whose represented function includes termination or continuity of an electrical or electromagnetic shield."@en,
        "Contato elétrico cuja função representada inclui terminação ou continuidade de blindagem elétrica ou eletromagnética."@pt-br ;
    skos:prefLabel "Shield Contact"@en,
        "Contato de Blindagem"@pt-br .

edo:SignalContact a owl:Class ;
    dcterms:identifier "SignalContact" ;
    rdfs:subClassOf edo:ElectricalContact ;
    skos:definition "Electrical contact whose represented function includes signal, control, instrumentation or electrical communication transmission."@en,
        "Contato elétrico cuja função representada inclui transmissão de sinal, controle, instrumentação ou comunicação elétrica."@pt-br ;
    skos:prefLabel "Signal Contact"@en,
        "Contato de Sinal"@pt-br .

edo:SmallHydropower a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "SmallHydropower" ;
    skos:broader edo:Hydropower ;
    skos:definition "Small hydropower plants, often called small hydro or PCH, typically have capacities below 30 MW. They use river flow with smaller infrastructure, reducing environmental impact compared to large dams."@en,
        "Pequenas centrais hidrelétricas, frequentemente chamadas de PCH, possuem tipicamente capacidade abaixo de 30 MW. Utilizam o fluxo dos rios com infraestrutura reduzida, diminuindo o impacto ambiental em comparação às grandes barragens."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Small Hydropower"@en,
        "Pequena Central Hidrelétrica"@pt-br .

edo:SmallWind a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "SmallWind" ;
    skos:broader edo:Wind ;
    skos:definition "Small wind systems refer to microturbines designed for residential, agricultural, or small business use. They provide decentralized renewable electricity generation and can operate independently or connected to the grid."@en,
        "Sistemas de pequena escala eólica referem-se a microturbinas projetadas para uso residencial, agrícola ou em pequenos negócios. Eles oferecem geração descentralizada de eletricidade renovável e podem operar de forma independente ou conectados à rede."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Small Wind"@en,
        "Eólica de Pequena Escala"@pt-br .

edo:Socket a owl:Class ;
    dcterms:identifier "Socket" ;
    rdfs:subClassOf edo:MooringAccessory ;
    skos:definition "End termination element for a mooring rope"@en,
        "Elemento de terminação para uma extremidade de um cabo de ancoragem"@pt-br ;
    skos:prefLabel "Socket"@en,
        "Soquete"@pt-br .

edo:SolarHeatingCooling a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "SolarHeatingCooling" ;
    skos:broader edo:Solar ;
    skos:definition "Solar heating and cooling technologies capture solar radiation at low or medium temperatures to provide hot water, space heating, or cooling through solar thermal collectors and absorption systems."@en,
        "Tecnologias de aquecimento e resfriamento solar capturam radiação solar em baixa ou média temperatura para fornecer água quente, aquecimento de ambientes ou resfriamento por meio de coletores solares térmicos e sistemas de absorção."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Solar Heating and Cooling"@en,
        "Aquecimento e Resfriamento Solar"@pt-br .

edo:SolarThermal a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "SolarThermal" ;
    skos:broader edo:Solar ;
    skos:definition "Solar thermal energy, also known as concentrated solar power (CSP), uses mirrors or lenses to concentrate sunlight and produce high-temperature heat, which is then converted into electricity through a thermodynamic cycle."@en,
        "Energia solar térmica, também conhecida como concentração solar (CSP), utiliza espelhos ou lentes para concentrar a luz solar e gerar calor em alta temperatura, que depois é convertido em eletricidade por meio de um ciclo termodinâmico."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Solar Thermal"@en,
        "Solar Térmica"@pt-br .

edo:SolidBiomass a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "SolidBiomass" ;
    skos:broader edo:Biomass ;
    skos:definition "Solid biomass energy comes from the combustion or processing of organic materials such as wood, forestry residues, and agricultural waste. It is one of the oldest forms of renewable energy, still widely used for heating and power generation."@en,
        "Energia de biomassa sólida vem da combustão ou processamento de materiais orgânicos como madeira, resíduos florestais e agrícolas. É uma das formas mais antigas de energia renovável, ainda amplamente utilizada para aquecimento e geração elétrica."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Solid Biomass"@en,
        "Biomassa Sólida"@pt-br .

edo:SpareQuantity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "SpareQuantity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Specifies the number of spare units available, ensuring adequate backup components are on hand for maintenance or replacement. This quantity helps in planning and minimizing downtime during operations."@en ;
    skos:prefLabel "Spare Quantity"@en,
        "Quantidade de Sobressalentes"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:SpatialAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "SpatialAttribute" ;
    skos:broader edo:AttributeCategories ;
    skos:definition "Attribute category related to position, orientation, georeference, location or installation site."@en,
        "Categoria de atributo relacionada a posição, orientação, georreferência, localização ou local de instalação."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory ;
    skos:prefLabel "Spatial attribute"@en,
        "Atributo espacial"@pt-br .

edo:SplicedElectricalCableEnd a owl:Class ;
    dcterms:identifier "SplicedElectricalCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:ElectricalSpliceBox ;
            owl:onProperty edo:isTerminatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalSplicePort ;
            owl:onProperty edo:hasEndInterface ],
        edo:ElectricalCableEnd ;
    skos:definition "Electrical cable end whose termination strategy is an electrical splice rather than a detachable connector. It exposes electrical splice interfaces and is terminated by electrical splice-box hardware, without implying that every electrical cable end is spliced."@en,
        "Extremidade de cabo elétrico cuja estratégia de terminação é uma emenda elétrica em vez de um conector destacável. Expõe interfaces elétricas de emenda e é terminada por hardware de caixa de emenda elétrica, sem implicar que toda extremidade de cabo elétrico seja emendada."@pt-br ;
    skos:prefLabel "Spliced Electrical Cable End"@en,
        "Extremidade de Cabo Elétrico Emendada"@pt-br .

edo:SplicedOpticalFiberCableEnd a owl:Class ;
    dcterms:identifier "SplicedOpticalFiberCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:OpticalSpliceBox ;
            owl:onProperty edo:isTerminatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalSplicePort ;
            owl:onProperty edo:hasEndInterface ],
        edo:OpticalFiberCableEnd ;
    skos:definition "Optical-fibre cable end whose termination strategy is an optical splice rather than a detachable connector. It exposes optical splice interfaces and is terminated by optical splice-box hardware, without implying that every optical-fibre cable end is spliced."@en,
        "Extremidade de cabo de fibra óptica cuja estratégia de terminação é uma emenda óptica em vez de um conector destacável. Expõe interfaces ópticas de emenda e é terminada por hardware de caixa de emenda óptica, sem implicar que toda extremidade de cabo de fibra óptica seja emendada."@pt-br ;
    skos:prefLabel "Spliced Optical Fiber Cable End"@en,
        "Extremidade de Cabo de Fibra Óptica Emendada"@pt-br .

edo:StaticEquipmentEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Static Equipment Engineering"@en,
        "Engenharia de Equipamentos Estáticos"@pt-br ;
    skos:broader edo:EquipmentEngineering ;
    skos:definition "Engineering of non-moving industrial equipment such as pressure vessels, tanks, and heat exchangers."@en,
        "Engenharia de equipamentos industriais sem partes móveis como vasos de pressão, tanques e trocadores de calor."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:StaticUmbilicalSpan a owl:Class ;
    dcterms:identifier "StaticUmbilicalSpan" ;
    rdfs:subClassOf edo:UmbilicalSpan ;
    skos:definition "Unsuspended umbilical span, laid over or under ground"@en,
        "Trecho de umbilical não suspenso, estendido sobre ou sob o solo"@pt-br ;
    skos:prefLabel "Static umbilical span"@en,
        "Trecho estático de umbilical"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:Status a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeCategory edo:ContentManagementAttribute ;
    edo:attributeOntologicalNature edo:StatusAttribute .

edo:StopperCollar a owl:Class ;
    dcterms:identifier "StopperCollar" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:MountingPoint ;
            owl:onProperty edo:hasMountingPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:SplitCollar ;
    skos:altLabel "Locking Collar"@en,
        "Positioning Collar"@en,
        "Retention Collar"@en,
        "Stopper Clamp"@en,
        "Stopping Collar"@en ;
    skos:definition "A component used to prevent the movement or displacement of other parts in subsea systems. The Stopper Collar is installed around the pipe or component and acts as a physical barrier to stop or limit movement, ensuring components stay in their intended positions. It is crucial for maintaining alignment and stability during installation, operation, or maintenance, providing secure positioning and preventing unwanted shifts or displacements."@en ;
    skos:prefLabel "Stopper Collar"@en,
        "Colar Batente"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:StorageBox a owl:Class ;
    dcterms:identifier "StorageBox" ;
    rdfs:subClassOf edo:StorageAccessory ;
    skos:prefLabel "Storage box"@en,
        "Caixa de armazenamento"@pt-br .

edo:StorageSkid a owl:Class ;
    dcterms:identifier "StorageSkid" ;
    rdfs:subClassOf edo:StorageAccessory ;
    skos:definition "Protective structure for equipment storage and transportation"@en,
        "Estrutura de proteção para transporte e armazenamento de equipamentos"@pt-br ;
    skos:prefLabel "Storage skid"@en,
        "Skid de armazenamento"@pt-br .

edo:StorageSpool a owl:Class ;
    dcterms:identifier "StorageSpool" ;
    rdfs:subClassOf edo:StorageAccessory ;
    skos:definition "Spool for line storage and transportation"@en,
        "Carretel/bobina para transporte e armazenamento de linhas"@pt-br ;
    skos:prefLabel "Storage spool"@en,
        "Carretel de armazenamento"@pt-br .

edo:StructuralEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Structural Engineering"@en,
        "Engenharia Estrutural"@pt-br ;
    skos:broader edo:CivilEngineering ;
    skos:definition "Engineering discipline focused on the structural integrity and design of buildings and infrastructure."@en,
        "Disciplina de engenharia focada na integridade estrutural e projeto de edifícios e infraestrutura."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:SubseaConnectionPoint a owl:Class ;
    dcterms:identifier "SubseaConnectionPoint" ;
    rdfs:subClassOf edo:ConnectionPoint ;
    skos:definition "Represents a connection point located in subsea environments, used to link subsea components."@en,
        "Representa um ponto de conexão localizado em ambientes submarinos, usado para ligar componentes submarinos."@pt-br ;
    skos:prefLabel "Subsea Connection Point"@en,
        "Ponto de Conexão Submarino"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:SubseaLayout a owl:Class ;
    dcterms:identifier "SubseaLayout" ;
    rdfs:subClassOf edo:InformationArtifact ;
    skos:definition "An information artifact documenting the spatial arrangement of subsea infrastructure, such as pipelines, risers, manifolds, wells and other equipment within a defined subsea area."@en,
        "Artefato informacional que documenta o arranjo espacial da infraestrutura submarina, como dutos, risers, manifolds, poços e outros equipamentos em uma área submarina definida."@pt-br ;
    skos:prefLabel "Subsea Layout"@en,
        "Arranjo Submarino"@pt-br .

edo:SubseaOilField a owl:Class ;
    dcterms:identifier "SubseaOilField" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edo:spatiallyContains ;
            owl:someValuesFrom edo:FloatingProductionUnit ],
        edo:Location ;
    skos:altLabel "Subsea Hydrocarbon Field"@en,
        "Subsea Oil Reservoir"@en,
        "Subsea Oil Site"@en,
        "Subsea Petroleum Field"@en ;
    skos:definition "A subsea oil field refers to an underwater reservoir of hydrocarbons located beneath the seabed. It involves the extraction of oil and gas from deposits situated in deepwater or shallow marine environments. The subsea oil field includes a range of equipment and infrastructure, such as subsea wells, pipelines, and production systems, all designed to safely and efficiently extract and transport hydrocarbons to processing facilities on the surface or shore. The development and operation of subsea oil fields require specialized technology and expertise to manage the challenges of deepwater environments and ensure the successful production and handling of resources."@en ;
    skos:prefLabel "Subsea Oil Field"@en,
        "Campo de Petróleo Submarino"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:SubseaPipeline a owl:Class ;
    dcterms:identifier "SubseaPipeline" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:NominalLength ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ProjectAcronym ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaximumThermalExchangeCoefficient ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:InternalIncidentalPressureTable_VPosWRTWaterline ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ProjectCode ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaxDesignAbsIntPresTable_PositionReference ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaxDesignAbsIntPresTable ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaterialRequest ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:SubProjectId ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:UnifilarDiagram ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:BasicProjectRevision ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaximumTemperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaterialRequestRev ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:ExecutiveProjectRevision ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaxDesignAbsIntPresTable_Pressure ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:InternalIncidentalPressureTable_Pressure ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:InternalIncidentalPressureTable ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MinimumThermalExchangeCoefficient ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RiserConfiguration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:InternalIncidentalPressureTable_PositionReference ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:InternalDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:Service ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:H2SVolumeConcentration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:MaxDesignAbsIntPresTable_VPosWRTWaterline ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:CO2VolumePercentage ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:UnifilarDiagramRev ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Interconnection ;
    skos:definition "A Subsea Pipeline is a conduit installed on the seafloor designed to transport oil, gas, or other fluids from underwater production facilities to processing or storage locations on the surface or shore. Engineered to withstand harsh underwater conditions, including high pressures, corrosive environments, and dynamic movements, the Subsea Pipeline is constructed with durable materials and advanced technologies to ensure reliable and efficient fluid transfer."@en ;
    skos:prefLabel "Subsea Pipeline"@en,
        "Linha Submarina"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:SubseaRigidPipeSpec a owl:Class ;
    rdfs:subClassOf edo:Specification ;
    skos:definition "Represents the specification for subsea rigid pipes, defining materials, mechanical properties, dimensions, and installation requirements."@en,
        "Representa a especificação para dutos rígidos submarinos, definindo materiais, propriedades mecânicas, dimensões e requisitos de instalação."@pt-br ;
    skos:prefLabel "Subsea Rigid Pipe Specification"@en,
        "Especificação de Tubo Rígido Submarino"@pt-br .

edo:SubseaRigidPipesEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Subsea Rigid Pipes Engineering"@en,
        "Engenharia de Tubos Rígidos Submarinos"@pt-br ;
    skos:broader edo:SubseaEngineering ;
    skos:definition "Engineering of rigid pipeline systems used in subsea applications."@en,
        "Engenharia de sistemas de tubulações rígidas utilizadas em aplicações submarinas."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:SubseaStructuresEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Subsea Structures Engineering"@en,
        "Engenharia de Estruturas Submarinas"@pt-br ;
    skos:broader edo:SubseaEngineering ;
    skos:definition "Engineering of subsea manifolds, christmas trees, and other structural components."@en,
        "Engenharia de manifolds submarinos, árvores de natal e outros componentes estruturais."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:SubseaUmbilical a owl:Class ;
    dcterms:identifier "SubseaUmbilical" ;
    rdfs:subClassOf edo:Interconnection ;
    skos:definition "A Subsea Umbilical is a composite cable system installed on the seafloor that provides vital control, power, and communication connections between topside facilities and subsea production systems. Designed to transmit hydraulic fluids, electrical power, and data signals, the Subsea Umbilical enables the remote operation and monitoring of subsea equipment such as valves, manifolds, and control modules. Engineered for long-term reliability in extreme underwater environments, it is constructed using multiple layers of protective sheathing, armoring, and insulation materials to resist mechanical stress, corrosion, and hydrostatic pressure, ensuring safe and continuous operation throughout the field’s lifecycle."@en ;
    skos:prefLabel "Subsea Umbilical"@en,
        "Umbilical Submarino"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass .

edo:SubseaWell a owl:Class ;
    dcterms:identifier "SubseaWell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty edo:hosts ;
            owl:someValuesFrom edo:WetChristmasTree ],
        edo:FunctionalAsset ;
    skos:definition "A Subsea Well is a well located on the seafloor from which hydrocarbons such as oil and gas are extracted. Positioned underwater, it typically involves a wellhead assembly that includes valves, controls, and monitoring equipment to manage the extraction process. The Subsea Well is connected to surface facilities via pipelines and umbilicals, which facilitate the transport of extracted resources and the provision of necessary services like power and communication. Designed to operate under high pressure and harsh marine conditions, the subsea well is a critical component of offshore oil and gas production systems."@en ;
    skos:prefLabel "Subsea Well"@en,
        "Poço"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering ;
    edo:hasInterconnection edo:Interconnection ;
    edo:serves edo:FloatingProductionUnit .

edo:SuctionPile a owl:Class ;
    dcterms:identifier "SuctionPile" ;
    rdfs:subClassOf edo:Pile ;
    skos:definition "Anchoring pile driven into seabed by hydrostatic pressure, by applying suction to an underside cavity"@en,
        "Estaca de ancoragem cravada no solo pela pressão hidrostática, mediante aplicação de sucção a uma cavidade em seu lado inferior"@pt-br ;
    skos:prefLabel "Suction pile"@en,
        "Estaca de sucção"@pt-br .

edo:TPT a owl:Class ;
    dcterms:identifier "TPT" ;
    rdfs:subClassOf edo:Sensor ;
    skos:prefLabel "Pressure and temperature sensor"@en,
        "Sensor de pressão e temperatura"@pt-br .

edo:TemperatureSensor a owl:Class ;
    dcterms:identifier "TemperatureSensor" ;
    rdfs:subClassOf edo:Sensor ;
    skos:prefLabel "Temperature sensor"@en,
        "Sensor de temperatura"@pt-br .

edo:TensileArmour a owl:Class ;
    dcterms:identifier "TensileArmour" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:TensileWiresCount ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:TensileWireLayAngle ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:WireLayer ;
    skos:definition "Protective layer designed to withstand high tensile stresses and mechanical loads, Tensile Armour is composed of high-strength steel wires or reinforced materials arranged in a helical configuration around the riser. It provides essential resistance to tension and shields the inner layers from mechanical damage and wear, ensuring the riser's integrity and durability during installation and operation in extreme underwater conditions."@en ;
    skos:prefLabel "Tensile Armour"@en,
        "Armadura de Tração"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:TestBase a owl:Class ;
    dcterms:identifier "TestBase" ;
    rdfs:subClassOf edo:TestEquipment ;
    skos:prefLabel "Test base"@en,
        "Base de teste"@pt-br .

edo:TestRole a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "TestRole" ;
    skos:broader edo:AttributeRoles ;
    skos:definition "Role of an attribute that expresses a value associated with testing or verification."@en,
        "Papel de um atributo que expressa um valor associado a teste ou verificação."@pt-br ;
    skos:inScheme edo:DomainAttributeRole ;
    skos:prefLabel "Test role"@en,
        "Papel de teste"@pt-br .

edo:ThermalPower a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Thermal Power"@en,
        "Energia Térmica"@pt-br ;
    skos:broader edo:Domain ;
    skos:definition "Energy production from fossil fuels (coal, natural gas) through thermal conversion."@en,
        "Produção de energia a partir de combustíveis fósseis (carvão, gás natural) através de conversão térmica."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:ThreadedFitting a owl:Class ;
    dcterms:identifier "ThreadedFitting" ;
    rdfs:subClassOf edo:TubingCoupling ;
    skos:definition "A Threaded Fitting is a connector used to join fluid or gas lines through screw threads, providing a secure and leak-tight connection that can be easily assembled or disassembled during installation or maintenance."@en,
        "Um Engate Rosqueado é um conector usado para unir linhas de fluido ou gás por meio de roscas, garantindo uma conexão segura e vedada que pode ser facilmente montada ou desmontada durante a instalação ou manutenção."@pt-br ;
    skos:prefLabel "Threaded Fitting"@en,
        "Engate Rosqueado"@pt-br .

edo:Tidal a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Tidal" ;
    skos:broader edo:Marine ;
    skos:definition "Tidal energy is generated by harnessing the predictable rise and fall of ocean tides, typically using barrages, tidal fences, or tidal stream turbines. It offers a highly reliable source of renewable energy due to the natural gravitational cycles of the Earth, Moon and Sun."@en,
        "Energia das marés é gerada aproveitando a previsível subida e descida das marés oceânicas, geralmente por meio de barragens, cercas de marés ou turbinas de corrente de maré. Oferece uma fonte altamente confiável de energia renovável devido aos ciclos gravitacionais naturais da Terra, da Lua e do Sol."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Tidal Energy"@en,
        "Energia das Marés"@pt-br .

edo:TieIn a owl:Class ;
    dcterms:identifier "TieIn" ;
    rdfs:subClassOf edo:PressureComponent ;
    skos:prefLabel "Tie-in"@en,
        "Tie-in"@pt-br .

edo:TimeValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Time Value"@en ;
    rdfs:comment "Expected XSD datatype for time-of-day values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:time .

edo:ToBeDeprecated a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ToBeDeprecated" ;
    skos:broader edo:ConceptStatuses ;
    skos:definition "Concept planned for future removal or replacement, without affecting its current use."@en,
        "Conceito planejado para remoção ou substituição futura, sem afetar seu uso atual."@pt-br ;
    skos:inScheme edo:ConceptStatusScheme ;
    skos:prefLabel "To be deprecated"@en,
        "A ser depreciado"@pt-br .

edo:TopBendStiffener a owl:Class ;
    dcterms:identifier "TopBendStiffener" ;
    rdfs:subClassOf edo:BendStiffener ;
    skos:altLabel "Curvature Stiffener"@en,
        "Stiffener"@en,
        "Top Bending Stiffener"@en ;
    skos:definition "Designed to support and stabilize the riser where it transitions from the seabed to the floating platform or vessel, the Top Bend Stiffener is composed of high-strength materials such as steel or composites. It helps prevent excessive bending, distributes mechanical loads, and enhances flexibility management, ensuring the riser's structural integrity and performance during installation and operation in dynamic offshore conditions."@en ;
    skos:prefLabel "Top Bend Stiffener"@en,
        "Enrijecedor de Curvatura de Topo"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:TopsideConnectionPoint a owl:Class ;
    dcterms:identifier "TopsideConnectionPoint" ;
    rdfs:subClassOf edo:ConnectionPoint ;
    skos:definition "Represents a connection point located on topside or surface facilities, linking elements above water or ground."@en,
        "Representa um ponto de conexão localizado em instalações topside ou de superfície, conectando elementos acima da água ou do solo."@pt-br ;
    skos:prefLabel "Topside Connection Point"@en,
        "Ponto de Conexão em Topside"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:TorpedoPile a owl:Class ;
    dcterms:identifier "TorpedoPile" ;
    rdfs:subClassOf edo:Pile ;
    skos:definition "Anchoring pile driven into seabed by free fall"@en,
        "Estaca de ancoragem cravada no solo por queda livre"@pt-br ;
    skos:prefLabel "Torpedo pile"@en,
        "Estaca-torpedo"@pt-br .

edo:TransportSupportPoint a owl:Class ;
    dcterms:identifier "TransportSupportPoint" ;
    rdfs:subClassOf edo:SupportPoint ;
    skos:definition "Represents a support point used specifically during transportation or handling of elements."@en,
        "Representa um ponto de apoio utilizado especificamente durante o transporte ou manuseio de elementos."@pt-br ;
    skos:prefLabel "Transport Support Point"@en,
        "Ponto de Apoio para Transporte"@pt-br .

edo:Transportation a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Transportation" ;
    skos:broader edo:ConstructionPhase ;
    skos:definition "Logistics and transport of materials and equipment to the construction or installation site."@en,
        "Logística e transporte de materiais e equipamentos para o local de construção ou instalação."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Transportation"@en,
        "Transporte"@pt-br .

edo:TreeCap a owl:Class ;
    dcterms:identifier "TreeCap" ;
    rdfs:subClassOf edo:FlowControlModule ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:TreeRunningTool a owl:Class ;
    dcterms:identifier "TreeRunningTool" ;
    rdfs:subClassOf edo:RunningTool ;
    skos:prefLabel "Wet Christmas tree running tool"@en,
        "Ferramenta de instalação de ANM"@pt-br .

edo:TrianglePlate a owl:Class ;
    dcterms:identifier "TrianglePlate" ;
    rdfs:subClassOf edo:MooringAccessory ;
    skos:prefLabel "Triangle plate"@en,
        "Placa triangular"@pt-br .

edo:TubingHanger a owl:Class ;
    dcterms:identifier "TubingHanger" ;
    rdfs:subClassOf edo:PressureComponent ;
    skos:definition "Top component providing mechanical support and interfaces (hydraulic, electrical, optical, etc.) to other well tubing components"@en,
        "Componente de topo que oferece suporte mecânico e interfaces (hidráulicas, elétricas, óticas, etc.) aos demais componentes da coluna de poço"@pt-br ;
    skos:prefLabel "Tubing hanger"@en,
        "Suspensor de coluna"@pt-br .

edo:TubingHangerRunningTool a owl:Class ;
    dcterms:identifier "TubingHangerRunningTool" ;
    rdfs:subClassOf edo:RunningTool ;
    skos:prefLabel "Tubing hanger running tool"@en,
        "Ferramenta de instalação de TH"@pt-br .

edo:UNSThreadedFastenerSet a owl:Class ;
    dcterms:identifier "UNSThreadedFastenerSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:ThreadsPerInch ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:ThreadedFastenerSet ;
    skos:definition "A threaded fastener set specified according to the Unified Special thread series, in which thread density is expressed as threads per inch."@en,
        "Conjunto de fixadores roscados especificado segundo a série Unified Special (UNS), na qual a densidade da rosca é expressa em fios por polegada."@pt-br ;
    skos:prefLabel "UNS Threaded Fastener Set"@en,
        "Conjunto de Fixadores Roscados UNS"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:UTA a owl:Class ;
    dcterms:identifier "UTA" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:UmbilicalEnd ;
            owl:onProperty edo:terminatesEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:UmbilicalEnd ;
            owl:onProperty edo:terminatesEnd ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:DomainElement ;
            owl:onProperty edo:hasTerminalHardware ],
        edo:SubseaEquipment ;
    skos:definition "Subsea equipment forming an umbilical termination and anchoring assembly, aggregating the structural and service-specific terminal hardware required at one umbilical end."@en,
        "Equipamento submarino que constitui um conjunto de terminação e ancoragem de umbilical, agregando o hardware terminal estrutural e específico de cada serviço requerido em uma extremidade do umbilical."@pt-br ;
    skos:prefLabel "Umbilical termination assembly"@en,
        "Conjunto de terminação de umbilical"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:UTM a owl:Class ;
    dcterms:identifier "UTM" ;
    rdfs:subClassOf edo:LineTerminationModule ;
    skos:prefLabel "Umbilical termination module"@en,
        "Módulo de terminação de umbilical"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:UmbilicalBundle a owl:Class ;
    dcterms:identifier "UmbilicalBundle" ;
    rdfs:subClassOf edo:Specification ;
    skos:definition "The Umbilical Bundle is the integrated assembly of functional elements within a subsea umbilical, designed to transmit hydraulic power, electrical energy, and data signals between surface and subsea systems. It typically consists of multiple tubes, cables, and fibers bundled together and protected by external sheathing and armoring. Engineered to ensure reliability and efficiency under deepwater conditions, the umbilical bundle provides essential control and communication pathways that enable the safe and continuous operation of subsea production equipment."@en,
        "O Conjunto de Umbilical é o agrupamento integrado dos elementos funcionais que compõem um umbilical submarino, projetado para transmitir potência hidráulica, energia elétrica e sinais de dados entre os sistemas de superfície e submarinos. Normalmente é formado por vários tubos, cabos e fibras reunidos em um único feixe, protegidos por camadas externas de revestimento e armadura. Projetado para garantir confiabilidade e eficiência em condições de águas profundas, o conjunto de umbilical fornece os canais essenciais de controle e comunicação que permitem a operação segura e contínua dos equipamentos submarinos de produção."@pt-br ;
    skos:prefLabel "Umbilical Bundle"@en,
        "Conjunto de Umbilical"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass .

edo:UmbilicalLocation a owl:Class ;
    dcterms:identifier "UmbilicalLocation" ;
    rdfs:subClassOf edo:LinearLocation ;
    skos:prefLabel "Umbilical location"@en,
        "Local de umbilical"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:UmbilicalPullingHead a owl:Class ;
    dcterms:identifier "UmbilicalPullingHead" ;
    rdfs:subClassOf edo:PullingHead ;
    skos:altLabel "Cabeça de Manuseio para Umbilical"@pt-br ;
    skos:definition "Tubular pulling head (with space for pigtails), used for umbilicals."@en,
        "Cabeça de tração tubular (com espaço para pigtails), usada para umbilicais."@pt-br ;
    skos:prefLabel "Umbilical Pulling Head"@en,
        "Cabeça de Tração para Umbilical"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:UmbilicalStructure a owl:Class ;
    dcterms:identifier "UmbilicalStructure" ;
    rdfs:subClassOf edo:FlexibleStructure ;
    skos:definition "The Umbilical Structure is the layered configuration, the specification, of a subsea umbilical, designed to provide mechanical protection, flexibility, and stability in underwater environments. It consists of multiple layers and components, such as tubes, cables, fillers, and armoring, each serving a specific function, including power transmission, signal communication, or structural reinforcement. This structure is engineered to withstand deepwater conditions, such as high external pressure and dynamic loads, ensuring the umbilical’s integrity and reliable performance throughout its service life.."@en,
        "A Estrutura do Umbilical é a configuração em camadas, a especificação, de um umbilical submarino, projetada para fornecer proteção mecânica, flexibilidade e estabilidade em ambientes subaquáticos. Ela é composta por múltiplas camadas e componentes, como tubos, cabos, materiais de enchimento e armaduras, cada um desempenhando uma função específica, incluindo transmissão de energia, comunicação de sinais ou reforço estrutural. Essa estrutura é projetada para suportar as condições de águas profundas, como alta pressão externa e cargas dinâmicas, garantindo a integridade e o desempenho confiável do umbilical ao longo de sua vida útil."@pt-br ;
    skos:prefLabel "Umbilical Structure"@en,
        "Estrutura do Umbilical"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass .

edo:UtilityPipingEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Utility Piping Engineering"@en,
        "Engenharia de Tubulação de Utilidades"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on the design of piping systems for utility services."@en,
        "Disciplina de engenharia focada no projeto de sistemas de tubulação para serviços de utilidades."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:VCM a owl:Class ;
    dcterms:identifier "VCM" ;
    rdfs:subClassOf edo:ConnectionModule ;
    skos:prefLabel "Vertical connection module"@en,
        "Módulo de conexão vertical"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:Version a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeCategory edo:ContentManagementAttribute ;
    edo:attributeOntologicalNature edo:ProvenanceAttribute .

edo:WasteToEnergy a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "WasteToEnergy" ;
    skos:broader edo:Biomass ;
    skos:definition "Waste-to-energy from biomass refers to the conversion of the organic fraction of municipal and industrial waste into useful energy through processes such as combustion, gasification, or anaerobic digestion."@en,
        "Energia a partir de resíduos de biomassa refere-se à conversão da fração orgânica de resíduos urbanos e industriais em energia útil por meio de processos como combustão, gaseificação ou digestão anaeróbica."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Waste to Energy"@en,
        "Energia a partir de Resíduos"@pt-br .

edo:WaterIntake a owl:Class ;
    dcterms:identifier "WaterIntake" ;
    rdfs:subClassOf edo:SubseaEquipment ;
    skos:prefLabel "Water Intake"@en,
        "Captador de Água"@pt-br .

edo:Wave a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Wave" ;
    skos:broader edo:Marine ;
    skos:definition "Wave energy captures the kinetic and potential energy of surface ocean waves using floating or submerged devices. It is considered a promising but still emerging technology, capable of providing consistent renewable electricity near coastal regions."@en,
        "Energia das ondas captura a energia cinética e potencial das ondas de superfície do oceano usando dispositivos flutuantes ou submersos. É considerada uma tecnologia promissora, porém ainda emergente, capaz de fornecer eletricidade renovável de forma consistente em regiões costeiras."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Wave Energy"@en,
        "Energia das Ondas"@pt-br .

edo:WearBushing a owl:Class ;
    dcterms:identifier "WearBushing" ;
    rdfs:subClassOf edo:Accessory ;
    skos:definition "Accessory for protecting delicate surfaces in the flowbase during downhole interventions"@en,
        "Acessório para proteção de superfícies delicadas na BAP durante intervenções no poço"@pt-br ;
    skos:prefLabel "Wear Bushing"@en,
        "Bucha de Desgaste"@pt-br .

edo:WearBushingRunningTool a owl:Class ;
    dcterms:identifier "WearBushingRunningTool" ;
    rdfs:subClassOf edo:RunningTool ;
    skos:prefLabel "Wear bushing running tool"@en,
        "Ferramenta de instalação de BD"@pt-br .

edo:Wellhead a owl:Class ;
    dcterms:identifier "Wellhead" ;
    rdfs:subClassOf edo:Structure ;
    skos:prefLabel "Wellhead"@en,
        "Cabeça de poço"@pt-br .

edo:WireRopeSegment a owl:Class ;
    dcterms:identifier "WireRopeSegment" ;
    rdfs:subClassOf edo:RopeSegment ;
    skos:prefLabel "Wire rope segment"@en,
        "Tramo de cabo de aço"@pt-br .

edo:allowedValue a owl:AnnotationProperty ;
    rdfs:label "Allowed Value"@en,
        "Valor Permitido"@pt-br ;
    dcterms:identifier "allowedValue" ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "Indicates a controlled value allowed for a domain attribute or context."@en,
        "Indica um valor controlado permitido para um atributo ou contexto de domínio."@pt-br .

edo:appliesTo a owl:AnnotationProperty ;
    rdfs:label "Applies to"@en,
        "Se aplica a"@pt-br ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "Indicates that the subject applies to the object."@en,
        "Indica que o sujeito se aplica ao predicado."@pt-br .

edo:appliesToDomainElement a owl:AnnotationProperty ;
    rdfs:label "Applies To Domain Element"@en,
        "Aplica-se a Elemento de Domínio"@pt-br ;
    dcterms:identifier "appliesToDomainElement" ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "Indicates the domain element class to which an entity, attribute, value or rule applies."@en,
        "Indica a classe de elemento de domínio à qual uma entidade, atributo, valor ou regra se aplica."@pt-br .

edo:appliesWhen a owl:AnnotationProperty ;
    rdfs:label "Applies When"@en,
        "Aplica-se Quando"@pt-br ;
    dcterms:identifier "appliesWhen" ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "Qualifies the context in which a relation, attribute, value or rule applies."@en,
        "Qualifica o contexto em que uma relação, atributo, valor ou regra se aplica."@pt-br .

edo:attributeCategory a owl:AnnotationProperty ;
    rdfs:label "Attribute category"@en,
        "Categoria do atributo"@pt-br ;
    dcterms:identifier "attributeCategory" ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "Classifies a domain attribute according to an internal EDO attribute-category vocabulary."@en,
        "Classifica um atributo de domínio segundo um vocabulário interno de categorias de atributos da EDO."@pt-br .

edo:attributeNature a owl:AnnotationProperty ;
    rdfs:label "Attribute nature"@en,
        "Natureza do atributo"@pt-br ;
    dcterms:identifier "attributeNature" ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "Indicates the conceptual nature of a domain attribute, such as dimensional, mechanical, environmental, operational, performance, location or capability."@en,
        "Indica a natureza conceitual de um atributo de domínio, como dimensional, mecânica, ambiental, operacional, desempenho, localização ou capacidade."@pt-br .

edo:attributeOntologicalNature a owl:AnnotationProperty ;
    rdfs:label "Attribute ontological nature"@en,
        "Natureza ontológica do atributo"@pt-br ;
    dcterms:identifier "attributeOntologicalNature" ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "Classifies a domain attribute according to its ontological or informational role, such as physical quantity, quality datum, identifier, condition, curve, table, table column, strategy or presence indicator."@en,
        "Classifica um atributo de domínio segundo seu papel ontológico ou informacional, como quantidade física, dado de qualidade, identificador, condição, curva, tabela, coluna de tabela, estratégia ou indicador de presença."@pt-br .

edo:attributePropagation a owl:AnnotationProperty ;
    rdfs:label "Attribute propagation"@en,
        "Propagação de atributo"@pt-br ;
    dcterms:identifier "attributePropagation" ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "Declares how attributes associated with one side of a semantic relation may be projected to another entity or to the relationship during an extraction or delivery process."@en,
        "Declara como atributos associados a um lado de uma relação semântica podem ser projetados para outra entidade ou para o relacionamento durante um processo de extração ou entrega."@pt-br .

edo:belongsToGroup a owl:ObjectProperty ;
    rdfs:label "Belongs To Group"@en,
        "Pertence a Grupo"@pt-br ;
    dcterms:identifier "belongsToGroup" ;
    rdfs:domain edo:DomainElement ;
    rdfs:subPropertyOf edo:OrganizationalRelation ;
    skos:altLabel "Is Member Of"@en,
        "É Membro De"@pt-br ;
    skos:definition "Indicates that a domain entity is a member of a group, where groups represent an organisational or logical grouping concept."@en,
        "Indica que uma entidade do domínio é membro de um grupo, onde grupos representam um conceito de agrupamento organizacional ou lógico."@pt-br .

edo:classInstantiationRole a owl:AnnotationProperty ;
    rdfs:label "Class instantiation role"@en,
        "Papel de instanciação da classe"@pt-br ;
    dcterms:identifier "classInstantiationRole" ;
    rdfs:subPropertyOf edo:DomainMetamodelAnnotation ;
    skos:definition "Indicates whether and how an EDO class is intended to be instantiated in project or asset information models."@en,
        "Indica se e como uma classe da EDO deve ser instanciada em modelos de informação de projetos ou ativos."@pt-br .

edo:conceptStatus a owl:AnnotationProperty ;
    rdfs:label "Concept Status"@en,
        "Status do Conceito"@pt-br ;
    dcterms:identifier "conceptStatus" ;
    rdfs:subPropertyOf edo:DomainGovernanceAnnotation ;
    skos:definition "Indicates the editorial or governance status of an Energy Domain Ontology concept, such as active, to be deprecated, deprecated or replaced."@en,
        "Indica o status editorial ou de governança de um conceito da Energy Domain Ontology, como ativo, a ser depreciado, depreciado ou substituído."@pt-br .

edo:defaultValidValues a owl:AnnotationProperty ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation .

edo:expectedXsdType a owl:AnnotationProperty ;
    rdfs:label "Expected XSD type"@en,
        "Tipo XSD esperado"@pt-br ;
    dcterms:identifier "expectedXsdType" ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Declares the expected XSD datatype for values represented by an EDO DataType."@en,
        "Declara o tipo XSD esperado para valores representados por um DataType da EDO."@pt-br .

edo:hasAttributeCategory a owl:AnnotationProperty ;
    rdfs:label "has attribute category"@en,
        "tem categoria de atributo"@pt-br ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "The technical category of the attribute (geometric, functional, etc.)"@en,
        "A categoria técnica do atributo (geométrica, funcional, etc.)"@pt-br .

edo:hasAttributeGroup a owl:AnnotationProperty ;
    rdfs:label "has attribute group"@en,
        "tem grupo de atributo"@pt-br ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Indicates that the attribute has a special grouping for organizational purposes"@en,
        "Indica que o atributo tem um agrupamento especial para fins de organização"@pt-br .

edo:hasAttributeScope a owl:AnnotationProperty ;
    rdfs:label "has attribute scope"@en,
        "tem escopo de atributo"@pt-br ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Classifies whether the attribute applies to equipment type, instance or batch"@en,
        "Classifica se o atributo se aplica ao tipo de equipamento, instância ou lote"@pt-br .

edo:hasClassificationReference a owl:ObjectProperty ;
    rdfs:label "Has Classification Reference"@en,
        "Tem Referência de Classificação"@pt-br ;
    dcterms:identifier "hasClassificationReference" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:ExternalReference ;
    rdfs:subPropertyOf edo:InformationRelation ;
    skos:altLabel "Has Classification"@en,
        "Tem Classificação"@pt-br ;
    skos:definition "Associates a domain entity with an external classification reference, such as an identifier from a classification system."@en,
        "Associa uma entidade do domínio a uma referência externa de classificação, como um identificador de um sistema de classificação."@pt-br .

edo:hasDiscipline a owl:AnnotationProperty ;
    rdfs:label "Has Discipline"@en,
        "Pertence a uma disciplina técnica"@pt-br ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "Belongs to a technical discipline"@en,
        "Associa a entidade a uma disciplina técnica"@pt-br .

edo:hasDocument a owl:ObjectProperty ;
    rdfs:label "Has Document"@en,
        "Tem Documento"@pt-br ;
    dcterms:identifier "hasDocument" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:ReferenceDocument ;
    rdfs:subPropertyOf edo:InformationRelation ;
    skos:altLabel "Document Reference"@en,
        "Referência de Documento"@pt-br ;
    skos:definition "Associates a domain entity with one or more documents describing, specifying or evidencing it."@en,
        "Associa uma entidade do domínio a um ou mais documentos que a descrevem, especificam ou evidenciam."@pt-br .

edo:hasDomain a owl:AnnotationProperty ;
    rdfs:label "Has Domain"@en,
        "Pertence a um domínio"@pt-br ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "Belongs to one or more domains"@en,
        "Associa a entidade a um ou mais domínios"@pt-br .

edo:hasInstallationPoint a owl:ObjectProperty ;
    rdfs:label "Has Installation Point"@en,
        "Tem Ponto de Instalação"@pt-br ;
    dcterms:identifier "hasInstallationPoint" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:InstallationPoint ;
    rdfs:subPropertyOf edo:hasAttachmentPoint ;
    skos:definition "Associates a host element with an installation point defining where another element is intended to be mounted or attached."@en,
        "Associa um elemento hospedeiro a um ponto de instalação que define onde outro elemento deve ser montado ou fixado."@pt-br .

edo:hasInterconnection a owl:ObjectProperty ;
    rdfs:label "Has Interconnection"@en,
        "Tem Interligação"@pt-br ;
    dcterms:identifier "hasInterconnection" ;
    rdfs:subPropertyOf edo:FunctionalRelation ;
    skos:definition "Associates a domain entity with a functional interconnection that originates from it, terminates at it or connects it to another entity, without implying that the interconnection is its physical part."@en,
        "Associa uma entidade do domínio a uma interligação funcional que parte dela, chega a ela ou a conecta a outra entidade, sem implicar que a interligação seja sua parte física."@pt-br .

edo:hasLifecycleCreationPhase a owl:AnnotationProperty ;
    rdfs:label "has lifecycle creation phase"@en,
        "tem fase de criação no ciclo de vida"@pt-br ;
    rdfs:subPropertyOf edo:DomainLifecycleAnnotation ;
    skos:definition "The lifecycle phase when the attribute value is created"@en,
        "A fase do ciclo de vida quando o valor do atributo é criado"@pt-br .

edo:hasLifecycleUsagePhase a owl:AnnotationProperty ;
    rdfs:label "has lifecycle usage phase"@en,
        "tem fase de uso no ciclo de vida"@pt-br ;
    rdfs:subPropertyOf edo:DomainLifecycleAnnotation ;
    skos:definition "The lifecycle phase(s) when the attribute value is used"@en,
        "A(s) fase(s) do ciclo de vida quando o valor do atributo é utilizado"@pt-br .

edo:hasLocationType a owl:AnnotationProperty ;
    rdfs:label "Has Location Type"@en,
        "Pertence a um tipo de locação"@pt-br ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "Belongs to one or more Location Types"@en,
        "Associa a entidade a um tipo de locação"@pt-br .

edo:hasMaturityLevel a owl:AnnotationProperty ;
    rdfs:label "Has Maturity Level"@en,
        "Tem Nível de Maturidade"@pt-br ;
    dcterms:identifier "hasMaturityLevel" ;
    rdfs:subPropertyOf edo:DomainGovernanceAnnotation ;
    skos:definition "Indicates the editorial or governance maturity level of an Energy Domain Ontology entity."@en,
        "Indica o nível de maturidade editorial ou de governança de uma entidade da Energy Domain Ontology."@pt-br .

edo:hasOperatingCondition a owl:ObjectProperty ;
    rdfs:label "Has Operating Condition"@en,
        "Tem Condição Operacional"@pt-br ;
    dcterms:identifier "hasOperatingCondition" ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    skos:definition "Associates a specification with a required design operating condition that forms part of its technical definition."@en,
        "Associa uma especificação a uma condição operacional de projeto requerida que integra sua definição técnica."@pt-br .

edo:hasOperatingState a owl:ObjectProperty ;
    rdfs:label "Has Operating State"@en,
        "Tem Estado Operacional"@pt-br ;
    dcterms:identifier "hasOperatingState" ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    skos:definition "Associates a design operating condition with a required state defined for a position or reference point along the engineered line."@en,
        "Associa uma condição operacional de projeto a um estado requerido definido para uma posição ou ponto de referência ao longo da linha de engenharia."@pt-br .

edo:hasSparePart a owl:ObjectProperty ;
    rdfs:label "Has Spare Part"@en,
        "Tem Sobressalente"@pt-br ;
    dcterms:identifier "hasSparePart" ;
    rdfs:domain edo:Asset ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:ProvisionRelation ;
    skos:altLabel "Spare For"@en,
        "Sobressalente Para"@pt-br ;
    skos:definition "Indicates that a domain asset may have spare parts intended to replace or support its operation, recorded in the domain schema."@en,
        "Indica que um ativo do domínio pode ter sobressalentes destinados a substituição ou suporte à operação, registrados no schema do domínio."@pt-br .

edo:hasSubDomain a owl:AnnotationProperty ;
    rdfs:label "Has SubDomain"@en,
        "Pertence a um subdomínio"@pt-br ;
    rdfs:subPropertyOf edo:DomainClassificationAnnotation ;
    skos:definition "Belongs to one or more subdomains"@en,
        "Associa a entidade a um ou mais subdomínios"@pt-br .

edo:hasTypedValue a owl:AnnotationProperty ;
    rdfs:label "Has Typed Value"@en,
        "Possui tipo de valor"@pt-br ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Indicates that the entity has a typed value, like float, string, boolean, integer, etc."@en,
        "Indica que a entidade tem um valor como número real, inteiro, texto, booleano e etc."@pt-br .

edo:hasUnit a owl:AnnotationProperty ;
    rdfs:label "Has Unit"@en,
        "Tem Unidade"@pt-br ;
    dcterms:identifier "hasUnit" ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Relates a DomainAttribute to the measurement unit in which its values are expressed."@en,
        "Relaciona um DomainAttribute à unidade de medida na qual seus valores são expressos."@pt-br .

edo:hasValueCardinality a owl:AnnotationProperty ;
    rdfs:label "Has Value Cardinality"@en,
        "Possui cardinalidade de valor"@pt-br ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Indicates the quantity of values the entity supports"@en,
        "Indica a quantidade de valores que a entidade possui"@pt-br .

edo:isCoincidentWith a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Is Coincident With"@en,
        "É Coincidente Com"@pt-br ;
    dcterms:identifier "isCoincidentWith" ;
    rdfs:domain edo:Feature ;
    rdfs:range edo:Feature ;
    rdfs:subPropertyOf edo:InterfaceRelation ;
    skos:definition "Relates two features intended to occupy the same geometric location without asserting that they are the same feature or that they form a flow connection."@en,
        "Relaciona duas features destinadas a ocupar a mesma posição geométrica, sem afirmar que sejam a mesma feature nem que formem uma conexão de fluxo."@pt-br .

edo:isDefinedByCatalogItem a owl:ObjectProperty ;
    rdfs:label "Is Defined By Catalog Item"@en,
        "É Definido Por Item ed Catálogo"@pt-br ;
    dcterms:identifier "isDefinedByCatalogItem" ;
    rdfs:subPropertyOf edo:TechnicalDefinitionRelation ;
    skos:definition "Associates a domain occurrence with a reusable technical type that defines its attributes or representation."@en,
        "Associa uma ocorrência de domínio a um tipo técnico reutilizável que define seus atributos ou representação."@pt-br .

edo:isElementConnectedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Is Element Connected To"@en,
        "Elemento Está Conectado A"@pt-br ;
    dcterms:identifier "isElementConnectedTo" ;
    rdfs:domain edo:DomainElement ;
    rdfs:range edo:DomainElement ;
    rdfs:subPropertyOf edo:ConnectionRelation ;
    owl:propertyChainAxiom ( edo:hasConnectionInterface edo:isInterfaceConnectedTo edo:isConnectionInterfaceOf ) .

edo:lifecycleRole a owl:AnnotationProperty ;
    rdfs:label "Lifecycle role"@en,
        "Papel no ciclo de vida"@pt-br ;
    dcterms:identifier "lifecycleRole" ;
    rdfs:subPropertyOf edo:DomainLifecycleAnnotation ;
    skos:definition "Indicates the semantic lifecycle role played by a domain attribute, such as requirement, design, test, operation, installation, as-built or certification."@en,
        "Indica o papel semântico desempenhado por um atributo de domínio ao longo do ciclo de vida, como requisito, projeto, teste, operação, instalação, as-built ou certificação."@pt-br .

edo:objectExpectedCardinality a owl:AnnotationProperty ;
    rdfs:label "Object Expected Cardinality"@en,
        "Cardinalidade Esperada do Objeto"@pt-br ;
    dcterms:identifier "objectExpectedCardinality" ;
    rdfs:subPropertyOf edo:DomainRelationConstraintAnnotation ;
    skos:definition "Indicates the expected cardinality of the object role when this annotation is applied to a domain relationship."@en,
        "Indica a cardinalidade esperada do papel de objeto quando esta anotação é aplicada a um relacionamento de domínio."@pt-br .

edo:serves a owl:ObjectProperty ;
    rdfs:label "Serves"@en,
        "Atende"@pt-br ;
    dcterms:identifier "serves" ;
    rdfs:subPropertyOf edo:FunctionalRelation ;
    skos:definition "Associates a functional element with the entity it serves in performing its function, without implying a part-whole relationship."@en,
        "Associa um elemento funcional à entidade que ele atende no desempenho de sua função, sem implicar relação parte-todo."@pt-br .

edo:sourceType a owl:AnnotationProperty ;
    rdfs:label "Source Type"@en,
        "Tipo de Origem"@pt-br ;
    dcterms:identifier "sourceType" ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "Indicates the source type in a rule, relation or applicability context."@en,
        "Indica o tipo de origem em uma regra, relação ou contexto de aplicabilidade."@pt-br .

edo:specializesAttribute a owl:AnnotationProperty ;
    rdfs:label "Specialises Attribute"@en,
        "Especializa Atributo"@pt-br ;
    dcterms:identifier "specializesAttribute" ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Indicates that a domain attribute specialises another, more general attribute, preserving the conceptual link between both."@en,
        "Indica que um atributo de domínio especializa outro atributo mais geral, preservando a ligação conceitual entre ambos."@pt-br .

edo:specifiValidValues a owl:AnnotationProperty ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation .

edo:subjectExpectedCardinality a owl:AnnotationProperty ;
    rdfs:label "Subject Expected Cardinality"@en,
        "Cardinalidade Esperada do Sujeito"@pt-br ;
    dcterms:identifier "subjectExpectedCardinality" ;
    rdfs:subPropertyOf edo:DomainRelationConstraintAnnotation ;
    skos:definition "Indicates the expected cardinality of the subject role when this annotation is applied to a domain relationship."@en,
        "Indica a cardinalidade esperada do papel de sujeito quando esta anotação é aplicada a um relacionamento de domínio."@pt-br .

edo:targetType a owl:AnnotationProperty ;
    rdfs:label "Target Type"@en,
        "Tipo de Destino"@pt-br ;
    dcterms:identifier "targetType" ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "Indicates the target type in a rule, relation or applicability context."@en,
        "Indica o tipo de destino em uma regra, relação ou contexto de aplicabilidade."@pt-br .

edo:validValues a owl:AnnotationProperty ;
    rdfs:label "Valid Values"@en,
        "Valores Válidos"@pt-br ;
    rdfs:subPropertyOf edo:DomainApplicabilityAnnotation ;
    skos:definition "List of valid values for the attribute."@en,
        "Lista de valores válidos para o atributo."@pt-br .

edo:valueOrigin a owl:AnnotationProperty ;
    rdfs:label "Value origin"@en,
        "Origem do valor"@pt-br ;
    dcterms:identifier "valueOrigin" ;
    rdfs:subPropertyOf edo:DomainAttributeStructureAnnotation ;
    skos:definition "Indicates the origin or acquisition mode of a value associated with a domain attribute."@en,
        "Indica a origem ou modo de obtenção de um valor associado a um atributo de domínio."@pt-br .

xsd:date a rdfs:Datatype .

xsd:time a rdfs:Datatype .

edo:AbsoluteInsidePressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "AbsoluteInsidePressure" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute,
        edo:DomainAttribute ;
    skos:definition "Represents the absolute internal pressure exerted within a component or system. This property is crucial for evaluating the structural integrity and performance, ensuring that the system can withstand the specified pressure without failure, particularly in subsea environments where pressure management is critical."@en ;
    skos:prefLabel "Absolute Inside Pressure"@en,
        "Pressão Absoluta Interna"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:AbsoluteOutsidePressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "AbsoluteOutsidePressure" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute,
        edo:DomainAttribute ;
    skos:definition "Represents the absolute external pressure exerted on a component or system. This property is essential for evaluating how the system withstands pressure from its surrounding environment, particularly in subsea applications where external pressure can be significantly higher and impact the structural integrity of the system."@en ;
    skos:prefLabel "Absolute Outside Pressure"@en,
        "Pressão Absoluta Externa"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:AnodeCollarsAxialSpacing a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "AnodeCollarsAxialSpacing" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Axial distance between each individual collar."@en ;
    skos:prefLabel "Anode Collars Axial Spacing"@en,
        "Espaçamento Axial entre os Colares de Anodo"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:AnodeCollarsQuantity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "AnodeCollarsQuantity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "The total number of anode collars to provide cathodic protection against corrosion."@en ;
    skos:prefLabel "Anode Collars Quantity"@en,
        "Quantidade de Colares de Anodo"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:IntValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:AssemblyShouldObeyModelPolarity a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "AssemblyShouldObeyModelPolarity" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "If true, the pipe section must be assembled according to the polarity in the model. If false, it can be mounted in any polarity."@en ;
    skos:prefLabel "Assembly Should Obey Model Polarity"@en,
        "A Montagem Deve Obedecer à Polaridade do Modelo"@pt-br ;
    edo:attributeOntologicalNature edo:ConditionAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:BooleanValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:AttributeValueStructures a owl:NamedIndividual,
        skos:Concept,
        edo:DomainVocabularyConcept ;
    skos:broader edo:AttributeConcepts ;
    skos:prefLabel "Attribute Value Structures"@en,
        "Estruturas de Valor de Atributo"@pt-br .

edo:AxialStiffnessUnderCompressionAtSeaLevel a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "AxialStiffnessUnderCompressionAtSeaLevel" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Represents the resistance of a component or system to axial deformation under compression when measured at sea level. This property is essential for understanding how the structure behaves under compressive loads, ensuring that it can maintain stability and structural integrity."@en,
        "Rigidez axial (EA) duto comprimido, 20°C e pressão atmosferica (dentro e fora)"@pt-br ;
    skos:prefLabel "Axial Stiffness Under Compression At Sea Level"@en,
        "Rigidez Axial sob Compressão ao Nível do Mar"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:AxialStiffnessUnderTensionAtSeaLevel a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "AxialStiffnessUnderTensionAtSeaLevel" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Represents the resistance of a component or system to axial deformation under tension when measured at sea level. This property is crucial for evaluating how the structure performs under tensile loads, ensuring it can withstand stretching forces while maintaining its integrity."@en,
        "Rigidez axial (EA) duto tracionado, 20°C e pressão atmosferica (dentro e fora)."@pt-br ;
    skos:prefLabel "Axial Stiffness Under Tension At Sea Level"@en,
        "Rigidez Axial sob Tração ao Nível do Mar"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:BasicProjectRevision a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BasicProjectRevision" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Numeric value incremented with each new submission of the project (e.g., 0000, 0001, 0002, etc.), recorded as text. This value tracks revisions and ensures clarity in version control throughout the project lifecycle, allowing stakeholders to reference the most current or previous versions as needed."@en,
        "Valor numérico incrementado a cada novo envio (0000, 0001, 0002 e etc.) como texto."@pt-br ;
    skos:prefLabel "Basic Project Revision"@en,
        "Revisão do Projeto Básico"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:BendMomentVsShearForceCurveAttribute a owl:Class ;
    rdfs:label "Bending Moment Versus Shear Force Attribute"@en ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:CurveAttribute .

edo:BendMomentVsShearForceTable a owl:Class .

edo:BendMomentVsShearForceTable_BendingMoment a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BendMomentVsShearForceTable_BendingMoment" ;
    rdfs:subClassOf edo:BendMomentVsShearForceTableColumn ;
    skos:definition "Represents the moment generated by a force causing the component or system to bend around an axis. This property is critical for assessing the structure's ability to resist bending under operational loads, ensuring it maintains its shape and structural integrity."@en ;
    skos:prefLabel "Bending Moment"@en,
        "Momento de flexão"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:BendMomentVsShearForceTable_Condition a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BendMomentVsShearForceTable_Condition" ;
    rdfs:subClassOf edo:BendMomentVsShearForceTableColumn ;
    skos:definition "Curve data flexible pipe condition."@en ;
    skos:prefLabel "Condition"@en,
        "Condição do flexível para os dados da curva"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:BendMomentVsShearForceTable_ShearForce a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BendMomentVsShearForceTable_ShearForce" ;
    rdfs:subClassOf edo:BendMomentVsShearForceTableColumn ;
    skos:definition "Represents the force applied parallel to the surface of a material or component, causing it to experience shear stress. This property is essential for evaluating the material's ability to resist sliding or deformation when subjected to external forces."@en,
        "Força de cisalhamento (Obrigatório incluir o valor para força = 0)"@pt-br ;
    skos:prefLabel "Shear Force"@en,
        "Força de Cisalhamento"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:BendingMomentTable_BendingMoment a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BendingMomentTable_BendingMoment" ;
    rdfs:subClassOf edo:BendingStiffnessTableColumn ;
    skos:definition "Represents the moment generated by a force causing the component or system to bend around an axis. This property is critical for assessing the structure's ability to resist bending under operational loads, ensuring it maintains its shape and structural integrity."@en ;
    skos:prefLabel "Bending Moment"@en,
        "Momento de Flexão"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:BendingMomentTable_Curvature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BendingMomentTable_Curvature" ;
    rdfs:subClassOf edo:BendingStiffnessTableColumn ;
    skos:definition "Represents the degree to which a component or structure bends or curves along its length. This property is important for understanding the flexibility and bending behavior, ensuring that the structure can perform as required under operational conditions without exceeding its design limits."@en ;
    skos:prefLabel "Curvature"@en,
        "Curvatura"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:BoreDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "BoreDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Internal diameter that defines the size of the passage through which fluids or gases can flow. This dimension is essential in industrial piping, as it determines flow capacity and impacts pressure and velocity within the system."@en ;
    skos:prefLabel "Bore Diameter"@en,
        "Diâmetro do Furo"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:BuoyancyTank a owl:Class ;
    dcterms:identifier "BuoyancyTank" ;
    rdfs:subClassOf edo:SubseaEquipment ;
    skos:prefLabel "Buoyancy tank"@en,
        "Tanque de flutuação"@pt-br .

edo:CO2VolumePercentage a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "CO2VolumePercentage" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Represents the percentage of carbon dioxide (CO2) in the total volume of the fluid or gas mixture within the pipeline. This value is essential for determining the material selection and design considerations for the flexible subsea pipeline, as CO2 can influence corrosion rates and impact the overall integrity and lifespan of the pipeline."@en ;
    skos:prefLabel "Carbon Dioxide (CO2) Volume Percentage"@en,
        "Porcentagem de Volume de Dióxido de Carbono (CO2)"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:BasicDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:CalculatedAbsoluteBurstPressure a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "CalculatedAbsoluteBurstPressure" ;
    rdfs:subClassOf edo:BurstPressure ;
    skos:definition "Represents the estimated absolute pressure at which a component or system is expected to fail or rupture. This property is crucial for determining the maximum safe operating pressure, ensuring that the component can withstand internal forces without bursting."@en ;
    skos:prefLabel "Calculated Absolute Burst Pressure"@en,
        "Pressão Absoluta de Ruptura Calculada"@pt-br ;
    edo:attributeNature edo:MechanicalAttribute,
        edo:PerformanceAttribute ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:PA ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:BurstPressure .

edo:CheckValve a owl:Class ;
    dcterms:identifier "CheckValve" ;
    rdfs:subClassOf edo:Valve ;
    skos:definition "Self-actuated valve designed to allow fluid passage in only one direction"@en,
        "Válvula auto-atuada projetada para permitir passagem de fluidos em apenas uma direção"@pt-br ;
    skos:prefLabel "Check Valve"@en,
        "Válvula de Retenção"@pt-br .

edo:CivilEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Civil Engineering"@en,
        "Engenharia Civil"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on the design and construction of infrastructure."@en,
        "Disciplina de engenharia focada no projeto e construção de infraestrutura."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:ClampedJoint a owl:Class ;
    dcterms:identifier "ClampedJoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:CollarClampingSurface ;
            owl:onProperty edo:connectsInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( edo:CollarClampingSurface edo:PipeClampingSurface ) ] ;
            owl:onProperty edo:connectsInterface ],
        [ a owl:Restriction ;
            owl:onClass edo:PipeClampingSurface ;
            owl:onProperty edo:connectsInterface ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:PhysicalConnection ;
    owl:disjointWith edo:FlangedJoint,
        edo:FlexiblePipeCrimpedJoint,
        edo:WeldedJoint ;
    skos:definition "Mechanical physical connection formed by distributed clamping contact between a collar clamping surface and a local external clamping surface of a pipe segment."@en,
        "Conexão física mecânica formada por contato distribuído de aperto entre a superfície de aperto de um colar e uma região local da superfície externa de um tramo de duto."@pt-br ;
    skos:prefLabel "Clamped Joint"@en,
        "Junta por Abraçadeira"@pt-br .

edo:CollarInternalDiameter a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "CollarInternalDiameter" ;
    rdfs:subClassOf edo:Diameter,
        edo:DomainAttribute ;
    skos:definition "Inner dimension of the collar, to ensure proper fitting and secure attachment."@en ;
    skos:prefLabel "Collar Internal Diameter"@en,
        "Diâmetro Interno do Colar"@pt-br ;
    edo:attributeNature edo:DimensionalAttribute ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:M ;
    edo:hasValueCardinality edo:SingleValue ;
    edo:lifecycleRole edo:DesignRole ;
    edo:specializesAttribute edo:Diameter .

edo:Commissioning a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Commissioning" ;
    skos:broader edo:ConstructionPhase ;
    skos:definition "Final testing and handover of the system into operational status."@en,
        "Testes finais e entrega do sistema para status operacional."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Commissioning"@en,
        "Comissionamento"@pt-br .

edo:CompositeLayerMaterialType a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "CompositeLayerMaterialType" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Type of material from which an object is made, allowing for precise documentation and categorisation."@en ;
    skos:prefLabel "Composite Layer Material Type"@en,
        "Tipo de Material da Camada de Compósito"@pt-br ;
    edo:attributeOntologicalNature edo:MaterialCompositionAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ConfiguredSystem a owl:Class ;
    rdfs:subClassOf edo:TechnicalArtifact ;
    skos:definition "Technical artifact that defines the internal configuration, composition or architecture of a domain system."@en,
        "Artefato técnico que define a configuração interna, composição ou arquitetura de um sistema de domínio."@pt-br ;
    skos:prefLabel "Configured System"@en,
        "Sistema Configurado"@pt-br .

edo:ConnectionSurface a owl:Class ;
    dcterms:identifier "ConnectionSurface" ;
    rdfs:subClassOf edo:ConnectionInterface ;
    skos:definition "Connection interface represented by an extended surface or contact region rather than by a discrete connection point."@en,
        "Interface de conexão representada por uma superfície ou região de contato estendida, em vez de um ponto de conexão discreto."@pt-br ;
    skos:prefLabel "Connection Surface"@en,
        "Superfície de Conexão"@pt-br .

edo:Content a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Content" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Text field for capturing observations, notes, or details related to the work. It allows for unstructured information to be recorded."@en ;
    skos:prefLabel "Content"@en ;
    edo:attributeCategory edo:ContentManagementAttribute ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ControlAndSignalLogic a owl:Class ;
    dcterms:identifier "ControlAndSignalLogic" ;
    rdfs:subClassOf edo:LogicalElement ;
    skos:definition "A logical element that defines control or signal behaviour and functional relationships within a system, independently of the physical devices that implement it."@en,
        "Elemento lógico que define comportamento de controle ou sinal e relações funcionais em um sistema, independentemente dos dispositivos físicos que o implementam."@pt-br ;
    skos:prefLabel "Control and Signal Logic"@en,
        "Lógica de Controle e Sinal"@pt-br .

edo:Coupling a owl:Class ;
    dcterms:identifier "Coupling" ;
    rdfs:subClassOf edo:HardwareItem ;
    skos:definition "Base class for termination components of cables, hoses, etc., enabling connection to other components or systems."@en,
        "Classe-base para componentes de terminação de cabos, mangueiras, etc., permitindo conexão a outros componentes ou sistemas."@pt-br ;
    skos:prefLabel "Coupling"@en,
        "Acoplamento"@pt-br .

edo:Creator a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "Creator" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:prefLabel "Creator"@en ;
    edo:attributeCategory edo:ProvenanceAttribute ;
    edo:attributeOntologicalNature edo:ProvenanceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:CreatorId a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "CreatorId" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:prefLabel "Creator Id"@en ;
    edo:attributeCategory edo:ProvenanceAttribute ;
    edo:attributeOntologicalNature edo:ProvenanceAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:CriticalCurvatureOfSlipping a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "CriticalCurvatureOfSlipping" ;
    rdfs:subClassOf edo:BendingStiffnessCurveAttribute,
        edo:DomainAttribute ;
    skos:definition "Represents the minimum curvature at which slipping or movement between layers or components begins to occur. This property is essential for assessing the flexibility and mechanical behavior of the structure, ensuring that it can maintain stability and performance under bending without experiencing slippage."@en ;
    skos:prefLabel "Critical Curvature Of Slipping"@en,
        "Curvatura crítica de escorregamento"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:DamagingPullInStraightLine a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DamagingPullInStraightLine" ;
    rdfs:subClassOf edo:DomainAttribute ;
    skos:definition "Represents the force applied during a straight-line pull-in operation that could cause damage to a component or system. This property is critical for determining safe operational limits during installation, ensuring that the component can withstand the pulling force without suffering structural damage."@en ;
    skos:prefLabel "Damaging Pull-In Straight Line"@en,
        "Tração Crítica em Linha Reta"@pt-br ;
    edo:attributeOntologicalNature edo:ConditionAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:DesignOperatingCondition a owl:Class ;
    dcterms:identifier "DesignOperatingCondition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:RequiredMaxWaterCut ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredAcetateConcentration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredHydrocarbonMolarComposition ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredFlowReferencePressure ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredVolumetricFlowRate ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredInternalFluid ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredFlowReferenceTemperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredChlorideConcentration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredBicarbonateConcentration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMaxWaterVaporConcentration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMaxH2SVolumeConcentration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredOperation ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMaxCO2MolarFraction ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredOperatingConditionId ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredPH ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMaxO2VolumeConcentration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredOperatingDuration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredFlowRegime ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Specification ;
    skos:definition "Structured owner-required operating condition established during basic design, grouping fluid, composition, operation and other condition-level requirements without representing an observed operational state."@en,
        "Condição operacional estruturada requerida pelo owner e estabelecida no projeto básico, agrupando requisitos de fluido, composição, operação e demais requisitos da condição sem representar um estado operacional observado."@pt-br ;
    skos:prefLabel "Design Operating Condition"@en,
        "Condição Operacional de Projeto"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering ;
    edo:hasOperatingState edo:DesignOperatingState .

edo:DesignOperatingState a owl:Class ;
    dcterms:identifier "DesignOperatingState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:RequiredFluidDensity ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredPositionReference ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredOperatingTemperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredOperatingPressure ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Specification ;
    skos:definition "Position-qualified state within a design operating condition, used to group required pressure, temperature, density and related values at a specific engineering reference position."@en,
        "Estado qualificado por posição dentro de uma condição operacional de projeto, usado para agrupar pressão, temperatura, massa específica e valores relacionados requeridos em uma posição de referência de engenharia específica."@pt-br ;
    skos:prefLabel "Design Operating State"@en,
        "Estado Operacional de Projeto"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering .

edo:DiffusionCurveAttribute a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:CurveAttribute .

edo:DiffusionTable a owl:Class .

edo:DiffusionTable_DiffusionCoefficient a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DiffusionTable_DiffusionCoefficient" ;
    rdfs:subClassOf edo:DiffusionTableColumn ;
    skos:definition "Represents the rate at which particles, molecules, or substances diffuse through a material. This property is important for evaluating how gases or liquids move within or through a material, helping to understand the behavior of the component, where diffusion can affect performance and integrity."@en ;
    skos:prefLabel "Diffusion Coefficient"@en,
        "Coeficiente de difusão"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:DiffusionTable_MoleculeIdentifier a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DiffusionTable_MoleculeIdentifier" ;
    rdfs:subClassOf edo:DiffusionTableColumn ;
    skos:definition "Specifies the type of molecule. This property identifies the particular molecule involved, which is crucial for understanding the material's interaction with or response to different chemical substances."@en,
        "Tipo de Molécula (co2, h2s, ch4, h2o,…)"@pt-br ;
    skos:prefLabel "Molecule Identifier"@en,
        "Identificador de Molécula"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:DiffusionTable_PolymerState a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DiffusionTable_PolymerState" ;
    rdfs:subClassOf edo:DiffusionTableColumn ;
    skos:definition "The state of the polymeric material is specified.. This property is crucial for understanding how the material behaves under different conditions and its suitability for various applications."@en,
        "estado do polímero (plastificado, não plastificado,…)"@pt-br ;
    skos:prefLabel "Polymer State"@en,
        "Estado do Polímero"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:DiffusionTable_Temperature a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DiffusionTable_Temperature" ;
    rdfs:subClassOf edo:DiffusionTableColumn ;
    skos:definition "Represents the thermal condition or measurement of heat for a component or system. This property is important for assessing how the component performs or operates under specific thermal conditions, ensuring it remains within safe and effective operating limits."@en ;
    skos:prefLabel "Temperature"@en,
        "Temperatura"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:DimensioningCriteria a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DimensioningCriteria" ;
    rdfs:subClassOf edo:LayingMinimumRadiusCurveAttribute ;
    skos:definition "Specifies the criteria used to determine the dimensions, providing guidelines and standards for accurate sizing and ensuring that the structure meets required performance and safety specifications."@en,
        "Critério de dimensionamento de raio mínimo de lançamento. Lista pré definida:Linear interpolation (curvature)Most restrictive value between the neighbouring values"@pt-br ;
    skos:prefLabel "Dimensioning Criteria"@en,
        "Critério de Dimensionamento"@pt-br ;
    edo:attributeOntologicalNature edo:RequirementDatumAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:DomainAttributeValueStructure a owl:NamedIndividual,
        skos:ConceptScheme ;
    dcterms:identifier "DomainAttributeValueStructure" ;
    skos:definition "Controlled vocabulary for structural categories of attribute values that are not datatypes or cardinalities."@en,
        "Vocabulário controlado para categorias estruturais de valores de atributos que não são tipos de dado nem cardinalidades."@pt-br ;
    skos:prefLabel "Domain attribute value structure"@en,
        "Estrutura de valor de atributo de domínio"@pt-br .

edo:DomainValidationAnnotation a owl:AnnotationProperty ;
    rdfs:label "Validation Annotation"@en,
        "Anotação de Validação"@pt-br ;
    dcterms:identifier "DomainValidationAnnotation" ;
    rdfs:subPropertyOf edo:DomainMetamodelAnnotation ;
    skos:definition "Category of annotations used to express constraints and validation rules over ontology elements."@en,
        "Categoria de anotações usadas para expressar restrições e regras de validação sobre elementos da ontologia."@pt-br .

edo:DrawingDimensionsTableAttribute a owl:Class ;
    rdfs:label "Drawing Dimensions Table" ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:TableAttribute .

edo:DrawingDimensionsTable_DimensionDescription a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DrawingDimensionsTable_DimensionDescription" ;
    rdfs:subClassOf edo:DimensionsTableColumn ;
    skos:definition "Provides a detailed description of the dimension. This property explains what the dimension represents, including its relevance and how it relates to other features or components."@en,
        "Descrição (Exemplo: Cota do ponto A ao ponto B)"@pt-br ;
    skos:prefLabel "Dimension Description"@en,
        "Descrição da Dimensão"@pt-br ;
    edo:attributeOntologicalNature edo:DocumentReferenceAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:DrawingDimensionsTable_DimensionName a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DrawingDimensionsTable_DimensionName" ;
    rdfs:subClassOf edo:DimensionsTableColumn ;
    skos:definition "Indicates the name or label assigned to the dimension. This property identifies the specific dimension, which helps in referencing and distinguishing it from other dimensions."@en ;
    skos:prefLabel "Dimension Name"@en,
        "Nome da dimensão"@pt-br ;
    edo:attributeOntologicalNature edo:IdentifierAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:DrawingDimensionsTable_DimensionUnit a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DrawingDimensionsTable_DimensionUnit" ;
    rdfs:subClassOf edo:DimensionsTableColumn ;
    skos:definition "Specifies the unit of measurement for the dimension value, expressed in SI units. For linear dimensions, this would be meters or millimeters, while for angles, it would be degrees. This property ensures that all measurements are clear, consistent, and standardized."@en,
        "A unidade pode qualquer uma do SI (Sistema Internacional de Unidades), por exemplo mm, °, etc."@pt-br ;
    skos:prefLabel "Dimension Unit"@en,
        "Unidade de Dimensão"@pt-br ;
    edo:attributeOntologicalNature edo:EnumerationAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:DrawingDimensionsTable_DimensionValue a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "DrawingDimensionsTable_DimensionValue" ;
    rdfs:subClassOf edo:DimensionsTableColumn ;
    skos:definition "Specifies the actual measurement value of the dimension. This property provides the numerical value for the dimension, which is critical for understanding the size and placement of components or features."@en ;
    skos:prefLabel "Dimension Value"@en,
        "Valor da dimensão"@pt-br ;
    edo:attributeOntologicalNature edo:TableColumnAttribute ;
    edo:hasAttributeScope edo:TypeLevelAttribute ;
    edo:hasLifecycleCreationPhase edo:DetailedDesign ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasValueCardinality edo:MultiValue .

edo:EModVsTempCurveAttribute a owl:Class ;
    rdfs:subClassOf edo:DomainAttribute ;
    edo:attributeOntologicalNature edo:CurveAttribute .

edo:EModVsTempTable_ElasticityModulus a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "EModVsTempTable_ElasticityModulus" ;
    rdfs:subClassOf edo:EModVsTempTableColumn ;

        "Módulo substituível com função principal de restrição ou regulagem de fluxo"@pt-br ;
    skos:prefLabel "Choke module"@en,
        "Módulo de choke"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:ChokeValve a owl:Class ;
    dcterms:identifier "ChokeValve" ;
    rdfs:subClassOf edo:ActuatedValve ;
    skos:definition "Valve designed to gradually restrict fluid flow, adjusted either manually or automatically by an autonomous control system/loop"@en,
        "Válvula projetada para restringir gradualmente a passagem de fluidos, ajustada manualmente ou automaticamente por um sistema/malha de controle autônoma"@pt-br ;
    skos:prefLabel "Choke Valve"@en,
        "Válvula de Restrição"@pt-br .

edo:ClampedConnection a owl:Class ;
    dcterms:identifier "ClampedConnection" ;
    dcterms:isReplacedBy edo:ClampingSurface ;
    owl:deprecated true ;
    skos:definition "Mechanical connection surface participating in a clamped attachment through distributed contact pressure."@en,
        "Superfície de conexão mecânica que participa de uma fixação por abraçadeira por meio de pressão de contato distribuída."@pt-br ;
    skos:prefLabel "Clamped Connection"@en,
        "Conexão por Abraçadeira"@pt-br .

edo:ComponentElement a owl:Class ;
    rdfs:subClassOf edo:DiscretePart ;
    skos:definition "Represents a physical part that is not individually traceable but can be replaced or assembled within a larger system, serving as a functional component rather than a consumable."@en,
        "Representa uma parte física que não é individualmente rastreável, mas pode ser substituída ou montada dentro de um sistema maior, atuando como um componente funcional em vez de um consumível."@pt-br ;
    skos:prefLabel "Component Element"@en,
        "Elemento Componente"@pt-br .

edo:CompositeMaterialSpecification a owl:Class ;
    dcterms:identifier "CompositeMaterialSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:RuptDefPerpendFibers ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:CompositeLayerMaterialType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:UltTensStrPerpendFibers ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:UltTensStrAlongFibers ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RuptDefAlongFibers ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:MaterialSpecification ;
    skos:definition "A material specification for a material composed of two or more distinct constituent materials, typically including a matrix and a reinforcement phase."@en,
        "Especificação de material composto por dois ou mais materiais constituintes distintos, tipicamente incluindo uma matriz e uma fase de reforço."@pt-br ;
    skos:prefLabel "Composite Material Specification"@en,
        "Especificação de Material Compósito"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:ConceptualDesign a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "ConceptualDesign" ;
    skos:broader edo:DesignPhase ;
    skos:definition "Initial design phase focused on feasibility, scope definition, and technology selection."@en,
        "Fase inicial de projeto focada em viabilidade, definição de escopo e seleção de tecnologia."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Conceptual Design"@en,
        "Projeto Conceitual"@pt-br .

edo:ConnectorizedElectricalCableEnd a owl:Class ;
    dcterms:identifier "ConnectorizedElectricalCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalConnectorPort ;
            owl:onProperty edo:hasEndInterface ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:Connector ;
            owl:onProperty edo:isTerminatedBy ],
        edo:ElectricalCableEnd ;
    skos:definition "Electrical cable end whose exposed service interface is provided through connector-based electrical mating hardware. It is a specialization for connectorized termination and does not imply that every electrical cable end is connectorized."@en,
        "Extremidade de cabo elétrico cuja interface de serviço exposta é fornecida por hardware de acoplamento elétrico baseado em conector. É uma especialização para terminação com conector e não implica que toda extremidade de cabo elétrico seja connectorizada."@pt-br ;
    skos:prefLabel "Connectorized Electrical Cable End"@en,
        "Extremidade de Cabo Elétrico com Conector"@pt-br .

edo:ConnectorizedOpticalFiberCableEnd a owl:Class ;
    dcterms:identifier "ConnectorizedOpticalFiberCableEnd" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass edo:Connector ;
            owl:onProperty edo:isTerminatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalConnectorPort ;
            owl:onProperty edo:hasEndInterface ],
        edo:OpticalFiberCableEnd ;
    skos:definition "Optical-fiber cable end whose exposed service interface is provided through detachable connector-based optical mating hardware. It is a specialization for connectorized termination and does not imply that every optical-fiber cable end is connectorized."@en,
        "Extremidade de cabo de fibra óptica cuja interface de serviço exposta é fornecida por hardware óptico de acoplamento baseado em conector destacável. É uma especialização para terminação com conector e não implica que toda extremidade de cabo de fibra óptica seja connectorizada."@pt-br ;
    skos:prefLabel "Connectorized Optical Fiber Cable End"@en,
        "Extremidade de Cabo de Fibra Óptica com Conector"@pt-br .

edo:ContactRatedCurrent a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ContactRatedCurrent" ;
    rdfs:subClassOf edo:ElectricalContactAttribute ;
    skos:definition "Declared current rating applicable to an individual electrical contact, allowing heterogeneous contacts within one connector to carry different current capabilities."@en,
        "Corrente nominal declarada aplicável a um contato elétrico individual, permitindo que contatos heterogêneos em um mesmo conector tenham diferentes capacidades de corrente."@pt-br ;
    skos:prefLabel "Contact Rated Current"@en,
        "Corrente Nominal do Contato"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:A ;
    edo:hasValueCardinality edo:SingleValue .

edo:ContactRatedVoltage a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ContactRatedVoltage" ;
    rdfs:subClassOf edo:ElectricalContactAttribute ;
    skos:definition "Declared voltage rating applicable to an individual electrical contact where contact-level voltage capability is specified. It is not the actual operating voltage of the connected circuit."@en,
        "Tensão nominal declarada aplicável a um contato elétrico individual quando a capacidade de tensão em nível de contato é especificada. Não corresponde à tensão efetiva de operação do circuito conectado."@pt-br ;
    skos:prefLabel "Contact Rated Voltage"@en,
        "Tensão Nominal do Contato"@pt-br ;
    edo:attributeOntologicalNature edo:PhysicalQuantityAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:FloatValue ;
    edo:hasUnit unit:V ;
    edo:hasValueCardinality edo:SingleValue .

edo:Contract a owl:Class ;
    dcterms:identifier "Contract" ;
    rdfs:subClassOf edo:InformationArtifact ;
    skos:definition "An information artifact representing a formal agreement that establishes obligations, responsibilities, scope or conditions between participating parties."@en,
        "Artefato informacional que representa um acordo formal que estabelece obrigações, responsabilidades, escopo ou condições entre as partes participantes."@pt-br ;
    skos:prefLabel "Contract"@en,
        "Contrato"@pt-br ;
    edo:hasDiscipline edo:CommissioningEngineering .

edo:ControlLoop a owl:Class ;
    dcterms:identifier "ControlLoop" ;
    rdfs:subClassOf edo:ControlAndSignalLogic ;
    skos:definition "A logical control structure that defines a feedback or regulation loop within a system, independently of the physical instruments and control devices that implement it."@en,
        "Estrutura lógica de controle que define uma malha de realimentação ou regulação em um sistema, independentemente dos instrumentos e dispositivos físicos de controle que a implementam."@pt-br ;
    skos:prefLabel "Control Loop"@en,
        "Loop de Controle"@pt-br .

edo:CrossoverModule a owl:Class ;
    dcterms:identifier "CrossoverModule" ;
    rdfs:subClassOf edo:FlowControlModule ;
    skos:definition "Replaceable module that enables closure of a flow circuit"@en,
        "Módulo substituível que permite fechamento de um circuito de fluxo"@pt-br ;
    skos:prefLabel "Cross-over module"@en,
        "Módulo de cross-over"@pt-br ;
    edo:hasDiscipline edo:WetChristmasTreesEngineering .

edo:DataDictionary a owl:Class ;
    dcterms:identifier "DataDictionary"@en ;
    rdfs:subClassOf edo:ExternalReference ;
    skos:definition "Represents a structured collection of definitions, attributes, and rules that provide a standardized reference for elements within a project or system."@en,
        "Representa uma coleção estruturada de definições, atributos e regras que fornecem uma referência padronizada para elementos dentro de um projeto ou sistema."@pt-br ;
    skos:prefLabel "Data Dictionary"@en,
        "Dicionário de Dados"@pt-br .

edo:DateValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Date Value"@en ;
    rdfs:comment "Expected XSD datatype for calendar date values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:date .

edo:DeadweightCollar a owl:Class ;
    dcterms:identifier "DeadweightCollar" ;
    rdfs:subClassOf edo:SplitCollar ;
    skos:altLabel "Ballast Collar"@en,
        "Dead Weight Clamp"@en,
        "Sinking Collar"@en,
        "Weight Collar"@en ;
    skos:definition "Component used in subsea systems to provide additional weight to flexible pipes, risers, or umbilicals, ensuring proper stability and positioning on the seabed. The Deadweight Collar is designed to counteract buoyant forces, preventing unwanted movement of the pipe due to ocean currents or other environmental factors. Typically made from dense materials, it plays a crucial role in maintaining the alignment and stability of lines in dynamic environments, ensuring that the system remains securely anchored."@en,
        "Componente utilizado em sistemas submersos para fornecer peso adicional a dutos flexíveis, risers ou umbilicais, garantindo a estabilidade e o posicionamento adequados no fundo marinho. O Colar de Peso Morto é projetado para contrabalançar as forças de flutuabilidade, prevenindo o movimento indesejado do duto devido a correntes oceânicas ou outros fatores ambientais. Geralmente feito de materiais densos, ele desempenha um papel crucial na manutenção do alinhamento e da estabilidade das linhas submersas em ambientes dinâmicos, garantindo que o sistema permaneça firmemente ancorado."@pt-br ;
    skos:prefLabel "Deadweight Collar"@en,
        "Colar de Peso Morto"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:DecimalValue a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Decimal Value"@en ;
    rdfs:comment "Expected XSD datatype for decimal numeric values."@en ;
    skos:broader edo:DomainValueTypes ;
    skos:inScheme edo:DomainValueType ;
    edo:expectedXsdType xsd:decimal .

edo:DeclaredValue a owl:NamedIndividual,

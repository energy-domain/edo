            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:EarlyLeakNomPressTable_TensLimit ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:EarlyLeakNomPressTable_PressValRef ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:FatNomPressValRefMult ;
            owl:onProperty edo:hasAttribute ;

    skos:prefLabel "Drag anchor"@en,
        "Âncora de arrasto"@pt-br .

edo:DynamicUmbilicalSpan a owl:Class ;
    dcterms:identifier "DynamicUmbilicalSpan" ;
    rdfs:subClassOf edo:UmbilicalSpan ;
    skos:definition "Suspended umbilical span, continuously subjected to dynamic loading"@en,
        "Trecho de umbilical suspenso, sujeito continuamente a esforços dinâmicos"@pt-br ;
    skos:prefLabel "Dynamic umbilical span"@en,
        "Trecho dinâmico de umbilical"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:ElectricalConnectorFamily a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ElectricalConnectorFamily" ;
    rdfs:subClassOf edo:ElectricalInterfaceSpecificationAttribute ;
    skos:definition "Identifier or designation of the connector family, series or interface system that defines a common electrical mating envelope. Concrete manufacturer catalogue identifiers belong in external data rather than as EDO core individuals."@en,
        "Identificador ou designação da família, série ou sistema de interface do conector que define um envelope comum de acoplamento elétrico. Identificadores concretos de catálogo de fabricante pertencem aos dados externos, e não como indivíduos do núcleo da EDO."@pt-br ;
    skos:prefLabel "Electrical Connector Family"@en,
        "Família de Conector Elétrico"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ElectricalContactArrangement a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ElectricalContactArrangement" ;
    rdfs:subClassOf edo:ElectricalInterfaceSpecificationAttribute ;
    skos:definition "Declared aggregate arrangement of electrical contacts relevant to mating, including count, layout or contact-type pattern as needed. It may coexist with detailed ElectricalContactSpecification records but does not require them and does not by itself represent project-specific circuit assignment or wiring."@en,
        "Arranjo agregado declarado dos contatos elétricos relevante ao acoplamento, incluindo quantidade, disposição ou padrão de tipos de contato conforme necessário. Pode coexistir com registros detalhados de ElectricalContactSpecification, mas não os exige e, por si só, não representa a atribuição de circuitos ou a fiação específica do projeto."@pt-br ;
    skos:prefLabel "Electrical Contact Arrangement"@en,
        "Arranjo de Contatos Elétricos"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ElectricalEngineering a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Electrical Engineering"@en,
        "Engenharia Elétrica"@pt-br ;
    skos:broader edo:TechnicalDiscipline ;
    skos:definition "Engineering discipline focused on electrical systems, power distribution and generation."@en,
        "Disciplina de engenharia focada em sistemas elétricos, distribuição e geração de energia."@pt-br ;
    skos:inScheme edo:TechnicalDisciplineScheme .

edo:ElectricalJumper a owl:Class ;
    dcterms:identifier "ElectricalJumper" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalControlPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:Jumper ;
    skos:definition "Jumper for signal transmission or low-power eletrical supply"@en,
        "Jumper para transmissão de sinais ou alimentação elétrica de baixa potência"@pt-br ;
    skos:prefLabel "Electrical jumper"@en,
        "Jumper elétrico"@pt-br .

edo:ElectricalJumperConnector a owl:Class ;
    dcterms:identifier "ElectricalJumperConnector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalControlConnectorPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalControlPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:JumperConnector ;
    skos:definition "Connector for termination of electrical signal/low-current jumpers or cables."@en,
        "Conector para terminação de jumpers/cabos elétricos de sinal/baixa corrente."@pt-br ;
    skos:prefLabel "Electrical Jumper Connector"@en,
        "Conector de Jumper Elétrico"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:ElectricalKeying a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ElectricalKeying" ;
    rdfs:subClassOf edo:ElectricalInterfaceSpecificationAttribute ;
    skos:definition "Keying, polarisation or coding designation used by an electrical connector interface to prevent unintended mating with a mechanically similar but incompatible counterpart."@en,
        "Designação de chaveamento, polarização ou codificação usada por uma interface de conector elétrico para impedir acoplamento não intencional com uma contraparte mecanicamente semelhante, porém incompatível."@pt-br ;
    skos:prefLabel "Electrical Keying"@en,
        "Chaveamento Elétrico"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ElectricalMatingRole a owl:Class ;
    dcterms:accessRights "PUBLIC" ;
    dcterms:identifier "ElectricalMatingRole" ;
    rdfs:subClassOf edo:ElectricalInterfaceSpecificationAttribute ;
    skos:definition "Declared mating role of an electrical connector interface, such as plug, receptacle, male, female or genderless/hermaphroditic where applicable. The vocabulary of concrete role values is intentionally not closed in the EDO core."@en,
        "Papel de acoplamento declarado de uma interface de conector elétrico, como plugue, receptáculo, macho, fêmea ou sem gênero/hermafrodita quando aplicável. O vocabulário de valores concretos de papel não é fechado intencionalmente no núcleo da EDO."@pt-br ;
    skos:prefLabel "Electrical Mating Role"@en,
        "Papel de Acoplamento Elétrico"@pt-br ;
    edo:attributeOntologicalNature edo:QualityDatumAttribute ;
    edo:hasAttributeScope edo:InstanceLevelAttribute ;
    edo:hasTypedValue edo:StringValue ;
    edo:hasValueCardinality edo:SingleValue .

edo:ElectricalPowerJumper a owl:Class ;
    dcterms:identifier "ElectricalPowerJumper" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalPowerPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:Jumper ;
    skos:prefLabel "Electrical power jumper"@en,
        "Jumper elétrico de potência"@pt-br .

edo:ElectricalPowerJumperConnector a owl:Class ;
    dcterms:identifier "ElectricalPowerJumperConnector" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalPowerConnectorPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricalPowerPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:ElectricPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:JumperConnector ;
    skos:definition "Connector for termination of high-voltage/high-current electrical jumpers or cables."@en,
        "Conector para terminação de jumpers/cabos elétricos de alta tensão/corrente."@pt-br ;
    skos:prefLabel "Electrical Power Jumper Connector"@en,
        "Conector de Jumper Elétrico de Potência"@pt-br ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:EnergyStorage a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Energy Storage"@en,
        "Armazenamento de Energia"@pt-br ;
    skos:broader edo:Domain ;
    skos:definition "Technologies for storing energy, such as batteries, pumped hydro, or compressed air."@en,
        "Tecnologias para armazenamento de energia, como baterias, hidroelétricas reversíveis ou ar comprimido."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme .

edo:EnhancedGeothermalSystems a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "EnhancedGeothermalSystems" ;
    skos:broader edo:Geothermal ;
    skos:definition "Enhanced geothermal systems (EGS) create artificial reservoirs in hot dry rock by injecting water at high pressure, enabling the extraction of geothermal energy in areas without naturally occurring hydrothermal resources."@en,
        "Sistemas geotérmicos estimulados (EGS) criam reservatórios artificiais em rochas secas quentes através da injeção de água em alta pressão, possibilitando a extração de energia geotérmica em áreas sem recursos hidrotermais naturais."@pt-br ;
    skos:inScheme edo:IndustrialDomainScheme ;
    skos:prefLabel "Enhanced Geothermal Systems"@en,
        "Sistemas Geotérmicos Estimulados"@pt-br .

edo:EquipmentLocation a owl:Class ;
    dcterms:identifier "EquipmentLocation" ;
    rdfs:subClassOf edo:PointLocation ;
    skos:definition "Base for installation sites for large underwater equipment."@en,
        "Base para locais de instalação de grandes equipamentos submarinos"@pt-br ;
    skos:prefLabel "Equipment Location"@en,
        "Localização de Equipamento"@pt-br .

edo:FEED a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "FEED" ;
    skos:broader edo:DesignPhase ;
    skos:definition "Intermediate phase between conceptual and detailed design, refining technical and cost details."@en,
        "Fase intermediária entre o projeto conceitual e detalhado, refinando detalhes técnicos e de custo."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "FEED (Front-End Engineering Design)"@en,
        "FEED (Projeto Básico de Engenharia)"@pt-br .

edo:FSHRLowerAssembly a owl:Class ;
    dcterms:identifier "FSHRLowerAssembly" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    skos:prefLabel "FSHR lower assembly"@en,
        "Estrutura inferior de RHAS"@pt-br .

edo:FSHRUpperAssembly a owl:Class ;
    dcterms:identifier "FSHRUpperAssembly" ;
    rdfs:subClassOf edo:FlowControlEquipment ;
    skos:prefLabel "FSHR upper assembly"@en,
        "Estrutura de topo de RHAS"@pt-br .

edo:FabricTape a owl:Class ;
    dcterms:identifier "FabricTape" ;
    rdfs:subClassOf edo:TapeLayer ;
    skos:definition "Material used in subsea flexible pipe construction, typically applied as a wrapping layer to provide protection and containment for internal components. Fabric Tape is designed to secure and hold various layers of the pipe in place during manufacturing and operation, preventing displacement or damage to the underlying layers. It also adds a layer of abrasion resistance, contributing to the overall durability of the pipe in dynamic subsea environments. Made from high-strength, flexible materials, Fabric Tape plays a key role in maintaining the integrity of the flexible pipe structure."@en,
        "Material utilizado na construção de dutos flexíveis, geralmente aplicado como uma camada de envolvimento para fornecer proteção e contenção para os componentes internos. A Fita Construtiva é projetada para segurar e manter as várias camadas do duto no lugar durante a fabricação e operação, evitando o deslocamento ou danos às camadas subjacentes. Ela também adiciona uma camada de resistência à abrasão, contribuindo para a durabilidade geral do duto em ambientes dinâmicos. Feita de materiais flexíveis e de alta resistência, a Fita Construtiva desempenha um papel crucial na manutenção da integridade da estrutura do duto flexível."@pt-br ;
    skos:prefLabel "Fabric Tape"@en,
        "Fita Construtiva"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:Fabrication a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "Fabrication" ;
    skos:broader edo:ConstructionPhase ;
    skos:definition "Manufacturing and assembly of components, modules, or structures in workshops or yards."@en,
        "Fabricação e montagem de componentes, módulos ou estruturas em oficinas ou estaleiros."@pt-br ;
    skos:inScheme edo:LifecyclePhaseScheme ;
    skos:prefLabel "Fabrication"@en,
        "Fabricação"@pt-br .

edo:FiberOpticJumper a owl:Class ;
    dcterms:identifier "FiberOpticJumper" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom edo:OpticalConnectorPort ;
            owl:onProperty edo:hasConnectionPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:DataPort ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:LinearObject ;
    skos:prefLabel "Optical Jumper"@en,
        "Jumper Ótico"@pt-br .

edo:FiberRopeSegment a owl:Class ;
    dcterms:identifier "FiberRopeSegment" ;
    rdfs:subClassOf edo:RopeSegment ;
    skos:prefLabel "Fiber rope segment"@en,
        "Tramo de cabo de fibra"@pt-br .

edo:Filler a owl:Class ;
    dcterms:identifier "Filler" ;
    rdfs:subClassOf edo:UmbilicalComponent ;
    skos:definition "Represents filler material used within an umbilical component to provide structural support or separation between functional lines."@en,
        "Representa material de preenchimento utilizado em um componente umbilical para fornecer suporte estrutural ou separação entre linhas funcionais."@pt-br ;
    skos:prefLabel "Filler"@en,
        "Enchimento"@pt-br,
        "Preenchimento"@pt-br ;
    edo:classInstantiationRole edo:ProjectInstantiableClass ;
    edo:hasDiscipline edo:SubseaUmbilicalsEngineering .

edo:FinancialAttribute a owl:NamedIndividual,
        skos:Concept ;
    dcterms:identifier "FinancialAttribute" ;
    skos:broader edo:AttributeCategories ;
    skos:definition "Attribute category related to costs, prices, depreciation or financial information."@en,
        "Categoria de atributo relacionada a custos, preços, depreciação ou informações financeiras."@pt-br ;
    skos:inScheme edo:DomainAttributeCategory ;
    skos:prefLabel "Financial attribute"@en,
        "Atributo financeiro"@pt-br .

edo:FlangeAdapter a owl:Class ;
    dcterms:identifier "FlangeAdapter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:FlangeConnection ;
            owl:onProperty edo:hasConnectionPoint ;
            owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom edo:FlangeConnection ;
            owl:onProperty edo:hasConnectionPoint ],
        edo:PressureComponent ;
    skos:definition "Component enabling connection between two different flanges."@en,
        "Peça que permite a conexão entre dois flanges diferentes."@pt-br ;
    skos:prefLabel "Flange Adapter"@en,
        "Adaptador de Flange"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering,
        edo:SubseaUmbilicalsEngineering .

edo:FlexiblePipeEnd a owl:Class ;
    dcterms:identifier "FlexiblePipeEnd" ;
    dcterms:isReplacedBy edo:FlexiblePipeBodyEnd ;
    rdfs:subClassOf edo:LinearEnd ;
    owl:deprecated true ;
    skos:definition "Linear end of a flexible pipe segment exposing the crimped interface by which an end fitting is permanently attached."@en,
        "Extremidade linear de um tramo de duto flexível que apresenta a interface crimpada pela qual um end fitting é permanentemente fixado."@pt-br ;
    skos:prefLabel "Flexible Pipe End"@en,
        "Extremidade do Duto Flexível"@pt-br .

edo:FlexiblePipeEnvelope a owl:Class ;
    dcterms:identifier "FlexiblePipeEnvelope" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass edo:RequiredDesignLife ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMinWaterDepth ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredBoreType ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMinimumTemperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredRiserConfiguration ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredService ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMaximumTemperature ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredInternalDiameter ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredPipeSectionApplication ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass edo:RequiredMaxWaterDepth ;
            owl:onProperty edo:hasAttribute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        edo:Specification ;
    skos:definition "A flexible pipe specification that defines the required design conditions, limits and technical requirements that constrain the development or selection of a flexible pipe structure."@en,
        "Especificação de duto flexível que define as condições de projeto, limites e requisitos técnicos requeridos que condicionam o desenvolvimento ou a seleção de uma estrutura de duto flexível."@pt-br ;
    skos:prefLabel "Flexible Pipe Envelope"@en,
        "Envoltória de Duto Flexível"@pt-br ;
    edo:hasDiscipline edo:SubseaFlexiblePipesEngineering ;
    edo:hasOperatingCondition edo:DesignOperatingCondition .


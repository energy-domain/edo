######################################################################
# 10) Controlled concepts for realizing element requirement
######################################################################

edo-ifc:RequiresRealizingElements
    rdf:type owl:NamedIndividual ;
    rdf:type edo-ifc:RealizingElementRequirement ;

    rdfs:label "Requires Realizing Elements"@en ;
    rdfs:label "Requer Elementos Realizadores"@pt-br ;

    skos:definition "Indicates that the IFC mapping rule applies when the EDO connection context includes one or more realizing elements."@en ;
    skos:definition "Indica que a regra de mapeamento IFC se aplica quando o contexto de conexão da EDO inclui um ou mais elementos realizadores."@pt-br ;

    dcterms:identifier "RequiresRealizingElements" .


edo-ifc:DoesNotRequireRealizingElements
    rdf:type owl:NamedIndividual ;
    rdf:type edo-ifc:RealizingElementRequirement ;

    rdfs:label "Does Not Require Realizing Elements"@en ;
    rdfs:label "Não Requer Elementos Realizadores"@pt-br ;

    skos:definition "Indicates that the IFC mapping rule applies when the EDO connection context does not include realizing elements."@en ;
    skos:definition "Indica que a regra de mapeamento IFC se aplica quando o contexto de conexão da EDO não inclui elementos realizadores."@pt-br ;

    dcterms:identifier "DoesNotRequireRealizingElements" .


edo-ifc:AnyRealizingElementRequirement
    rdf:type owl:NamedIndividual ;
    rdf:type edo-ifc:RealizingElementRequirement ;

    rdfs:label "Any Realizing Element Requirement"@en ;
    rdfs:label "Qualquer Requisito de Elemento Realizador"@pt-br ;

    skos:definition "Indicates that the IFC mapping rule applies regardless of whether realizing elements are present or absent."@en ;
    skos:definition "Indica que a regra de mapeamento IFC se aplica independentemente de elementos realizadores estarem presentes ou ausentes."@pt-br ;

    dcterms:identifier "AnyRealizingElementRequirement" .

######################################################################
# 11) Direct IFC mappings for EDO relationships
######################################################################

edo:hasPart
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAggregates ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatingObject ;
    edo-ifc:ifc_objectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_relationshipName "hasPart" .

edo:hasOrderedPart
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelNests ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatingObject ;
    edo-ifc:ifc_objectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_relationshipName "hasOrderedPart" .

edo:hasDocument
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAssociatesDocument ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_objectRole edo-ifc:RelatingDocument .

edo:hasClassificationReference
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAssociatesClassification ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_objectRole edo-ifc:RelatingClassification .

edo:hasMaterial
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAssociatesMaterial ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_objectRole edo-ifc:RelatingMaterial .

edo:belongsToGroup
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAssignsToGroup ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_objectRole edo-ifc:RelatingGroup .

edo:hasSparePart
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAssignsToProduct ;
    edo-ifc:ifc_invertedDirection "true"^^xsd:boolean ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatingProduct ;
    edo-ifc:ifc_objectRole edo-ifc:RelatedObjects .

######################################################################
# 11A) Synchronized IFC class mappings
#
# Legacy class mappings migrated from 418986468282 only when the
# EDO class still exists in the current core. Explicit current decisions
# for flexible pipes override legacy values.
######################################################################


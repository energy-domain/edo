# Occurrence -> reusable technical type.
edo:isDefinedByCatalogItem
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelDefinesByType ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_objectRole edo-ifc:RelatingType ;
    edo-ifc:ifc_relationshipName "isDefinedByCatalogItem" .


edo:ConnectionModule
    edo-ifc:ifc_equivalentClass edo-ifc:IfcElementAssembly ;
    edo-ifc:ifc_objectType "ConnectionModule" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .


    edo-ifc:ifc_objectType "WearBushingRunningTool" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .

edo:WeldedConnection
    edo-ifc:ifc_equivalentClass edo-ifc:IfcDistributionPort ;
    edo-ifc:ifc_objectType "WeldedConnection" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .

edo:Wellhead
    edo-ifc:ifc_equivalentClass edo-ifc:IfcPipeFitting ;
    edo-ifc:ifc_objectType "Wellhead" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .

edo:WetChristmasTree
    edo-ifc:ifc_equivalentClass edo-ifc:IfcElementAssembly ;
    edo-ifc:ifc_objectType "WetChristmasTree" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .

edo:WireRopeSegment
    edo-ifc:ifc_equivalentClass edo-ifc:IfcMember ;
    edo-ifc:ifc_objectType "WireRopeSegment" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .



# Occurrence -> reusable technical type.
edo:isDefinedByCatalogItem
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelDefinesByType ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_objectRole edo-ifc:RelatingType ;
    edo-ifc:ifc_relationshipName "isDefinedByCatalogItem" .


edo:ConnectionModule
    edo-ifc:ifc_equivalentClass edo-ifc:IfcElementAssembly ;
    edo-ifc:ifc_objectType "ConnectionModule" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .

edo:RiserSupport
    edo-ifc:ifc_equivalentClass edo-ifc:IfcElementAssembly ;
    edo-ifc:ifc_objectType "RiserSupport" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .

edo:ConnectionPoint
    edo-ifc:ifc_equivalentClass edo-ifc:IfcDistributionPort ;
    edo-ifc:ifc_objectType "ConnectionPoint" ;
    edo-ifc:ifc_predefinedType "USERDEFINED" .

# H03: field spatially contains the platform. With SubseaOilField→IfcSite and
# FloatingProductionUnit→IfcElementAssembly this is valid IfcRelContainedInSpatialStructure.
edo:spatiallyContains
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelContainedInSpatialStructure ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatingStructure ;
    edo-ifc:ifc_objectRole edo-ifc:RelatedElements ;
    edo-ifc:ifc_relationshipName "spatiallyContains" .

# H02: the well serves the production unit, while the IFC tree is intentionally
# inverted so the production unit is the aggregate parent of the well.
edo:serves
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAggregates ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_objectRole edo-ifc:RelatingObject ;
    edo-ifc:ifc_relationshipName "serves" .

# H04: functional interconnections are organised below the well in the IFC tree.
edo:hasInterconnection
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAggregates ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatingObject ;
    edo-ifc:ifc_objectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_relationshipName "hasInterconnection" .

# H05: with SubseaWell and WetChristmasTree both materialised as IfcElementAssembly,
# hierarchy is carried by IfcRelAggregates; physical WCT↔Wellhead connectivity remains separate.
edo:hosts
    edo-ifc:ifc_equivalentClass edo-ifc:IfcRelAggregates ;
    edo-ifc:ifc_subjectRole edo-ifc:RelatingObject ;
    edo-ifc:ifc_objectRole edo-ifc:RelatedObjects ;
    edo-ifc:ifc_relationshipName "hosts" .

# Specification attribute projection. FlexiblePipeEnvelope remains a first-class
# EDO specification but is deliberately not materialised as an IFC object in the
# current Petrobras delivery. Its requirement attributes are projected onto the
# IfcPipeSegmentType carrier of FlexiblePipeStructure. They can then be exposed to
# FlexiblePipeSegment occurrences through native IfcRelDefinesByType semantics.
edo:hasSpec
    edo-ifc:ifc_attributeProjectionRule [
        edo-ifc:sourceEDOClass edo:FlexiblePipeStructure ;
        edo-ifc:targetEDOClass edo:FlexiblePipeEnvelope ;
        edo-ifc:attributeProjectionDirection edo-ifc:ObjectToSubject ;
        edo-ifc:projectInheritedAttributes true ;
        edo-ifc:projectNestedStructures true
    ] .

edo:hasOperatingCondition
    edo-ifc:ifc_attributeProjectionRule [
        edo-ifc:sourceEDOClass edo:FlexiblePipeEnvelope ;
        edo-ifc:targetEDOClass edo:DesignOperatingCondition ;
        edo-ifc:attributeProjectionDirection edo-ifc:ObjectToSubject ;
        edo-ifc:projectInheritedAttributes true ;
        edo-ifc:projectNestedStructures true
    ] .

edo:hasOperatingState
    edo-ifc:ifc_attributeProjectionRule [
        edo-ifc:sourceEDOClass edo:DesignOperatingCondition ;
        edo-ifc:targetEDOClass edo:DesignOperatingState ;
        edo-ifc:attributeProjectionDirection edo-ifc:ObjectToSubject ;
        edo-ifc:projectInheritedAttributes true
    ] .

######################################################################
# 12) Conditional IFC materialisation rules for edo:isConnectedTo
#
# Logic:
#
# 1. Port + Port:
#    - Always materialise as IfcRelConnectsPorts.
#    - If realizing elements exist, they fill IfcRelConnectsPorts.RealizingElement.
#
# 2. Non-port + Non-port:
#    - Without realizing elements: IfcRelConnectsElements.
#    - With realizing elements: IfcRelConnectsWithRealizingElements.
#
# The negative condition is IFC-specific and therefore lives here,
# not in the EDO core.
######################################################################

edo:isConnectedTo
    edo-ifc:ifc_mappingRule [
        edo-ifc:sourceIfcEquivalentClass edo-ifc:IfcDistributionPort ;
        edo-ifc:targetIfcEquivalentClass edo-ifc:IfcDistributionPort ;
        edo-ifc:realizingElementRequirement edo-ifc:AnyRealizingElementRequirement ;
        edo-ifc:ifc_equivalentClass edo-ifc:IfcRelConnectsPorts ;
        edo-ifc:ifc_subjectRole edo-ifc:RelatingPort ;
        edo-ifc:ifc_objectRole edo-ifc:RelatedPort ;
        edo-ifc:realizingElementRole edo-ifc:RealizingElement
    ] ;

    edo-ifc:ifc_mappingRule [
        edo-ifc:sourceNotIfcEquivalentClass edo-ifc:IfcDistributionPort ;
        edo-ifc:targetNotIfcEquivalentClass edo-ifc:IfcDistributionPort ;
        edo-ifc:realizingElementRequirement edo-ifc:DoesNotRequireRealizingElements ;
        edo-ifc:ifc_equivalentClass edo-ifc:IfcRelConnectsElements ;
        edo-ifc:ifc_subjectRole edo-ifc:RelatingElement ;
        edo-ifc:ifc_objectRole edo-ifc:RelatedElement
    ] ;

    edo-ifc:ifc_mappingRule [
        edo-ifc:sourceNotIfcEquivalentClass edo-ifc:IfcDistributionPort ;
        edo-ifc:targetNotIfcEquivalentClass edo-ifc:IfcDistributionPort ;
        edo-ifc:realizingElementRequirement edo-ifc:RequiresRealizingElements ;
        edo-ifc:ifc_equivalentClass edo-ifc:IfcRelConnectsWithRealizingElements ;
        edo-ifc:ifc_subjectRole edo-ifc:RelatingElement ;
        edo-ifc:ifc_objectRole edo-ifc:RelatedElement ;
        edo-ifc:realizingElementRole edo-ifc:RealizingElements
    ] .